module view
  purpose: The frame of a game state: sky, floor, textured walls, the demons, the shotgun, the bar.

import enemies exposing Enemy
import fixed
import font
import game exposing State, Status
import hud
import level exposing Tile, Cell
import raycast exposing Hit, Side, Vector
import shapes
import sprites
import std.screen exposing Colour, Shape
import weapon

public type Span
  purpose: The first and last screen rows of something drawn on a column.
  has top: Integer
  has bottom: Integer
  can ToText
end

type Walls
  purpose: The wall strips of a frame and the depth of the nearest wall at every screen column.
  has strips: List of Shape
  has depths: List of Integer
end

let horizon: Integer be 84
  purpose: The screen row of the eye's level, the middle of the view above the status bar.

let projection: Integer be 242
  purpose: The rows a cell's height takes one cell away: as many as the columns of its width.

let eye: Integer be 41
  purpose: The eye's height above the floor in a cell 128 high, the original game's.

let texels: Integer be 128
  purpose: The texels of a wall's height and of a cell's width; images are drawn at this scale.

function height_at(distance: Integer) returns Integer
  purpose: The rows a thing of one cell's height takes at a distance.
  example: height_at(4096) is 242
  example: height_at(8192) is 121

  return (projection * fixed.unit).quotient(distance.at_least(128))
end

public function wall_span(distance: Integer) returns Span
  purpose: The rows a wall at a distance covers, from its top to the floor; the host clips.
  example: wall_span(4096) is Span(top: -80, bottom: 160)
  example: wall_span(8192) is Span(top: 2, bottom: 121)

  let height be height_at(distance)
  let top be horizon - ((texels - eye) * height).quotient(texels)
  return Span(top: top, bottom: horizon + (eye * height).quotient(texels) - 1)
end

public function shade_for(distance: Integer, side: Side) returns Integer
  purpose: The light on a wall in percent: dimmer with distance, faces across y darker, at least 20.
  example: shade_for(distance: 0, side: AcrossX) is 100
  example: shade_for(distance: 4096 * 4, side: AcrossY) is 60
  example: shade_for(distance: 4096 * 50, side: AcrossX) is 20

  let near be 100 - (distance * 6).quotient(fixed.unit)
  match side
    when AcrossX then return near.at_least(20)
    when AcrossY then return (near - 16).at_least(20)
  end
end

public function texture_column(offset: Integer) returns Integer
  purpose: The texel column of a hit's offset: a cell is 128 texels wide, so 64-wide images repeat.
  example: texture_column(0) is 0
  example: texture_column(2048) is 64
  example: texture_column(4095) is 127

  return offset.quotient(fixed.unit.quotient(texels))
end

public function texture_of(tile: Tile, column: Integer) returns Text
  purpose: The image of a wall: STARTAN's two halves across a cell, one image for the others.
  example: texture_of(tile: Stone, column: 10) is "sw19_2"
  example: texture_of(tile: Stone, column: 70) is "sw19_1"
  example: texture_of(tile: Exit, column: 70) is "door9_2"

  match tile
    when Stone then return if column is less than 64 then "sw19_2" otherwise "sw19_1" end
    when Brick then return "rw1_4"
    when Bronze then return "rw10_1"
    when Metal then return "wall47_1"
    when Marble then return "mwall1_1"
    when Tech then return "w94_1"
    when Panel then return "wla128_1"
    when Door then return "door2_4"
    when Exit then return "door9_2"
    when Floor then return "wall62_1"
  end
end

public function wall_strip(hit: Hit, column: Integer) returns Shape
  purpose: The Strip a ray's hit draws: rows from the distance, texel and light from the hit.
  example: wall_strip(
    hit: Hit(distance: 8192, tile: Exit, side: AcrossX, offset: 2048, opening: 0),
    column: 7
  ) is Strip(screen_x: 7, top: 2, bottom: 121, image: "door9_2", column: 64, shade: 88)
  example: wall_strip(
    hit: Hit(distance: 8192, tile: Door, side: AcrossY, offset: 0, opening: 2048),
    column: 7
  ) is Strip(screen_x: 7, top: 2, bottom: 61, image: "door2_4", column: 0, shade: 72)

  let span be wall_span(hit.distance)
  let texel be texture_column(hit.offset)
  let lowered be span.bottom - ((span.bottom - span.top + 1) * hit.opening).quotient(fixed.unit)
  return Strip(
    screen_x: column,
    top: span.top,
    bottom: lowered,
    image: texture_of(tile: hit.tile, column: texel),
    column: texel,
    shade: shade_for(distance: hit.distance, side: hit.side)
  )
end

function walls(state: State) returns Walls
  purpose: The strips of every screen column, a wall seen under a door that is rising first.

  let mutable strips: List of Shape be []
  let mutable depths: List of Integer be []
  let origin be state.hero.position
  let view be raycast.camera(state.hero.angle)
  for each column from 0 to shapes.screen_width - 1
    let ray be raycast.ray_through(view: view, column: column, columns: shapes.screen_width)
    let hit be raycast.cast(maze: state.maze, origin: origin, ray: ray)
    if hit.opening is greater than 0 then
      let behind be raycast.cast_past(maze: state.maze, origin: origin, ray: ray, skip: 1)
      change strips to strips.append(wall_strip(hit: behind, column: column))
    end
    change strips to strips.append(wall_strip(hit: hit, column: column))
    change depths to depths.append(hit.distance)
  end
  return Walls(strips: strips, depths: depths)
end

let sky_width: Integer be 436
  purpose: The columns the sky's 256 texels take: a quarter turn of view, as in the original game.

public function sky(angle: Integer) returns List of Shape
  purpose: The sky above the walls, two copies side by side, scrolled a quarter turn per copy.
  example: sky(0).at(0)
    is Picture(screen_x: 0, screen_y: -36, width: 436, height: 154, image: "rsky1", shade: 100)
  example: sky(512).at(1)
    is Picture(screen_x: 218, screen_y: -36, width: 436, height: 154, image: "rsky1", shade: 100)

  let left be 0 - ((angle remainder 1024) * sky_width).quotient(1024)
  return [
    Picture(
      screen_x: left,
      screen_y: -36,
      width: sky_width,
      height: 154,
      image: "rsky1",
      shade: 100
    ),
    Picture(
      screen_x: left + sky_width,
      screen_y: -36,
      width: sky_width,
      height: 154,
      image: "rsky1",
      shade: 100
    )
  ]
end

let floor_bands: List of Shape be build_floor()
  purpose: The floor from the horizon to the bar in twelve bands, darker toward the horizon.

function build_floor() returns List of Shape
  purpose: The floor bands, each shaded by how far away the floor at its middle row lies.

  let ground be Colour(red: 96, green: 82, blue: 68)
  let mutable bands: List of Shape be []
  for each band from 0 to 11
    let middle be band * 7 + 4
    let distance be (eye * projection * fixed.unit).quotient(texels * middle)
    let shade be shade_for(distance: distance, side: AcrossX)
    let colour be shapes.shaded(colour: ground, percent: shade)
    change bands to bands.append(
      Rectangle(screen_x: 0, screen_y: horizon + band * 7, width: 320, height: 7, colour: colour)
    )
  end
  return bands
end

public function figure(
  enemy: Enemy,
  origin: Vector,
  angle: Integer,
  clock: Integer,
  depths: List of Integer
)
  returns List of Shape
  purpose: The strips of one demon nearer than the wall at their column, one per screen column.

  let seen be raycast.seen_from(origin: origin, angle: angle, point: enemy.position)
  if seen.dx is less than 512 then return [] end
  let height be height_at(seen.dx)
  let to_viewer be Vector(dx: origin.dx - enemy.position.dx, dy: origin.dy - enemy.position.dy)
  let pose be sprites.pose_of(enemy: enemy, to_viewer: to_viewer, clock: clock)
  let image be pose.image
  let wide be (image.width * height).quotient(texels).at_least(1)
  let centre be raycast.column_of(seen: seen, columns: shapes.screen_width)
  let left be centre - (pose.anchor_x * height).quotient(texels)
  let floor_row be horizon + (eye * height).quotient(texels)
  let top be floor_row - (pose.anchor_y * height).quotient(texels)
  let bottom be top + (image.height * height).quotient(texels) - 1
  let shade be shade_for(distance: seen.dx, side: AcrossX)
  let mutable drawn: List of Shape be []
  for each column from left.at_least(0) to (left + wide - 1).at_most(shapes.screen_width - 1)
    let wall be depths.at(column) otherwise 0
    if seen.dx is at least wall then continue end
    let across be ((column - left) * image.width).quotient(wide)
    let texel be sprites.image_column(pose: pose, column: across)
    change drawn to drawn.append(
      Strip(
        screen_x: column,
        top: top,
        bottom: bottom,
        image: image.name,
        column: texel,
        shade: shade
      )
    )
  end
  return drawn
end

function depth_of(enemy: Enemy, origin: Vector, angle: Integer) returns Integer
  purpose: How far ahead of the camera a demon stands.

  return raycast.seen_from(origin: origin, angle: angle, point: enemy.position).dx
end

function world(state: State) returns List of Shape
  purpose: The view of the maze: the sky, the floor, the walls, then the demons far to near.

  let built be walls(state)
  let origin be state.hero.position
  let angle be state.hero.angle
  let mutable frame be sky(angle).append_all(floor_bands).append_all(built.strips)
  for each enemy in state.crowd
    sorted by depth_of(enemy: enemy, origin: origin, angle: angle) descending
    change frame to frame.append_all(
      figure(enemy: enemy, origin: origin, angle: angle, clock: state.clock, depths: built.depths)
    )
  end
  return frame
end

public function sway(state: State) returns Vector
  purpose: How far walking sways the shotgun, across and down; none while it fires.
  example: sway(game.new_game(["###", "#S#", "###"])) is Vector(dx: 6, dy: 0)

  if state.gun.since is less than weapon.cycle then return Vector(dx: 0, dy: 0) end
  let phase be (state.stride * fixed.full_turn).quotient(900)
  let across be (6 * fixed.cosine(phase)).quotient(fixed.unit)
  let down be (5 * fixed.sine(phase).absolute()).quotient(fixed.unit)
  return Vector(dx: across, dy: down)
end

function blinking(state: State, text: Text, screen_y: Integer) returns List of Shape
  purpose: A text centred on a row, shown half of every second.

  if state.clock.quotient(500) remainder 2 is 1 then return [] end
  return font.centred(text: text, screen_y: screen_y, scale: 2)
end

function title_screen(state: State) returns List of Shape
  purpose: The title: the picture, the game's name in the large font, and fire to start, blinking.

  let picture be Picture(
    screen_x: 0,
    screen_y: 0,
    width: 320,
    height: 200,
    image: "titlepic",
    shade: 100
  )
  let name be font.centred(text: "RAYCASTER", screen_y: 6, scale: 3)
  let byline be font.centred(text: "A MAZE WRITTEN IN RENYI", screen_y: 32, scale: 1)
  return [picture].append_all(name).append_all(byline).append_all(
    blinking(state: state, text: "PRESS FIRE", screen_y: 180)
  )
end

function ending(state: State) returns List of Shape
  purpose: The words over the view once the game has ended: how, the kills and the score.

  let headline be
    match state.status
      when Escaped then "YOU ESCAPED"
      when Fallen then "YOU DIED"
      otherwise "GAME OVER"
    end
  let tally be "KILLS {game.kills(state)} OF {state.crowd.length()}   SCORE {state.score}"
  let words be font.centred(text: headline, screen_y: 40, scale: 3).append_all(
    font.centred(text: tally, screen_y: 70, scale: 1)
  )
  if state.clock - state.ended is less than 1000 then return words end
  return words.append_all(blinking(state: state, text: "PRESS FIRE", screen_y: 140))
end

function in_hand(state: State) returns List of Shape
  purpose: The shotgun swaying in the player's hands and the message of the moment.

  let moved be sway(state)
  let gun be weapon.pictures(gun: state.gun, sway_x: moved.dx, sway_y: moved.dy)
  if state.notice_left is 0 then return gun end
  return gun.append_all(font.lettered(text: state.notice, screen_x: 2, screen_y: 2, scale: 1))
end

public function render(state: State) returns List of Shape
  purpose: The frame for a state: the title, or the view with the shotgun, the bar and the words.

  if state.status is Title then return title_screen(state) end
  let view be world(state)
  if state.status is Playing then
    return view.append_all(in_hand(state)).append_all(hud.status_bar(state))
  end
  return view.append_all(hud.status_bar(state)).append_all(ending(state))
end

function strip_columns(frame: List of Shape, image: Text) returns List of Integer
  purpose: The screen columns of the Strip shapes of one image in a frame, in order.

  let mutable found: List of Integer be []
  for each shape in frame
    match shape
      when Strip(screen_x, image: drawn) where drawn is image then
        change found to found.append(screen_x)
      otherwise continue
    end
  end
  return found
end

function wall_count(frame: List of Shape) returns Integer
  purpose: How many Strip shapes of a frame draw a wall's image rather than a demon's.

  let mutable found be 0
  for each shape in frame
    match shape
      when Strip(image) where image.starts_with("sarg") then continue
      when Strip then change found to found + 1
      otherwise continue
    end
  end
  return found
end

test "a frame has the sky, the floor and one wall strip per screen column"
  let state be game.new_game(["#####", "#S..#", "#####"])
  let frame be render(state)
  check wall_count(frame) is 320
  check frame.at(0) is sky(0).at(0)
  let left_halves be strip_columns(frame: frame, image: "sw19_2")
  let right_halves be strip_columns(frame: frame, image: "sw19_1")
  check left_halves.length() + right_halves.length() is 320
end

test "a demon in view adds strips; one behind a wall adds none"
  let open_state be game.new_game(["#######", "#S..E.#", "#######"])
  let hidden_state be game.new_game(["#######", "#S.#E.#", "#######"])
  check strip_columns(frame: render(open_state), image: "sarga1").length() is greater than 10
  check strip_columns(frame: render(hidden_state), image: "sarga1").length() is 0
end

function walled_left_of(edge: Integer) returns List of Integer
  purpose: Wall depths for the tests: a wall one cell away left of a screen column, far beyond it.

  return for each column from 0 to 319
    collect if column is less than edge then 4096 otherwise 40960 end
end

test "a demon is cut at the columns where a wall stands nearer"
  let origin be Vector(dx: 6144, dy: 6144)
  let demon be enemies.spawn(cell: Cell(column: 4, row: 1), angle: 2048)
  let open_depths be walled_left_of(0)
  let all_of_it be figure(enemy: demon, origin: origin, angle: 0, clock: 0, depths: open_depths)
  let half_depths be walled_left_of(160)
  let half be figure(enemy: demon, origin: origin, angle: 0, clock: 0, depths: half_depths)
  check all_of_it.length() is greater than 10
  check half.length() is less than all_of_it.length()
  check half.length() is greater than 0
end

function strip_texels(frame: List of Shape, image: Text) returns List of Integer
  purpose: The image columns of the Strip shapes of one image in a frame, in order.

  let mutable found: List of Integer be []
  for each shape in frame
    match shape
      when Strip(image: drawn, column) where drawn is image then
        change found to found.append(column)
      otherwise continue
    end
  end
  return found
end

test "a sleeping demon seen from its right is the side view, drawn mirrored"
  let start be game.new_game(["#######", "#S..E.#", "#######"])
  let south be Vector(dx: 0, dy: 4096)
  let facing_south be for each demon in start.crowd collect demon with heading: south
  let texels be strip_texels(frame: render(start with crowd: facing_south), image: "sarga3a7")
  check texels.length() is greater than 10
  let leftmost be texels.first() otherwise 0
  let rightmost be texels.last() otherwise 0
  check leftmost is greater than rightmost
end

test "a door on its way up shows the wall behind it under its lower edge"
  let shut be game.new_game(["######", "#S.D.#", "######"])
  let maze be level.with_opening(level: shut.maze, cell: Cell(column: 3, row: 1), amount: 2048)
  let frame be render(shut with maze: maze)
  check strip_columns(frame: frame, image: "door2_4").length() is greater than 0
  check wall_count(frame) is greater than 320
end

test "the title shows the picture; play shows the walls, the shotgun and the bar"
  let titled be render(game.title(level.maze_rows))
  check titled.at(0) is Picture(
    screen_x: 0,
    screen_y: 0,
    width: 320,
    height: 200,
    image: "titlepic",
    shade: 100
  )
  let playing be render(game.new_game(level.maze_rows))
  check playing.length() is less than 700
  check strip_columns(frame: playing, image: "sw19_2").length() is greater than 0
end
