module raycast
  purpose: The raycaster: one ray per screen column stepped through the grid cell by cell (DDA).

import fixed
import level exposing Level, Tile, Cell

public type Vector
  purpose: A direction or an offset in fixed-point map units.
  has dx: Integer
  has dy: Integer
  can ToText
end

public type Side is one of
  purpose: Which face of a cell a ray hit: a face across x (east or west) or across y.
  AcrossX
  AcrossY
  can ToText
end

public type Hit
  purpose: Where a ray stopped: the distance, the tile, the face, the offset on it, how open a door.
  has distance: Integer
  has tile: Tile
  has side: Side
  has offset: Integer
  has opening: Integer
  can ToText
end

let plane_scale: Integer be 2703
  purpose: The half-width of the camera plane, 0.66 of the unit: a field of view of 66 degrees.

let farthest: Integer be 64
  purpose: The most grid lines a ray crosses before it gives up.

public function facing(angle: Integer) returns Vector
  purpose: The unit direction of an angle in steps.
  example: facing(0) is Vector(dx: 4096, dy: 0)
  example: facing(1024) is Vector(dx: 0, dy: 4096)

  return Vector(dx: fixed.cosine(angle), dy: fixed.sine(angle))
end

public type Camera
  purpose: The view of one frame: the facing, and the camera plane to its right at its full width.
  has ahead: Vector
  has plane: Vector
  can ToText
end

public function camera(angle: Integer) returns Camera
  purpose: The camera of a facing, worked out once a frame for all its rays.
  example: camera(0) is Camera(ahead: Vector(dx: 4096, dy: 0), plane: Vector(dx: 0, dy: 2703))

  let ahead be facing(angle)
  let plane be Vector(
    dx: fixed.multiply(left: 0 - ahead.dy, right: plane_scale),
    dy: fixed.multiply(left: ahead.dx, right: plane_scale)
  )
  return Camera(ahead: ahead, plane: plane)
end

public function ray_through(view: Camera, column: Integer, columns: Integer) returns Vector
  purpose: The ray through a screen column: the facing plus a share of the camera plane.
  example: ray_through(view: camera(0), column: 0, columns: 2) is Vector(dx: 4096, dy: -1351)

  let share be ((2 * column + 1) * fixed.unit).quotient(columns) - fixed.unit
  return Vector(
    dx: view.ahead.dx + fixed.multiply(left: view.plane.dx, right: share),
    dy: view.ahead.dy + fixed.multiply(left: view.plane.dy, right: share)
  )
end

public function ray_for(angle: Integer, column: Integer, columns: Integer) returns Vector
  purpose: The ray through a screen column for a facing.
  example: ray_for(angle: 0, column: 0, columns: 2) is Vector(dx: 4096, dy: -1351)
  example: ray_for(angle: 0, column: 1, columns: 2) is Vector(dx: 4096, dy: 1351)

  return ray_through(view: camera(angle), column: column, columns: columns)
end

function cells_per_crossing(component: Integer) returns Integer
  purpose: How far along the ray, in units of the facing, one grid cell is crossed on one axis.
  example: cells_per_crossing(4096) is 4096
  example: cells_per_crossing(-2048) is 8192

  if component is 0 then return 1_000_000_000 end
  return (fixed.unit * fixed.unit).quotient(component.absolute())
end

function first_crossing(position: Integer, component: Integer, per_cell: Integer) returns Integer
  purpose: How far along the ray the first grid line is crossed on one axis.
  example: first_crossing(position: 6144, component: 4096, per_cell: 4096) is 2048
  example: first_crossing(position: 6144, component: -4096, per_cell: 4096) is 2048

  let inside be position - fixed.cell_of(position) * fixed.unit
  if component is less than 0 then return (inside * per_cell).quotient(fixed.unit) end
  return ((fixed.unit - inside) * per_cell).quotient(fixed.unit)
end

function step_of(component: Integer) returns Integer
  purpose: The cell step of a ray on one axis: -1 or 1.

  if component is less than 0 then return -1 end
  return 1
end

type Stop
  purpose: Where a ray's walk ended: the cell it entered, the distance there, the face it crossed.
  has column: Integer
  has row: Integer
  has distance: Integer
  has side: Side
end

function walked(maze: Level, origin: Vector, ray: Vector, skip: Integer) returns Stop
  purpose: The ray stepped cell by cell until a cell stops it, passing `skip` doors open part way.

  let per_x be cells_per_crossing(ray.dx)
  let per_y be cells_per_crossing(ray.dy)
  let step_x be step_of(ray.dx)
  let step_y be step_of(ray.dy)
  let mutable column be fixed.cell_of(origin.dx)
  let mutable row be fixed.cell_of(origin.dy)
  let mutable next_x be first_crossing(position: origin.dx, component: ray.dx, per_cell: per_x)
  let mutable next_y be first_crossing(position: origin.dy, component: ray.dy, per_cell: per_y)
  let mutable distance be 0
  let mutable side be AcrossX
  let mutable crossings be 0
  let mutable doors_left be skip
  repeat until crossings is at least farthest
    change crossings to crossings + 1
    if next_x is less than next_y then
      change column to column + step_x
      change distance to next_x
      change next_x to next_x + per_x
      change side to AcrossX
    otherwise
      change row to row + step_y
      change distance to next_y
      change next_y to next_y + per_y
      change side to AcrossY
    end
    let tile be level.tile_at(level: maze, column: column, row: row)
    if tile is not Floor then
      if tile is not Door then break end
      let opening be level.opening_at(level: maze, column: column, row: row)
      if opening is less than level.fully_open then
        if doors_left is 0 or opening is 0 then break end
        change doors_left to doors_left - 1
      end
    end
  end
  return Stop(column: column, row: row, distance: distance, side: side)
end

public function cast(maze: Level, origin: Vector, ray: Vector) returns Hit
  purpose: The first solid tile on the ray; the distance is along the facing, so it has no fish-eye.
  see also: ray_for, cast_past

  return cast_past(maze: maze, origin: origin, ray: ray, skip: 0)
end

public function cast_past(maze: Level, origin: Vector, ray: Vector, skip: Integer) returns Hit
  purpose: The tile the ray stops at once it has passed `skip` doors open part way.

  let walker be walked(maze: maze, origin: origin, ray: ray, skip: skip)
  let tile be level.tile_at(level: maze, column: walker.column, row: walker.row)
  return Hit(
    distance: walker.distance,
    tile: tile,
    side: walker.side,
    offset: offset_of(origin: origin, ray: ray, distance: walker.distance, side: walker.side),
    opening: if tile is Door then level.opening_at(
      level: maze,
      column: walker.column,
      row: walker.row
    )
    otherwise 0
    end
  )
end

public function offset_of(origin: Vector, ray: Vector, distance: Integer, side: Side)
  returns Integer
  purpose: Where along the face the ray struck, 0 to the unit, from the left as the face is seen.
  example: offset_of(
    origin: Vector(dx: 0, dy: 1000),
    ray: Vector(dx: 4096, dy: 0),
    distance: 4096,
    side: AcrossX
  ) is 1000
  example: offset_of(
    origin: Vector(dx: 0, dy: 1000),
    ray: Vector(dx: -4096, dy: 0),
    distance: 4096,
    side: AcrossX
  ) is 3095

  let struck_at be
    match side
      when AcrossX then origin.dy + fixed.multiply(left: distance, right: ray.dy)
      when AcrossY then origin.dx + fixed.multiply(left: distance, right: ray.dx)
    end
  let along_face be struck_at remainder fixed.unit
  let mirrored be
    match side
      when AcrossX then ray.dx is less than 0
      when AcrossY then ray.dy is greater than 0
    end
  if mirrored then return fixed.unit - 1 - along_face end
  return along_face
end

public function along(offset: Vector, direction: Vector) returns Integer
  purpose: How far an offset reaches along a unit direction: their dot product.
  example: along(offset: Vector(dx: 8192, dy: 4096), direction: Vector(dx: 4096, dy: 0)) is 8192

  return fixed.multiply(left: offset.dx, right: direction.dx) + fixed.multiply(
    left: offset.dy,
    right: direction.dy
  )
end

public function beside(offset: Vector, direction: Vector) returns Integer
  purpose: How far an offset lies to the right of a unit direction (y grows downward).
  example: beside(offset: Vector(dx: 8192, dy: 4096), direction: Vector(dx: 4096, dy: 0)) is 4096

  return fixed.multiply(left: offset.dy, right: direction.dx) - fixed.multiply(
    left: offset.dx,
    right: direction.dy
  )
end

public function seen_from(origin: Vector, angle: Integer, point: Vector) returns Vector
  purpose: A point in the camera's frame: dx how far ahead along the facing, dy how far right.
  example: seen_from(
    origin: Vector(dx: 4096, dy: 4096),
    angle: 1024,
    point: Vector(dx: 0, dy: 12288)
  ) is Vector(dx: 8192, dy: 4096)

  let gap be Vector(dx: point.dx - origin.dx, dy: point.dy - origin.dy)
  let ahead be facing(angle)
  return Vector(dx: along(offset: gap, direction: ahead), dy: beside(offset: gap, direction: ahead))
end

public function column_of(seen: Vector, columns: Integer) returns Integer
  purpose: The screen column a point in the camera's frame (ahead, right) projects to.
  example: column_of(seen: Vector(dx: 8192, dy: 0), columns: 320) is 160
  example: column_of(seen: Vector(dx: 4096, dy: 2703), columns: 320) is 320

  let half be columns.quotient(2)
  return half + (half * seen.dy * fixed.unit).quotient(seen.dx.at_least(1) * plane_scale)
end

test "a ray straight ahead stops at the wall two and a half cells away"
  let maze be level.parse_level(["#####", "#...#", "#...#", "#...#", "#####"])
  let origin be Vector(dx: 6144, dy: 10240)
  let hit be cast(maze: maze, origin: origin, ray: ray_for(angle: 0, column: 160, columns: 320))
  check hit.distance is 10240
  check hit.tile is Stone
  check hit.side is AcrossX
  check hit.offset is at least 2048 and hit.offset is at most 2100
end

test "a ray to the north meets the top wall across y"
  let maze be level.parse_level(["#####", "#...#", "#...#", "#...#", "#####"])
  let hit be cast(maze: maze, origin: Vector(dx: 6144, dy: 10240), ray: facing(3072))
  check hit.distance is 6144
  check hit.side is AcrossY
end

test "a flat wall is equally far at the centre and at both edges: no fish-eye"
  let open_rows be ["#######", "#.....#", "#.....#", "#.....#", "#.....#", "#.....#"]
  let maze be level.parse_level(open_rows.append_all(["#.....#", "#.....#", "#######"]))
  let origin be Vector(dx: 6144, dy: 18432)
  let centre be cast(maze: maze, origin: origin, ray: ray_for(angle: 0, column: 160, columns: 320))
  let left_edge be cast(maze: maze, origin: origin, ray: ray_for(angle: 0, column: 0, columns: 320))
  let right_edge be cast(
    maze: maze,
    origin: origin,
    ray: ray_for(angle: 0, column: 319, columns: 320)
  )
  check centre.distance is 18432
  check left_edge.distance is centre.distance
  check right_edge.distance is centre.distance
end

test "a ray stops at a closed door and names it"
  let maze be level.parse_level(["#####", "#..D#", "#####"])
  let hit be cast(maze: maze, origin: Vector(dx: 6144, dy: 6144), ray: facing(0))
  check hit.tile is Door
  check hit.distance is 6144
  check hit.opening is 0
end

test "a door open part way stops the ray, and the ray cast past it meets the wall behind"
  let shut be level.parse_level(["######", "#..D.#", "######"])
  let maze be level.with_opening(level: shut, cell: Cell(column: 3, row: 1), amount: 2048)
  let origin be Vector(dx: 6144, dy: 6144)
  let door be cast(maze: maze, origin: origin, ray: facing(0))
  check door.tile is Door
  check door.opening is 2048
  let behind be cast_past(maze: maze, origin: origin, ray: facing(0), skip: 1)
  check behind.tile is Stone
  check behind.distance is 14336
  let wide_open be level.with_opening(level: shut, cell: Cell(column: 3, row: 1), amount: 4096)
  check cast(maze: wide_open, origin: origin, ray: facing(0)).tile is Stone
end
