  "type",
  "until",
  "when",
  "where",
  "with",
  "within"
]
  purpose: Every reserved word, in the order that gives its code.

public let phrases: List of Text be [
  "is not",
  "is less than",
  "is at most",
  "is greater than",
  "is at least",
  "or fails with",
  "is one of",
  "for each",
  "for any",
  "run concurrently",
  "sorted by",
  "group by",
  "see also",
  "expose as tool",
  "repeat until",
  "at most",
  "only to"
]
  purpose: Every reserved phrase, one Word token each, after the words in code order.

public let symbols: List of Text be [
  "(",
  ")",
  "[",
  "]",
  "\{",
  "}",
  ",",
  ":",
  ".",
  "+",
  "-",
  "*",
  "/"
]
  purpose: Every symbol token, in the order that gives its code, from 1000.

public let all_words: List of Text be reserved_words.append_all(phrases)
  purpose: The words and the phrases together: the code of each is its index here plus one.

public let word_codes: Map of Text to Integer be codes_of(items: all_words, first_code: 1)
  purpose: The code of every reserved word and phrase, by its spelling.

public let symbol_codes: Map of Text to Integer be codes_of(items: symbols, first_code: 1000)
  purpose: The code of every symbol, by its text.

function codes_of(items: List of Text, first_code: Integer) returns Map of Text to Integer
  purpose: Each item mapped to its code: the first item gets `first_code`, the next one more.

  let mutable codes: Map of Text to Integer be {}
  let mutable code be first_code
  for each item in items
    change codes to codes.set(key: item, value: code)
    change code to code + 1
  end
  return codes
end

public function word_code(spelling: Text) returns Integer
  purpose: The code of a reserved word or phrase, 0 for any other text.

  return word_codes.get(spelling) otherwise 0
end

public function symbol_code(text: Text) returns Integer
  purpose: The code of a symbol, 0 for any other text.

  return symbol_codes.get(text) otherwise 0
end

public function spelling_of(code: Integer) returns Text
  purpose: The spelling of a word or phrase by its code, for a message.

  return all_words.at(code - 1) otherwise ""
end

