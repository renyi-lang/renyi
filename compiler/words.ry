module words
  purpose: The reserved words, phrases and symbols, each with the code its token carries (AU53).

public let reserved_words: List of Text be [
  "ability",
  "all",
  "also",
  "and",
  "any",
  "as",
  "at",
  "be",
  "break",
  "by",
  "can",
  "change",
  "check",
  "collect",
  "concurrently",
  "continue",
