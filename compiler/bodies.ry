module bodies
  purpose: Checking function bodies, tests, examples and constants (the Rust `check.rs`).

import ast exposing Function,
  Param,
  Test,
  Constant,
  TypeDefinition,
  Type,
  TypeName,
  Name,
  Span,
  Block,
  Statement,
  Arm,
  SortOrder,
  Pattern,
  FieldPattern,
  Expr,
  TextPiece,
  Arg,
  BinaryOp,
  Outcome,
  ExprArm,
  QueryTerminal,
  Example,
  ExampleOutcome,
  Capability,
  Item,
  Branch,
  ExprBranch,
  MapEntry,
  QuerySource
import lists
import report exposing Diagnostic
import effects exposing Grant
import suggest
import types exposing Ty, FunctionSignature, Substitution
import refine exposing Literal, Verdict
import declare exposing World,
  BodyLocation,
  FunctionInfo,
  TypeKindInfo,
  FieldInfo,
  VariantInfo,
  NamedTy,
  NamedParam,
  AbilityMethod,
  VariantRef,
  ModuleInfo,
  ConstantInfo

public type VarKind is one of
  purpose: What an inference variable stands for: anything, or a number literal of a kind.
  AnyVar
  IntegerVar(literal: maybe Literal)
  DecimalVar(literal: maybe Literal)
end

public type VarInfo
  purpose: An inference variable: what it is bound to, and its kind.
  has binding: maybe Ty
  has kind: VarKind
end

public type BindingKind is one of
  purpose: How a name came to be bound; `CountBinding` is the loop variable of a bare `count`.
  LetBinding
  ParamBinding
  LoopBinding
  PatternBinding
  QueryBinding
  CountBinding(source: Span)
end

public type Binding
  purpose: A name in scope with its type, whether it may change and whether it was read.
  has name: Text
  has ty: Ty
  has is_mutable: Boolean
  has used: Boolean
  has span: Span
  has kind: BindingKind
end

public type Scope
  purpose: The bindings of one block.
  has bindings: List of Binding
end

public type ConditionScope
  purpose: The field whose refinement is being checked, and the other fields it may not read.
  has type_name: Text
  has field: Text
  has others: List of Text
end

public type TaskScope
  purpose: What a task of `run concurrently` may not touch (decision V7).
  has outer: List of Text
  has siblings: List of Text
end

public type Context
  purpose: The body being checked: its name, result, failures, grant, and whether it is a test.
  has name: Text
  has result: maybe Ty
  has failures: List of Ty
  has fails_any: Boolean
  has capabilities: List of Grant
  has is_test: Boolean
end

public type Deferred
  purpose: An ability check postponed until the type is known.
  has ty: Ty
  has ability_id: Integer
  has span: Span
  has what: Text
end

public type Info
  purpose: What an expression produced: its type, its unhandled errors, the function it names.
  has ty: Ty
  has failures: List of Ty
  has function_id: maybe Integer
end

public type Shape is one of
  purpose: A pattern as exhaustiveness sees it: a constructor over sub-shapes, or anything.
  Wild
  Constructed(ctor: Ctor, subs: List of Shape)
end

public type Ctor is one of
  purpose: A constructor of a matched type.
  NothingCtor
  SomeCtor
  SuccessCtor
  FailureCtor
  TrueCtor
  FalseCtor
  VariantCtor(type_id: Integer, name: Text)
  MemberCtor(ty: Ty)
  LiteralCtor
end

public type Column is one of
  purpose: A column of the pattern matrix: a value, or the outcome of a fallible call.
  ValueColumn(ty: Ty)
  OutcomeColumn(ok: Ty, errors: List of Ty)
end

public type CtorFields
  purpose: A constructor with the names and types of its fields.
  has ctor: Ctor
  has fields: List of NamedTy
end

public type CtorSet is one of
  purpose: The constructors of a matched type, or none when only a wildcard covers it.
  Finite(ctors: List of CtorFields)
  Infinite
end

public type Target is one of
  purpose: What a body refers to, as the checker resolved it (the reference graph).
  FunctionTarget(function_id: Integer)
  AbilityMethodTarget(ability_id: Integer, index: Integer)
  ConstantTarget(owner: Integer, name: Text)
  TypeTarget(type_id: Integer)
  VariantTarget(type_id: Integer, index: Integer)
  AbilityTarget(ability_id: Integer)
  NumberTarget(kind: NumberKind)
  ResultTarget(ty: Ty)
  OtherwiseTarget(fallible: Boolean)
end

public type NumberKind is one of
  purpose: The runtime type of a numeric literal.
  IntegerKind
  DecimalKind
  FloatKind
end

public type Reference
  purpose: A reference a body makes, at its span.
  has body: BodyLocation
  has target: Target
  has span: Span
end

public type SpanTy
  purpose: A type noted at a span, resolved once the body is finished.
  has span: Span
  has ty: Ty
end

public type Checker
  purpose: The state of checking one module's bodies, threaded through every function.
  has world: World
  has module_id: Integer
  has diagnostics: List of Diagnostic
  has references: List of Reference
  has owner: BodyLocation
  has vars: List of VarInfo
  has scopes: List of Scope
  has context: Context
  has deferred: List of Deferred
  has loop_depth: Integer
  has effect_calls: Integer
  has concurrent_depth: Integer
  has current_errors: maybe Ty
  has literals: List of SpanTy
  has results: List of SpanTy
  has depth: Integer
  has task: maybe TaskScope
  has type_params: List of NamedParam
  has condition: maybe ConditionScope
end

public type Done of Value
  purpose: A value computed while checking, and the checker after it.
  has value: Value
  has checker: Checker
end

public type Checked
  purpose: What checking a module produced: its diagnostics and the references of its bodies.
  has diagnostics: List of Diagnostic
  has references: List of Reference
end

type Method is one of
  purpose: A method found for a receiver: declared on the type, or a method of an ability it has.
  DeclaredMethod(function_id: Integer)
  MethodOfAbility(ability_id: Integer, index: Integer)
end

type Needed
  purpose: A capability a call needs, from the callee or a passed function.
  has grant: Grant
  has runtime_scoped: Boolean
  has source: Text
end

type Subject
  purpose: The subject of a `match`: its type, and the errors of a fallible call.
  has ty: Ty
  has errors: maybe List of Ty
end

type FieldSpec
  purpose: A field of a record with its arguments applied: name, type and refinement.
  has name: Text
  has ty: Ty
  has refinement: maybe Expr
end

type VariantFields
  purpose: The fields of a variant or of a record matched by its name, with the type's parameters.
  has type_id: Integer
  has fields: List of FieldInfo
  has params: List of Integer
end

type Witness
  purpose: One case the arms miss, spelled column by column.
  has parts: List of Text
end

let nesting_depth: Integer be 4

let body_lines: Integer be 60

function task_fix() returns Text
  purpose: The fix for a task that reads or changes what it may not (decision V7).

  return "bind the result with `let` inside the task, or run the statements in sequence"
end

let wild: Text be "..."

public function new_checker(world: World, module_id: Integer) returns Checker
  purpose: A checker for one module with nothing checked yet.

  let context be Context(
    name: "",
    result: nothing,
    failures: [],
    fails_any: false,
    capabilities: [],
    is_test: false
  )
  return Checker(
    world: world,
    module_id: module_id,
    diagnostics: [],
    references: [],
    owner: NoBody,
    vars: [],
    scopes: [],
    context: context,
    deferred: [],
    loop_depth: 0,
    effect_calls: 0,
    concurrent_depth: 0,
    current_errors: nothing,
    literals: [],
    results: [],
    depth: 0,
    task: nothing,
    type_params: [],
    condition: nothing
  )
end

function plain(ty: Ty) returns Info
  purpose: A value without unhandled errors that names no function.

  return Info(ty: ty, failures: [], function_id: nothing)
end

function push_error(checker: Checker, code: Text, message: Text, span: Span, fix: Text)
  returns Checker
  purpose: An error with its fix (decision D3).

  let diagnostic be report.error(code: code, message: message, span: span, fix: fix)
  return checker with diagnostics: checker.diagnostics.append(diagnostic)
end

function push_warning(checker: Checker, code: Text, message: Text, span: Span, fix: Text)
  returns Checker
  purpose: A warning with its fix.

  let diagnostic be report.warning(code: code, message: message, span: span, fix: fix)
  return checker with diagnostics: checker.diagnostics.append(diagnostic)
end

function push_bare(checker: Checker, diagnostic: Diagnostic) returns Checker
  purpose: A diagnostic as raised, with or without a fix.

  return checker with diagnostics: checker.diagnostics.append(diagnostic)
end

function show(checker: Checker, ty: Ty) returns Text
  purpose: A type spelled for a message, variables followed.

  return declare.show(world: checker.world, ty: zonk(checker: checker, ty: ty))
end

function module_info(checker: Checker) returns ModuleInfo
  purpose: The module being checked.

  return declare.module_at(world: checker.world, id: checker.module_id)
end

function source_text(checker: Checker, span: Span) returns Text
  purpose: The source text under a span, for a fix that quotes it.

  let chars be module_info(checker).source_chars
  return chars.take(span.stop).drop(span.start).join("")
end

function line_of(checker: Checker, offset: Integer) returns Integer
  purpose: The one-based line of an offset: how many of the file's lines start at or before it.

  let starts be module_info(checker).line_starts
  let mutable low be 0
  let mutable high be starts.length()
  repeat until low is high
    let middle be (low + high).quotient(2)
    let start be starts.at(middle) otherwise crash with "a line start"
    if start is at most offset then
      change low to middle + 1
    otherwise
      change high to middle
    end
  end
  return low
end

function without_trailing_dots(text: Text) returns Text
  purpose: The text with every trailing full stop removed.

  let mutable current be text
  repeat until not current.ends_with(".")
    change current to current.take(current.length() - 1)
  end
  return current
end

function note_deprecated(checker: Checker, name: Text, deprecation: maybe Text, span: Span)
  returns Checker
  purpose: A use of a deprecated definition (decision C8c): a warning `--strict` makes an error.

  let text be deprecation otherwise return checker
  let fix be deprecation_fix(text)
  return push_warning(
    checker: checker,
    code: "deprecated",
    message: "`{name}` is deprecated: {text}",
    span: span,
    fix: fix
  )
end

function deprecation_fix(text: Text) returns Text
  purpose: The fix a deprecation note carries: its replacement, or a search for one.

  let found be text.index_of(
    "replaced by "
  ) otherwise return "find a replacement before the definition is removed"
  let replacement be without_trailing_dots(text.drop(found + 12).trim())
  return "call `{replacement}` instead"
end

function inside(checker: Checker, function_id: Integer) returns Boolean
  purpose: Whether the body being checked is the function's own, or one of its examples.

  match declare.function_at(world: checker.world, id: function_id).body
    when ItemBody(item: own_item) then
      match checker.owner
        when ItemBody(item) then return own_item is item
        when ExampleBody(item, method) then return own_item is item and method is nothing
        otherwise return false
      end
    when ImplementationBody(item: own_item, method: own_method) then
      match checker.owner
        when ImplementationBody(item, method) then return own_item is item and own_method is method
        when ExampleBody(item, method) then return own_item is item and method is own_method
        otherwise return false
      end
    otherwise return false
  end
end

function task_conflict(checker: Checker, name: Text, changing: Boolean) returns maybe Text
  purpose: Decision V7: a task may not read a sibling's binding nor change an outer one.

  let task be checker.task otherwise return nothing
  if task.siblings.contains(name) then
    return "`{name}` is bound by another task of this `run concurrently` block"
  end
  if changing and task.outer.contains(name) then
    return "a task of `run concurrently` cannot change `{name}`, which is bound outside the block"
  end
  return nothing
end

function record(checker: Checker, target: Target, span: Span) returns Checker
  purpose: A reference of the body being checked; none while checking `example:` lines.

  match checker.owner
    when NoBody then return checker
    otherwise
      let reference be Reference(body: checker.owner, target: target, span: span)
      return checker with references: checker.references.append(reference)
  end
end

function record_type_names(checker: Checker, ty: Type) returns Checker
  purpose: Every type an annotation names, each at its own name token.

  match ty
    when NamedType(name, args) then
      let mutable updated be checker
      match declare.lookup_type(world: checker.world, owner: checker.module_id, name: name.text)
        when some(id) then
          change updated to record(
            checker: updated,
            target: TypeTarget(type_id: id),
            span: name.span
          )
        when nothing then change updated to updated
      end
      for each arg in args
        change updated to record_type_names(checker: updated, ty: arg)
      end
      return updated
    when MaybeType(inner) then return record_type_names(checker: checker, ty: inner)
    when FunctionType(params, result, failures) then
      let mutable updated be checker
      for each param in params
        change updated to record_type_names(checker: updated, ty: param)
      end
      match result
        when some(result_type) then
          change updated to record_type_names(checker: updated, ty: result_type)
        when nothing then change updated to updated
      end
      for each failing in failures
        change updated to record_type_names(checker: updated, ty: failing)
      end
      return updated
  end
end

function var_at(checker: Checker, id: Integer) returns VarInfo
  purpose: An inference variable by its id.

  return checker.vars.at(id) otherwise crash with "an inference variable"
end

function set_var_binding(checker: Checker, id: Integer, ty: Ty) returns Checker
  purpose: The checker with a variable bound.

  let info be var_at(checker: checker, id: id) with binding: ty
  return checker with vars: lists.replace_at(items: checker.vars, index: id, item: info)
end

function set_var_kind(checker: Checker, id: Integer, kind: VarKind) returns Checker
  purpose: The checker with a variable's kind changed.

  let info be var_at(checker: checker, id: id) with kind: kind
  return checker with vars: lists.replace_at(items: checker.vars, index: id, item: info)
end

function fresh(checker: Checker, kind: VarKind) returns Done of Ty
  purpose: A new inference variable of a kind.

  let id be checker.vars.length()
  let updated be checker with vars: checker.vars.append(VarInfo(binding: nothing, kind: kind))
  return Done(value: Var(id: id), checker: updated)
end

function resolve(checker: Checker, ty: Ty) returns Ty
  purpose: The type with variable bindings followed at the top.

  let mutable current be ty
  repeat until not is_bound_var(checker: checker, ty: current)
    match current
      when Var(id) then change current to var_at(checker: checker, id: id).binding otherwise current
      otherwise break
    end
  end
  return current
end

function is_bound_var(checker: Checker, ty: Ty) returns Boolean
  purpose: Whether the type is a variable that has a binding.

  match ty
    when Var(id) then return var_at(checker: checker, id: id).binding is not nothing
    otherwise return false
  end
end

function var_id(ty: Ty) returns maybe Integer
  purpose: The id of a variable, when the type is one.

  match ty
    when Var(id) then return id
    otherwise return nothing
  end
end

function zonk(checker: Checker, ty: Ty) returns Ty
  purpose: The type with variable bindings followed everywhere.

  match resolve(checker: checker, ty: ty)
    when App(id, args) then return App(id: id, args: zonk_all(checker: checker, tys: args))
    when MaybeTy(inner) then return MaybeTy(inner: zonk(checker: checker, ty: inner))
    when FunctionTy(signature) then
      let params be zonk_all(checker: checker, tys: signature.params)
      let result be zonk_maybe(checker: checker, ty: signature.result)
      let failures be zonk_all(checker: checker, tys: signature.failures)
      return FunctionTy(
        signature: signature with params: params, result: result, failures: failures
      )
    when Union(members) then return Union(members: zonk_all(checker: checker, tys: members))
    otherwise return resolve(checker: checker, ty: ty)
  end
end

function zonk_all(checker: Checker, tys: List of Ty) returns List of Ty
  purpose: Every type with variable bindings followed.

  return for each ty in tys collect zonk(checker: checker, ty: ty)
end

function zonk_maybe(checker: Checker, ty: maybe Ty) returns maybe Ty
  purpose: An optional type with variable bindings followed.

  match ty
    when some(inner) then return zonk(checker: checker, ty: inner)
    when nothing then return nothing
  end
end

function builtin(id: Integer) returns Ty
  purpose: A prelude type without arguments.

  return App(id: id, args: [])
end

function is_builtin(checker: Checker, ty: Ty, id: Integer) returns Boolean
  purpose: Whether the type resolves to the prelude type.

  match resolve(checker: checker, ty: ty)
    when App(id: found) then return found is id
    otherwise return false
  end
end

function base_of(checker: Checker, ty: Ty) returns Ty
  purpose: The base type a subtype chain ends in.

  let mutable current be resolve(checker: checker, ty: ty)
  repeat until not is_subtype(checker: checker, ty: current)
    match current
      when App(id) then
        match declare.type_at(world: checker.world, id: id).kind
          when SubtypeKind(base) then change current to resolve(checker: checker, ty: base)
          otherwise break
        end
      otherwise break
    end
  end
  return current
end

function is_subtype(checker: Checker, ty: Ty) returns Boolean
  purpose: Whether a resolved type is a declared subtype.

  match ty
    when App(id) then
      match declare.type_at(world: checker.world, id: id).kind
        when SubtypeKind then return true
        otherwise return false
      end
    otherwise return false
  end
end

function is_numeric(checker: Checker, ty: Ty) returns Boolean
  purpose: Whether the type's base is Integer, Decimal or Float.

  let builtins be checker.world.builtins
  let base be base_of(checker: checker, ty: ty)
  return is_builtin(checker: checker, ty: base, id: builtins.integer)
    or is_builtin(checker: checker, ty: base, id: builtins.decimal)
    or is_builtin(checker: checker, ty: base, id: builtins.float)
end

function merged_kind(left: VarKind, right: VarKind) returns VarKind
  purpose: The kind two merged variables keep: a literal kind over any, decimal over integer.

  if left is AnyVar then return right end
  if right is AnyVar then return left end
  match left
    when DecimalVar then return left
    otherwise
      match right
        when DecimalVar then return right
        otherwise return left
      end
  end
end

function bind_var(checker: Checker, id: Integer, ty: Ty, span: Span) returns Done of Boolean
  purpose: Bind a variable, honoring literal kinds and the occurs check.

  let resolved be resolve(checker: checker, ty: ty)
  match var_id(resolved)
    when some(other) then
      if other is id then return Done(value: true, checker: checker) end
      let kind be merged_kind(
        left: var_at(checker: checker, id: id).kind,
        right: var_at(checker: checker, id: other).kind
      )
      let mutable updated be set_var_kind(checker: checker, id: other, kind: kind)
      change updated to set_var_binding(checker: updated, id: id, ty: resolved)
      return Done(value: true, checker: updated)
    when nothing then
      if types.mentions_var(ty: resolved, var: id) then
        return Done(value: false, checker: checker)
      end
      let kind be var_at(checker: checker, id: id).kind
      match kind
        when AnyVar then
          return Done(value: true, checker: set_var_binding(checker: checker, id: id, ty: resolved))
        when IntegerVar(literal) then
          return bind_literal_var(
            checker: checker,
            id: id,
            kind: kind,
            literal: literal,
            ty: resolved,
            span: span
          )
        when DecimalVar(literal) then
          return bind_literal_var(
            checker: checker,
            id: id,
            kind: kind,
            literal: literal,
            ty: resolved,
            span: span
          )
      end
  end
end

function bind_literal_var(
  checker: Checker,
  id: Integer,
  kind: VarKind,
  literal: maybe Literal,
  ty: Ty,
  span: Span
)
  returns Done of Boolean
  purpose: Bind a literal's variable when the literal fits the type.

  let fits be literal_fits(checker: checker, kind: kind, literal: literal, ty: ty, span: span)
  if not fits.value then return Done(value: false, checker: fits.checker) end
  return Done(value: true, checker: set_var_binding(checker: fits.checker, id: id, ty: ty))
end

function literal_fits(checker: Checker, kind: VarKind, literal: maybe Literal, ty: Ty, span: Span)
  returns Done of Boolean
  purpose: Whether a number literal can take the type: a numeric base, or a refinement it meets.

  let builtins be checker.world.builtins
  let base be base_of(checker: checker, ty: ty)
  let is_decimal be is_builtin(checker: checker, ty: base, id: builtins.decimal)
  let is_float be is_builtin(checker: checker, ty: base, id: builtins.float)
  let fits_base be
    match kind
      when IntegerVar then
        is_builtin(checker: checker, ty: base, id: builtins.integer) or is_decimal or is_float
      when DecimalVar then is_decimal or is_float
      when AnyVar then true
    end
  if not fits_base then return Done(value: false, checker: checker) end
  match literal
    when some(value) then
      return check_subtype_refinements(checker: checker, ty: ty, literal: value, span: span)
    when nothing then return Done(value: true, checker: checker)
  end
end

function check_subtype_refinements(checker: Checker, ty: Ty, literal: Literal, span: Span)
  returns Done of Boolean
  purpose: Run the refinements of a subtype chain on a literal; false (and an error) when one fails.

  let mutable current be resolve(checker: checker, ty: ty)
  repeat until not is_subtype(checker: checker, ty: current)
    let id be types.head_type(current) otherwise crash with "a subtype"
    let info be declare.type_at(world: checker.world, id: id)
    match info.kind
      when SubtypeKind(base, refinement) then
        match refinement
          when some(condition) then
            if refine.evaluate(condition: condition, name: "value", value: literal) is Fails then
              let updated be push_error(
                checker: checker,
                code: "constraint-violation",
                message: "this value does not satisfy the condition of `{info.name}`",
                span: span,
                fix: "write a value the condition of `{info.name}` accepts"
              )
              return Done(value: false, checker: updated)
            end
          when nothing then change current to current
        end
        change current to resolve(checker: checker, ty: base)
      otherwise break
    end
  end
  return Done(value: true, checker: checker)
end

function assign(checker: Checker, actual: Ty, expected: Ty, span: Span) returns Done of Boolean
  purpose: Is `actual` acceptable where `expected` is wanted? Binds variables, climbs subtypes.

  let left be resolve(checker: checker, ty: actual)
  let right be resolve(checker: checker, ty: expected)
  if types.is_error(left) or types.is_error(right) or left is Never then
    return Done(value: true, checker: checker)
  end
  match var_id(right)
    when some(expected_var) then
      if var_id(left) is expected_var then return Done(value: true, checker: checker) end
      return bind_var(checker: checker, id: expected_var, ty: left, span: span)
    when nothing then
      match left
        when Var(id: actual_var) then
          match right
            when MaybeTy(inner) where literal_var(checker: checker, id: actual_var) then
              return assign(checker: checker, actual: left, expected: inner, span: span)
            otherwise return bind_var(checker: checker, id: actual_var, ty: right, span: span)
          end
        otherwise return assign_shapes(checker: checker, left: left, right: right, span: span)
      end
  end
end

function literal_var(checker: Checker, id: Integer) returns Boolean
  purpose: Whether a variable stands for a number literal.

  return var_at(checker: checker, id: id).kind is not AnyVar
end

function unwrap_maybe(ty: Ty) returns Ty
  purpose: The type inside a `maybe`, or the type itself.

  match ty
    when MaybeTy(inner) then return inner
    otherwise return ty
  end
end

function assign_shapes(checker: Checker, left: Ty, right: Ty, span: Span) returns Done of Boolean
  purpose: Assignment once neither side is an error or a variable: into `maybe`, then by shape.

  match right
    when MaybeTy(inner) then
      return assign(checker: checker, actual: unwrap_maybe(left), expected: inner, span: span)
    otherwise return assign_concrete(checker: checker, left: left, right: right, span: span)
  end
end

function assign_concrete(checker: Checker, left: Ty, right: Ty, span: Span) returns Done of Boolean
  purpose: Assignment between two resolved, non-optional types.

  match left
    when MaybeTy then return Done(value: false, checker: checker)
    when App(id: actual_id, args: actual_args) then
      return assign_app(
        checker: checker,
        actual_id: actual_id,
        actual_args: actual_args,
        right: right,
        span: span
      )
    when FunctionTy(signature: actual_signature) then
      match right
        when FunctionTy(signature: expected_signature) then
          return assign_functions(
            checker: checker,
            actual: actual_signature,
            expected: expected_signature,
            span: span
          )
        otherwise return Done(value: false, checker: checker)
      end
    when Param(id: actual_param) then
      match right
        when Param(id: expected_param) then
          return Done(value: actual_param is expected_param, checker: checker)
        otherwise return Done(value: false, checker: checker)
      end
    when Union(members: actual_members) then
      match right
        when Union(members: expected_members) then
          let covered be all_members_in(
            checker: checker,
            members: actual_members,
            expected: expected_members
          )
          return Done(value: covered, checker: checker)
        otherwise
          return assign_each(checker: checker, members: actual_members, expected: right, span: span)
      end
    when Unit then return Done(value: right is Unit, checker: checker)
    otherwise return Done(value: false, checker: checker)
  end
end

function assign_app(
  checker: Checker,
  actual_id: Integer,
  actual_args: List of Ty,
  right: Ty,
  span: Span
)
  returns Done of Boolean
  purpose: A named type assigned to another: the same type argument by argument, or the base.

  match right
    when App(id: expected_id, args: expected_args) then
      if actual_id is expected_id then
        return assign_all(
          checker: checker,
          actual: actual_args,
          expected: expected_args,
          span: span
        )
      end
      match declare.type_at(world: checker.world, id: actual_id).kind
        when SubtypeKind(base) then
          return assign(checker: checker, actual: base, expected: right, span: span)
        otherwise return Done(value: false, checker: checker)
      end
    otherwise return Done(value: false, checker: checker)
  end
end

function assign_all(checker: Checker, actual: List of Ty, expected: List of Ty, span: Span)
  returns Done of Boolean
  purpose: Pairwise assignment, stopping at the first failure.

  let mutable updated be checker
  let mutable index be 0
  for each actual_ty in actual
    let expected_ty be expected.at(index) otherwise break
    let done be assign(checker: updated, actual: actual_ty, expected: expected_ty, span: span)
    change updated to done.checker
    if not done.value then return Done(value: false, checker: updated) end
    change index to index + 1
  end
  return Done(value: true, checker: updated)
end

function assign_each(checker: Checker, members: List of Ty, expected: Ty, span: Span)
  returns Done of Boolean
  purpose: Every member of a union assigned to the expected type, stopping at the first failure.

  let mutable updated be checker
  for each member in members
    let done be assign(checker: updated, actual: member, expected: expected, span: span)
    change updated to done.checker
    if not done.value then return Done(value: false, checker: updated) end
  end
  return Done(value: true, checker: updated)
end

function all_members_in(checker: Checker, members: List of Ty, expected: List of Ty) returns Boolean
  purpose: Whether every member has the same type as some expected member.

  for each member in members
    let found be
      for each candidate in expected
      any same_type(checker: checker, left: member, right: candidate)
    if not found then return false end
  end
  return true
end

function assign_functions(
  checker: Checker,
  actual: FunctionSignature,
  expected: FunctionSignature,
  span: Span
)
  returns Done of Boolean
  purpose: A function value where a function type is wanted: parameters unified, result assigned.

  if actual.params.length() is not expected.params.length() then
    return Done(value: false, checker: checker)
  end
  let params_done be unify_all(
    checker: checker,
    left: actual.params,
    right: expected.params,
    span: span
  )
  let mutable updated be params_done.checker
  let mutable returns_ok be false
  match actual.result
    when some(actual_result) then
      match expected.result
        when some(expected_result) then
          let done be assign(
            checker: updated,
            actual: actual_result,
            expected: expected_result,
            span: span
          )
          change updated to done.checker
          change returns_ok to done.value
        when nothing then change returns_ok to false
      end
    when nothing then change returns_ok to expected.result is nothing
  end
  let fails_ok be all_members_in(
    checker: updated,
    members: actual.failures,
    expected: expected.failures
  )
  return Done(value: params_done.value and returns_ok and fails_ok, checker: updated)
end

function unify_all(checker: Checker, left: List of Ty, right: List of Ty, span: Span)
  returns Done of Boolean
  purpose: Pairwise unification, stopping at the first failure.

  let mutable updated be checker
  let mutable index be 0
  for each left_ty in left
    let right_ty be right.at(index) otherwise break
    let done be unify(checker: updated, left: left_ty, right: right_ty, span: span)
    change updated to done.checker
    if not done.value then return Done(value: false, checker: updated) end
    change index to index + 1
  end
  return Done(value: true, checker: updated)
end

function unify(checker: Checker, left: Ty, right: Ty, span: Span) returns Done of Boolean
  purpose: Make two types the same, binding variables either way.

  let left_resolved be resolve(checker: checker, ty: left)
  let right_resolved be resolve(checker: checker, ty: right)
  if types.is_error(left_resolved) or types.is_error(right_resolved) then
    return Done(value: true, checker: checker)
  end
  match var_id(left_resolved)
    when some(left_var) then
      if var_id(right_resolved) is left_var then return Done(value: true, checker: checker) end
      return bind_var(checker: checker, id: left_var, ty: right_resolved, span: span)
    when nothing then
      match var_id(right_resolved)
        when some(right_var) then
          return bind_var(checker: checker, id: right_var, ty: left_resolved, span: span)
        when nothing then
          return unify_shapes(
            checker: checker,
            left: left_resolved,
            right: right_resolved,
            span: span
          )
      end
  end
end

function unify_shapes(checker: Checker, left: Ty, right: Ty, span: Span) returns Done of Boolean
  purpose: Unification of two resolved, non-variable types.

  match left
    when App(id: left_id, args: left_args) then
      match right
        when App(id: right_id, args: right_args) then
          if left_id is not right_id then return Done(value: false, checker: checker) end
          return unify_all(checker: checker, left: left_args, right: right_args, span: span)
        otherwise return Done(value: false, checker: checker)
      end
    when MaybeTy(inner: left_inner) then
      match right
        when MaybeTy(inner: right_inner) then
          return unify(checker: checker, left: left_inner, right: right_inner, span: span)
        otherwise return Done(value: false, checker: checker)
      end
    when Param(id: left_param) then
      match right
        when Param(id: right_param) then
          return Done(value: left_param is right_param, checker: checker)
        otherwise return Done(value: false, checker: checker)
      end
    otherwise return Done(value: left is right, checker: checker)
  end
end

function same_type(checker: Checker, left: Ty, right: Ty) returns Boolean
  purpose: Whether two types are the same once variables are followed.

  return zonk(checker: checker, ty: left) is zonk(checker: checker, ty: right)
end

function is_maybe(ty: Ty) returns Boolean
  purpose: Whether the type is a `maybe`.

  match ty
    when MaybeTy then return true
    otherwise return false
  end
end

function mismatch(checker: Checker, actual: Ty, expected: Ty, span: Span, what: Text)
  returns Checker
  purpose: Report a mismatch with a message that names the usual mistakes.

  let shown_actual be show(checker: checker, ty: actual)
  let shown_expected be show(checker: checker, ty: expected)
  let actual_resolved be resolve(checker: checker, ty: actual)
  if maybe_mismatch(checker: checker, actual: actual_resolved, expected: expected) then
    return push_error(
      checker: checker,
      code: "maybe-value",
      message: "{what} may be nothing (it is `{shown_actual}`) where `{shown_expected}` is needed",
      span: span,
      fix: "read it out with `otherwise` or a `match`"
    )
  end
  if actual_resolved is Unit then
    return push_error(
      checker: checker,
      code: "type-mismatch",
      message: "{what} returns nothing, but `{shown_expected}` is needed",
      span: span,
      fix: "call a function that returns a value, or drop the binding"
    )
  end
  let fix be suggest.conversion_fix(actual: shown_actual, expected: shown_expected)
  return push_error(
    checker: checker,
    code: "type-mismatch",
    message: "{what} is `{shown_actual}`, but `{shown_expected}` is needed",
    span: span,
    fix: fix
  )
end

function maybe_mismatch(checker: Checker, actual: Ty, expected: Ty) returns Boolean
  purpose: Whether a `maybe` value was given where its inner type, or no `maybe`, is needed.

  match actual
    when MaybeTy(inner) then
      let expected_resolved be resolve(checker: checker, ty: expected)
      let inner_resolved be resolve(checker: checker, ty: inner)
      return expected_resolved is inner_resolved or not is_maybe(expected_resolved)
    otherwise return false
  end
end

function expect(checker: Checker, actual: Ty, expected: Ty, span: Span, what: Text) returns Checker
  purpose: Assign, and report a mismatch when that fails.

  let done be assign(checker: checker, actual: actual, expected: expected, span: span)
  if done.value then return done.checker end
  return mismatch(checker: done.checker, actual: actual, expected: expected, span: span, what: what)
end

function is_json_ability(checker: Checker, ability_id: Integer) returns Boolean
  purpose: Whether the ability is `ToJson` or `FromJson`.

  let name be declare.ability_at(world: checker.world, id: ability_id).name
  return name is "ToJson" or name is "FromJson"
end

function has_ability(checker: Checker, ty: Ty, ability_id: Integer) returns maybe Boolean
  purpose: Whether a type has an ability; nothing while an unbound variable makes it unknown.

  let builtins be checker.world.builtins
  let resolved be resolve(checker: checker, ty: ty)
  if ability_id is builtins.equal then
    match resolved
      when FunctionTy then return false
      otherwise return true
    end
  end
  match resolved
    when Var then return nothing
    when ErrorTy then return true
    when Never then return true
    when Param(id) then return param_has(checker: checker, param: id, ability_id: ability_id)
    when MaybeTy(inner) then
      let hash_like be ability_id is builtins.hash
        or is_json_ability(checker: checker, ability_id: ability_id)
      if hash_like then return has_ability(checker: checker, ty: inner, ability_id: ability_id) end
      return false
    when Union(members) then
      return union_has(checker: checker, members: members, ability_id: ability_id)
    when App(id, args) then
      return app_has(checker: checker, id: id, args: args, ability_id: ability_id)
    otherwise return false
  end
end

function param_has(checker: Checker, param: Integer, ability_id: Integer) returns Boolean
  purpose: A type parameter has what its constraints give it, and what those abilities require.

  let constraints be declare.constraints(world: checker.world, param: param)
  if constraints.contains(ability_id) then return true end
  for each constraint in constraints
    let required be declare.ability_at(world: checker.world, id: constraint).requirements
    if required.contains(ability_id) then return true end
  end
  return false
end

function union_has(checker: Checker, members: List of Ty, ability_id: Integer) returns maybe Boolean
  purpose: A union has an ability when every member has it; unknown when any member is unknown.

  let mutable every be true
  for each member in members
    match has_ability(checker: checker, ty: member, ability_id: ability_id)
      when some(true) then change every to every
      when some(false) then change every to false
      when nothing then return nothing
    end
  end
  return every
end

function both_have(checker: Checker, left: Ty, right: Ty, ability_id: Integer) returns maybe Boolean
  purpose: Whether two type arguments both have an ability; unknown when either is.

  let first_has be has_ability(checker: checker, ty: left, ability_id: ability_id)
  let second_has be has_ability(checker: checker, ty: right, ability_id: ability_id)
  if first_has is nothing or second_has is nothing then return nothing end
  return first_has is true and second_has is true
end

function subtype_base(kind: TypeKindInfo) returns maybe Ty
  purpose: The base of a subtype, when the kind is one.

  match kind
    when SubtypeKind(base) then return base
    otherwise return nothing
  end
end

function app_has(checker: Checker, id: Integer, args: List of Ty, ability_id: Integer)
  returns maybe Boolean
  purpose: A declared type's ability: derived, implemented, inherited, or structural (collections).

  let mutable builtins be checker.world.builtins
  let info be declare.type_at(world: checker.world, id: id)
  if info.derives.contains(ability_id) then return true end
  if declare.implemented_for(world: checker.world, ability_id: ability_id, head: id) then
    return true
  end
  match subtype_base(info.kind)
    when some(base) then return has_ability(checker: checker, ty: base, ability_id: ability_id)
    when nothing then change builtins to builtins
  end
  let is_json be is_json_ability(checker: checker, ability_id: ability_id)
  let first_arg be args.at(0) otherwise ErrorTy
  let second_arg be args.at(1) otherwise ErrorTy
  if id is builtins.list or id is builtins.set_type then
    if ability_id is builtins.hash or is_json then
      return has_ability(checker: checker, ty: first_arg, ability_id: ability_id)
    end
    return false
  end
  if id is builtins.map then
    if is_json then
      let both be both_have(
        checker: checker,
        left: first_arg,
        right: second_arg,
        ability_id: ability_id
      )
      if both is nothing then return nothing end
      if both is true then return is_builtin(checker: checker, ty: first_arg, id: builtins.text) end
      return false
    end
    return false
  end
  if id is builtins.pair then
    if ability_id is builtins.hash then
      return both_have(checker: checker, left: first_arg, right: second_arg, ability_id: ability_id)
    end
    return false
  end
  if is_json then
    return id is builtins.integer
      or id is builtins.decimal
      or id is builtins.float
      or id is builtins.text
      or id is builtins.boolean
      or id is builtins.bytes
  end
  return false
end

function require_ability(checker: Checker, ty: Ty, ability_id: Integer, span: Span, what: Text)
  returns Checker
  purpose: An error when the type lacks the ability; deferred while the type is unknown.

  match has_ability(checker: checker, ty: ty, ability_id: ability_id)
    when some(true) then return checker
    when some(false) then
      return missing_ability(
        checker: checker,
        ty: ty,
        ability_id: ability_id,
        span: span,
        what: what
      )
    when nothing then
      let deferred be Deferred(ty: ty, ability_id: ability_id, span: span, what: what)
      return checker with deferred: checker.deferred.append(deferred)
  end
end

function missing_ability(checker: Checker, ty: Ty, ability_id: Integer, span: Span, what: Text)
  returns Checker
  purpose: The error for a type without an ability it needs.

  let name be declare.ability_at(world: checker.world, id: ability_id).name
  let shown be show(checker: checker, ty: ty)
  let fix be ability_fix(checker: checker, ty: ty, ability_name: name)
  return push_error(
    checker: checker,
    code: "missing-ability",
    message: "{what} needs `{name}`, which `{shown}` does not have",
    span: span,
    fix: fix
  )
end

function push_scope(checker: Checker) returns Checker
  purpose: A new innermost scope.

  return checker with scopes: checker.scopes.append(Scope(bindings: []))
end

function pop_scope(checker: Checker) returns Checker
  purpose: Leave the innermost scope, reporting the bindings it never read.

  let scope be checker.scopes.last() otherwise crash with "a scope"
  let mutable updated be checker with scopes: checker.scopes.without_last()
  for each binding in scope.bindings
    if not binding.used and binding.name is not "self" then
      change updated to unused_binding(checker: updated, binding: binding)
    end
  end
  return updated
end

function unused_binding(checker: Checker, binding: Binding) returns Checker
  purpose: The error for a binding that is never read.

  let what be
    match binding.kind
      when ParamBinding then "the parameter"
      when LoopBinding then "the loop variable"
      when QueryBinding then "the loop variable"
      when CountBinding then "the loop variable"
      when PatternBinding then "the pattern binding"
      when LetBinding then "the binding"
    end
  let fix be
    match binding.kind
      when QueryBinding then "remove it, or read it in a clause"
      when CountBinding(source) then count_fix(checker: checker, source: source)
      when PatternBinding then "remove it from the pattern"
      otherwise "remove it, or use it"
    end
  return push_error(
    checker: checker,
    code: "unused-binding",
    message: "{what} `{binding.name}` is never used",
    span: binding.span,
    fix: fix
  )
end

function count_fix(checker: Checker, source: Span) returns Text
  purpose: The fix for an unread loop variable of a bare `count`: the source's length.

  let quoted be source_text(checker: checker, span: source)
  return "write `{quoted}.length()`"
end

function find_binding(checker: Checker, name: Text) returns maybe Binding
  purpose: The innermost binding of a name.

  for each scope in checker.scopes.reversed()
    for each binding in scope.bindings
      if binding.name is name then return binding end
    end
  end
  return nothing
end

function update_binding(checker: Checker, name: Text, replacement: Binding) returns Checker
  purpose: The checker with the innermost binding of a name replaced.

  let mutable scope_index be checker.scopes.length() - 1
  repeat until scope_index is less than 0
    let scope be checker.scopes.at(scope_index) otherwise crash with "a scope"
    let mutable binding_index be 0
    for each binding in scope.bindings
      if binding.name is name then
        let bindings be lists.replace_at(
          items: scope.bindings,
          index: binding_index,
          item: replacement
        )
        let scopes be lists.replace_at(
          items: checker.scopes,
          index: scope_index,
          item: Scope(bindings: bindings)
        )
        return checker with scopes: scopes
      end
      change binding_index to binding_index + 1
    end
    change scope_index to scope_index - 1
  end
  return checker
end

function mark_used(checker: Checker, name: Text) returns Checker
  purpose: The innermost binding of a name counted as read.

  let binding be find_binding(checker: checker, name: name) otherwise return checker
  return update_binding(checker: checker, name: name, replacement: binding with used: true)
end

function mark_all_used(checker: Checker) returns Checker
  purpose: Every binding of the innermost scope counted as read.

  let scope be checker.scopes.last() otherwise return checker
  let bindings be for each binding in scope.bindings collect binding with used: true
  let index be checker.scopes.length() - 1
  return checker
    with scopes: lists.replace_at(
      items: checker.scopes,
      index: index,
      item: Scope(bindings: bindings)
    )
end

function bind(checker: Checker, name: Name, ty: Ty, is_mutable: Boolean, kind: BindingKind)
  returns Checker
  purpose: Bind a name in the innermost scope; a name is bound once per function.

  let mutable updated be checker
  if name.text is not "self" then
    change updated to check_shadowing(checker: updated, name: name)
  end
  let binding be Binding(
    name: name.text,
    ty: ty,
    is_mutable: is_mutable,
    used: false,
    span: name.span,
    kind: kind
  )
  let scope be updated.scopes.last() otherwise crash with "a scope"
  let index be updated.scopes.length() - 1
  let replaced be Scope(bindings: scope.bindings.append(binding))
  return updated with scopes: lists.replace_at(items: updated.scopes, index: index, item: replaced)
end

function check_shadowing(checker: Checker, name: Name) returns Checker
  purpose: A new binding may not reuse a bound name, an import's namespace or a function's name.

  if find_binding(checker: checker, name: name.text) is not nothing then
    return push_error(
      checker: checker,
      code: "shadowing",
      message: "`{name.text}` is already bound in this function",
      span: name.span,
      fix: "choose another name; a name is bound once per function"
    )
  end
  if module_info(checker).imports.contains_key(name.text) then
    return push_error(
      checker: checker,
      code: "shadowing",
      message: "`{name.text}` is the namespace of an import",
      span: name.span,
      fix: "choose another name, or rename the import with `as`"
    )
  end
  let function_named be declare.lookup_function(
    world: checker.world,
    owner: checker.module_id,
    name: name.text
  )
  if function_named is not nothing then
    return push_error(
      checker: checker,
      code: "shadowing",
      message: "`{name.text}` is a function of this module",
      span: name.span,
      fix: "choose another name"
    )
  end
  return checker
end

function fresh_context(
  name: Text,
  result: maybe Ty,
  failures: List of Ty,
  fails_any: Boolean,
  capabilities: List of Grant,
  is_test: Boolean
)
  returns Context
  purpose: A context for a body.

  return Context(
    name: name,
    result: result,
    failures: failures,
    fails_any: fails_any,
    capabilities: capabilities,
    is_test: is_test
  )
end

function start_body(checker: Checker, owner: BodyLocation, context: Context) returns Checker
  purpose: The checker ready for a new body: variables, deferred checks and the nesting reset.

  return checker
    with owner: owner, context: context, vars: [], deferred: [], depth: 0, task: nothing
end

public function check_function(checker: Checker, id: Integer, func: Function) returns Checker
  purpose: Check a function body: parameters, statements, the return, unused bindings, deferred.

  let info be declare.function_at(world: checker.world, id: id)
  let context be fresh_context(
    name: info.name,
    result: info.result,
    failures: info.failures,
    fails_any: false,
    capabilities: info.capabilities,
    is_test: false
  )
  let params be
    for each param in info.type_params
    collect NamedParam(name: declare.param_name(world: checker.world, id: param), id: param)
  let mutable updated be start_body(checker: checker, owner: info.body, context: context)
    with type_params: params
  change updated to push_scope(updated)
  change updated to bind_params(checker: updated, info: info, func: func)
  if func.docs.expose_as_tool then
    change updated to check_tool_signature(checker: updated, id: id, func: func)
  end
  match func.body
    when some(body) then
      if not info.is_library then
        change updated to check_body_length(checker: updated, func: func, body: body)
      end
      let done be check_block_in_scope(checker: updated, block: body)
      change updated to done.checker
      match info.result
        when some(result) where not done.value then
          change updated to missing_return(checker: updated, func: func, result: result)
        otherwise change updated to updated
      end
    when nothing then change updated to updated
  end
  change updated to pop_scope(updated)
  change updated to finish_body(updated)
  return check_examples(checker: updated, id: id, func: func)
end

function bind_params(checker: Checker, info: FunctionInfo, func: Function) returns Checker
  purpose: The parameters bound in the body's scope; a bare `self` is unknown.

  let mutable updated be checker
  let mutable index be 0
  for each declared in info.params
    let param be func.params.at(index) otherwise break
    let ty be
      match declared.ty
        when SelfTy then ErrorTy
        otherwise declared.ty
      end
    change updated to bind(
      checker: updated,
      name: param.name,
      ty: ty,
      is_mutable: false,
      kind: ParamBinding
    )
    change index to index + 1
  end
  return updated
end

function missing_return(checker: Checker, func: Function, result: Ty) returns Checker
  purpose: A function with a result whose body can reach its end.

  let stop be func.span.stop
  let start be (stop - 3).at_least(0)
  let shown be show(checker: checker, ty: result)
  return push_error(
    checker: checker,
    code: "missing-return",
    message: "`{func.name.text}` returns `{shown}` but can reach its end without a `return`",
    span: Span(start: start, stop: stop),
    fix: "end every path with `return`, `fail with` or `crash with`"
  )
end

function check_body_length(checker: Checker, func: Function, body: Block) returns Checker
  purpose: Decision V5: the statements of a body may span at most 60 source lines.

  let first_statement be body.statements.first() otherwise return checker
  let last_statement be body.statements.last() otherwise return checker
  let from_line be line_of(checker: checker, offset: statement_span(first_statement).start)
  let last_offset be (statement_span(last_statement).stop - 1).at_least(0)
  let to_line be line_of(checker: checker, offset: last_offset)
  let lines be to_line + 1 - from_line
  if lines is at most body_lines then return checker end
  return push_error(
    checker: checker,
    code: "body-length",
    message: "the body of `{func.name.text}` spans {lines} lines; {body_lines} is the limit",
    span: func.name.span,
    fix: "move the inner part into a function"
  )
end

function check_tool_signature(checker: Checker, id: Integer, func: Function) returns Checker
  purpose: Decision D6: a tool's parameters and result must be JSON; its purpose is its description.

  let mutable updated be checker
  let no_purpose be "`{func.name.text}` is exposed as a tool but has no purpose"
  if func.docs.summary is nothing then
    change updated to push_error(
      checker: updated,
      code: "purpose-missing",
      message: "{no_purpose}, which is the tool's description",
      span: func.name.span,
      fix: "add a `purpose:` clause after the signature"
    )
  end
  let from_json be declare.lookup_ability(
    world: checker.world,
    owner: checker.module_id,
    name: "FromJson"
  ) otherwise return updated
  let to_json be declare.lookup_ability(
    world: checker.world,
    owner: checker.module_id,
    name: "ToJson"
  ) otherwise return updated
  let info be declare.function_at(world: checker.world, id: id)
  let fix be "use a record, a variant, a list, a map keyed by Text or a base type"
  let mutable index be 0
  for each declared in info.params
    let param be func.params.at(index) otherwise break
    if has_ability(checker: updated, ty: declared.ty, ability_id: from_json) is false then
      let shown be show(checker: updated, ty: declared.ty)
      let must_be_json be "the parameter `{declared.name}` of a tool must be JSON"
      change updated to push_error(
        checker: updated,
        code: "tool-type",
        message: "{must_be_json}; `{shown}` cannot be decoded",
        span: param.span,
        fix: fix
      )
    end
    change index to index + 1
  end
  let result be info.result otherwise return updated
  let result_syntax be func.result otherwise return updated
  if has_ability(checker: updated, ty: result, ability_id: to_json) is false then
    let shown be show(checker: updated, ty: result)
    change updated to push_error(
      checker: updated,
      code: "tool-type",
      message: "the result of a tool must be JSON; `{shown}` cannot be encoded",
      span: type_span(result_syntax),
      fix: fix
    )
  end
  return updated
end

function debug_quoted(text: Text) returns Text
  purpose: A text as Rust's debug formatting prints it: quoted, with quotes and backslashes escaped.

  let mutable out be "\""
  for each ch in text.characters()
    let piece be
      if ch is "\"" then "\\\""
      otherwise if ch is "\\" then "\\\\"
      otherwise if ch is "\n" then "\\n"
      otherwise if ch is "\t" then "\\t"
      otherwise ch
      end
    change out to "{out}{piece}"
  end
  return "{out}\""
end

public function check_test(checker: Checker, index: Integer, block: Test) returns Checker
  purpose: A `test` block, the `index`th item of the module.

  let grants be for each capability in block.capabilities collect effects.from_ast(capability)
  let mutable updated be checker with owner: ItemBody(item: index)
  let mutable position be 0
  for each grant in grants
    let syntax be block.capabilities.at(position) otherwise break
    if effects.unavailable(grant.path) then
      change updated to push_error(
        checker: updated,
        code: "capability-unavailable",
        message: effects.unavailable_message(grant.path),
        span: syntax.span,
        fix: "remove it from `needs`"
      )
    end
    change position to position + 1
  end
  let quoted_name be debug_quoted(block.name)
  let context be fresh_context(
    name: "test {quoted_name}",
    result: nothing,
    failures: [],
    fails_any: true,
    capabilities: grants,
    is_test: true
  )
  change updated to start_body(checker: updated, owner: ItemBody(item: index), context: context)
    with type_params: []
  change updated to push_scope(updated)
  change updated to check_block_in_scope(checker: updated, block: block.body).checker
  change updated to pop_scope(updated)
  return finish_body(updated)
end

public function check_type_conditions(checker: Checker, index: Integer, def: TypeDefinition)
  returns Checker
  purpose: The refinement conditions of a type: a subtype's `where value ...` and field conditions.

  let type_id be module_info(checker).types.get(def.name.text) otherwise return checker
  match declare.type_at(world: checker.world, id: type_id).kind
    when SubtypeKind(base, refinement) then
      let condition be refinement otherwise return checker
      let owner be ConditionBody(item: index, variant: nothing, field: nothing)
      let bindings be [NamedTy(name: "value", ty: base)]
      return check_condition_body(
        checker: checker,
        owner: owner,
        bindings: bindings,
        condition: condition,
        scope: nothing
      )
    when RecordKind(fields) then
      return check_field_conditions(
        checker: checker,
        index: index,
        variant: nothing,
        type_name: def.name.text,
        fields: fields
      )
    when SumKind(variants) then
      let mutable updated be checker
      let mutable tag be 0
      for each variant in variants
        change updated to check_field_conditions(
          checker: updated,
          index: index,
          variant: tag,
          type_name: def.name.text,
          fields: variant.fields
        )
        change tag to tag + 1
      end
      return updated
    otherwise return checker
  end
end

function check_field_conditions(
  checker: Checker,
  index: Integer,
  variant: maybe Integer,
  type_name: Text,
  fields: List of FieldInfo
)
  returns Checker
  purpose: The conditions of the fields of a record or a variant, each over its own field.

  let mutable updated be checker
  let mutable field_index be 0
  for each field in fields
    match field.refinement
      when some(condition) then
        let owner be ConditionBody(item: index, variant: variant, field: field_index)
        let others be for each other in fields where other.name is not field.name collect other.name
        let scope be ConditionScope(type_name: type_name, field: field.name, others: others)
        change updated to check_condition_body(
          checker: updated,
          owner: owner,
          bindings: [NamedTy(name: field.name, ty: field.ty)],
          condition: condition,
          scope: scope
        )
      when nothing then change updated to updated
    end
    change field_index to field_index + 1
  end
  return updated
end

function check_condition_body(
  checker: Checker,
  owner: BodyLocation,
  bindings: List of NamedTy,
  condition: Expr,
  scope: maybe ConditionScope
)
  returns Checker
  purpose: One condition as a small body: the field is its parameter; the scope names the others.

  let context be fresh_context(
    name: "a refinement",
    result: nothing,
    failures: [],
    fails_any: false,
    capabilities: [],
    is_test: false
  )
  let mutable updated be checker
    with owner: owner, context: context, vars: [], deferred: [], type_params: [], condition: scope
  change updated to push_scope(updated)
  let span be expr_span(condition)
  for each binding in bindings
    let name be Name(text: binding.name, span: span)
    change updated to bind(
      checker: updated,
      name: name,
      ty: binding.ty,
      is_mutable: false,
      kind: ParamBinding
    )
  end
  change updated to check_condition(checker: updated, condition: condition)
  change updated to mark_all_used(updated)
  change updated to pop_scope(updated)
  return finish_body(updated) with condition: nothing
end

public function check_constant(checker: Checker, index: Integer, constant: Constant, ty: Ty)
  returns Checker
  purpose: A top-level constant, the `index`th item of the module.

  let context be fresh_context(
    name: constant.name.text,
    result: nothing,
    failures: [],
    fails_any: false,
    capabilities: [],
    is_test: false
  )
  let mutable updated be checker
    with owner: ItemBody(item: index), context: context, vars: [], deferred: [], type_params: []
  change updated to push_scope(updated)
  let done be infer(checker: updated, expr: constant.value, expected: ty)
  change updated to done.checker
  let span be expr_span(constant.value)
  change updated to require_handled(checker: updated, info: done.value, span: span)
  change updated to expect(
    checker: updated,
    actual: done.value.ty,
    expected: ty,
    span: span,
    what: "the value"
  )
  change updated to pop_scope(updated)
  return finish_body(updated)
end

function check_examples(checker: Checker, id: Integer, func: Function) returns Checker
  purpose: Example clauses: `expression is value` and `expression fails with Pattern`.

  let body be declare.function_at(world: checker.world, id: id).body
  let mutable updated be checker
  let mutable index be 0
  for each sample in func.docs.examples
    let owner be
      match body
        when ItemBody(item) then ExampleBody(item: item, method: nothing, sample: index)
        when ImplementationBody(item, method) then
          ExampleBody(item: item, method: method, sample: index)
        otherwise return updated
      end
    change updated to check_example(checker: updated, owner: owner, func: func, sample: sample)
    change index to index + 1
  end
  return updated
end

function check_example(checker: Checker, owner: BodyLocation, func: Function, sample: Example)
  returns Checker
  purpose: One example line as a body of its own.

  let context be fresh_context(
    name: "example of {func.name.text}",
    result: nothing,
    failures: [],
    fails_any: false,
    capabilities: [],
    is_test: false
  )
  let mutable updated be checker with owner: owner, context: context, vars: [], deferred: []
  change updated to push_scope(updated)
  let result be infer(checker: updated, expr: sample.expression, expected: nothing)
  change updated to result.checker
  match sample.outcome
    when IsValue(value) then
      change updated to check_example_value(
        checker: updated,
        result: result.value,
        value: value,
        span: sample.span
      )
    when FailsWith(pattern) then
      change updated to check_example_failure(
        checker: updated,
        result: result.value,
        pattern: pattern
      )
  end
  change updated to pop_scope(updated)
  return finish_body(updated)
end

function check_example_value(checker: Checker, result: Info, value: Expr, span: Span)
  returns Checker
  purpose: `expression is value`: the value has the result's type, which must be comparable.

  let expected be infer(checker: checker, expr: value, expected: result.ty)
  let mutable updated be expected.checker
  let value_span be expr_span(value)
  change updated to require_handled(checker: updated, info: expected.value, span: value_span)
  let value_ty be resolve(checker: updated, ty: result.ty)
  change updated to expect(
    checker: updated,
    actual: expected.value.ty,
    expected: value_ty,
    span: value_span,
    what: "the expected value"
  )
  return require_ability(
    checker: updated,
    ty: result.ty,
    ability_id: updated.world.builtins.equal,
    span: span,
    what: "comparing the result"
  )
end

function check_example_failure(checker: Checker, result: Info, pattern: Pattern) returns Checker
  purpose: `expression fails with Pattern`: the call must be fallible, the pattern fit its errors.

  if result.failures.is_empty() then
    return push_error(
      checker: checker,
      code: "example-fails",
      message: "`fails with` on a call that cannot fail",
      span: pattern_span(pattern),
      fix: "write `is value` instead"
    )
  end
  let mutable updated be push_scope(checker)
  change updated to check_pattern(
    checker: updated,
    pattern: pattern,
    subject: Union(members: result.failures)
  ).checker
  change updated to mark_all_used(updated)
  return pop_scope(updated)
end

function number_kind(checker: Checker, ty: Ty) returns maybe NumberKind
  purpose: The number type behind a literal's type: a numeric base or a refined subtype of one.

  let builtins be checker.world.builtins
  let mutable current be resolve(checker: checker, ty: ty)
  repeat until false
    let id be types.head_type(current) otherwise return nothing
    if id is builtins.integer then return IntegerKind end
    if id is builtins.decimal then return DecimalKind end
    if id is builtins.float then return FloatKind end
    match declare.type_at(world: checker.world, id: id).kind
      when SubtypeKind(base) then change current to resolve(checker: checker, ty: base)
      otherwise return nothing
    end
  end
  return nothing
end

function finish_body(checker: Checker) returns Checker
  purpose: Defaults for literal variables, the noted literals and results, and the deferred checks.

  let builtins be checker.world.builtins
  let mutable updated be checker
  let mutable id be 0
  for each var in checker.vars
    if var.binding is nothing then
      match var.kind
        when IntegerVar then
          change updated to set_var_binding(checker: updated, id: id, ty: builtin(builtins.integer))
        when DecimalVar then
          change updated to set_var_binding(checker: updated, id: id, ty: builtin(builtins.decimal))
        when AnyVar then change updated to updated
      end
    end
    change id to id + 1
  end
  let literals be updated.literals
  change updated to updated with literals: []
  for each noted in literals
    match number_kind(checker: updated, ty: noted.ty)
      when some(kind) then
        change updated to record(
          checker: updated,
          target: NumberTarget(kind: kind),
          span: noted.span
        )
      when nothing then change updated to updated
    end
  end
  let results be updated.results
  change updated to updated with results: []
  for each noted in results
    let ty be zonk(checker: updated, ty: noted.ty)
    if not types.has_vars(ty) then
      change updated to record(checker: updated, target: ResultTarget(ty: ty), span: noted.span)
    end
  end
  let deferred be updated.deferred
  change updated to updated with deferred: []
  for each item in deferred
    if has_ability(checker: updated, ty: item.ty, ability_id: item.ability_id) is false then
      change updated to missing_ability(
        checker: updated,
        ty: item.ty,
        ability_id: item.ability_id,
        span: item.span,
        what: item.what
      )
    end
  end
  return updated
end

function statement_span(statement: Statement) returns Span
  purpose: The span of a statement.

  match statement
    when Let(span) then return span
    when Change(span) then return span
    when If(span) then return span
    when Match(span) then return span
    when ForEach(span) then return span
    when RepeatUntil(span) then return span
    when RunConcurrently(span) then return span
    when Return(span) then return span
    when Fail(span) then return span
    when Crash(span) then return span
    when Break(span) then return span
    when Continue(span) then return span
    when Ignore(span) then return span
    when Check(span) then return span
    when Expression(span) then return span
  end
end

function expr_span(expr: Expr) returns Span
  purpose: The span of an expression.

  match expr
    when IntegerLiteral(span) then return span
    when DecimalLiteral(span) then return span
    when TextLiteral(span) then return span
    when RawTextLiteral(span) then return span
    when BooleanLiteral(span) then return span
    when NothingLiteral(span) then return span
    when SelfValue(span) then return span
    when NameExpr(span) then return span
    when TypeNameExpr(span) then return span
    when Member(span) then return span
    when Call(span) then return span
    when Construct(span) then return span
    when ListLiteral(span) then return span
    when MapLiteral(span) then return span
    when RangeLiteral(span) then return span
    when Not(span) then return span
    when Binary(span) then return span
    when With(span) then return span
    when Otherwise(span) then return span
    when IfExpr(span) then return span
    when MatchExpr(span) then return span
    when QueryExpr(span) then return span
    when Paren(span) then return span
  end
end

function pattern_span(pattern: Pattern) returns Span
  purpose: The span of a pattern.

  match pattern
    when VariantPattern(span) then return span
    when LiteralPattern(span) then return span
    when NothingPattern(span) then return span
    when SomePattern(span) then return span
    when SuccessPattern(span) then return span
    when FailurePattern(span) then return span
    when BindingPattern(span) then return span
    when TypedPattern(span) then return span
  end
end

function type_span(ty: Type) returns Span
  purpose: The span of a type annotation.

  match ty
    when NamedType(span) then return span
    when MaybeType(span) then return span
    when FunctionType(span) then return span
  end
end

function unreachable(checker: Checker, span: Span) returns Checker
  purpose: The warning for a statement after a way out.

  return push_warning(
    checker: checker,
    code: "unreachable",
    message: "this statement can never run",
    span: span,
    fix: "remove it, or move it before the `return`, `fail` or `crash`"
  )
end

function check_block_in_scope(checker: Checker, block: Block) returns Done of Boolean
  purpose: The statements of a block in the current scope; whether they always leave.

  let mutable updated be checker
  let mutable diverges be false
  let mutable reported be false
  for each statement in block.statements
    if diverges and not reported then
      change updated to unreachable(checker: updated, span: statement_span(statement))
      change reported to true
    end
    let done be check_statement(checker: updated, statement: statement)
    change updated to done.checker
    if done.value then change diverges to true end
  end
  return Done(value: diverges, checker: updated)
end

function check_block(checker: Checker, block: Block) returns Done of Boolean
  purpose: A nested block in its own scope; whether it always leaves.

  let done be check_block_in_scope(checker: push_scope(checker), block: block)
  return Done(value: done.value, checker: pop_scope(done.checker))
end

function opening_word(statement: Statement) returns maybe Text
  purpose: The word a block statement opens with, for the nesting rule.

  match statement
    when If then return "if"
    when Match then return "match"
    when ForEach then return "for each"
    when RepeatUntil then return "repeat until"
    when RunConcurrently then return "run concurrently"
    otherwise return nothing
  end
end

function check_statement(checker: Checker, statement: Statement) returns Done of Boolean
  purpose: Whether the statement always leaves; a block statement counts the nesting (decision V5).

  match opening_word(statement)
    when some(word) then
      let mutable updated be checker with depth: checker.depth + 1
      if updated.depth is nesting_depth + 1 then
        let start be statement_span(statement).start
        change updated to push_error(
          checker: updated,
          code: "nesting-depth",
          message: "`{word}` opens a fifth level of nesting; four is the limit",
          span: Span(start: start, stop: start + word.length()),
          fix: "move the inner part into a function"
        )
      end
      let done be check_statement_kind(checker: updated, statement: statement)
      let finished be done.checker with depth: done.checker.depth - 1
      return Done(value: done.value, checker: finished)
    when nothing then return check_statement_kind(checker: checker, statement: statement)
  end
end

function check_statement_kind(checker: Checker, statement: Statement) returns Done of Boolean
  purpose: One statement by its kind: the binding and block statements here, the rest after.

  match statement
    when Let(is_mutable, name, annotation, value) then
      let bound be check_let(
        checker: checker,
        is_mutable: is_mutable,
        name: name,
        annotation: annotation,
        value: value
      )
      return Done(value: false, checker: bound)
    when Change(name, value) then
      return Done(value: false, checker: check_set(checker: checker, name: name, value: value))
    when If(branches, fallback) then
      return check_if(checker: checker, branches: branches, fallback: fallback)
    when Match(subject, arms, fallback, span) then
      return check_match_statement(
        checker: checker,
        subject: subject,
        arms: arms,
        fallback: fallback,
        span: span
      )
    when ForEach(bindings, source, filter, order, body) then
      let looped be check_for_each(
        checker: checker,
        bindings: bindings,
        source: source,
        filter: filter,
        order: order,
        body: body
      )
      return Done(value: false, checker: looped)
    when RepeatUntil(condition, body) then
      return Done(
        value: false,
        checker: check_repeat(checker: checker, condition: condition, body: body)
      )
    when RunConcurrently(deadline, body) then
      return check_run_concurrently(checker: checker, deadline: deadline, body: body)
    otherwise return check_leaving_statement(checker: checker, statement: statement)
  end
end

function check_leaving_statement(checker: Checker, statement: Statement) returns Done of Boolean
  purpose: The statements that leave or stand alone: return, fail, crash, break, continue, a call.

  match statement
    when Return(value, span) then
      return Done(value: true, checker: check_return(checker: checker, value: value, span: span))
    when Fail(value, span) then
      return Done(value: true, checker: check_fail(checker: checker, value: value, span: span))
    when Crash(message) then
      let text be builtin(checker.world.builtins.text)
      let crashed be infer_value(
        checker: checker,
        expr: message,
        expected: text,
        what: "the crash message"
      )
      return Done(value: true, checker: crashed)
    when Break(span) then
      return Done(value: true, checker: check_break(checker: checker, word: "break", span: span))
    when Continue(span) then
      return Done(value: true, checker: check_break(checker: checker, word: "continue", span: span))
    when Ignore(value) then
      return Done(value: false, checker: check_ignore(checker: checker, value: value))
    when Check(value, span) then
      return Done(value: false, checker: check_check(checker: checker, value: value, span: span))
    when Expression(value) then
      return Done(value: false, checker: check_expression(checker: checker, value: value))
    otherwise crash with "a statement handled before"
  end
end

function check_let(
  checker: Checker,
  is_mutable: Boolean,
  name: Name,
  annotation: maybe Type,
  value: Expr
)
  returns Checker
  purpose: `let`: the value checked against the annotation, or given its own type.

  let mutable updated be checker
  let mutable declared: maybe Ty be nothing
  match annotation
    when some(ty) then
      let resolved be resolve_type(checker: updated, ty: ty)
      change updated to resolved.checker
      change declared to resolved.value
    when nothing then change declared to nothing
  end
  let done be infer(checker: updated, expr: value, expected: declared)
  change updated to done.checker
  let span be expr_span(value)
  change updated to require_handled(checker: updated, info: done.value, span: span)
  let mutable ty be ErrorTy
  match declared
    when some(wanted) then
      change updated to expect(
        checker: updated,
        actual: done.value.ty,
        expected: wanted,
        span: span,
        what: "the value"
      )
      change ty to wanted
    when nothing then
      if resolve(checker: updated, ty: done.value.ty) is Unit then
        change updated to push_error(
          checker: updated,
          code: "type-mismatch",
          message: "this call returns nothing, so there is no value to bind",
          span: span,
          fix: "call it as a statement, without `let`"
        )
      otherwise
        change updated to default_literal(checker: updated, ty: done.value.ty)
        change ty to done.value.ty
      end
  end
  return bind(checker: updated, name: name, ty: ty, is_mutable: is_mutable, kind: LetBinding)
end

function check_set(checker: Checker, name: Name, value: Expr) returns Checker
  purpose: `change`: the binding must exist and be mutable; the new value has its type.

  let mutable updated be checker
  match task_conflict(checker: checker, name: name.text, changing: true)
    when some(reason) then
      change updated to push_error(
        checker: updated,
        code: "task-independence",
        message: reason,
        span: name.span,
        fix: task_fix()
      )
    when nothing then change updated to updated
  end
  match find_binding(checker: updated, name: name.text)
    when nothing then
      let fix be suggest_binding(
        checker: updated,
        name: name.text
      ) otherwise "declare it first: `let mutable {name.text} be ...`"
      change updated to push_error(
        checker: updated,
        code: "unknown-name",
        message: "there is no binding named `{name.text}`",
        span: name.span,
        fix: fix
      )
      return infer(checker: updated, expr: value, expected: nothing).checker
    when some(binding) then
      if not binding.is_mutable then
        change updated to push_error(
          checker: updated,
          code: "immutable-binding",
          message: "`{name.text}` cannot be changed",
          span: name.span,
          fix: "declare it with `let mutable {name.text}`"
        )
      end
      let done be infer(checker: updated, expr: value, expected: binding.ty)
      change updated to done.checker
      let span be expr_span(value)
      change updated to require_handled(checker: updated, info: done.value, span: span)
      return expect(
        checker: updated,
        actual: done.value.ty,
        expected: binding.ty,
        span: span,
        what: "the new value"
      )
  end
end

function check_if(checker: Checker, branches: List of Branch, fallback: maybe Block)
  returns Done of Boolean
  purpose: `if`: every condition Boolean; leaves only when every branch and the `otherwise` do.

  let mutable updated be checker
  let mutable all_diverge be true
  for each branch in branches
    change updated to check_condition(checker: updated, condition: branch.condition)
    let done be check_block(checker: updated, block: branch.body)
    change updated to done.checker
    if not done.value then change all_diverge to false end
  end
  match fallback
    when some(block) then
      let done be check_block(checker: updated, block: block)
      change updated to done.checker
      if not done.value then change all_diverge to false end
      return Done(value: all_diverge, checker: updated)
    when nothing then return Done(value: false, checker: updated)
  end
end

function check_match_statement(
  checker: Checker,
  subject: Expr,
  arms: List of Arm,
  fallback: maybe Block,
  span: Span
)
  returns Done of Boolean
  purpose: `match` as a statement: the arms checked, exhaustiveness without an `otherwise`.

  let matched be match_subject(checker: checker, subject: subject)
  let saved_errors be matched.checker.current_errors
  let mutable updated be matched.checker with current_errors: errors_union(matched.value.errors)
  let mutable all_diverge be true
  let mutable rows: List of List of Shape be []
  for each arm in arms
    change updated to push_scope(updated)
    let shape be check_pattern(checker: updated, pattern: arm.pattern, subject: matched.value.ty)
    change updated to shape.checker
    match arm.guard
      when some(guard) then change updated to check_condition(checker: updated, condition: guard)
      when nothing then change rows to rows.append([shape.value])
    end
    let done be check_block_in_scope(checker: updated, block: arm.body)
    change updated to done.checker
    if not done.value then change all_diverge to false end
    change updated to pop_scope(updated)
  end
  change updated to updated with current_errors: saved_errors
  match fallback
    when some(block) then
      let done be check_block(checker: updated, block: block)
      change updated to done.checker
      if not done.value then change all_diverge to false end
      return Done(value: all_diverge, checker: updated)
    when nothing then
      let exhaustive be check_exhaustive(
        checker: updated,
        subject: matched.value.ty,
        rows: rows,
        errors: matched.value.errors,
        span: span
      )
      return Done(value: exhaustive.value and all_diverge, checker: exhaustive.checker)
  end
end

function errors_union(errors: maybe List of Ty) returns maybe Ty
  purpose: The error union a `match` examines, when its subject is a fallible call.

  match errors
    when some(members) then return Union(members: members)
    when nothing then return nothing
  end
end

function check_for_each(
  checker: Checker,
  bindings: List of Name,
  source: Expr,
  filter: maybe Expr,
  order: maybe SortOrder,
  body: Block
)
  returns Checker
  purpose: `for each`: the loop variables bound to the items of the source.

  let items be loop_items(checker: checker, bindings: bindings, source: source)
  let mutable updated be push_scope(items.checker)
  let mutable index be 0
  for each name in bindings
    let ty be items.value.at(index) otherwise break
    change updated to bind(
      checker: updated,
      name: name,
      ty: ty,
      is_mutable: false,
      kind: LoopBinding
    )
    change index to index + 1
  end
  match filter
    when some(condition) then
      change updated to check_condition(checker: updated, condition: condition)
    when nothing then change updated to updated
  end
  match order
    when some(ordering) then change updated to check_ordering(checker: updated, order: ordering)
    when nothing then change updated to updated
  end
  change updated to updated with loop_depth: updated.loop_depth + 1
  change updated to check_block_in_scope(checker: updated, block: body).checker
  change updated to updated with loop_depth: updated.loop_depth - 1
  return pop_scope(updated)
end

function check_repeat(checker: Checker, condition: Expr, body: Block) returns Checker
  purpose: `repeat until`: a Boolean condition and a loop body.

  let mutable updated be check_condition(checker: checker, condition: condition)
  change updated to updated with loop_depth: updated.loop_depth + 1
  change updated to check_block(checker: updated, block: body).checker
  return updated with loop_depth: updated.loop_depth - 1
end

function all_binding_names(checker: Checker) returns List of Text
  purpose: Every name bound in any scope.

  let mutable names: List of Text be []
  for each scope in checker.scopes
    for each binding in scope.bindings
      change names to names.append(binding.name)
    end
  end
  return names
end

function last_scope_names(checker: Checker, start: Integer) returns List of Text
  purpose: The names the innermost scope gained after a position.

  let scope be checker.scopes.last() otherwise return []
  return for each binding in scope.bindings.drop(start) collect binding.name
end

function last_scope_length(checker: Checker) returns Integer
  purpose: How many bindings the innermost scope holds.

  let scope be checker.scopes.last() otherwise return 0
  return scope.bindings.length()
end

function check_run_concurrently(checker: Checker, deadline: maybe Expr, body: Block)
  returns Done of Boolean
  purpose: `run concurrently`: each statement is a task (decision V7) with its own restrictions.

  let mutable updated be checker
  match deadline
    when some(limit) then change updated to check_within(checker: updated, deadline: limit)
    when nothing then change updated to updated
  end
  let saved be updated.task
  change updated to updated with concurrent_depth: updated.concurrent_depth + 1, task: nothing
  let outer be all_binding_names(updated)
  let mutable siblings: List of Text be []
  let mutable diverges be false
  let mutable reported be false
  for each statement in body.statements
    if diverges and not reported then
      change updated to unreachable(checker: updated, span: statement_span(statement))
      change reported to true
    end
    change updated to updated with task: TaskScope(outer: outer, siblings: siblings)
    let before be last_scope_length(updated)
    let done be check_statement(checker: updated, statement: statement)
    change updated to done.checker
    if done.value then change diverges to true end
    change siblings to siblings.append_all(last_scope_names(checker: updated, start: before))
  end
  change updated to updated with task: saved, concurrent_depth: updated.concurrent_depth - 1
  return Done(value: diverges, checker: updated)
end

function check_break(checker: Checker, word: Text, span: Span) returns Checker
  purpose: `break` and `continue` belong in a loop, and may not leave a `run concurrently` block.

  if checker.loop_depth is 0 then
    return push_error(
      checker: checker,
      code: "outside-loop",
      message: "`{word}` outside a loop",
      span: span,
      fix: "remove it, or put it inside `for each` or `repeat until`"
    )
  end
  if checker.concurrent_depth is greater than 0 then
    return push_error(
      checker: checker,
      code: "outside-loop",
      message: "`{word}` cannot leave a `run concurrently` block",
      span: span,
      fix: "end the task with `return` instead, or move the loop inside the block"
    )
  end
  return checker
end

function check_ignore(checker: Checker, value: Expr) returns Checker
  purpose: `ignore`: the call must return something, and must have effects (decision R6).

  let before be checker.effect_calls
  let done be infer(checker: checker, expr: value, expected: nothing)
  let mutable updated be done.checker
  let span be expr_span(value)
  change updated to require_handled(checker: updated, info: done.value, span: span)
  let ty be resolve(checker: updated, ty: done.value.ty)
  if ty is Unit then
    return push_error(
      checker: updated,
      code: "ignore-nothing",
      message: "this call returns nothing; there is no result to ignore",
      span: span,
      fix: "call it without `ignore`"
    )
  end
  if updated.effect_calls is before and not types.is_error(ty) and ty is not Never then
    let fix be ignored_pure_fix(checker: updated, value: value)
    return push_error(
      checker: updated,
      code: "ignore-pure",
      message: "this call has no effects, so discarding its result does nothing",
      span: span,
      fix: fix
    )
  end
  return updated
end

function check_check(checker: Checker, value: Expr, span: Span) returns Checker
  purpose: `check` belongs in a test.

  let mutable updated be checker
  if not checker.context.is_test then
    change updated to push_error(
      checker: updated,
      code: "check-outside-test",
      message: "`check` belongs in a `test` block",
      span: span,
      fix: "write `if not condition then fail with ... end`, or move it into a `test`"
    )
  end
  return check_condition(checker: updated, condition: value)
end

function check_expression(checker: Checker, value: Expr) returns Checker
  purpose: An expression statement: a call whose result is nothing, or an unused result.

  let done be infer(checker: checker, expr: value, expected: nothing)
  let mutable updated be done.checker
  let span be expr_span(value)
  change updated to require_handled(checker: updated, info: done.value, span: span)
  let ty be resolve(checker: updated, ty: done.value.ty)
  if ty is Unit or types.is_error(ty) or ty is Never then return updated end
  let shown be show(checker: updated, ty: ty)
  let fix be unused_result_fix(checker: updated, value: value)
  return push_error(
    checker: updated,
    code: "unused-result",
    message: "the result (`{shown}`) is not used",
    span: span,
    fix: fix
  )
end

type MethodCall
  purpose: The receiver and method of `x.method(...)` on a mutable binding.
  has receiver: Text
  has method: Text
end

function unused_result_fix(checker: Checker, value: Expr) returns Text
  purpose: The fix for an unused result: `change x to x.method(...)` on a mutable binding (J15).

  let call be mutable_method_call(
    checker: checker,
    value: value
  ) otherwise return "bind it with `let`, or discard it with `ignore`"
  let change_call be "write `change {call.receiver} to {call.receiver}.{call.method}(...)`"
  return "{change_call}, or bind it with `let`, or discard it with `ignore`"
end

function ignored_pure_fix(checker: Checker, value: Expr) returns Text
  purpose: The fix for `ignore` of a pure result (decision R6).

  match mutable_method_call(checker: checker, value: value)
    when some(call) then
      let change_call be "write `change {call.receiver} to {call.receiver}.{call.method}(...)`"
      return "{change_call}, or remove the call"
    when nothing then return "bind the result with `let`, or remove the call"
  end
end

function callee_of(expr: Expr) returns maybe Expr
  purpose: The callee of a call, looking through `otherwise`.

  match expr
    when Call(callee) then return callee
    when Otherwise(value) then return callee_of(value)
    otherwise return nothing
  end
end

function mutable_method_call(checker: Checker, value: Expr) returns maybe MethodCall
  purpose: The receiver and method of `x.method(...)` when `x` is a mutable binding.

  let callee be callee_of(value) otherwise return nothing
  match callee
    when Member(base, name) then
      match base
        when NameExpr(name: receiver) then
          let binding be find_binding(
            checker: checker,
            name: receiver.text
          ) otherwise return nothing
          if binding.is_mutable then
            return MethodCall(receiver: receiver.text, method: name.text)
          end
          return nothing
        otherwise return nothing
      end
    otherwise return nothing
  end
end

function check_condition(checker: Checker, condition: Expr) returns Checker
  purpose: A Boolean expression.

  let boolean be builtin(checker.world.builtins.boolean)
  return infer_value(checker: checker, expr: condition, expected: boolean, what: "the condition")
end

function check_within(checker: Checker, deadline: Expr) returns Checker
  purpose: A `within` deadline: a Duration, and `TimedOut` among the declared failures.

  let builtins be checker.world.builtins
  let duration be builtin(builtins.duration)
  let mutable updated be infer_value(
    checker: checker,
    expr: deadline,
    expected: duration,
    what: "the deadline"
  )
  let timed_out be builtin(builtins.timed_out)
  let declared be
    for each failing in updated.context.failures
    any same_type(checker: updated, left: failing, right: timed_out)
  if updated.context.fails_any or declared then return updated end
  return push_error(
    checker: updated,
    code: "error-not-declared",
    message: "a `within` deadline can fail with `TimedOut`, which this function does not declare",
    span: expr_span(deadline),
    fix: "add `or fails with TimedOut` to the signature"
  )
end

function check_ordering(checker: Checker, order: SortOrder) returns Checker
  purpose: `sorted by`: the key must be comparable.

  let done be infer(checker: checker, expr: order.key, expected: nothing)
  let span be expr_span(order.key)
  let updated be require_handled(checker: done.checker, info: done.value, span: span)
  return require_ability(
    checker: updated,
    ty: done.value.ty,
    ability_id: updated.world.builtins.compare,
    span: span,
    what: "`sorted by`"
  )
end

function check_return(checker: Checker, value: maybe Expr, span: Span) returns Checker
  purpose: `return` with or without a value, against the body's result type.

  match value
    when nothing then
      let result be checker.context.result otherwise return checker
      let shown be show(checker: checker, ty: result)
      return push_error(
        checker: checker,
        code: "missing-value",
        message: "`return` needs a value of type `{shown}`",
        span: span,
        fix: "write `return value`"
      )
    when some(expr) then
      match checker.context.result
        when nothing then return return_without_result(checker: checker, expr: expr)
        when some(result) then
          let done be infer(checker: checker, expr: expr, expected: result)
          let value_span be expr_span(expr)
          let updated be require_handled(checker: done.checker, info: done.value, span: value_span)
          return expect(
            checker: updated,
            actual: done.value.ty,
            expected: result,
            span: value_span,
            what: "the returned value"
          )
      end
  end
end

function return_without_result(checker: Checker, expr: Expr) returns Checker
  purpose: `return value` in a body that returns nothing.

  let updated be infer(checker: checker, expr: expr, expected: nothing).checker
  if updated.context.is_test then
    return push_error(
      checker: updated,
      code: "return-value",
      message: "a test returns nothing",
      span: expr_span(expr),
      fix: "drop the value; a test ends with `check`, or with `return` alone"
    )
  end
  return push_error(
    checker: updated,
    code: "return-value",
    message: "`{updated.context.name}` returns nothing, so `return` takes no value",
    span: expr_span(expr),
    fix: "add a `returns` clause to the signature, or drop the value"
  )
end

function check_fail(checker: Checker, value: maybe Expr, span: Span) returns Checker
  purpose: `fail` with an error value, or bare after `otherwise`.

  match value
    when nothing then
      if checker.context.fails_any then return checker end
      return push_error(
        checker: checker,
        code: "bare-fail",
        message: "`fail` without a value is only allowed after `otherwise`",
        span: span,
        fix: "write `fail with Error(...)`"
      )
    when some(expr) then
      let done be infer(checker: checker, expr: expr, expected: nothing)
      let value_span be expr_span(expr)
      let updated be require_handled(checker: done.checker, info: done.value, span: value_span)
      return check_error_declared(checker: updated, ty: done.value.ty, span: value_span)
  end
end

function check_error_declared(checker: Checker, ty: Ty, span: Span) returns Checker
  purpose: The error value or union must be among the declared failure types.

  if checker.context.fails_any then return checker end
  let members be
    match resolve(checker: checker, ty: ty)
      when Union(members) then members
      otherwise [resolve(checker: checker, ty: ty)]
    end
  let mutable updated be checker
  for each member in members
    if types.is_error(member) then continue end
    let mutable found be false
    for each declared in updated.context.failures
      let done be assign(checker: updated, actual: member, expected: declared, span: span)
      change updated to done.checker
      if done.value then
        change found to true
        break
      end
    end
    if not found then
      change updated to error_not_declared(checker: updated, member: member, span: span)
    end
  end
  return updated
end

function error_not_declared(checker: Checker, member: Ty, span: Span) returns Checker
  purpose: The error for a failure the signature does not list.

  let shown be show(checker: checker, ty: member)
  let add_clause be "add `or fails with {shown}` to the signature"
  let fix be
    if checker.context.is_test then "a test may fail with any error"
    otherwise "{add_clause}, or translate it with `otherwise fail with ...`"
    end
  return push_error(
    checker: checker,
    code: "error-not-declared",
    message: "`{checker.context.name}` does not declare that it fails with `{shown}`",
    span: span,
    fix: fix
  )
end

function require_handled(checker: Checker, info: Info, span: Span) returns Checker
  purpose: A fallible call whose errors nothing handled is an error (`otherwise` is mandatory).

  if info.failures.is_empty() then return checker end
  let shown be for each failing in info.failures collect show(checker: checker, ty: failing)
  let joined be shown.join(" or ")
  return push_error(
    checker: checker,
    code: "missing-otherwise",
    message: "this call can fail with {joined}",
    span: span,
    fix: "add `otherwise fail`, `otherwise <value>`, or handle it with `match`"
  )
end

function iterable_item(checker: Checker, head: Integer, args: List of Ty) returns maybe Ty
  purpose: The item type of a loop over a type with an `Iterable` implementation (decision V10).

  let wanted be checker.world.builtins.iterable
  for each implementation in checker.world.impls
    if implementation.ability_id is wanted and types.head_type(implementation.target) is head then
      let item be implementation.ability_args.first() otherwise return nothing
      let bound be bind_target_params(target: implementation.target, args: args)
      return types.substitute(ty: item, bindings: bound)
    end
  end
  return nothing
end

function bind_target_params(target: Ty, args: List of Ty) returns List of Substitution
  purpose: The implementation's parameters bound to the type's actual arguments, by position.

  match target
    when App(args: declared) then
      let mutable bound: List of Substitution be []
      let mutable index be 0
      for each declared_arg in declared
        let actual be args.at(index) otherwise break
        match declared_arg
          when Param(id) then change bound to bound.append(Substitution(param: id, ty: actual))
          otherwise change index to index
        end
        change index to index + 1
      end
      return bound
    otherwise return []
  end
end

type Items
  purpose: The item type of a loop source, and its halves when the items are pairs.
  has item: Ty
  has pair: maybe ItemPair
end

type ItemPair
  purpose: The two halves of a pair item.
  has left: Ty
  has right: Ty
end

function pair_halves(checker: Checker, item: Ty) returns maybe ItemPair
  purpose: The halves of an item that is a pair.

  match resolve(checker: checker, ty: item)
    when App(id, args) where id is checker.world.builtins.pair then
      let left be args.at(0) otherwise return nothing
      let right be args.at(1) otherwise return nothing
      return ItemPair(left: left, right: right)
    otherwise return nothing
  end
end

function error_items() returns Items
  purpose: The items of a source that is not iterable, after an error.

  return Items(item: ErrorTy, pair: ItemPair(left: ErrorTy, right: ErrorTy))
end

function source_items(checker: Checker, ty: Ty, source: Expr) returns Done of Items
  purpose: What a source yields: by its type, a collection, a range, a text or an `Iterable`.

  let builtins be checker.world.builtins
  match ty
    when App(id, args) then
      match iterable_item(checker: checker, head: id, args: args)
        when some(item) then
          return Done(
            value: Items(item: item, pair: pair_halves(checker: checker, item: item)),
            checker: checker
          )
        when nothing then
          let first_arg be args.at(0) otherwise ErrorTy
          let second_arg be args.at(1) otherwise ErrorTy
          if id is builtins.list or id is builtins.set_type then
            return Done(
              value: Items(item: first_arg, pair: pair_halves(checker: checker, item: first_arg)),
              checker: checker
            )
          end
          if id is builtins.map then
            let pair be App(id: builtins.pair, args: [first_arg, second_arg])
            return Done(
              value: Items(item: pair, pair: ItemPair(left: first_arg, right: second_arg)),
              checker: checker
            )
          end
          if id is builtins.range then
            return Done(
              value: Items(item: builtin(builtins.integer), pair: nothing),
              checker: checker
            )
          end
          if id is builtins.text then
            return Done(value: Items(item: builtin(builtins.text), pair: nothing), checker: checker)
          end
          return Done(
            value: error_items(),
            checker: not_iterable(checker: checker, ty: ty, source: source)
          )
      end
    when ErrorTy then return Done(value: error_items(), checker: checker)
    when MaybeTy then
      let wanted be App(id: builtins.list, args: [ErrorTy])
      let updated be mismatch(
        checker: checker,
        actual: ty,
        expected: wanted,
        span: expr_span(source),
        what: "the source"
      )
      return Done(value: error_items(), checker: updated)
    otherwise
      return Done(
        value: error_items(),
        checker: not_iterable(checker: checker, ty: ty, source: source)
      )
  end
end

function not_iterable(checker: Checker, ty: Ty, source: Expr) returns Checker
  purpose: The error for a source that cannot be iterated.

  let shown be show(checker: checker, ty: ty)
  let what be "a list, set, map, range, text or a type with `Iterable` can"
  let implement be "implement `Iterable` for `{shown}`"
  return push_error(
    checker: checker,
    code: "type-mismatch",
    message: "`{shown}` cannot be iterated; {what}",
    span: expr_span(source),
    fix: "iterate a collection, or {implement}: `ability Iterable of Item for {shown}`"
  )
end

function loop_items(checker: Checker, bindings: List of Name, source: Expr)
  returns Done of List of Ty
  purpose: The item types a loop or query header binds for a source.

  let done be infer(checker: checker, expr: source, expected: nothing)
  let span be expr_span(source)
  let mutable updated be require_handled(checker: done.checker, info: done.value, span: span)
  let ty be resolve(checker: updated, ty: done.value.ty)
  let items be source_items(checker: updated, ty: ty, source: source)
  change updated to items.checker
  match bindings.length()
    when 1 then return Done(value: [items.value.item], checker: updated)
    when 2 then
      match items.value.pair
        when some(pair) then return Done(value: [pair.left, pair.right], checker: updated)
        when nothing then
          let shown be show(checker: updated, ty: items.value.item)
          change updated to push_error(
            checker: updated,
            code: "type-mismatch",
            message: "two loop variables need pairs or a map, but the items are `{shown}`",
            span: span,
            fix: "bind one variable, or iterate a map or a list of pairs"
          )
          return Done(value: [ErrorTy, ErrorTy], checker: updated)
      end
    otherwise
      change updated to push_error(
        checker: updated,
        code: "loop-variables",
        message: "a loop binds one variable, or two for pairs",
        span: span,
        fix: "write `for each item in items`, or `for each key, value in map`"
      )
      let errors be error_types(bindings.length())
      return Done(value: errors, checker: updated)
  end
end

function infer(checker: Checker, expr: Expr, expected: maybe Ty) returns Done of Info
  purpose: Infer an expression; `expected` guides literals and generic results.

  match expr
    when IntegerLiteral(text, span) then
      return infer_integer(
        checker: checker,
        expr: expr,
        digits: text,
        span: span,
        expected: expected
      )
    when DecimalLiteral(text, span) then
      return infer_decimal(
        checker: checker,
        expr: expr,
        digits: text,
        span: span,
        expected: expected
      )
    when TextLiteral(pieces, span) then
      return infer_text(
        checker: checker,
        expr: expr,
        pieces: pieces,
        span: span,
        expected: expected
      )
    when RawTextLiteral then
      return Done(value: plain(builtin(checker.world.builtins.text)), checker: checker)
    when BooleanLiteral then
      return Done(value: plain(builtin(checker.world.builtins.boolean)), checker: checker)
    when NothingLiteral then return infer_nothing(checker: checker, expected: expected)
    when SelfValue(span) then return infer_self(checker: checker, span: span)
    when NameExpr(name) then return infer_name(checker: checker, name: name)
    when TypeNameExpr(name) then
      return infer_bare_type_name(checker: checker, name: name, expected: expected)
    when Member(base, name, span) then
      return infer_member(checker: checker, base: base, name: name, span: span)
    when Call(callee, args, span) then
      return infer_call(
        checker: checker,
        callee: callee,
        args: args,
        span: span,
        expected: expected
      )
    when Construct(name, args, span) then
      return infer_construct(
        checker: checker,
        name: name,
        args: args,
        span: span,
        expected: expected
      )
    otherwise return infer_compound(checker: checker, expr: expr, expected: expected)
  end
end

function infer_compound(checker: Checker, expr: Expr, expected: maybe Ty) returns Done of Info
  purpose: The expressions built from others: collections, operators, `with`, `otherwise`, branches.

  match expr
    when ListLiteral(items) then
      return infer_list(checker: checker, items: items, expected: expected)
    when MapLiteral(entries, span) then
      return infer_map(checker: checker, entries: entries, span: span, expected: expected)
    when RangeLiteral(lower, upper, step) then
      return infer_range(checker: checker, lower: lower, upper: upper, step: step)
    when Not(value) then
      let updated be check_condition(checker: checker, condition: value)
      return Done(value: plain(builtin(checker.world.builtins.boolean)), checker: updated)
    when Binary(operator, left, right, span) then
      return infer_binary(
        checker: checker,
        operator: operator,
        left: left,
        right: right,
        span: span,
        expected: expected
      )
    when With(base, updates) then
      return infer_with(checker: checker, base: base, updates: updates, expected: expected)
    when Otherwise(value, fallback, span) then
      return infer_otherwise(
        checker: checker,
        value: value,
        fallback: fallback,
        span: span,
        expected: expected
      )
    when IfExpr(branches, fallback) then
      return infer_if(checker: checker, branches: branches, fallback: fallback, expected: expected)
    when MatchExpr(subject, arms, fallback, span) then
      return infer_match(
        checker: checker,
        subject: subject,
        arms: arms,
        fallback: fallback,
        span: span,
        expected: expected
      )
    when QueryExpr then return infer_query(checker: checker, query: expr, expected: expected)
    when Paren(value) then return infer(checker: checker, expr: value, expected: expected)
    otherwise crash with "an expression handled before"
  end
end

function numeric_expectation(checker: Checker, expected: maybe Ty) returns maybe Ty
  purpose: The expected type resolved, when it is a known numeric type.

  let wanted be expected otherwise return nothing
  let resolved be resolve(checker: checker, ty: wanted)
  if var_id(resolved) is not nothing then return nothing end
  if is_numeric(checker: checker, ty: resolved) then return resolved end
  return nothing
end

function note_literal(checker: Checker, span: Span, ty: Ty) returns Checker
  purpose: A numeric literal noted with its type, for the VM's number kinds.

  return checker with literals: checker.literals.append(SpanTy(span: span, ty: ty))
end

function infer_integer(checker: Checker, expr: Expr, digits: Text, span: Span, expected: maybe Ty)
  returns Done of Info
  purpose: An integer literal takes the numeric type its context expects, or a literal variable.

  let literal be refine.literal_of(expr)
  match numeric_expectation(checker: checker, expected: expected)
    when some(resolved) then
      let mutable updated be checker
      match literal
        when some(value) then
          change updated to check_subtype_refinements(
            checker: updated,
            ty: resolved,
            literal: value,
            span: span
          ).checker
        when nothing then change updated to updated
      end
      let fits be literal_fits(
        checker: updated,
        kind: IntegerVar(literal: literal),
        literal: nothing,
        ty: resolved,
        span: span
      )
      change updated to fits.checker
      if not fits.value then
        change updated to integer_mismatch(
          checker: updated,
          digits: digits,
          resolved: resolved,
          span: span
        )
      end
      change updated to note_literal(checker: updated, span: span, ty: resolved)
      return Done(value: plain(resolved), checker: updated)
    when nothing then
      let var be fresh(checker: checker, kind: IntegerVar(literal: literal))
      let updated be note_literal(checker: var.checker, span: span, ty: var.value)
      return Done(value: plain(var.value), checker: updated)
  end
end

function integer_mismatch(checker: Checker, digits: Text, resolved: Ty, span: Span) returns Checker
  purpose: The error for an integer literal where another number type is needed.

  let shown be show(checker: checker, ty: resolved)
  let fix be
    if shown is "Decimal" then "write `{digits}.0`"
    otherwise if shown is "Float" then "write `{digits}.0.to_float()`"
    otherwise "write a `{shown}`"
    end
  return push_error(
    checker: checker,
    code: "type-mismatch",
    message: "the literal `{digits}` is an Integer, but `{shown}` is needed",
    span: span,
    fix: fix
  )
end

function infer_decimal(checker: Checker, expr: Expr, digits: Text, span: Span, expected: maybe Ty)
  returns Done of Info
  purpose: A decimal literal takes Decimal or Float as its context expects, or a literal variable.

  let literal be refine.literal_of(expr)
  match numeric_expectation(checker: checker, expected: expected)
    when some(resolved) then
      let fits be literal_fits(
        checker: checker,
        kind: DecimalVar(literal: literal),
        literal: nothing,
        ty: resolved,
        span: span
      )
      let mutable updated be fits.checker
      if not fits.value then
        let shown be show(checker: updated, ty: resolved)
        change updated to push_error(
          checker: updated,
          code: "type-mismatch",
          message: "the literal `{digits}` is a Decimal, but `{shown}` is needed",
          span: span,
          fix: "an Integer value is converted with `.to_decimal()`, never the other way"
        )
      otherwise
        match literal
          when some(value) then
            change updated to check_subtype_refinements(
              checker: updated,
              ty: resolved,
              literal: value,
              span: span
            ).checker
          when nothing then change updated to updated
        end
      end
      change updated to note_literal(checker: updated, span: span, ty: resolved)
      return Done(value: plain(resolved), checker: updated)
    when nothing then
      let var be fresh(checker: checker, kind: DecimalVar(literal: literal))
      let updated be note_literal(checker: var.checker, span: span, ty: var.value)
      return Done(value: plain(var.value), checker: updated)
  end
end

function infer_text(
  checker: Checker,
  expr: Expr,
  pieces: List of TextPiece,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: A text literal: its holes checked; a literal of a refined Text subtype when expected.

  let builtins be checker.world.builtins
  let mutable updated be checker
  for each piece in pieces
    match piece
      when Hole(expression) then
        change updated to check_hole(checker: updated, expression: expression)
      otherwise change updated to updated
    end
  end
  let text be builtin(builtins.text)
  match expected
    when some(wanted) then
      let resolved be resolve(checker: updated, ty: wanted)
      let base be base_of(checker: updated, ty: resolved)
      let refined be is_builtin(checker: updated, ty: base, id: builtins.text)
        and not is_builtin(checker: updated, ty: resolved, id: builtins.text)
      if refined then
        match refine.literal_of(expr)
          when some(literal) then
            let holds be check_subtype_refinements(
              checker: updated,
              ty: resolved,
              literal: literal,
              span: span
            )
            if holds.value then return Done(value: plain(resolved), checker: holds.checker) end
            return Done(value: plain(ErrorTy), checker: holds.checker)
          when nothing then change updated to updated
        end
      end
      return Done(value: plain(text), checker: updated)
    when nothing then return Done(value: plain(text), checker: updated)
  end
end

function check_hole(checker: Checker, expression: Expr) returns Checker
  purpose: An interpolated value: not optional, and printable.

  let builtins be checker.world.builtins
  let done be infer(checker: checker, expr: expression, expected: nothing)
  let span be expr_span(expression)
  let updated be require_handled(checker: done.checker, info: done.value, span: span)
  if is_maybe(resolve(checker: updated, ty: done.value.ty)) then
    return mismatch(
      checker: updated,
      actual: done.value.ty,
      expected: builtin(builtins.text),
      span: span,
      what: "the interpolated value"
    )
  end
  return require_ability(
    checker: updated,
    ty: done.value.ty,
    ability_id: builtins.to_text,
    span: span,
    what: "interpolation"
  )
end

function infer_nothing(checker: Checker, expected: maybe Ty) returns Done of Info
  purpose: `nothing` is a `maybe` of what the context expects, or of a fresh variable.

  match expected
    when some(wanted) then
      match resolve(checker: checker, ty: wanted)
        when MaybeTy(inner) then return Done(value: plain(MaybeTy(inner: inner)), checker: checker)
        otherwise return fresh_maybe(checker)
      end
    when nothing then return fresh_maybe(checker)
  end
end

function fresh_maybe(checker: Checker) returns Done of Info
  purpose: A `maybe` of a fresh variable.

  let var be fresh(checker: checker, kind: AnyVar)
  return Done(value: plain(MaybeTy(inner: var.value)), checker: var.checker)
end

function infer_self(checker: Checker, span: Span) returns Done of Info
  purpose: `self`, bound only in a method.

  match find_binding(checker: checker, name: "self")
    when some(binding) then
      return Done(value: plain(binding.ty), checker: mark_used(checker: checker, name: "self"))
    when nothing then
      let updated be push_error(
        checker: checker,
        code: "unknown-name",
        message: "`self` is only bound in a method",
        span: span,
        fix: "declare the function with `self` as its first parameter, in the module of its type"
      )
      return Done(value: plain(ErrorTy), checker: updated)
  end
end

function expected_app_args(checker: Checker, expected: maybe Ty, id: Integer)
  returns maybe List of Ty
  purpose: The arguments of the expected type when it is the given type constructor.

  let wanted be expected otherwise return nothing
  match resolve(checker: checker, ty: wanted)
    when App(id: found, args) where found is id then return args
    otherwise return nothing
  end
end

function infer_list(checker: Checker, items: List of Expr, expected: maybe Ty) returns Done of Info
  purpose: A list literal: every item of one type, guided by the expected list type.

  let builtins be checker.world.builtins
  let mutable updated be checker
  let mutable item_ty be ErrorTy
  match expected_app_args(checker: checker, expected: expected, id: builtins.list)
    when some(args) then change item_ty to args.at(0) otherwise ErrorTy
    when nothing then
      let var be fresh(checker: updated, kind: AnyVar)
      change updated to var.checker
      change item_ty to var.value
  end
  for each item in items
    change updated to infer_value(checker: updated, expr: item, expected: item_ty, what: "the item")
  end
  return Done(value: plain(App(id: builtins.list, args: [item_ty])), checker: updated)
end

function infer_map(checker: Checker, entries: List of MapEntry, span: Span, expected: maybe Ty)
  returns Done of Info
  purpose: A map literal: keys of one hashable type, values of one type.

  let builtins be checker.world.builtins
  let mutable updated be checker
  let mutable key_ty be ErrorTy
  let mutable value_ty be ErrorTy
  match expected_app_args(checker: checker, expected: expected, id: builtins.map)
    when some(args) then
      change key_ty to args.at(0) otherwise ErrorTy
      change value_ty to args.at(1) otherwise ErrorTy
    when nothing then
      let key_var be fresh(checker: updated, kind: AnyVar)
      let value_var be fresh(checker: key_var.checker, kind: AnyVar)
      change updated to value_var.checker
      change key_ty to key_var.value
      change value_ty to value_var.value
  end
  for each entry in entries
    change updated to infer_value(
      checker: updated,
      expr: entry.key,
      expected: key_ty,
      what: "the key"
    )
    change updated to infer_value(
      checker: updated,
      expr: entry.value,
      expected: value_ty,
      what: "the value"
    )
  end
  change updated to require_ability(
    checker: updated,
    ty: key_ty,
    ability_id: builtins.hash,
    span: span,
    what: "a map key"
  )
  return Done(value: plain(App(id: builtins.map, args: [key_ty, value_ty])), checker: updated)
end

function infer_range(checker: Checker, lower: Expr, upper: Expr, step: maybe Expr)
  returns Done of Info
  purpose: A range: Integer bounds and step.

  let builtins be checker.world.builtins
  let integer be builtin(builtins.integer)
  let mutable updated be infer_value(
    checker: checker,
    expr: lower,
    expected: integer,
    what: "the range bound"
  )
  change updated to infer_value(
    checker: updated,
    expr: upper,
    expected: integer,
    what: "the range bound"
  )
  match step
    when some(step_expr) then
      change updated to infer_value(
        checker: updated,
        expr: step_expr,
        expected: integer,
        what: "the range bound"
      )
    when nothing then change updated to updated
  end
  return Done(value: plain(builtin(builtins.range)), checker: updated)
end

function infer_with(checker: Checker, base: Expr, updates: List of Arg, expected: maybe Ty)
  returns Done of Info
  purpose: `with`: a record's fields replaced; a refined field can fail like a construction (U9).

  let done be infer(checker: checker, expr: base, expected: expected)
  let mutable updated be require_handled(
    checker: done.checker,
    info: done.value,
    span: expr_span(base)
  )
  let ty be resolve(checker: updated, ty: done.value.ty)
  let mutable failures: List of Ty be []
  match record_fields(checker: updated, ty: ty)
    when some(fields) then
      for each update in updates
        let changed be check_update(
          checker: updated,
          ty: ty,
          fields: fields,
          update: update,
          failures: failures
        )
        change updated to changed.checker
        change failures to changed.value
      end
    when nothing then
      if not types.is_error(ty) then
        let shown be show(checker: updated, ty: ty)
        change updated to push_error(
          checker: updated,
          code: "type-mismatch",
          message: "`with` updates a record, but this is `{shown}`",
          span: expr_span(base),
          fix: "apply `with` to a record value"
        )
      end
      for each update in updates
        change updated to infer(checker: updated, expr: update.value, expected: nothing).checker
      end
  end
  return Done(value: Info(ty: ty, failures: failures, function_id: nothing), checker: updated)
end

function find_field(fields: List of FieldSpec, name: Text) returns maybe FieldSpec
  purpose: A field by name.

  for each field in fields
    if field.name is name then return field end
  end
  return nothing
end

function check_update(
  checker: Checker,
  ty: Ty,
  fields: List of FieldSpec,
  update: Arg,
  failures: List of Ty
)
  returns Done of List of Ty
  purpose: One `field: value` of a `with`.

  let field_name be update.name otherwise return unnamed_update(
    checker: checker,
    update: update,
    failures: failures
  )
  match find_field(fields: fields, name: field_name.text)
    when some(field) then
      let value_span be expr_span(update.value)
      let done be infer(checker: checker, expr: update.value, expected: field.ty)
      let mutable updated be require_handled(
        checker: done.checker,
        info: done.value,
        span: value_span
      )
      change updated to expect(
        checker: updated,
        actual: done.value.ty,
        expected: field.ty,
        span: value_span,
        what: "the new value"
      )
      match field.refinement
        when some(condition) then
          return check_field_refinement(
            checker: updated,
            field: field_name.text,
            condition: condition,
            value: update.value,
            failures: failures
          )
        when nothing then return Done(value: failures, checker: updated)
      end
    when nothing then
      let shown be show(checker: checker, ty: ty)
      let fix be suggest_field(checker: checker, ty: ty, name: field_name.text)
      let mutable updated be push_error(
        checker: checker,
        code: "unknown-field",
        message: "`{shown}` has no field named `{field_name.text}`",
        span: field_name.span,
        fix: fix
      )
      change updated to infer(checker: updated, expr: update.value, expected: nothing).checker
      return Done(value: failures, checker: updated)
  end
end

function unnamed_update(checker: Checker, update: Arg, failures: List of Ty)
  returns Done of List of Ty
  purpose: `with` names every field it changes.

  let mutable updated be push_error(
    checker: checker,
    code: "argument-name",
    message: "`with` names every field it changes",
    span: update.span,
    fix: "write `with field: value`"
  )
  change updated to infer(checker: updated, expr: update.value, expected: nothing).checker
  return Done(value: failures, checker: updated)
end

function infer_if(
  checker: Checker,
  branches: List of ExprBranch,
  fallback: Outcome,
  expected: maybe Ty
)
  returns Done of Info
  purpose: An `if` expression: every branch a value of one type, or a way out.

  let mutable updated be checker
  let mutable result be expected
  for each branch in branches
    change updated to check_condition(checker: updated, condition: branch.condition)
    let done be check_outcome(checker: updated, outcome: branch.outcome, result: result)
    change updated to done.checker
    change result to done.value
  end
  let done be check_outcome(checker: updated, outcome: fallback, result: result)
  return Done(value: plain(done.value otherwise Never), checker: done.checker)
end

function infer_match(
  checker: Checker,
  subject: Expr,
  arms: List of ExprArm,
  fallback: maybe Outcome,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: A `match` expression: every arm a value of one type, or a way out.

  let matched be match_subject(checker: checker, subject: subject)
  let saved_errors be matched.checker.current_errors
  let mutable updated be matched.checker with current_errors: errors_union(matched.value.errors)
  let mutable result be expected
  let mutable rows: List of List of Shape be []
  for each arm in arms
    change updated to push_scope(updated)
    let shape be check_pattern(checker: updated, pattern: arm.pattern, subject: matched.value.ty)
    change updated to shape.checker
    match arm.guard
      when some(guard) then change updated to check_condition(checker: updated, condition: guard)
      when nothing then change rows to rows.append([shape.value])
    end
    let done be check_outcome(checker: updated, outcome: arm.body, result: result)
    change updated to done.checker
    change result to done.value
    change updated to pop_scope(updated)
  end
  change updated to updated with current_errors: saved_errors
  match fallback
    when some(outcome) then
      let done be check_outcome(checker: updated, outcome: outcome, result: result)
      change updated to done.checker
      change result to done.value
    when nothing then
      change updated to check_exhaustive(
        checker: updated,
        subject: matched.value.ty,
        rows: rows,
        errors: matched.value.errors,
        span: span
      ).checker
  end
  return Done(value: plain(result otherwise Never), checker: updated)
end

function infer_value(checker: Checker, expr: Expr, expected: Ty, what: Text) returns Checker
  purpose: A plain, handled expression of the expected type.

  let done be infer(checker: checker, expr: expr, expected: expected)
  let span be expr_span(expr)
  let updated be require_handled(checker: done.checker, info: done.value, span: span)
  return expect(checker: updated, actual: done.value.ty, expected: expected, span: span, what: what)
end

function check_outcome(checker: Checker, outcome: Outcome, result: maybe Ty)
  returns Done of maybe Ty
  purpose: A branch of an `if` or `match` expression: a value or a way out.

  match outcome
    when ValueOutcome(value) then
      let done be infer(checker: checker, expr: value, expected: result)
      let span be expr_span(value)
      let updated be require_handled(checker: done.checker, info: done.value, span: span)
      match result
        when some(ty) then
          return Done(
            value: result,
            checker: expect(
              checker: updated,
              actual: done.value.ty,
              expected: ty,
              span: span,
              what: "this branch"
            )
          )
        when nothing then return Done(value: done.value.ty, checker: updated)
      end
    when FailOutcome(value, span) then
      return Done(value: result, checker: check_fail(checker: checker, value: value, span: span))
    when ReturnOutcome(value, span) then
      return Done(value: result, checker: check_return(checker: checker, value: value, span: span))
    when CrashOutcome(message) then
      let text be builtin(checker.world.builtins.text)
      return Done(
        value: result,
        checker: infer_value(
          checker: checker,
          expr: message,
          expected: text,
          what: "the crash message"
        )
      )
    when BreakOutcome(span) then
      return Done(value: result, checker: outside_loop(checker: checker, span: span))
    when ContinueOutcome(span) then
      return Done(value: result, checker: outside_loop(checker: checker, span: span))
  end
end

function outside_loop(checker: Checker, span: Span) returns Checker
  purpose: `break` or `continue` as an outcome, outside a loop.

  if checker.loop_depth is not 0 then return checker end
  return push_error(
    checker: checker,
    code: "outside-loop",
    message: "`break` or `continue` outside a loop",
    span: span,
    fix: "remove it, or put it inside `for each` or `repeat until`"
  )
end

function infer_name(checker: Checker, name: Name) returns Done of Info
  purpose: A bare name: a binding, a constant, a function passed by name, or unknown.

  let mutable updated be checker
  match task_conflict(checker: checker, name: name.text, changing: false)
    when some(reason) then
      change updated to push_error(
        checker: updated,
        code: "task-independence",
        message: reason,
        span: name.span,
        fix: task_fix()
      )
    when nothing then change updated to updated
  end
  match find_binding(checker: updated, name: name.text)
    when some(binding) then
      return Done(value: plain(binding.ty), checker: mark_used(checker: updated, name: name.text))
    when nothing then change updated to updated
  end
  match refinement_field_error(checker: updated, name: name)
    when some(failed) then return Done(value: plain(ErrorTy), checker: failed)
    when nothing then change updated to updated
  end
  match module_info(updated).constants.get(name.text)
    when some(constant) then
      return infer_constant_name(checker: updated, name: name, constant: constant)
    when nothing then change updated to updated
  end
  match declare.lookup_function(world: updated.world, owner: updated.module_id, name: name.text)
    when some(function_id) then
      return infer_function_name(checker: updated, name: name, function_id: function_id)
    when nothing then change updated to updated
  end
  if module_info(updated).imports.contains_key(name.text) then
    change updated to push_error(
      checker: updated,
      code: "unknown-name",
      message: "`{name.text}` is a module, not a value",
      span: name.span,
      fix: "call one of its functions: `{name.text}.function(...)`"
    )
    return Done(value: plain(ErrorTy), checker: updated)
  end
  let fix be unknown_name_fix(checker: updated, name: name.text)
  change updated to push_error(
    checker: updated,
    code: "unknown-name",
    message: "there is no binding, constant or function named `{name.text}`",
    span: name.span,
    fix: fix
  )
  return Done(value: plain(ErrorTy), checker: updated)
end

function infer_constant_name(checker: Checker, name: Name, constant: ConstantInfo)
  returns Done of Info
  purpose: A constant of this module named bare.

  let target be ConstantTarget(owner: checker.module_id, name: name.text)
  let mutable updated be record(checker: checker, target: target, span: name.span)
  change updated to note_deprecated(
    checker: updated,
    name: name.text,
    deprecation: constant.deprecation,
    span: name.span
  )
  return Done(value: plain(constant.ty), checker: updated)
end

function infer_function_name(checker: Checker, name: Name, function_id: Integer)
  returns Done of Info
  purpose: A function of this module passed by name.

  let mutable updated be record(
    checker: checker,
    target: FunctionTarget(function_id: function_id),
    span: name.span
  )
  if not inside(checker: updated, function_id: function_id) then
    let deprecation be declare.function_at(world: updated.world, id: function_id).deprecation
    change updated to note_deprecated(
      checker: updated,
      name: name.text,
      deprecation: deprecation,
      span: name.span
    )
  end
  let info be Info(
    ty: function_type(checker: updated, id: function_id),
    failures: [],
    function_id: function_id
  )
  return Done(value: info, checker: updated)
end

function refinement_field_error(checker: Checker, name: Name) returns maybe Checker
  purpose: The error when a refinement condition names another field of its type (decision Y4).

  let scope be checker.condition otherwise return nothing
  if not scope.others.contains(name.text) then return nothing end
  let field be scope.field
  let owner be scope.type_name
  return push_error(
    checker: checker,
    code: "refinement-field",
    message: "the condition of `{field}` reads `{name.text}`, another field of `{owner}`",
    span: name.span,
    fix: "a refinement sees only its own field; check both where the value is built"
  )
end

function unknown_name_fix(checker: Checker, name: Text) returns Text
  purpose: The fix for an unknown name: an import, a foreign spelling, a close binding or function.

  let imported be suggest_module_import(checker: checker, name: name)
  if imported is not nothing then return imported otherwise "" end
  let foreign be suggest.foreign_value(name)
  if foreign is not nothing then return foreign otherwise "" end
  let binding be suggest_binding(checker: checker, name: name)
  if binding is not nothing then return binding otherwise "" end
  let func be suggest_function(checker: checker, name: name)
  if func is not nothing then return func otherwise "" end
  return "declare it first: `let {name} be ...`"
end

function suggest_module_import(checker: Checker, name: Text) returns maybe Text
  purpose: `environment.arguments()` without `import std.environment`: name the import.

  for each found in checker.world.modules
    let last be found.name.split(".").last() otherwise ""
    if found.is_library and last is name then
      return "write `import {found.name}` at the top of the module"
    end
  end
  return nothing
end

function require_public(checker: Checker, function_id: Integer, span: Span) returns Checker
  purpose: A definition of another module is reachable only when it is `public`.

  let info be declare.function_at(world: checker.world, id: function_id)
  if info.is_public or info.owner is checker.module_id then return checker end
  let owner be declare.module_at(world: checker.world, id: info.owner).name
  return push_error(
    checker: checker,
    code: "private-name",
    message: "`{info.name}` is not public in `{owner}`",
    span: span,
    fix: "add `public` to its declaration in `{owner}`"
  )
end

function function_type(checker: Checker, id: Integer) returns Ty
  purpose: The type of a function used as a value (passed by name).

  let info be declare.function_at(world: checker.world, id: id)
  let params be for each param in info.params collect param.ty
  let signature be FunctionSignature(
    params: params,
    result: info.result,
    failures: info.failures,
    capabilities: info.capabilities
  )
  return FunctionTy(signature: signature)
end

function variant_with_type(candidates: List of VariantRef, type_id: Integer)
  returns maybe VariantRef
  purpose: The candidate variant of a type, when one belongs to it.

  for each candidate in candidates
    if candidate.type_id is type_id then return candidate end
  end
  return nothing
end

function expected_head(checker: Checker, expected: maybe Ty) returns maybe Integer
  purpose: The type constructor the context expects, when it is a named type.

  let wanted be expected otherwise return nothing
  return types.head_type(resolve(checker: checker, ty: wanted))
end

function infer_bare_type_name(checker: Checker, name: TypeName, expected: maybe Ty)
  returns Done of Info
  purpose: A bare `Red` or `Point`: a variant without fields.

  let candidates be declare.lookup_variant(
    world: checker.world,
    owner: checker.module_id,
    name: name.text
  )
  if candidates.is_empty() then return bare_name_unknown(checker: checker, name: name) end
  let mutable chosen: maybe VariantRef be candidates.first()
  if candidates.length() is greater than 1 then
    let head be expected_head(checker: checker, expected: expected)
    match head
      when some(type_id) then
        change chosen to variant_with_type(candidates: candidates, type_id: type_id)
      when nothing then change chosen to nothing
    end
    if chosen is nothing then
      return ambiguous_bare_variant(checker: checker, name: name, candidates: candidates)
    end
  end
  let variant be chosen otherwise crash with "a variant"
  let mutable updated be record(
    checker: checker,
    target: VariantTarget(type_id: variant.type_id, index: variant.index),
    span: name.span
  )
  let info be declare.type_at(world: checker.world, id: variant.type_id)
  match info.kind
    when SumKind(variants) then
      let found be variants.at(variant.index) otherwise crash with "a variant"
      if not found.fields.is_empty() then
        let fields be for each field in found.fields collect "{field.name}: ..."
        let joined be fields.join(", ")
        change updated to push_error(
          checker: updated,
          code: "missing-fields",
          message: "`{name.text}` has fields",
          span: name.span,
          fix: "write `{name.text}({joined})`"
        )
      end
    otherwise change updated to updated
  end
  let args be fresh_args(checker: updated, count_of: info.params.length())
  return Done(value: plain(App(id: variant.type_id, args: args.value)), checker: args.checker)
end

function fresh_args(checker: Checker, count_of: Integer) returns Done of List of Ty
  purpose: Fresh variables for a type's parameters.

  let mutable updated be checker
  let mutable args: List of Ty be []
  let mutable index be 0
  repeat until index is at least count_of
    let var be fresh(checker: updated, kind: AnyVar)
    change updated to var.checker
    change args to args.append(var.value)
    change index to index + 1
  end
  return Done(value: args, checker: updated)
end

function ambiguous_bare_variant(checker: Checker, name: TypeName, candidates: List of VariantRef)
  returns Done of Info
  purpose: A bare variant name shared by several sum types that the context does not decide.

  let names be
    for each candidate in candidates
    collect declare.type_name(world: checker.world, id: candidate.type_id)
  let first_name be names.first() otherwise "Type"
  let joined be names.join(" and ")
  let updated be push_error(
    checker: checker,
    code: "ambiguous-variant",
    message: "`{name.text}` is a variant of {joined}; the context does not say which",
    span: name.span,
    fix: "annotate the binding: `let value: {first_name} be {name.text}`"
  )
  return Done(value: plain(ErrorTy), checker: updated)
end

function bare_name_unknown(checker: Checker, name: TypeName) returns Done of Info
  purpose: A capitalised name that is a type (not a value) or nothing known.

  let type_named be declare.lookup_type(
    world: checker.world,
    owner: checker.module_id,
    name: name.text
  )
  if type_named is not nothing then
    let updated be push_error(
      checker: checker,
      code: "type-as-value",
      message: "`{name.text}` is a type, not a value",
      span: name.span,
      fix: "construct one with `{name.text}(...)`"
    )
    return Done(value: plain(ErrorTy), checker: updated)
  end
  let fix be
    match suggest.foreign_value(name.text)
      when some(foreign) then foreign
      when nothing then
        declare.suggest_type(world: checker.world, owner: checker.module_id, name: name.text)
    end
  let updated be push_error(
    checker: checker,
    code: "unknown-name",
    message: "unknown name `{name.text}`",
    span: name.span,
    fix: fix
  )
  return Done(value: plain(ErrorTy), checker: updated)
end

function param_bindings(params: List of Integer, args: List of Ty) returns List of Substitution
  purpose: A type's parameters bound to its arguments, by position.

  let mutable bound: List of Substitution be []
  let mutable index be 0
  for each param in params
    match args.at(index)
      when some(arg) then change bound to bound.append(Substitution(param: param, ty: arg))
      when nothing then break
    end
    change index to index + 1
  end
  return bound
end

function record_fields(checker: Checker, ty: Ty) returns maybe List of FieldSpec
  purpose: The fields of a record type with its arguments applied, or of a pair.

  match resolve(checker: checker, ty: ty)
    when App(id, args) then
      if id is checker.world.builtins.pair then
        let left be args.at(0) otherwise ErrorTy
        let right be args.at(1) otherwise ErrorTy
        return [
          FieldSpec(name: "left", ty: left, refinement: nothing),
          FieldSpec(name: "right", ty: right, refinement: nothing)
        ]
      end
      let info be declare.type_at(world: checker.world, id: id)
      match info.kind
        when RecordKind(fields) then
          let bound be param_bindings(params: info.params, args: args)
          return for each field in fields
            collect FieldSpec(
              name: field.name,
              ty: types.substitute(ty: field.ty, bindings: bound),
              refinement: field.refinement
            )
        otherwise return nothing
      end
    otherwise return nothing
  end
end

function namespace_of(checker: Checker, base: Expr) returns maybe Integer
  purpose: The imported module a member's base names, when it is not a binding.

  match base
    when NameExpr(name) then
      if find_binding(checker: checker, name: name.text) is not nothing then return nothing end
      return module_info(checker).imports.get(name.text)
    otherwise return nothing
  end
end

function infer_member(checker: Checker, base: Expr, name: Name, span: Span) returns Done of Info
  purpose: `base.name`: a module's function or constant, or a field of a record.

  match namespace_of(checker: checker, base: base)
    when some(target) then return infer_module_member(checker: checker, target: target, name: name)
    when nothing then
      let done be infer(checker: checker, expr: base, expected: nothing)
      let mutable updated be require_handled(
        checker: done.checker,
        info: done.value,
        span: expr_span(base)
      )
      let ty be resolve(checker: updated, ty: done.value.ty)
      if is_maybe(ty) then
        change updated to mismatch(
          checker: updated,
          actual: ty,
          expected: ErrorTy,
          span: span,
          what: "this value"
        )
        return Done(value: plain(ErrorTy), checker: updated)
      end
      if types.is_error(ty) then return Done(value: plain(ErrorTy), checker: updated) end
      match record_fields(checker: updated, ty: ty)
        when some(fields) then
          match find_field(fields: fields, name: name.text)
            when some(field) then return Done(value: plain(field.ty), checker: updated)
            when nothing then
              let fix be method_or_field_fix(
                checker: updated,
                ty: ty,
                name: name.text,
                fallback: suggest_field(checker: updated, ty: ty, name: name.text)
              )
              return Done(
                value: plain(ErrorTy),
                checker: unknown_field(checker: updated, ty: ty, name: name, fix: fix)
              )
          end
        when nothing then
          let records_only be "fields belong to records; other values have methods"
          let fallback be "{records_only}, called with parentheses"
          let fix be method_or_field_fix(
            checker: updated,
            ty: ty,
            name: name.text,
            fallback: fallback
          )
          return Done(
            value: plain(ErrorTy),
            checker: unknown_field(checker: updated, ty: ty, name: name, fix: fix)
          )
      end
  end
end

function method_or_field_fix(checker: Checker, ty: Ty, name: Text, fallback: Text) returns Text
  purpose: The fix for a field read that names a method, else the fallback.

  if find_method(checker: checker, ty: ty, name: name) is not nothing then
    return "`{name}` is a method: call it with `.{name}()`"
  end
  return fallback
end

function unknown_field(checker: Checker, ty: Ty, name: Name, fix: Text) returns Checker
  purpose: The error for a field the type does not have.

  let shown be show(checker: checker, ty: ty)
  return push_error(
    checker: checker,
    code: "unknown-field",
    message: "`{shown}` has no field named `{name.text}`",
    span: name.span,
    fix: fix
  )
end

function infer_module_member(checker: Checker, target: Integer, name: Name) returns Done of Info
  purpose: `module.function` as a value, or `module.constant`.

  let mutable updated be checker
  match declare.lookup_function(world: checker.world, owner: target, name: name.text)
    when some(function_id) then
      change updated to record(
        checker: updated,
        target: FunctionTarget(function_id: function_id),
        span: name.span
      )
      change updated to require_public(checker: updated, function_id: function_id, span: name.span)
      let deprecation be declare.function_at(world: updated.world, id: function_id).deprecation
      change updated to note_deprecated(
        checker: updated,
        name: name.text,
        deprecation: deprecation,
        span: name.span
      )
      let info be Info(
        ty: function_type(checker: updated, id: function_id),
        failures: [],
        function_id: function_id
      )
      return Done(value: info, checker: updated)
    when nothing then change updated to updated
  end
  let target_info be declare.module_at(world: checker.world, id: target)
  match target_info.constants.get(name.text)
    when some(constant) then
      return module_constant(
        checker: updated,
        target: target,
        target_info: target_info,
        name: name,
        constant: constant
      )
    when nothing then change updated to updated
  end
  let fallback be "see `renyi index` for what `{target_info.name}` declares"
  let fix be suggest_module_function(
    checker: updated,
    target: target,
    name: name.text
  ) otherwise fallback
  change updated to push_error(
    checker: updated,
    code: "unknown-name",
    message: "`{target_info.name}` has no function or constant named `{name.text}`",
    span: name.span,
    fix: fix
  )
  return Done(value: plain(ErrorTy), checker: updated)
end

function module_constant(
  checker: Checker,
  target: Integer,
  target_info: ModuleInfo,
  name: Name,
  constant: ConstantInfo
)
  returns Done of Info
  purpose: `module.constant`: public, recorded, and its deprecation noted.

  let mutable updated be checker
  if not constant.is_public then
    change updated to push_error(
      checker: updated,
      code: "private-name",
      message: "`{name.text}` is not public in `{target_info.name}`",
      span: name.span,
      fix: "add `public` to its declaration in `{target_info.name}`"
    )
  end
  change updated to record(
    checker: updated,
    target: ConstantTarget(owner: target, name: name.text),
    span: name.span
  )
  change updated to note_deprecated(
    checker: updated,
    name: name.text,
    deprecation: constant.deprecation,
    span: name.span
  )
  return Done(value: plain(constant.ty), checker: updated)
end

function infer_args_only(checker: Checker, args: List of Arg) returns Checker
  purpose: The arguments of a call with no parameters to check against, inferred on their own.

  let mutable updated be checker
  for each arg in args
    change updated to infer(checker: updated, expr: arg.value, expected: nothing).checker
  end
  return updated
end

function infer_call(
  checker: Checker,
  callee: Expr,
  args: List of Arg,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: A call: of a function by name, of a module's function, or of a method.

  match callee
    when NameExpr(name) then
      return call_by_name(checker: checker, name: name, args: args, span: span, expected: expected)
    when Member(base, name) then
      return call_member(
        checker: checker,
        base: base,
        name: name,
        args: args,
        span: span,
        expected: expected
      )
    otherwise
      let updated be push_error(
        checker: checker,
        code: "not-callable",
        message: "only a named function or a method can be called",
        span: expr_span(callee),
        fix: "bind the function to a name with `let`, then call the name"
      )
      return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
  end
end

function call_by_name(
  checker: Checker,
  name: Name,
  args: List of Arg,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: `name(args)`: a function-typed binding, or a function of this module.

  let mutable updated be checker
  match task_conflict(checker: checker, name: name.text, changing: false)
    when some(reason) then
      change updated to push_error(
        checker: updated,
        code: "task-independence",
        message: reason,
        span: name.span,
        fix: task_fix()
      )
    when nothing then change updated to updated
  end
  match find_binding(checker: updated, name: name.text)
    when some(binding) then
      change updated to mark_used(checker: updated, name: name.text)
      return call_binding(checker: updated, name: name, ty: binding.ty, args: args, span: span)
    when nothing then change updated to updated
  end
  match declare.lookup_function(world: updated.world, owner: updated.module_id, name: name.text)
    when some(function_id) then
      return call_known(
        checker: updated,
        id: function_id,
        receiver: nothing,
        args: args,
        span: span,
        name_span: name.span,
        expected: expected
      )
    when nothing then
      let fix be unknown_function_fix(checker: updated, name: name.text)
      change updated to push_error(
        checker: updated,
        code: "unknown-function",
        message: "there is no function named `{name.text}` in this module",
        span: name.span,
        fix: fix
      )
      return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
  end
end

function unknown_function_fix(checker: Checker, name: Text) returns Text
  purpose: The fix for a call of an unknown function.

  let close be suggest_function(checker: checker, name: name)
  if close is not nothing then return close otherwise "" end
  let foreign be suggest.foreign_function(name)
  if foreign is not nothing then return foreign otherwise "" end
  return "declare `function {name}(...)`"
end

function call_binding(checker: Checker, name: Name, ty: Ty, args: List of Arg, span: Span)
  returns Done of Info
  purpose: A call through a binding: a function value, or not callable.

  match resolve(checker: checker, ty: ty)
    when FunctionTy(signature) then
      return call_function_type(
        checker: checker,
        signature: signature,
        args: args,
        span: span,
        name: name.text
      )
    when ErrorTy then
      return Done(value: plain(ErrorTy), checker: infer_args_only(checker: checker, args: args))
    otherwise
      let shown be show(checker: checker, ty: ty)
      let updated be push_error(
        checker: checker,
        code: "not-callable",
        message: "`{name.text}` is `{shown}`, not a function",
        span: name.span,
        fix: "read `{name.text}` without parentheses, or call a function with it"
      )
      return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
  end
end

function call_member(
  checker: Checker,
  base: Expr,
  name: Name,
  args: List of Arg,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: `base.name(args)`: a module's function, or a method on a value.

  match namespace_of(checker: checker, base: base)
    when some(target) then
      return call_module_function(
        checker: checker,
        target: target,
        name: name,
        args: args,
        span: span,
        expected: expected
      )
    when nothing then
      match unimported_namespace(checker: checker, base: base)
        when some(namespace) then
          let fix be suggest_module_import(checker: checker, name: namespace.text) otherwise ""
          let updated be push_error(
            checker: checker,
            code: "unknown-name",
            message: "`{namespace.text}` is not imported",
            span: namespace.span,
            fix: fix
          )
          return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
        when nothing then
          let receiver be infer(checker: checker, expr: base, expected: nothing)
          let updated be require_handled(
            checker: receiver.checker,
            info: receiver.value,
            span: expr_span(base)
          )
          return infer_method_call(
            checker: updated,
            receiver_ty: receiver.value.ty,
            receiver_span: expr_span(base),
            name: name,
            args: args,
            span: span,
            expected: expected
          )
      end
  end
end

function unimported_namespace(checker: Checker, base: Expr) returns maybe Name
  purpose: A base that names a library module the program did not import.

  match base
    when NameExpr(name) then
      if find_binding(checker: checker, name: name.text) is not nothing then return nothing end
      let function_named be declare.lookup_function(
        world: checker.world,
        owner: checker.module_id,
        name: name.text
      )
      if function_named is not nothing then return nothing end
      if module_info(checker).constants.contains_key(name.text) then return nothing end
      if suggest_module_import(checker: checker, name: name.text) is nothing then return nothing end
      return name
    otherwise return nothing
  end
end

function call_module_function(
  checker: Checker,
  target: Integer,
  name: Name,
  args: List of Arg,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: `module.function(args)`.

  match declare.lookup_function(world: checker.world, owner: target, name: name.text)
    when some(function_id) then
      let updated be require_public(checker: checker, function_id: function_id, span: name.span)
      return call_known(
        checker: updated,
        id: function_id,
        receiver: nothing,
        args: args,
        span: span,
        name_span: name.span,
        expected: expected
      )
    when nothing then
      let module_name be declare.module_at(world: checker.world, id: target).name
      let fix be suggest_module_function(
        checker: checker,
        target: target,
        name: name.text
      ) otherwise "see `renyi index` for what `{module_name}` declares"
      let updated be push_error(
        checker: checker,
        code: "unknown-function",
        message: "`{module_name}` has no function named `{name.text}`",
        span: name.span,
        fix: fix
      )
      return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
  end
end

type Receiver
  purpose: The receiver of a method call, with its span.
  has ty: Ty
  has span: Span
end

function infer_method_call(
  checker: Checker,
  receiver_ty: Ty,
  receiver_span: Span,
  name: Name,
  args: List of Arg,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: `receiver.name(args)`: a method declared for the type or a base, or an ability method.

  let mutable updated be default_literal(checker: checker, ty: receiver_ty)
  let ty be resolve(checker: updated, ty: receiver_ty)
  if types.is_error(ty) then
    return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
  end
  if is_maybe(ty) then
    change updated to mismatch(
      checker: updated,
      actual: ty,
      expected: ErrorTy,
      span: receiver_span,
      what: "this value"
    )
    return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
  end
  match find_method(checker: updated, ty: ty, name: name.text)
    when some(DeclaredMethod(function_id)) then
      let chosen be choose_overload(
        checker: updated,
        fallback: function_id,
        receiver: ty,
        name: name.text,
        span: receiver_span
      )
      let receiver be Receiver(ty: ty, span: receiver_span)
      return call_known(
        checker: chosen.checker,
        id: chosen.value,
        receiver: receiver,
        args: args,
        span: span,
        name_span: name.span,
        expected: expected
      )
    when some(MethodOfAbility(ability_id, index)) then
      return call_ability_method(
        checker: updated,
        ty: ty,
        ability_id: ability_id,
        index: index,
        name: name,
        args: args,
        span: span
      )
    when nothing then
      let shown be show(checker: updated, ty: ty)
      let fix be suggest_method(
        checker: updated,
        ty: ty,
        name: name.text
      ) otherwise "call a function with the value as its argument: `{name.text}(value)`"
      change updated to push_error(
        checker: updated,
        code: "unknown-method",
        message: "`{shown}` has no method named `{name.text}`",
        span: name.span,
        fix: fix
      )
      return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
  end
end

function call_ability_method(
  checker: Checker,
  ty: Ty,
  ability_id: Integer,
  index: Integer,
  name: Name,
  args: List of Arg,
  span: Span
)
  returns Done of Info
  purpose: A method of an ability the receiver's type has, with `Self` read as the receiver.

  let mutable updated be record(
    checker: checker,
    target: AbilityMethodTarget(ability_id: ability_id, index: index),
    span: name.span
  )
  let method be declare.ability_at(world: checker.world, id: ability_id).methods.at(
    index
  ) otherwise crash with "a method"
  let params be
    for each param in method.params
    collect NamedTy(name: param.name, ty: types.with_self(ty: param.ty, self_type: ty))
  let result be types.with_self_maybe(ty: method.result, self_type: ty)
  let failures be types.with_self_all(tys: method.failures, self_type: ty)
  change updated to check_args(
    checker: updated,
    params: params,
    args: args,
    span: span,
    name: name.text
  ).checker
  return Done(
    value: Info(ty: result otherwise Unit, failures: failures, function_id: nothing),
    checker: updated
  )
end

function default_literal(checker: Checker, ty: Ty) returns Checker
  purpose: A number literal whose type nothing fixed takes its default when a method is called.

  let builtins be checker.world.builtins
  match resolve(checker: checker, ty: ty)
    when Var(id) then
      match var_at(checker: checker, id: id).kind
        when IntegerVar then
          return set_var_binding(checker: checker, id: id, ty: builtin(builtins.integer))
        when DecimalVar then
          return set_var_binding(checker: checker, id: id, ty: builtin(builtins.decimal))
        when AnyVar then return checker
      end
    otherwise return checker
  end
end

function restore_bindings(checker: Checker, saved: List of VarInfo) returns Checker
  purpose: The variables as before a trial, their kinds kept, the trial's own variables dropped.

  let mutable vars: List of VarInfo be []
  let mutable index be 0
  for each old in saved
    let current be checker.vars.at(index) otherwise crash with "a variable"
    change vars to vars.append(current with binding: old.binding)
    change index to index + 1
  end
  return checker with vars: vars
end

function instantiate(checker: Checker, type_params: List of Integer)
  returns Done of List of Substitution
  purpose: Fresh variables for a function's `for any` parameters.

  let mutable updated be checker
  let mutable instances: List of Substitution be []
  for each param in type_params
    let var be fresh(checker: updated, kind: AnyVar)
    change updated to var.checker
    change instances to instances.append(Substitution(param: param, ty: var.value))
  end
  return Done(value: instances, checker: updated)
end

function choose_overload(checker: Checker, fallback: Integer, receiver: Ty, name: Text, span: Span)
  returns Done of Integer
  purpose: Among several methods of one name on one type, the one whose `self` fits the receiver.

  let head be types.head_type(
    resolve(checker: checker, ty: receiver)
  ) otherwise return Done(value: fallback, checker: checker)
  let candidates be declare.methods_of(world: checker.world, type_id: head, name: name)
  if candidates.length() is at most 1 then return Done(value: fallback, checker: checker) end
  let mutable updated be checker
  for each candidate in candidates
    let saved_vars be updated.vars
    let saved_diagnostics be updated.diagnostics
    let info be declare.function_at(world: updated.world, id: candidate)
    let instances be instantiate(checker: updated, type_params: info.type_params)
    let self_param be info.params.first() otherwise crash with "a self parameter"
    let self_ty be types.substitute(ty: self_param.ty, bindings: instances.value)
    let fits be assign(checker: instances.checker, actual: receiver, expected: self_ty, span: span)
    let reverted be fits.checker with diagnostics: saved_diagnostics
    change updated to restore_bindings(checker: reverted, saved: saved_vars)
    if fits.value then return Done(value: candidate, checker: updated) end
  end
  return Done(value: fallback, checker: updated)
end

function find_method(checker: Checker, ty: Ty, name: Text) returns maybe Method
  purpose: A method for a receiver type: declared on the type and its bases, then ability methods.

  let mutable current be resolve(checker: checker, ty: ty)
  repeat until false
    match current
      when App(id) then
        match declare.methods_of(world: checker.world, type_id: id, name: name).first()
          when some(function_id) then return DeclaredMethod(function_id: function_id)
          when nothing then change current to current
        end
        let found be ability_method(checker: checker, ty: current, name: name)
        if found is not nothing then return found end
        match declare.type_at(world: checker.world, id: id).kind
          when SubtypeKind(base) then change current to resolve(checker: checker, ty: base)
          otherwise return nothing
        end
      when Param then return ability_method(checker: checker, ty: current, name: name)
      when Union then return ability_method(checker: checker, ty: current, name: name)
      otherwise return nothing
    end
  end
  return nothing
end

function ability_method(checker: Checker, ty: Ty, name: Text) returns maybe Method
  purpose: A method of an ability the type has, by name.

  let mutable ability_id be 0
  for each abil in checker.world.abilities
    match method_position(methods: abil.methods, name: name)
      when some(index) then
        if has_ability(checker: checker, ty: ty, ability_id: ability_id) is true then
          return MethodOfAbility(ability_id: ability_id, index: index)
        end
      when nothing then change ability_id to ability_id
    end
    change ability_id to ability_id + 1
  end
  return nothing
end

function method_position(methods: List of AbilityMethod, name: Text) returns maybe Integer
  purpose: The position of an ability's method by name.

  let mutable index be 0
  for each method in methods
    if method.name is name then return index end
    change index to index + 1
  end
  return nothing
end

function records_result(info: FunctionInfo) returns Boolean
  purpose: Whether a library call's result type comes from the context alone (the VM decodes by it).

  if not info.is_library then return false end
  let result be info.result otherwise return false
  for each param in info.type_params
    if types.mentions_param(ty: result, param: param) then
      let in_params be
        for each named in info.params
        any types.mentions_param(ty: named.ty, param: param)
      if not info.capabilities.is_empty() or not in_params then return true end
    end
  end
  return false
end

function call_known(
  checker: Checker,
  id: Integer,
  receiver: maybe Receiver,
  args: List of Arg,
  span: Span,
  name_span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: Call a declared function: instantiate, check the arguments, charge the effects.

  let mutable updated be record(
    checker: checker,
    target: FunctionTarget(function_id: id),
    span: name_span
  )
  let info be declare.function_at(world: checker.world, id: id)
  let name be info.name
  if not inside(checker: updated, function_id: id) then
    change updated to note_deprecated(
      checker: updated,
      name: name,
      deprecation: info.deprecation,
      span: name_span
    )
  end
  let instances be instantiate(checker: updated, type_params: info.type_params)
  change updated to instances.checker
  let subst be instances.value
  let params be
    for each named in info.params
    collect NamedTy(name: named.name, ty: types.substitute(ty: named.ty, bindings: subst))
  let result be substitute_result(result: info.result, subst: subst)
  let failures be types.substitute_all(tys: info.failures, bindings: subst)
  change updated to note_result(checker: updated, info: info, result: result, span: span)
  let explicit be explicit_params(
    checker: updated,
    id: id,
    info: info,
    params: params,
    receiver: receiver,
    span: span,
    name_span: name_span
  )
  change updated to explicit.checker
  change updated to guide_result(checker: updated, result: result, expected: expected, span: span)
  let passed be check_args(
    checker: updated,
    params: explicit.value,
    args: args,
    span: span,
    name: name
  )
  change updated to check_matches_literal(checker: passed.checker, info: info, args: args)
  change updated to charge_effects(checker: updated, info: info, passed: passed.value, span: span)
  change updated to check_instance_constraints(
    checker: updated,
    instances: subst,
    name: name,
    span: span
  )
  return Done(
    value: Info(ty: result otherwise Unit, failures: failures, function_id: nothing),
    checker: updated
  )
end

function note_result(checker: Checker, info: FunctionInfo, result: maybe Ty, span: Span)
  returns Checker
  purpose: A call whose result type the context decides, noted for the VM once the body is finished.

  if not records_result(info) then return checker end
  let result_ty be result otherwise return checker
  return checker with results: checker.results.append(SpanTy(span: span, ty: result_ty))
end

function check_matches_literal(checker: Checker, info: FunctionInfo, args: List of Arg)
  returns Checker
  purpose: Decision K3: the literal pattern given to `matches` is checked here.

  if not info.is_library or not info.is_method or info.name is not "matches" then return checker end
  let arg be args.first() otherwise return checker
  return check_regex_literal(checker: checker, value: arg.value)
end

function substitute_result(result: maybe Ty, subst: List of Substitution) returns maybe Ty
  purpose: A result type with the instantiated parameters.

  match result
    when some(ty) then return types.substitute(ty: ty, bindings: subst)
    when nothing then return nothing
  end
end

function explicit_params(
  checker: Checker,
  id: Integer,
  info: FunctionInfo,
  params: List of NamedTy,
  receiver: maybe Receiver,
  span: Span,
  name_span: Span
)
  returns Done of List of NamedTy
  purpose: The parameters the arguments fill: the receiver fills `self`, and a method needs one.

  match receiver
    when some(found) then
      if not info.is_method then
        let updated be push_error(
          checker: checker,
          code: "not-a-method",
          message: "`{info.name}` is not a method",
          span: span,
          fix: "write `{info.name}(value, ...)`"
        )
        return Done(value: params, checker: updated)
      end
      let mutable updated be require_public(checker: checker, function_id: id, span: name_span)
      let self_param be params.first() otherwise crash with "a self parameter"
      let fits be assign(
        checker: updated,
        actual: found.ty,
        expected: self_param.ty,
        span: found.span
      )
      change updated to fits.checker
      if not fits.value then
        change updated to mismatch(
          checker: updated,
          actual: found.ty,
          expected: self_param.ty,
          span: found.span,
          what: "the receiver"
        )
      end
      return Done(value: params.drop(1), checker: updated)
    when nothing then
      if not info.is_method then return Done(value: params, checker: checker) end
      let updated be push_error(
        checker: checker,
        code: "method-call",
        message: "`{info.name}` is a method",
        span: span,
        fix: "call it on a value: `value.{info.name}(...)`"
      )
      return Done(value: params.drop(1), checker: updated)
  end
end

function guide_result(checker: Checker, result: maybe Ty, expected: maybe Ty, span: Span)
  returns Checker
  purpose: The expected type guides a generic result (`let users: List of User be json.parse(x)`).

  let result_ty be result otherwise return checker
  let wanted be expected otherwise return checker
  let resolved be resolve(checker: checker, ty: wanted)
  if var_id(resolved) is not nothing then return checker end
  return assign(checker: checker, actual: result_ty, expected: resolved, span: span).checker
end

function charge_effects(checker: Checker, info: FunctionInfo, passed: List of Integer, span: Span)
  returns Checker
  purpose: The callee's needs plus those of function-valued arguments, each required of the body.

  let mutable needed: List of Needed be []
  for each grant in info.capabilities
    change needed to needed.append(
      Needed(grant: grant, runtime_scoped: info.is_library, source: info.name)
    )
  end
  for each passed_id in passed
    let passed_info be declare.function_at(world: checker.world, id: passed_id)
    for each grant in passed_info.capabilities
      change needed to needed.append(
        Needed(grant: grant, runtime_scoped: passed_info.is_library, source: passed_info.name)
      )
    end
  end
  let mutable updated be checker
  if not needed.is_empty() then
    change updated to updated with effect_calls: updated.effect_calls + 1
  end
  for each need in needed
    change updated to require_capability(
      checker: updated,
      needed: need.grant,
      runtime_scoped: need.runtime_scoped,
      source: need.source,
      span: span
    )
  end
  return updated
end

function check_instance_constraints(
  checker: Checker,
  instances: List of Substitution,
  name: Text,
  span: Span
)
  returns Checker
  purpose: The constraints of the instantiated parameters, checked when known.

  let mutable updated be checker
  for each instance in instances
    for each ability_id in declare.constraints(world: checker.world, param: instance.param)
      change updated to require_ability(
        checker: updated,
        ty: instance.ty,
        ability_id: ability_id,
        span: span,
        what: "`{name}`"
      )
    end
  end
  return updated
end

function call_function_type(
  checker: Checker,
  signature: FunctionSignature,
  args: List of Arg,
  span: Span,
  name: Text
)
  returns Done of Info
  purpose: A call through a function type (a parameter passed by name): positional arguments.

  let mutable updated be checker
  let wanted be signature.params.length()
  if args.length() is not wanted then
    let plural be if wanted is 1 then "" otherwise "s" end
    let found be args.length()
    change updated to push_error(
      checker: updated,
      code: "argument-count",
      message: "`{name}` takes {wanted} argument{plural}, found {found}",
      span: span,
      fix: "pass one argument for each parameter of the function type"
    )
  end
  let mutable index be 0
  for each arg in args
    let param be signature.params.at(index) otherwise break
    match arg.name
      when some(label) then
        change updated to push_error(
          checker: updated,
          code: "argument-name",
          message: "arguments of a function passed by name are positional",
          span: label.span,
          fix: "drop the name"
        )
      when nothing then change updated to updated
    end
    change updated to infer_value(
      checker: updated,
      expr: arg.value,
      expected: param,
      what: "the argument"
    )
    change index to index + 1
  end
  if not signature.capabilities.is_empty() then
    change updated to updated with effect_calls: updated.effect_calls + 1
  end
  let info be Info(
    ty: signature.result otherwise Unit,
    failures: signature.failures,
    function_id: nothing
  )
  return Done(value: info, checker: updated)
end

function check_args(
  checker: Checker,
  params: List of NamedTy,
  args: List of Arg,
  span: Span,
  name: Text
)
  returns Done of List of Integer
  purpose: Arguments against parameters: one is positional, two or more are named in order (M4).

  if args.length() is not params.length() then
    let updated be argument_count(
      checker: checker,
      params: params,
      args: args,
      span: span,
      name: name
    )
    return Done(value: [], checker: infer_args_only(checker: updated, args: args))
  end
  let mutable updated be check_arg_names(checker: checker, params: params, args: args, name: name)
  let mutable passed: List of Integer be []
  let mutable index be 0
  for each arg in args
    let param be params.at(index) otherwise break
    let done be infer(checker: updated, expr: arg.value, expected: param.ty)
    let value_span be expr_span(arg.value)
    change updated to require_handled(checker: done.checker, info: done.value, span: value_span)
    match done.value.function_id
      when some(function_id) then change passed to passed.append(function_id)
      when nothing then change passed to passed
    end
    change updated to expect(
      checker: updated,
      actual: done.value.ty,
      expected: param.ty,
      span: value_span,
      what: "the argument"
    )
    change index to index + 1
  end
  return Done(value: passed, checker: updated)
end

function argument_count(
  checker: Checker,
  params: List of NamedTy,
  args: List of Arg,
  span: Span,
  name: Text
)
  returns Checker
  purpose: The error for a call with the wrong number of arguments.

  let wanted be for each param in params collect param.name
  let total be params.length()
  let plural be if total is 1 then "" otherwise "s" end
  let joined be wanted.join(", ")
  let found be args.length()
  let message be
    if params.is_empty() then "`{name}` takes no arguments"
    otherwise "`{name}` takes {total} argument{plural} ({joined}), found {found}"
    end
  let named be for each param_name in wanted collect "{param_name}: ..."
  let named_joined be named.join(", ")
  let fix be
    match wanted.length()
      when 0 then "write `{name}()`"
      when 1 then "write `{name}(value)`"
      otherwise "write `{name}({named_joined})`"
    end
  return push_error(
    checker: checker,
    code: "argument-count",
    message: message,
    span: span,
    fix: fix
  )
end

function check_arg_names(checker: Checker, params: List of NamedTy, args: List of Arg, name: Text)
  returns Checker
  purpose: One argument is unnamed; several are named after their parameters, in order.

  let mutable updated be checker
  if params.length() is 1 then
    let single be args.first() otherwise return updated
    match single.name
      when some(label) then
        return push_error(
          checker: updated,
          code: "argument-name",
          message: "a call with one argument does not name it",
          span: label.span,
          fix: "drop the name"
        )
      when nothing then return updated
    end
  end
  let order be for each param in params collect "{param.name}:"
  let order_joined be order.join(" ")
  let names be for each param in params collect param.name
  let mutable index be 0
  for each arg in args
    let param be params.at(index) otherwise break
    match arg.name
      when nothing then
        change updated to push_error(
          checker: updated,
          code: "argument-name",
          message: "a call with two or more arguments names every argument",
          span: arg.span,
          fix: "write `{param.name}: ...`"
        )
      when some(label) where label.text is not param.name then
        if names.contains(label.text) then
          change updated to push_error(
            checker: updated,
            code: "argument-order",
            message: "`{label.text}` is out of order",
            span: label.span,
            fix: "the arguments of `{name}` are {order_joined}"
          )
        otherwise
          change updated to push_error(
            checker: updated,
            code: "argument-name",
            message: "`{name}` has no parameter named `{label.text}`",
            span: label.span,
            fix: "the arguments are {order_joined}"
          )
        end
      otherwise change updated to updated
    end
    change index to index + 1
  end
  return updated
end

function check_regex_literal(checker: Checker, value: Expr) returns Checker
  purpose: A literal regular expression (decision K3): what the engine would refuse is refused here.

  match refine.literal_of(value)
    when some(TextValue(text: pattern)) then
      let detail be refine.regex_error(pattern) otherwise return checker
      return push_error(
        checker: checker,
        code: "regex-invalid",
        message: "this is not a valid regular expression: {detail}",
        span: expr_span(value),
        fix: "the syntax is that of the Rust regex crate: no backreferences, no look-around"
      )
    otherwise return checker
  end
end

function check_text_literal(checker: Checker, type_id: Integer, value: Expr) returns Checker
  purpose: `Pattern`, `Url` and `Path` literals (decisions N2 and K3), checked as the run time does.

  let text be
    match refine.literal_of(value)
      when some(TextValue(text)) then text
      otherwise return checker
    end
  let info be declare.type_at(world: checker.world, id: type_id)
  let owner be declare.module_at(world: checker.world, id: info.owner).name
  if owner is "std.regex" and info.name is "Pattern" then
    return check_regex_literal(checker: checker, value: value)
  end
  if owner is "std.http" and info.name is "Url" and not refine.is_url(text) then
    return invalid_literal(
      checker: checker,
      value: value,
      message: "this is not an absolute URL",
      fix: "write a scheme and a host: `https://example.com/path`"
    )
  end
  let bad_path be text.is_empty() or text.contains("\n")
  if owner is "std.filesystem" and info.name is "Path" and bad_path then
    return invalid_literal(
      checker: checker,
      value: value,
      message: "this is not a path",
      fix: "write a non-empty path without control characters"
    )
  end
  return checker
end

function invalid_literal(checker: Checker, value: Expr, message: Text, fix: Text) returns Checker
  purpose: The error for a literal the run time would refuse.

  return push_error(
    checker: checker,
    code: "invalid-literal",
    message: message,
    span: expr_span(value),
    fix: fix
  )
end

function integer_arg(args: List of Arg, index: Integer) returns maybe Integer
  purpose: The integer literal of an argument, when it is one.

  let arg be args.at(index) otherwise return nothing
  match refine.literal_of(arg.value)
    when some(IntegerValue(value)) then return value
    otherwise return nothing
  end
end

function zero_padded(value: Integer, width: Integer) returns Text
  purpose: A number padded with zeros to a width, the sign first.

  let digits be value.absolute().to_text()
  let sign be if value is less than 0 then "-" otherwise "" end
  let mutable padded be digits
  repeat until padded.length() + sign.length() is at least width
    change padded to "0{padded}"
  end
  return "{sign}{padded}"
end

function check_date_literal(checker: Checker, type_id: Integer, args: List of Arg, span: Span)
  returns Checker
  purpose: `Date(year:, month:, day:)` from literals: the day must exist in the month (sketch 4).

  let info be declare.type_at(world: checker.world, id: type_id)
  if info.name is not "Date" then return checker end
  if declare.module_at(world: checker.world, id: info.owner).name is not "std.time" then
    return checker
  end
  let year be integer_arg(args: args, index: 0) otherwise return checker
  let month be integer_arg(args: args, index: 1) otherwise return checker
  let day be integer_arg(args: args, index: 2) otherwise return checker
  if month is less than 1 or month is greater than 12 or day is less than 1 then return checker end
  let length be refine.days_in_month(year: year, month: month)
  if day is at most length then return checker end
  let shown_year be zero_padded(value: year, width: 4)
  let shown_month be zero_padded(value: month, width: 2)
  let shown_day be zero_padded(value: day, width: 2)
  return push_error(
    checker: checker,
    code: "constraint-violation",
    message: "{shown_year}-{shown_month}-{shown_day} is not a date: the month has {length} days",
    span: span,
    fix: "write a day the month has"
  )
end

function require_capability(
  checker: Checker,
  needed: Grant,
  runtime_scoped: Boolean,
  source: Text,
  span: Span
)
  returns Checker
  purpose: A call's capability must be covered by the body's grant.

  if effects.covered(
    granted: checker.context.capabilities,
    needed: needed,
    runtime_scoped: runtime_scoped
  ) then
    return checker
  end
  let spelling be effects.spelling(needed)
  let owner be checker.context.name
  let fix be
    if checker.context.is_test then "add `needs {spelling}` after the test's name"
    otherwise "add `needs {spelling}` to the signature of `{owner}`"
    end
  return push_error(
    checker: checker,
    code: "capability-missing",
    message: "`{source}` needs `{spelling}`, which `{owner}` does not declare",
    span: span,
    fix: fix
  )
end

function did_you_mean(close: maybe Text) returns maybe Text
  purpose: `did you mean ...?` for a close name.

  let name be close otherwise return nothing
  return "did you mean `{name}`?"
end

function suggest_function(checker: Checker, name: Text) returns maybe Text
  purpose: A module function called without its namespace, or the closest function of this module.

  let info be module_info(checker)
  for each namespace in info.imports.keys()
    let target be info.imports.get(namespace) otherwise continue
    if declare.lookup_function(world: checker.world, owner: target, name: name) is not nothing then
      return "write `{namespace}.{name}(...)`"
    end
  end
  return did_you_mean(suggest.closest(name: name, candidates: info.functions.keys()))
end

function suggest_module_function(checker: Checker, target: Integer, name: Text) returns maybe Text
  purpose: The closest plain function of a module.

  let info be declare.module_at(world: checker.world, id: target)
  let mutable names: List of Text be []
  for each candidate in info.functions.keys()
    let ids be info.functions.get(candidate) otherwise []
    let plain_function be
      for each id in ids
      any not declare.function_at(world: checker.world, id: id).is_method
    if plain_function then change names to names.append(candidate) end
  end
  return did_you_mean(suggest.closest(name: name, candidates: names))
end

function suggest_method(checker: Checker, ty: Ty, name: Text) returns maybe Text
  purpose: The closest method of the receiver's base type.

  let head be types.head_type(base_of(checker: checker, ty: ty)) otherwise return nothing
  let prefix be "{head}:"
  let mutable names: List of Text be []
  for each key in checker.world.method_index.keys()
    if key.starts_with(prefix) then change names to names.append(key.drop(prefix.length())) end
  end
  return did_you_mean(suggest.closest(name: name, candidates: names))
end

function suggest_binding(checker: Checker, name: Text) returns maybe Text
  purpose: The closest binding in scope, for an unknown name.

  return did_you_mean(suggest.closest(name: name, candidates: all_binding_names(checker)))
end

function suggest_field(checker: Checker, ty: Ty, name: Text) returns Text
  purpose: The fix for an unknown field: the closest field of the record, or its fields.

  let fields be field_names(checker: checker, ty: ty)
  match suggest.closest(name: name, candidates: fields)
    when some(close) then return "did you mean `{close}`?"
    when nothing then
      if fields.is_empty() then return "read a field of a record" end
      let quoted be suggest.quoted(fields)
      return "name one of {quoted}"
  end
end

function suggest_variant(checker: Checker, ty: Ty, name: Text) returns Text
  purpose: The fix for an unknown variant in a pattern: the closest variant, or the variants.

  let variants be variant_names(checker: checker, ty: ty)
  match suggest.closest(name: name, candidates: variants)
    when some(close) then return "did you mean `{close}`?"
    when nothing then
      if variants.is_empty() then return "match a value of a sum type" end
      let quoted be suggest.quoted(variants)
      return "write one of {quoted}"
  end
end

function field_names(checker: Checker, ty: Ty) returns List of Text
  purpose: The field names of a record type.

  let head be types.head_type(base_of(checker: checker, ty: ty)) otherwise return []
  match declare.type_at(world: checker.world, id: head).kind
    when RecordKind(fields) then return for each field in fields collect field.name
    otherwise return []
  end
end

function variant_names(checker: Checker, ty: Ty) returns List of Text
  purpose: The variant names of a sum type.

  let head be types.head_type(base_of(checker: checker, ty: ty)) otherwise return []
  match declare.type_at(world: checker.world, id: head).kind
    when SumKind(variants) then return for each variant in variants collect variant.name
    otherwise return []
  end
end

function ability_fix(checker: Checker, ty: Ty, ability_name: Text) returns Text
  purpose: The fix for a type without an ability: `can` for the program's own types, else another.

  let head be types.head_type(base_of(checker: checker, ty: ty))
  let own be
    match head
      when some(id) then
        not declare.module_at(
          world: checker.world,
          id: declare.type_at(world: checker.world, id: id).owner
        ).is_library
      when nothing then false
    end
  if own then
    let shown be show(checker: checker, ty: ty)
    return "add `can {ability_name}` to `{shown}`"
  end
  return "use a type that has `{ability_name}`"
end

function declared_failure_variant(checker: Checker, variants: List of VariantRef)
  returns maybe VariantRef
  purpose: Inside `fail with`, the declared failure types decide between the sum types.

  let mutable declared: List of VariantRef be []
  for each variant in variants
    let listed be
      for each failing in checker.context.failures
      any types.head_type(resolve(checker: checker, ty: failing)) is variant.type_id
    if listed then change declared to declared.append(variant) end
  end
  if declared.length() is 1 then return declared.first() end
  return nothing
end

function infer_construct(
  checker: Checker,
  name: TypeName,
  args: List of Arg,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: `Name(args)`: a variant with fields, a record, a pair, a subtype from one value.

  let variants be declare.lookup_variant(
    world: checker.world,
    owner: checker.module_id,
    name: name.text
  )
  if not variants.is_empty() then
    return construct_variant(
      checker: checker,
      name: name,
      args: args,
      span: span,
      expected: expected,
      variants: variants
    )
  end
  match declare.lookup_type(world: checker.world, owner: checker.module_id, name: name.text)
    when some(type_id) then
      return construct_type(checker: checker, name: name, args: args, span: span, type_id: type_id)
    when nothing then
      let fix be declare.suggest_type(
        world: checker.world,
        owner: checker.module_id,
        name: name.text
      )
      let updated be push_error(
        checker: checker,
        code: "unknown-type",
        message: "unknown type `{name.text}`",
        span: name.span,
        fix: fix
      )
      return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
  end
end

function construct_variant(
  checker: Checker,
  name: TypeName,
  args: List of Arg,
  span: Span,
  expected: maybe Ty,
  variants: List of VariantRef
)
  returns Done of Info
  purpose: A variant with fields, chosen by the expected type or the declared failures when shared.

  let mutable chosen: maybe VariantRef be variants.first()
  if variants.length() is greater than 1 then
    match expected_head(checker: checker, expected: expected)
      when some(type_id) then
        change chosen to variant_with_type(candidates: variants, type_id: type_id)
      when nothing then
        change chosen to declared_failure_variant(checker: checker, variants: variants)
    end
  end
  let variant be chosen otherwise return ambiguous_construct(
    checker: checker,
    name: name,
    args: args
  )
  let mutable updated be record(
    checker: checker,
    target: VariantTarget(type_id: variant.type_id, index: variant.index),
    span: name.span
  )
  let info be declare.type_at(world: checker.world, id: variant.type_id)
  change updated to note_deprecated(
    checker: updated,
    name: info.name,
    deprecation: info.deprecation,
    span: name.span
  )
  let fields be
    match info.kind
      when SumKind(variants: declared) then
        variant_fields_at(variants: declared, index: variant.index)
      otherwise []
    end
  let args_tys be fresh_args(checker: updated, count_of: info.params.length())
  let failures be construct_fields(
    checker: args_tys.checker,
    name: name.text,
    type_id: variant.type_id,
    type_args: args_tys.value,
    fields: fields,
    args: args,
    span: span
  )
  let ty be App(id: variant.type_id, args: args_tys.value)
  return Done(
    value: Info(ty: ty, failures: failures.value, function_id: nothing),
    checker: failures.checker
  )
end

function variant_fields_at(variants: List of VariantInfo, index: Integer) returns List of FieldInfo
  purpose: The fields of a variant by position.

  let variant be variants.at(index) otherwise return []
  return variant.fields
end

function ambiguous_construct(checker: Checker, name: TypeName, args: List of Arg)
  returns Done of Info
  purpose: A variant name shared by several types that nothing decides.

  let updated be push_error(
    checker: checker,
    code: "ambiguous-variant",
    message: "`{name.text}` is a variant of several types; the context does not say which",
    span: name.span,
    fix: "annotate the binding: `let value: Type be {name.text}(...)`"
  )
  return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
end

function construct_type(
  checker: Checker,
  name: TypeName,
  args: List of Arg,
  span: Span,
  type_id: Integer
)
  returns Done of Info
  purpose: A record, a pair, a subtype from one value; a sum or an opaque type is not constructed.

  let mutable updated be record(
    checker: checker,
    target: TypeTarget(type_id: type_id),
    span: name.span
  )
  let info be declare.type_at(world: checker.world, id: type_id)
  change updated to note_deprecated(
    checker: updated,
    name: name.text,
    deprecation: info.deprecation,
    span: name.span
  )
  let args_tys be fresh_args(checker: updated, count_of: info.params.length())
  change updated to args_tys.checker
  if type_id is checker.world.builtins.pair then
    return construct_pair(
      checker: updated,
      params: info.params,
      args: args,
      span: span,
      type_id: type_id,
      args_tys: args_tys.value
    )
  end
  match info.kind
    when RecordKind(fields) then
      return construct_record(
        checker: updated,
        name: name,
        fields: fields,
        args: args,
        span: span,
        type_id: type_id,
        args_tys: args_tys.value
      )
    when SubtypeKind(base, refinement) then
      return construct_subtype(
        checker: updated,
        name: name,
        args: args,
        span: span,
        type_id: type_id,
        base: base,
        refinement: refinement
      )
    when SumKind(variants) then
      return construct_sum_error(checker: updated, name: name, variants: variants, args: args)
    otherwise return construct_opaque_error(checker: updated, name: name, args: args)
  end
end

function construct_sum_error(
  checker: Checker,
  name: TypeName,
  variants: List of VariantInfo,
  args: List of Arg
)
  returns Done of Info
  purpose: A sum type named where a value is constructed: name one of its variants instead.

  let names be for each variant in variants collect variant.name
  let quoted be suggest.quoted(names)
  let updated be push_error(
    checker: checker,
    code: "construct-sum",
    message: "`{name.text}` is a sum type; construct one of its variants",
    span: name.span,
    fix: "write one of {quoted}"
  )
  return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
end

function construct_opaque_error(checker: Checker, name: TypeName, args: List of Arg)
  returns Done of Info
  purpose: An opaque type named where a value is constructed: only its module makes one.

  let updated be push_error(
    checker: checker,
    code: "construct-opaque",
    message: "`{name.text}` cannot be constructed from fields",
    span: name.span,
    fix: "call a function of its module that returns a `{name.text}`"
  )
  return Done(value: plain(ErrorTy), checker: infer_args_only(checker: updated, args: args))
end

function construct_pair(
  checker: Checker,
  params: List of Integer,
  args: List of Arg,
  span: Span,
  type_id: Integer,
  args_tys: List of Ty
)
  returns Done of Info
  purpose: `Pair(left: ..., right: ...)`: a record of two parameters.

  let first_param be params.at(0) otherwise crash with "a pair parameter"
  let second_param be params.at(1) otherwise crash with "a pair parameter"
  let fields be [
    FieldInfo(
      name: "left",
      ty: Param(id: first_param),
      refinement: nothing,
      external_name: nothing,
      span: span
    ),
    FieldInfo(
      name: "right",
      ty: Param(id: second_param),
      refinement: nothing,
      external_name: nothing,
      span: span
    )
  ]
  let failures be construct_fields(
    checker: checker,
    name: "Pair",
    type_id: type_id,
    type_args: args_tys,
    fields: fields,
    args: args,
    span: span
  )
  let ty be App(id: type_id, args: args_tys)
  return Done(
    value: Info(ty: ty, failures: failures.value, function_id: nothing),
    checker: failures.checker
  )
end

function construct_record(
  checker: Checker,
  name: TypeName,
  fields: List of FieldInfo,
  args: List of Arg,
  span: Span,
  type_id: Integer,
  args_tys: List of Ty
)
  returns Done of Info
  purpose: A record from its fields; a `Date` from literals is checked as a date.

  let failures be construct_fields(
    checker: checker,
    name: name.text,
    type_id: type_id,
    type_args: args_tys,
    fields: fields,
    args: args,
    span: span
  )
  let updated be check_date_literal(
    checker: failures.checker,
    type_id: type_id,
    args: args,
    span: span
  )
  let ty be App(id: type_id, args: args_tys)
  return Done(value: Info(ty: ty, failures: failures.value, function_id: nothing), checker: updated)
end

function construct_subtype(
  checker: Checker,
  name: TypeName,
  args: List of Arg,
  span: Span,
  type_id: Integer,
  base: Ty,
  refinement: maybe Expr
)
  returns Done of Info
  purpose: `Port(8080)`: one value of the base type; a literal is decided here, else at run time.

  let ty be App(id: type_id, args: [])
  if args.length() is not 1 then
    let updated be push_error(
      checker: checker,
      code: "argument-count",
      message: "`{name.text}` is built from one value",
      span: span,
      fix: "write `{name.text}(value)`"
    )
    return Done(value: plain(ty), checker: infer_args_only(checker: updated, args: args))
  end
  let arg be args.first() otherwise crash with "an argument"
  let mutable updated be checker
  match arg.name
    when some(label) then
      change updated to push_error(
        checker: updated,
        code: "argument-name",
        message: "a construction from one value does not name it",
        span: label.span,
        fix: "drop the name"
      )
    when nothing then change updated to updated
  end
  change updated to infer_value(
    checker: updated,
    expr: arg.value,
    expected: base,
    what: "the value"
  )
  let mutable failures: List of Ty be []
  match refinement
    when some(condition) then
      let checked be check_subtype_value(
        checker: updated,
        name: name,
        condition: condition,
        value: arg.value
      )
      change updated to checked.checker
      change failures to checked.value
    when nothing then change updated to updated
  end
  change updated to check_text_literal(checker: updated, type_id: type_id, value: arg.value)
  return Done(value: Info(ty: ty, failures: failures, function_id: nothing), checker: updated)
end

function check_subtype_value(checker: Checker, name: TypeName, condition: Expr, value: Expr)
  returns Done of List of Ty
  purpose: The refinement of a subtype on its value: a literal decided now, a variable at run time.

  let violation be builtin(checker.world.builtins.constraint_violation)
  match refine.literal_of(value)
    when some(literal) then
      match refine.evaluate(condition: condition, name: "value", value: literal)
        when Holds then return Done(value: [], checker: checker)
        when Fails then
          let updated be push_error(
            checker: checker,
            code: "constraint-violation",
            message: "this value does not satisfy the condition of `{name.text}`",
            span: expr_span(value),
            fix: "write a value the condition of `{name.text}` accepts"
          )
          return Done(value: [], checker: updated)
        when Unknown then return Done(value: [violation], checker: checker)
      end
    when nothing then return Done(value: [violation], checker: checker)
  end
end

function construct_fields(
  checker: Checker,
  name: Text,
  type_id: Integer,
  type_args: List of Ty,
  fields: List of FieldInfo,
  args: List of Arg,
  span: Span
)
  returns Done of List of Ty
  purpose: The fields of a record or variant construction, and the errors it can raise at run time.

  let params be declare.type_at(world: checker.world, id: type_id).params
  let subst be param_bindings(params: params, args: type_args)
  if args.length() is not fields.length() then
    let updated be field_count(checker: checker, name: name, fields: fields, args: args, span: span)
    return Done(value: [], checker: infer_args_only(checker: updated, args: args))
  end
  let mutable updated be checker
  let mutable failures: List of Ty be []
  let mutable index be 0
  for each arg in args
    let field be fields.at(index) otherwise break
    change updated to check_field_label(
      checker: updated,
      name: name,
      fields: fields,
      field: field,
      arg: arg
    )
    let field_ty be types.substitute(ty: field.ty, bindings: subst)
    change updated to infer_value(
      checker: updated,
      expr: arg.value,
      expected: field_ty,
      what: "the field value"
    )
    match field.refinement
      when some(condition) then
        let checked be check_field_refinement(
          checker: updated,
          field: field.name,
          condition: condition,
          value: arg.value,
          failures: failures
        )
        change updated to checked.checker
        change failures to checked.value
      when nothing then change updated to updated
    end
    change index to index + 1
  end
  return Done(value: failures, checker: updated)
end

function field_count(
  checker: Checker,
  name: Text,
  fields: List of FieldInfo,
  args: List of Arg,
  span: Span
)
  returns Checker
  purpose: The error for a construction with the wrong number of arguments.

  let wanted be for each field in fields collect "{field.name}:"
  let joined be wanted.join(" ")
  let total be fields.length()
  let found be args.length()
  let field_plural be if total is 1 then "" otherwise "s" end
  let arg_plural be if found is 1 then "" otherwise "s" end
  return push_error(
    checker: checker,
    code: "argument-count",
    message: "`{name}` has {total} field{field_plural}, found {found} argument{arg_plural}",
    span: span,
    fix: "the fields are {joined}"
  )
end

function check_field_label(
  checker: Checker,
  name: Text,
  fields: List of FieldInfo,
  field: FieldInfo,
  arg: Arg
)
  returns Checker
  purpose: A construction names every field, in declaration order.

  let order be for each declared in fields collect "{declared.name}:"
  let joined be order.join(" ")
  let names be for each declared in fields collect declared.name
  match arg.name
    when nothing then
      return push_error(
        checker: checker,
        code: "argument-name",
        message: "a construction names every field",
        span: arg.span,
        fix: "write `{field.name}: ...`"
      )
    when some(label) where label.text is not field.name then
      if names.contains(label.text) then
        return push_error(
          checker: checker,
          code: "argument-order",
          message: "`{label.text}` is out of order",
          span: label.span,
          fix: "the fields of `{name}` are {joined}"
        )
      end
      return push_error(
        checker: checker,
        code: "unknown-field",
        message: "`{name}` has no field named `{label.text}`",
        span: label.span,
        fix: "the fields are {joined}"
      )
    otherwise return checker
  end
end

function with_violation(checker: Checker, failures: List of Ty) returns List of Ty
  purpose: The failures with `ConstraintViolation` added once.

  let violation be builtin(checker.world.builtins.constraint_violation)
  if failures.contains(violation) then return failures end
  return failures.append(violation)
end

function check_field_refinement(
  checker: Checker,
  field: Text,
  condition: Expr,
  value: Expr,
  failures: List of Ty
)
  returns Done of List of Ty
  purpose: A refined field: a literal is checked now, anything else at run time, which can fail.

  match refine.literal_of(value)
    when some(literal) then
      match refine.evaluate(condition: condition, name: field, value: literal)
        when Holds then return Done(value: failures, checker: checker)
        when Fails then
          let updated be push_error(
            checker: checker,
            code: "constraint-violation",
            message: "this value does not satisfy the condition on `{field}`",
            span: expr_span(value),
            fix: "write a value the condition on `{field}` accepts"
          )
          return Done(value: failures, checker: updated)
        when Unknown then
          return Done(value: with_violation(checker: checker, failures: failures), checker: checker)
      end
    when nothing then
      return Done(value: with_violation(checker: checker, failures: failures), checker: checker)
  end
end

function infer_otherwise(
  checker: Checker,
  value: Expr,
  fallback: Outcome,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: `value otherwise fallback`: a call's failure or the absence of a `maybe` value, handled.

  let done be infer(checker: checker, expr: value, expected: expected)
  let info be done.value
  let ty be resolve(checker: done.checker, ty: info.ty)
  let fallible be not info.failures.is_empty()
  let mutable updated be record(
    checker: done.checker,
    target: OtherwiseTarget(fallible: fallible),
    span: span
  )
  let mutable inner be ty
  match ty
    when MaybeTy(inner: present) then
      if fallible then
        change inner to ty
      otherwise
        change inner to present
      end
    otherwise
      if not fallible and not types.is_error(ty) then
        let shown be show(checker: updated, ty: ty)
        let after_plain be "`otherwise` after a value that cannot fail and is not optional"
        change updated to push_error(
          checker: updated,
          code: "superfluous-otherwise",
          message: "{after_plain} (it is `{shown}`)",
          span: span,
          fix: "remove `otherwise` and what follows it"
        )
      end
  end
  change updated to check_fallback(
    checker: updated,
    info: info,
    ty: ty,
    inner: inner,
    fallback: fallback
  )
  return Done(value: plain(inner), checker: updated)
end

function check_fallback(checker: Checker, info: Info, ty: Ty, inner: Ty, fallback: Outcome)
  returns Checker
  purpose: What follows `otherwise`: a default of the inner type, or a way out.

  match fallback
    when ValueOutcome(value) then
      return infer_value(checker: checker, expr: value, expected: inner, what: "the default")
    when FailOutcome(value: nothing, span) then
      if info.failures.is_empty() then
        if not is_maybe(ty) then return checker end
        let needs_error be "`otherwise fail` needs an error to pass on"
        return push_error(
          checker: checker,
          code: "otherwise-fail-maybe",
          message: "{needs_error}, but this value is optional, not fallible",
          span: span,
          fix: "write `otherwise fail with Error(...)` or give a default"
        )
      end
      return check_error_declared(checker: checker, ty: Union(members: info.failures), span: span)
    when FailOutcome(value: some(error), span) then
      let done be infer(checker: checker, expr: error, expected: nothing)
      let updated be require_handled(
        checker: done.checker,
        info: done.value,
        span: expr_span(error)
      )
      return check_error_declared(checker: updated, ty: done.value.ty, span: span)
    when ReturnOutcome(value, span) then
      return check_return(checker: checker, value: value, span: span)
    when CrashOutcome(message) then
      let text be builtin(checker.world.builtins.text)
      return infer_value(checker: checker, expr: message, expected: text, what: "the crash message")
    when BreakOutcome(span) then return outside_loop(checker: checker, span: span)
    when ContinueOutcome(span) then return outside_loop(checker: checker, span: span)
  end
end

function spelling_of(operator: BinaryOp) returns Text
  purpose: How an operator is written.

  match operator
    when Add then return "+"
    when Subtract then return "-"
    when Multiply then return "*"
    when Divide then return "/"
    when Remainder then return "remainder"
    when Power then return "power"
    when Is then return "is"
    when IsNot then return "is not"
    when IsLessThan then return "is less than"
    when IsAtMost then return "is at most"
    when IsGreaterThan then return "is greater than"
    when IsAtLeast then return "is at least"
    when And then return "and"
    when Or then return "or"
  end
end

function infer_binary(
  checker: Checker,
  operator: BinaryOp,
  left: Expr,
  right: Expr,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: A binary operation by its operator: logic, equality, comparison or arithmetic.

  match operator
    when And then return infer_logic(checker: checker, left: left, right: right)
    when Or then return infer_logic(checker: checker, left: left, right: right)
    when Is then return infer_equality(checker: checker, left: left, right: right, span: span)
    when IsNot then return infer_equality(checker: checker, left: left, right: right, span: span)
    when IsLessThan then
      return infer_comparison(
        checker: checker,
        operator: operator,
        left: left,
        right: right,
        span: span
      )
    when IsAtMost then
      return infer_comparison(
        checker: checker,
        operator: operator,
        left: left,
        right: right,
        span: span
      )
    when IsGreaterThan then
      return infer_comparison(
        checker: checker,
        operator: operator,
        left: left,
        right: right,
        span: span
      )
    when IsAtLeast then
      return infer_comparison(
        checker: checker,
        operator: operator,
        left: left,
        right: right,
        span: span
      )
    otherwise
      return infer_arithmetic(
        checker: checker,
        operator: operator,
        left: left,
        right: right,
        span: span,
        expected: expected
      )
  end
end

function infer_logic(checker: Checker, left: Expr, right: Expr) returns Done of Info
  purpose: `and` and `or`: two conditions.

  let mutable updated be check_condition(checker: checker, condition: left)
  change updated to check_condition(checker: updated, condition: right)
  return Done(value: plain(builtin(checker.world.builtins.boolean)), checker: updated)
end

function infer_equality(checker: Checker, left: Expr, right: Expr, span: Span) returns Done of Info
  purpose: `is` and `is not`: both sides of one type, which must be comparable for equality.

  let builtins be checker.world.builtins
  let left_done be infer(checker: checker, expr: left, expected: nothing)
  let mutable updated be require_handled(
    checker: left_done.checker,
    info: left_done.value,
    span: expr_span(left)
  )
  let right_done be infer(checker: updated, expr: right, expected: left_done.value.ty)
  let right_span be expr_span(right)
  change updated to require_handled(
    checker: right_done.checker,
    info: right_done.value,
    span: right_span
  )
  let left_ty be resolve(checker: updated, ty: left_done.value.ty)
  let forward be assign(
    checker: updated,
    actual: right_done.value.ty,
    expected: left_ty,
    span: right_span
  )
  change updated to forward.checker
  let mutable ok be forward.value
  if not ok then
    let backward be assign(
      checker: updated,
      actual: left_done.value.ty,
      expected: right_done.value.ty,
      span: right_span
    )
    change updated to backward.checker
    change ok to backward.value
  end
  if not ok then
    change updated to mismatch(
      checker: updated,
      actual: right_done.value.ty,
      expected: left_ty,
      span: right_span,
      what: "the right side of `is`"
    )
  end
  change updated to require_ability(
    checker: updated,
    ty: left_done.value.ty,
    ability_id: builtins.equal,
    span: span,
    what: "`is`"
  )
  return Done(value: plain(builtin(builtins.boolean)), checker: updated)
end

function infer_comparison(checker: Checker, operator: BinaryOp, left: Expr, right: Expr, span: Span)
  returns Done of Info
  purpose: An ordering comparison: both sides of one type, which must have `Compare`.

  let builtins be checker.world.builtins
  let left_done be infer(checker: checker, expr: left, expected: nothing)
  let left_span be expr_span(left)
  let mutable updated be require_handled(
    checker: left_done.checker,
    info: left_done.value,
    span: left_span
  )
  let right_done be infer(checker: updated, expr: right, expected: left_done.value.ty)
  let right_span be expr_span(right)
  change updated to require_handled(
    checker: right_done.checker,
    info: right_done.value,
    span: right_span
  )
  let forward be assign(
    checker: updated,
    actual: right_done.value.ty,
    expected: left_done.value.ty,
    span: right_span
  )
  change updated to forward.checker
  let mutable ok be forward.value
  if not ok then
    let backward be assign(
      checker: updated,
      actual: left_done.value.ty,
      expected: right_done.value.ty,
      span: left_span
    )
    change updated to backward.checker
    change ok to backward.value
  end
  if not ok then
    change updated to mismatch(
      checker: updated,
      actual: right_done.value.ty,
      expected: left_done.value.ty,
      span: right_span,
      what: "the right side of the comparison"
    )
  end
  let spelled be spelling_of(operator)
  change updated to require_ability(
    checker: updated,
    ty: left_done.value.ty,
    ability_id: builtins.compare,
    span: span,
    what: "`{spelled}`"
  )
  return Done(value: plain(builtin(builtins.boolean)), checker: updated)
end

function infer_arithmetic(
  checker: Checker,
  operator: BinaryOp,
  left: Expr,
  right: Expr,
  span: Span,
  expected: maybe Ty
)
  returns Done of Info
  purpose: Arithmetic: numbers of one base type; the exponent of `power` is an Integer or a Float.

  let builtins be checker.world.builtins
  let numeric_expected be numeric_expectation(checker: checker, expected: expected)
  let left_done be infer(checker: checker, expr: left, expected: numeric_expected)
  let mutable updated be require_handled(
    checker: left_done.checker,
    info: left_done.value,
    span: expr_span(left)
  )
  let left_ty be resolve(checker: updated, ty: left_done.value.ty)
  if operator is Power then
    let base be base_of(checker: updated, ty: left_ty)
    let exponent be
      if is_builtin(checker: updated, ty: base, id: builtins.float) then builtin(builtins.float)
      otherwise builtin(builtins.integer)
      end
    change updated to infer_value(
      checker: updated,
      expr: right,
      expected: exponent,
      what: "the exponent"
    )
  otherwise
    let right_done be infer(checker: updated, expr: right, expected: left_ty)
    let right_span be expr_span(right)
    change updated to require_handled(
      checker: right_done.checker,
      info: right_done.value,
      span: right_span
    )
    let left_base be base_of(checker: updated, ty: left_ty)
    let right_base be base_of(checker: updated, ty: right_done.value.ty)
    let unified be unify(checker: updated, left: left_base, right: right_base, span: span)
    change updated to unified.checker
    if not unified.value then
      change updated to mismatch(
        checker: updated,
        actual: right_done.value.ty,
        expected: left_ty,
        span: right_span,
        what: "the right operand"
      )
    end
  end
  let result be base_of(checker: updated, ty: left_ty)
  return arithmetic_result(
    checker: updated,
    operator: operator,
    result: result,
    left: left,
    span: span
  )
end

function arithmetic_result(checker: Checker, operator: BinaryOp, result: Ty, left: Expr, span: Span)
  returns Done of Info
  purpose: The result of arithmetic: the base type, which must be numeric; `/` divides no Integers.

  let builtins be checker.world.builtins
  let resolved be resolve(checker: checker, ty: result)
  let known be var_id(resolved) is nothing and not types.is_error(resolved)
  if known and not is_numeric(checker: checker, ty: resolved) then
    let shown be show(checker: checker, ty: resolved)
    let spelled be spelling_of(operator)
    let mutable fix be "arithmetic works on Integer, Decimal and Float"
    if is_builtin(checker: checker, ty: resolved, id: builtins.text) then
      change fix to "join texts with interpolation: \"\{left}\{right}\""
    end
    let updated be push_error(
      checker: checker,
      code: "type-mismatch",
      message: "`{spelled}` needs numbers, but this is `{shown}`",
      span: expr_span(left),
      fix: fix
    )
    return Done(value: plain(ErrorTy), checker: updated)
  end
  if operator is Divide and integer_like(checker: checker, ty: resolved) then
    let quotient be "write `dividend.quotient(divisor)` for whole-number division"
    let updated be push_error(
      checker: checker,
      code: "integer-division",
      message: "`/` divides Decimal or Float values, not two Integers",
      span: span,
      fix: "{quotient}, or `dividend.to_decimal() / divisor`"
    )
    return Done(value: plain(result), checker: updated)
  end
  return Done(value: plain(result), checker: checker)
end

function integer_like(checker: Checker, ty: Ty) returns Boolean
  purpose: Whether a resolved type is Integer, or a variable of an integer literal.

  if is_builtin(checker: checker, ty: ty, id: checker.world.builtins.integer) then return true end
  match ty
    when Var(id) then
      match var_at(checker: checker, id: id).kind
        when IntegerVar then return true
        otherwise return false
      end
    otherwise return false
  end
end

function match_subject(checker: Checker, subject: Expr) returns Done of Subject
  purpose: The subject of a `match`: a fallible call gives its success type and its errors.

  let done be infer(checker: checker, expr: subject, expected: nothing)
  let errors be if done.value.failures.is_empty() then nothing otherwise done.value.failures end
  return Done(value: Subject(ty: done.value.ty, errors: errors), checker: done.checker)
end

function check_pattern(checker: Checker, pattern: Pattern, subject: Ty) returns Done of Shape
  purpose: A pattern against the subject's type, binding its names; the shape feeds exhaustiveness.

  let subject_ty be resolve(checker: checker, ty: subject)
  match pattern
    when BindingPattern(name) then
      let updated be bind(
        checker: checker,
        name: name,
        ty: subject_ty,
        is_mutable: false,
        kind: PatternBinding
      )
      return Done(value: Wild, checker: updated)
    when NothingPattern(span) then
      return check_nothing_pattern(checker: checker, subject_ty: subject_ty, span: span)
    when SomePattern(inner, span) then
      return check_some_pattern(checker: checker, inner: inner, subject_ty: subject_ty, span: span)
    when SuccessPattern(inner) then
      let done be check_pattern(checker: checker, pattern: inner, subject: subject_ty)
      return Done(value: Constructed(ctor: SuccessCtor, subs: [done.value]), checker: done.checker)
    when FailurePattern(inner) then return check_failure_pattern(checker: checker, inner: inner)
    when LiteralPattern(value) then
      return check_literal_pattern(checker: checker, value: value, subject_ty: subject_ty)
    when TypedPattern(name, annotation, span) then
      return check_typed_pattern(
        checker: checker,
        name: name,
        annotation: annotation,
        span: span,
        subject_ty: subject_ty
      )
    when VariantPattern(name, fields, span) then
      return check_variant_pattern(
        checker: checker,
        name: name,
        fields: fields,
        span: span,
        subject_ty: subject_ty
      )
  end
end

function check_nothing_pattern(checker: Checker, subject_ty: Ty, span: Span) returns Done of Shape
  purpose: `nothing` matches a `maybe` value.

  let shape be Constructed(ctor: NothingCtor, subs: [])
  if is_maybe(subject_ty) or types.is_error(subject_ty) then
    return Done(value: shape, checker: checker)
  end
  let shown be show(checker: checker, ty: subject_ty)
  let updated be push_error(
    checker: checker,
    code: "pattern-mismatch",
    message: "`nothing` matches a `maybe` value, but the subject is `{shown}`",
    span: span,
    fix: "drop this arm, or match a `maybe` value"
  )
  return Done(value: shape, checker: updated)
end

function check_some_pattern(checker: Checker, inner: Pattern, subject_ty: Ty, span: Span)
  returns Done of Shape
  purpose: `some(...)` matches a `maybe` value; the inner pattern sees the value's type.

  match subject_ty
    when MaybeTy(inner: item) then
      let done be check_pattern(checker: checker, pattern: inner, subject: item)
      return Done(value: Constructed(ctor: SomeCtor, subs: [done.value]), checker: done.checker)
    when ErrorTy then
      let done be check_pattern(checker: checker, pattern: inner, subject: ErrorTy)
      return Done(value: Constructed(ctor: SomeCtor, subs: [done.value]), checker: done.checker)
    otherwise
      let shown be show(checker: checker, ty: subject_ty)
      let updated be push_error(
        checker: checker,
        code: "pattern-mismatch",
        message: "`some(...)` matches a `maybe` value, but the subject is `{shown}`",
        span: span,
        fix: "drop this arm, or match a `maybe` value"
      )
      let done be check_pattern(checker: updated, pattern: inner, subject: ErrorTy)
      return Done(value: Constructed(ctor: SomeCtor, subs: [done.value]), checker: done.checker)
  end
end

function check_failure_pattern(checker: Checker, inner: Pattern) returns Done of Shape
  purpose: `failure(...)` sees the match's error union; a typed arm removes its type from it.

  let errors be checker.current_errors otherwise ErrorTy
  let done be check_pattern(checker: checker, pattern: inner, subject: errors)
  let mutable updated be done.checker
  match inner
    when TypedPattern(annotation) then
      let handled be resolve_type(checker: updated, ty: annotation)
      change updated to handled.checker
      match updated.current_errors
        when some(Union(members)) then
          let remaining be
            for each member in members
            where not same_type(checker: updated, left: member, right: handled.value)
            collect member
          change updated to updated with current_errors: Union(members: remaining)
        otherwise change updated to updated
      end
    otherwise change updated to updated
  end
  return Done(value: Constructed(ctor: FailureCtor, subs: [done.value]), checker: updated)
end

function check_literal_pattern(checker: Checker, value: Expr, subject_ty: Ty) returns Done of Shape
  purpose: A literal pattern has the subject's type; a Boolean is a constructor, else one value.

  let done be infer(checker: checker, expr: value, expected: subject_ty)
  let updated be expect(
    checker: done.checker,
    actual: done.value.ty,
    expected: subject_ty,
    span: expr_span(value),
    what: "the pattern"
  )
  let shape be
    match value
      when BooleanLiteral(value: true) then Constructed(ctor: TrueCtor, subs: [])
      when BooleanLiteral(value: false) then Constructed(ctor: FalseCtor, subs: [])
      otherwise Constructed(ctor: LiteralCtor, subs: [])
    end
  return Done(value: shape, checker: updated)
end

function check_typed_pattern(
  checker: Checker,
  name: Name,
  annotation: Type,
  span: Span,
  subject_ty: Ty
)
  returns Done of Shape
  purpose: `name: Type` names a member of an error union, or restates the subject's type.

  let resolved be resolve_type(checker: checker, ty: annotation)
  let wanted be resolved.value
  let mutable updated be resolved.checker
  let mutable shape be Wild
  match subject_ty
    when Union(members) then
      let listed be
        for each member in members
        any same_type(checker: updated, left: member, right: wanted)
      if not listed then
        let shown be show(checker: updated, ty: wanted)
        let errors be for each member in members collect show(checker: updated, ty: member)
        let quoted be suggest.quoted(errors)
        change updated to push_error(
          checker: updated,
          code: "pattern-mismatch",
          message: "the errors here are not `{shown}`",
          span: span,
          fix: "write one of {quoted}"
        )
      end
      change shape to Constructed(
        ctor: MemberCtor(ty: zonk(checker: updated, ty: wanted)),
        subs: [Wild]
      )
    when ErrorTy then change shape to Wild
    otherwise
      if not same_type(checker: updated, left: subject_ty, right: wanted) then
        let shown be show(checker: updated, ty: wanted)
        let subject_shown be show(checker: updated, ty: subject_ty)
        change updated to push_error(
          checker: updated,
          code: "pattern-mismatch",
          message: "`{shown}` does not match a `{subject_shown}`",
          span: span,
          fix: "write a pattern of `{subject_shown}`"
        )
      end
  end
  change updated to bind(
    checker: updated,
    name: name,
    ty: wanted,
    is_mutable: false,
    kind: PatternBinding
  )
  return Done(value: shape, checker: updated)
end

type VariantSubject
  purpose: Where a variant pattern's type comes from: the error union's member, and its arguments.
  has member: maybe Ty
  has args: List of Ty
end

function variant_target(checker: Checker, subject_ty: Ty, name: Text) returns maybe VariantFields
  purpose: The type a variant pattern belongs to: the subject's, or a member of an error union.

  match subject_ty
    when App(id) then return variant_fields(checker: checker, type_id: id, name: name)
    when Union(members) then
      for each member in members
        match resolve(checker: checker, ty: member)
          when App(id) then
            let found be variant_fields(checker: checker, type_id: id, name: name)
            if found is not nothing then return found end
          otherwise continue
        end
      end
      return nothing
    otherwise return nothing
  end
end

function variant_subject(checker: Checker, subject_ty: Ty, name: Text) returns VariantSubject
  purpose: The union member a variant pattern matches, and the subject's type arguments.

  match subject_ty
    when App(args) then return VariantSubject(member: nothing, args: args)
    when Union(members) then
      for each member in members
        match resolve(checker: checker, ty: member)
          when App(id, args) then
            if variant_fields(checker: checker, type_id: id, name: name) is not nothing then
              return VariantSubject(member: zonk(checker: checker, ty: member), args: args)
            end
          otherwise continue
        end
      end
      return VariantSubject(member: nothing, args: [])
    otherwise return VariantSubject(member: nothing, args: [])
  end
end

function record_variant_target(checker: Checker, target: VariantFields, name: TypeName)
  returns Checker
  purpose: The VM matches by the type and the variant's position: record which.

  match declare.type_at(world: checker.world, id: target.type_id).kind
    when SumKind(variants) then
      match declare.variant_index(variants: variants, name: name.text)
        when some(index) then
          return record(
            checker: checker,
            target: VariantTarget(type_id: target.type_id, index: index),
            span: name.span
          )
        when nothing then return checker
      end
    otherwise
      return record(checker: checker, target: TypeTarget(type_id: target.type_id), span: name.span)
  end
end

function check_variant_pattern(
  checker: Checker,
  name: TypeName,
  fields: List of FieldPattern,
  span: Span,
  subject_ty: Ty
)
  returns Done of Shape
  purpose: `Name(fields)`: a variant of the subject's sum type, a union member's, or a record (K6).

  let target be variant_target(checker: checker, subject_ty: subject_ty, name: name.text)
  let mutable updated be checker
  match target
    when some(found) then
      change updated to record_variant_target(checker: updated, target: found, name: name)
    when nothing then change updated to updated
  end
  let subject be variant_subject(checker: updated, subject_ty: subject_ty, name: name.text)
  let shaped be
    match target
      when nothing then
        unknown_variant_pattern(
          checker: updated,
          name: name,
          fields: fields,
          span: span,
          subject_ty: subject_ty
        )
      when some(found) then
        variant_fields_patterns(
          checker: updated,
          name: name,
          fields: fields,
          target: found,
          subject_args: subject.args
        )
    end
  match subject.member
    when some(member) then
      return Done(
        value: Constructed(ctor: MemberCtor(ty: member), subs: [shaped.value]),
        checker: shaped.checker
      )
    when nothing then return shaped
  end
end

function unknown_variant_pattern(
  checker: Checker,
  name: TypeName,
  fields: List of FieldPattern,
  span: Span,
  subject_ty: Ty
)
  returns Done of Shape
  purpose: A variant the subject's type does not have: an error, and the fields bound as unknown.

  let mutable updated be checker
  if not types.is_error(subject_ty) then
    let shown be show(checker: updated, ty: subject_ty)
    let fix be suggest_variant(checker: updated, ty: subject_ty, name: name.text)
    change updated to push_error(
      checker: updated,
      code: "pattern-mismatch",
      message: "`{shown}` has no variant named `{name.text}`",
      span: span,
      fix: fix
    )
  end
  for each field in fields
    change updated to bind_unknown_field(checker: updated, field: field)
  end
  return Done(value: Wild, checker: updated)
end

function bind_unknown_field(checker: Checker, field: FieldPattern) returns Checker
  purpose: A field pattern whose type is unknown after an error.

  match field.pattern
    when some(inner) then
      return check_pattern(checker: checker, pattern: inner, subject: ErrorTy).checker
    when nothing then
      return bind(
        checker: checker,
        name: field.field,
        ty: ErrorTy,
        is_mutable: false,
        kind: PatternBinding
      )
  end
end

function field_position(fields: List of FieldInfo, name: Text) returns maybe Integer
  purpose: The position of a field by name.

  let mutable index be 0
  for each field in fields
    if field.name is name then return index end
    change index to index + 1
  end
  return nothing
end

function variant_fields_patterns(
  checker: Checker,
  name: TypeName,
  fields: List of FieldPattern,
  target: VariantFields,
  subject_args: List of Ty
)
  returns Done of Shape
  purpose: The field patterns of a known variant, each against its field's type.

  let subst be param_bindings(params: target.params, args: subject_args)
  let mutable updated be checker
  let mutable subs be wild_shapes(target.fields.length())
  for each field in fields
    match field_position(fields: target.fields, name: field.field.text)
      when some(index) then
        let declared be target.fields.at(index) otherwise crash with "a field"
        let field_ty be types.substitute(ty: declared.ty, bindings: subst)
        match field.pattern
          when some(inner) then
            let done be check_pattern(checker: updated, pattern: inner, subject: field_ty)
            change updated to done.checker
            change subs to lists.replace_at(items: subs, index: index, item: done.value)
          when nothing then
            change updated to bind(
              checker: updated,
              name: field.field,
              ty: field_ty,
              is_mutable: false,
              kind: PatternBinding
            )
        end
      when nothing then
        change updated to unknown_pattern_field(
          checker: updated,
          name: name,
          field: field,
          target: target
        )
        change updated to bind_unknown_field(checker: updated, field: field)
    end
  end
  return Done(
    value: Constructed(ctor: VariantCtor(type_id: target.type_id, name: name.text), subs: subs),
    checker: updated
  )
end

function unknown_pattern_field(
  checker: Checker,
  name: TypeName,
  field: FieldPattern,
  target: VariantFields
)
  returns Checker
  purpose: The error for a field the variant does not have.

  let names be for each declared in target.fields collect declared.name
  let quoted be suggest.quoted(names)
  let fix be
    match suggest.closest(name: field.field.text, candidates: names)
      when some(close) then "did you mean `{close}`?"
      when nothing then
        if names.is_empty() then "drop the parentheses" otherwise "name one of {quoted}" end
    end
  return push_error(
    checker: checker,
    code: "unknown-field",
    message: "`{name.text}` has no field named `{field.field.text}`",
    span: field.field.span,
    fix: fix
  )
end

function variant_fields(checker: Checker, type_id: Integer, name: Text) returns maybe VariantFields
  purpose: The fields of a variant of a sum type, or of a record matched by its own name.

  let info be declare.type_at(world: checker.world, id: type_id)
  match info.kind
    when SumKind(variants) then
      for each variant in variants
        if variant.name is name then
          return VariantFields(type_id: type_id, fields: variant.fields, params: info.params)
        end
      end
      return nothing
    when RecordKind(fields) where info.name is name then
      return VariantFields(type_id: type_id, fields: fields, params: info.params)
    otherwise return nothing
  end
end

function check_exhaustive(
  checker: Checker,
  subject: Ty,
  rows: List of List of Shape,
  errors: maybe List of Ty,
  span: Span
)
  returns Done of Boolean
  purpose: Whether the arms cover the subject (sketch section 8); reports the cases they miss.

  let resolved be resolve(checker: checker, ty: subject)
  let column be
    match errors
      when some(members) then OutcomeColumn(ok: resolved, errors: members)
      when nothing then ValueColumn(ty: resolved)
    end
  let witnesses be missing(checker: checker, columns: [column], rows: rows)
  if witnesses.is_empty() then return Done(value: true, checker: checker) end
  let cases be for each witness in witnesses collect first_part(witness)
  if for each case in cases
  all case is wild then
    let updated be push_error(
      checker: checker,
      code: "not-exhaustive",
      message: "a match on this value needs an `otherwise` arm",
      span: span,
      fix: "add `otherwise ...`"
    )
    return Done(value: false, checker: updated)
  end
  let shown be for each case in cases.take(6) collect "`{case}`"
  let joined be shown.join(", ")
  let extra be cases.length() - 6
  let more be if cases.length() is greater than 6 then " and {extra} more" otherwise "" end
  let updated be push_error(
    checker: checker,
    code: "not-exhaustive",
    message: "the match does not cover {joined}{more}",
    span: span,
    fix: "add an arm for each, or an `otherwise`"
  )
  return Done(value: false, checker: updated)
end

function first_part(witness: Witness) returns Text
  purpose: The first column of a missing case.

  return witness.parts.first() otherwise wild
end

function ctor_set(checker: Checker, column: Column) returns CtorSet
  purpose: The constructors of a column's type.

  let builtins be checker.world.builtins
  match column
    when OutcomeColumn(ok, errors) then
      let success_ctor be CtorFields(ctor: SuccessCtor, fields: [NamedTy(name: "", ty: ok)])
      let failure_ctor be CtorFields(
        ctor: FailureCtor,
        fields: [NamedTy(name: "", ty: Union(members: errors))]
      )
      return Finite(ctors: [success_ctor, failure_ctor])
    when ValueColumn(ty) then
      match resolve(checker: checker, ty: ty)
        when ErrorTy then return Finite(ctors: [])
        when MaybeTy(inner) then
          let absent be CtorFields(ctor: NothingCtor, fields: [])
          let present be CtorFields(ctor: SomeCtor, fields: [NamedTy(name: "", ty: inner)])
          return Finite(ctors: [absent, present])
        when Union(members) then
          let ctors be
            for each member in members
            collect CtorFields(
              ctor: MemberCtor(ty: zonk(checker: checker, ty: member)),
              fields: [NamedTy(name: "", ty: member)]
            )
          return Finite(ctors: ctors)
        when App(id, args) then
          if id is builtins.boolean then
            return Finite(
              ctors: [
                CtorFields(ctor: TrueCtor, fields: []),
                CtorFields(ctor: FalseCtor, fields: [])
              ]
            )
          end
          return app_ctors(checker: checker, id: id, args: args)
        otherwise return Infinite
      end
  end
end

function app_ctors(checker: Checker, id: Integer, args: List of Ty) returns CtorSet
  purpose: The constructors of a declared type: its variants, or a record as one constructor.

  let info be declare.type_at(world: checker.world, id: id)
  let subst be param_bindings(params: info.params, args: args)
  match info.kind
    when SumKind(variants) then
      let ctors be
        for each variant in variants
        collect CtorFields(
          ctor: VariantCtor(type_id: id, name: variant.name),
          fields: fields_of(fields: variant.fields, subst: subst)
        )
      return Finite(ctors: ctors)
    when RecordKind(fields) then
      return Finite(
        ctors: [
          CtorFields(
            ctor: VariantCtor(type_id: id, name: info.name),
            fields: fields_of(fields: fields, subst: subst)
          )
        ]
      )
    otherwise return Infinite
  end
end

function fields_of(fields: List of FieldInfo, subst: List of Substitution) returns List of NamedTy
  purpose: The fields of a constructor with the type's arguments applied.

  return for each field in fields
    collect NamedTy(name: field.name, ty: types.substitute(ty: field.ty, bindings: subst))
end

function default_rows(rows: List of List of Shape) returns List of List of Shape
  purpose: The rows whose first pattern is a wildcard, without it.

  let mutable out: List of List of Shape be []
  for each row in rows
    match row.first()
      when some(Wild) then change out to out.append(row.drop(1))
      otherwise continue
    end
  end
  return out
end

function row_heads(rows: List of List of Shape) returns List of Ctor
  purpose: The constructors the rows start with.

  let mutable heads: List of Ctor be []
  for each row in rows
    match row.first()
      when some(Constructed(ctor)) then change heads to heads.append(ctor)
      otherwise continue
    end
  end
  return heads
end

function specialise(rows: List of List of Shape, ctor: Ctor, arity: Integer)
  returns List of List of Shape
  purpose: The rows that match a constructor, their first pattern replaced by its sub-patterns.

  let mutable out: List of List of Shape be []
  let wilds be wild_shapes(arity)
  for each row in rows
    match row.first()
      when some(Constructed(ctor: head, subs)) then
        if head is ctor then change out to out.append(subs.append_all(row.drop(1))) end
      when some(Wild) then change out to out.append(wilds.append_all(row.drop(1)))
      when nothing then continue
    end
  end
  return out
end

function wild_texts(total: Integer) returns List of Text
  purpose: As many `...` as a constructor has fields.

  let mutable out: List of Text be []
  let mutable index be 0
  repeat until index is at least total
    change out to out.append(wild)
    change index to index + 1
  end
  return out
end

function error_types(total: Integer) returns List of Ty
  purpose: As many unknown types as names to bind after an error.

  let mutable out: List of Ty be []
  let mutable index be 0
  repeat until index is at least total
    change out to out.append(ErrorTy)
    change index to index + 1
  end
  return out
end

function wild_shapes(arity: Integer) returns List of Shape
  purpose: As many wildcards as a constructor has fields.

  let mutable out: List of Shape be []
  let mutable index be 0
  repeat until index is at least arity
    change out to out.append(Wild)
    change index to index + 1
  end
  return out
end

function missing(checker: Checker, columns: List of Column, rows: List of List of Shape)
  returns List of Witness
  purpose: The cases the rows leave uncovered, one spelling per column; empty when exhaustive.

  if columns.is_empty() then
    if rows.is_empty() then return [Witness(parts: [])] end
    return []
  end
  let head_column be columns.first() otherwise crash with "a column"
  let rest be columns.drop(1)
  match ctor_set(checker: checker, column: head_column)
    when Finite(ctors) then
      let heads be row_heads(rows)
      let complete be for each entry in ctors all heads.contains(entry.ctor)
      if complete then
        return missing_complete(checker: checker, ctors: ctors, rest: rest, rows: rows)
      end
      return missing_incomplete(
        checker: checker,
        ctors: ctors,
        heads: heads,
        rest: rest,
        rows: rows
      )
    when Infinite then
      let mutable witnesses: List of Witness be []
      for each witness in missing(checker: checker, columns: rest, rows: default_rows(rows))
        change witnesses to witnesses.append(Witness(parts: [wild].append_all(witness.parts)))
      end
      return witnesses
  end
end

function missing_complete(
  checker: Checker,
  ctors: List of CtorFields,
  rest: List of Column,
  rows: List of List of Shape
)
  returns List of Witness
  purpose: Every constructor named: specialise on each and spell what its rows miss.

  let mutable witnesses: List of Witness be []
  for each entry in ctors
    let columns be (for each field in entry.fields
    collect ValueColumn(ty: field.ty)).append_all(rest)
    let specialised be specialise(rows: rows, ctor: entry.ctor, arity: entry.fields.length())
    for each witness in missing(checker: checker, columns: columns, rows: specialised)
      let own be witness.parts.take(entry.fields.length())
      let tail be witness.parts.drop(entry.fields.length())
      let spelled_head be spell(checker: checker, ctor: entry.ctor, fields: entry.fields, subs: own)
      let spelled be Witness(parts: [spelled_head].append_all(tail))
      if not witnesses.contains(spelled) then change witnesses to witnesses.append(spelled) end
    end
  end
  return witnesses
end

function missing_incomplete(
  checker: Checker,
  ctors: List of CtorFields,
  heads: List of Ctor,
  rest: List of Column,
  rows: List of List of Shape
)
  returns List of Witness
  purpose: Some constructor unnamed: the wildcard rows decide the rest, each unnamed one is a case.

  let mutable witnesses: List of Witness be []
  for each witness in missing(checker: checker, columns: rest, rows: default_rows(rows))
    for each entry in ctors
      if heads.contains(entry.ctor) then continue end
      let wilds be wild_texts(entry.fields.length())
      let spelled_head be spell(
        checker: checker,
        ctor: entry.ctor,
        fields: entry.fields,
        subs: wilds
      )
      let spelled be Witness(parts: [spelled_head].append_all(witness.parts))
      if not witnesses.contains(spelled) then change witnesses to witnesses.append(spelled) end
    end
  end
  return witnesses
end

function spell(checker: Checker, ctor: Ctor, fields: List of NamedTy, subs: List of Text)
  returns Text
  purpose: A missing case as the reader would write its arm.

  let head_sub be subs.first() otherwise wild
  match ctor
    when NothingCtor then return "nothing"
    when TrueCtor then return "true"
    when FalseCtor then return "false"
    when SomeCtor then return "some({head_sub})"
    when SuccessCtor then return "success({head_sub})"
    when FailureCtor then return "failure({head_sub})"
    when MemberCtor(ty) then
      if head_sub is wild then
        let shown be show(checker: checker, ty: ty)
        return "error: {shown}"
      end
      return head_sub
    when VariantCtor(name) then return spell_variant(name: name, fields: fields, subs: subs)
    when LiteralCtor then return wild
  end
end

function spell_variant(name: Text, fields: List of NamedTy, subs: List of Text) returns Text
  purpose: A variant case: bare, with `...`, or with its fields.

  if fields.is_empty() then return name end
  if for each sub in subs all sub is wild then return "{name}({wild})" end
  let mutable parts: List of Text be []
  let mutable index be 0
  for each field in fields
    let sub be subs.at(index) otherwise break
    change parts to parts.append("{field.name}: {sub}")
    change index to index + 1
  end
  let joined be parts.join(", ")
  return "{name}({joined})"
end

function infer_query(checker: Checker, query: Expr, expected: maybe Ty) returns Done of Info
  purpose: A `for each ... collect/sum/count/first/any/all` query, with its clauses.

  match query
    when QueryExpr(sources, deadline, filter, order, group_by, terminal, span) then
      let builtins be checker.world.builtins
      let mutable updated be push_scope(checker)
      let mutable last_item be ErrorTy
      for each source in sources
        let items be loop_items(checker: updated, bindings: source.bindings, source: source.source)
        change updated to items.checker
        change last_item to single_or_pair(checker: updated, items: items.value)
        let mutable index be 0
        for each name in source.bindings
          let ty be items.value.at(index) otherwise break
          change updated to bind(
            checker: updated,
            name: name,
            ty: ty,
            is_mutable: false,
            kind: QueryBinding
          )
          change index to index + 1
        end
      end
      change updated to check_query_clauses(
        checker: updated,
        deadline: deadline,
        filter: filter,
        order: order
      )
      let key be query_key(checker: updated, group_by: group_by)
      change updated to key.checker
      let expected_inner be query_expected_inner(
        checker: updated,
        expected: expected,
        grouped: key.value is not nothing
      )
      let result be query_result(
        checker: updated,
        sources: sources,
        filter: filter,
        terminal: terminal,
        expected_inner: expected_inner,
        last_item: last_item,
        span: span
      )
      change updated to pop_scope(result.checker)
      let ty be
        match key.value
          when some(key_ty) then App(id: builtins.map, args: [key_ty, result.value])
          when nothing then result.value
        end
      return Done(value: plain(ty), checker: updated)
    otherwise crash with "a query"
  end
end

function single_or_pair(checker: Checker, items: List of Ty) returns Ty
  purpose: The item of a query source: the one type, or a pair of the two.

  if items.length() is 1 then return items.first() otherwise ErrorTy end
  return App(id: checker.world.builtins.pair, args: items)
end

function check_query_clauses(
  checker: Checker,
  deadline: maybe Expr,
  filter: maybe Expr,
  order: maybe SortOrder
)
  returns Checker
  purpose: The `within`, `where` and `sorted by` clauses of a query.

  let mutable updated be checker
  match deadline
    when some(limit) then change updated to check_within(checker: updated, deadline: limit)
    when nothing then change updated to updated
  end
  match filter
    when some(condition) then
      change updated to check_condition(checker: updated, condition: condition)
    when nothing then change updated to updated
  end
  match order
    when some(ordering) then change updated to check_ordering(checker: updated, order: ordering)
    when nothing then change updated to updated
  end
  return updated
end

function query_key(checker: Checker, group_by: maybe Expr) returns Done of maybe Ty
  purpose: The key type of `group by`, which must be hashable.

  let key be group_by otherwise return Done(value: nothing, checker: checker)
  let done be infer(checker: checker, expr: key, expected: nothing)
  let span be expr_span(key)
  let mutable updated be require_handled(checker: done.checker, info: done.value, span: span)
  change updated to require_ability(
    checker: updated,
    ty: done.value.ty,
    ability_id: checker.world.builtins.hash,
    span: span,
    what: "`group by`"
  )
  return Done(value: done.value.ty, checker: updated)
end

function query_expected_inner(checker: Checker, expected: maybe Ty, grouped: Boolean)
  returns maybe Ty
  purpose: What the context expects of the query's result: the map's value type when grouped.

  let wanted be expected otherwise return nothing
  let resolved be resolve(checker: checker, ty: wanted)
  if grouped then
    match resolved
      when App(id, args) where id is checker.world.builtins.map then return args.at(1)
      otherwise return nothing
    end
  end
  return resolved
end

function query_result(
  checker: Checker,
  sources: List of QuerySource,
  filter: maybe Expr,
  terminal: QueryTerminal,
  expected_inner: maybe Ty,
  last_item: Ty,
  span: Span
)
  returns Done of Ty
  purpose: The type a query's terminal produces.

  let builtins be checker.world.builtins
  match terminal
    when Collect(value) then
      let item_expected be expected_app_args(
        checker: checker,
        expected: expected_inner,
        id: builtins.list
      )
      let item be
        match item_expected
          when some(args) then args.first()
          when nothing then nothing
        end
      let done be infer(checker: checker, expr: value, expected: item)
      let updated be require_handled(
        checker: done.checker,
        info: done.value,
        span: expr_span(value)
      )
      return Done(value: App(id: builtins.list, args: [done.value.ty]), checker: updated)
    when Sum(value) then return query_sum(checker: checker, value: value, span: span)
    when Count then
      let source_span: maybe Span be
        match sources.first()
          when some(source) where sources.length() is 1 and filter is nothing then
            expr_span(source.source)
          otherwise nothing
        end
      return Done(
        value: builtin(builtins.integer),
        checker: retag_count(checker: checker, source: source_span)
      )
    when First then return Done(value: MaybeTy(inner: last_item), checker: mark_all_used(checker))
    when Any(condition) then
      return Done(
        value: builtin(builtins.boolean),
        checker: check_condition(checker: checker, condition: condition)
      )
    when All(condition) then
      return Done(
        value: builtin(builtins.boolean),
        checker: check_condition(checker: checker, condition: condition)
      )
    when GroupOnly then
      return Done(value: App(id: builtins.list, args: [last_item]), checker: checker)
  end
end

function query_sum(checker: Checker, value: Expr, span: Span) returns Done of Ty
  purpose: `sum`: numbers, whose base type the result and the VM's zero take.

  let done be infer(checker: checker, expr: value, expected: nothing)
  let mutable updated be require_handled(
    checker: done.checker,
    info: done.value,
    span: expr_span(value)
  )
  let resolved be resolve(checker: updated, ty: done.value.ty)
  let unknown be var_id(resolved) is not nothing or types.is_error(resolved)
  if not unknown and not is_numeric(checker: updated, ty: resolved) then
    let shown be show(checker: updated, ty: resolved)
    change updated to push_error(
      checker: updated,
      code: "type-mismatch",
      message: "`sum` adds numbers, but these are `{shown}`",
      span: expr_span(value),
      fix: "sum a number of each item: `for each item in items sum item.amount`"
    )
  end
  let result be base_of(checker: updated, ty: done.value.ty)
  return Done(value: result, checker: note_literal(checker: updated, span: span, ty: result))
end

function retag_count(checker: Checker, source: maybe Span) returns Checker
  purpose: The loop variables of a bare `count` are not read (M2); the fix counts the source.

  let span be source otherwise return checker
  let scope be checker.scopes.last() otherwise return checker
  let bindings be
    for each binding in scope.bindings
    collect count_tagged(binding: binding, span: span)
  let index be checker.scopes.length() - 1
  return checker
    with scopes: lists.replace_at(
      items: checker.scopes,
      index: index,
      item: Scope(bindings: bindings)
    )
end

function count_tagged(binding: Binding, span: Span) returns Binding
  purpose: A query binding retagged as the loop variable of a bare `count`.

  if binding.kind is QueryBinding then return binding with kind: CountBinding(source: span) end
  return binding
end

function resolve_type(checker: Checker, ty: Type) returns Done of Ty
  purpose: A type written inside a body, with the function's `for any` parameters in scope.

  let resolved be resolve_in_body(checker: checker, ty: ty)
  return Done(value: resolved.value, checker: record_type_names(checker: resolved.checker, ty: ty))
end

function resolve_in_body(checker: Checker, ty: Type) returns Done of Ty
  purpose: Resolve a type written inside a body without changing the world.

  match ty
    when MaybeType(inner) then
      let done be resolve_in_body(checker: checker, ty: inner)
      return Done(value: MaybeTy(inner: done.value), checker: done.checker)
    when FunctionType(params, result, failures, capabilities) then
      let params_done be resolve_in_body_all(checker: checker, tys: params)
      let mutable updated be params_done.checker
      let mutable resolved_result: maybe Ty be nothing
      match result
        when some(result_type) then
          let done be resolve_in_body(checker: updated, ty: result_type)
          change updated to done.checker
          change resolved_result to done.value
        when nothing then change updated to updated
      end
      let failures_done be resolve_in_body_all(checker: updated, tys: failures)
      let grants be for each capability in capabilities collect effects.from_ast(capability)
      let signature be FunctionSignature(
        params: params_done.value,
        result: resolved_result,
        failures: failures_done.value,
        capabilities: grants
      )
      return Done(value: FunctionTy(signature: signature), checker: failures_done.checker)
    when NamedType(name, args, span) then
      return resolve_named_in_body(checker: checker, name: name, args: args, span: span)
  end
end

function resolve_in_body_all(checker: Checker, tys: List of Type) returns Done of List of Ty
  purpose: Every type of a list resolved inside a body.

  let mutable updated be checker
  let mutable out: List of Ty be []
  for each ty in tys
    let done be resolve_in_body(checker: updated, ty: ty)
    change updated to done.checker
    change out to out.append(done.value)
  end
  return Done(value: out, checker: updated)
end

function resolve_named_in_body(checker: Checker, name: TypeName, args: List of Type, span: Span)
  returns Done of Ty
  purpose: A named type inside a body: a type parameter in scope, or a declared type with arguments.

  let param be declare.lookup_named_param(params: checker.type_params, name: name.text)
  if param is not nothing then
    let id be param otherwise crash with "a type parameter"
    if args.is_empty() then return Done(value: Param(id: id), checker: checker) end
    let diagnostic be report.bare_error(
      code: "type-arity",
      message: "`{name.text}` is a type parameter and takes no arguments",
      span: span
    )
    return Done(value: Param(id: id), checker: push_bare(checker: checker, diagnostic: diagnostic))
  end
  match declare.lookup_type(world: checker.world, owner: checker.module_id, name: name.text)
    when nothing then
      let message be "unknown type `{name.text}`"
      let diagnostic be
        match declare.suggest_import(
          world: checker.world,
          owner: checker.module_id,
          name: name.text
        )
          when some(fix) then
            report.error(code: "unknown-type", message: message, span: name.span, fix: fix)
          when nothing then
            report.bare_error(code: "unknown-type", message: message, span: name.span)
        end
      return Done(value: ErrorTy, checker: push_bare(checker: checker, diagnostic: diagnostic))
    when some(type_id) then
      let expected be declare.type_at(world: checker.world, id: type_id).params.length()
      if expected is not args.length() then
        let plural be if expected is 1 then "" otherwise "s" end
        let found be args.length()
        let message be "`{name.text}` takes {expected} type argument{plural}, found {found}"
        let diagnostic be report.bare_error(code: "type-arity", message: message, span: span)
        return Done(value: ErrorTy, checker: push_bare(checker: checker, diagnostic: diagnostic))
      end
      let done be resolve_in_body_all(checker: checker, tys: args)
      return Done(value: App(id: type_id, args: done.value), checker: done.checker)
  end
end

public function check_module(world: World, module_id: Integer) returns Checked
  purpose: Check every body of a module; its diagnostics and the references its bodies make.

  let mutable checker be new_checker(world: world, module_id: module_id)
  let info be declare.module_at(world: world, id: module_id)
  let bodies be body_index(world: world, module_id: module_id)
  let mutable index be 0
  for each item in info.tree.items
    change checker to check_item(checker: checker, index: index, item: item, bodies: bodies)
    change index to index + 1
  end
  if info.tree.docs.summary is nothing then
    let stop be
      match info.tree.name.last()
        when some(last) then last.span.stop
        when nothing then 0
      end
    change checker to push_error(
      checker: checker,
      code: "purpose-missing",
      message: "the module has no purpose",
      span: Span(start: 0, stop: stop),
      fix: "add a `purpose:` clause under the `module` line"
    )
  end
  return Checked(diagnostics: checker.diagnostics, references: checker.references)
end

function check_item(checker: Checker, index: Integer, item: Item, bodies: Map of Text to Integer)
  returns Checker
  purpose: One item of the module, its bodies checked; `bodies` maps an item to its function.

  let info be module_info(checker)
  match item
    when FunctionItem(value: func) then
      match bodies.get("{index}")
        when some(id) then return check_function(checker: checker, id: id, func: func)
        when nothing then return checker
      end
    when ImplementationItem(value: implementation) then
      let mutable updated be checker
      let mutable method be 0
      for each func in implementation.functions
        match bodies.get("{index}:{method}")
          when some(id) then change updated to check_function(checker: updated, id: id, func: func)
          when nothing then change updated to updated
        end
        change method to method + 1
      end
      return updated
    when TestItem(value: block) then return check_test(checker: checker, index: index, block: block)
    when ConstantItem(value: constant) then
      let constant_info be info.constants.get(constant.name.text) otherwise return checker
      return check_constant(
        checker: checker,
        index: index,
        constant: constant,
        ty: constant_info.ty
      )
    when TypeItem(value: def) then
      return check_type_conditions(checker: checker, index: index, def: def)
    when AbilityItem then return checker
  end
end

function body_index(world: World, module_id: Integer) returns Map of Text to Integer
  purpose: The module's functions by body: an item's index, or `item:method` in an implementation.

  let mutable bodies: Map of Text to Integer be {}
  let mutable id be 0
  for each func in world.functions
    if func.owner is module_id then
      match func.body
        when ItemBody(item) then change bodies to bodies.set(key: "{item}", value: id)
        when ImplementationBody(item, method) then
          change bodies to bodies.set(key: "{item}:{method}", value: id)
        otherwise change bodies to bodies
      end
    end
    change id to id + 1
  end
  return bodies
end
