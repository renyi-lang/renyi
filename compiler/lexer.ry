module lexer
  purpose: Source text to tokens and diagnostics, by the rules of the reference's section 1.

import ast exposing Span
import report exposing Diagnostic

public type TokenKind is one of
  purpose: What a token is; a phrase such as `is at least` is one Word.
  Word(spelling: Text)
  Identifier
  TypeIdentifier
  MemberName
  IntegerToken
  DecimalToken
  TextToken(parts: List of Part, is_block: Boolean)
  RawToken(text: Text)
  ClauseToken(text: Text)
  CommentToken
  LineBreak
  Symbol(text: Text)
  ErrorToken
  EndOfFile
end

public type Part is one of
  purpose: A piece of a text literal: characters, or the tokens of a `{hole}`.
  Characters(text: Text)
  HolePart(tokens: List of Token)
end

public type Token
  purpose: A token with the source text it covers.
  has kind: TokenKind
  has text: Text
  has span: Span
end

public type Lexed
  purpose: The tokens of a text, ending with EndOfFile, and the lexer's diagnostics in source order.
  has tokens: List of Token
  has diagnostics: List of Diagnostic
end

type Step is one of
  purpose: One step's product: a token, or tokens and diagnostics with where the next step starts.
  Single(token: Token)
  Several(tokens: List of Token, diagnostics: List of Diagnostic, next: Integer)
end

type Phrase
  purpose: The longest phrase starting at a word, and where it ends.
  has spelling: Text
  has stop: Integer
end

type BlockLines
  purpose: The content lines of a block text and the span of its closing quotes.
  has lines: List of Span
  has closing: Span
end

type Segment
  purpose: The parts of a text literal's content and the diagnostics met in it.
  has parts: List of Part
  has diagnostics: List of Diagnostic
end

let reserved_words: List of Text be [
  "ability",
  "all",
  "also",
  "and",
  "any",
  "as",
  "at",
  "be",
  "break",
  "by",
  "can",
  "change",
  "check",
  "collect",
  "concurrently",
  "continue",
  "count",
  "crash",
  "deprecated",
  "descending",
  "each",
  "end",
  "example",
  "expose",
  "exposing",
  "fail",
  "fails",
  "failure",
  "false",
  "first",
  "for",
  "from",
  "function",
  "greater",
  "group",
  "has",
  "if",
  "ignore",
  "import",
  "in",
  "is",
  "lazy",
  "least",
  "less",
  "let",
  "match",
  "maybe",
  "module",
  "most",
  "mutable",
  "needs",
  "not",
  "nothing",
  "of",
  "one",
  "only",
  "or",
  "otherwise",
  "per",
  "power",
  "public",
  "purpose",
  "raw",
  "remainder",
  "repeat",
  "replays",
  "return",
  "returns",
  "run",
  "see",
  "self",
  "some",
  "sorted",
  "success",
  "sum",
  "tags",
  "test",
  "than",
  "then",
  "to",
  "tool",
  "true",
  "type",
  "until",
  "when",
  "where",
  "with",
  "within"
]

let phrases: List of Text be [
  "is not",
  "is less than",
  "is at most",
  "is greater than",
  "is at least",
  "or fails with",
  "is one of",
  "for each",
  "for any",
  "run concurrently",
  "sorted by",
  "group by",
  "see also",
  "expose as tool",
  "repeat until",
  "at most",
  "only to"
]

let phrase_starters: List of Text be [
  "is",
  "or",
  "for",
  "run",
  "repeat",
  "at",
  "only",
  "sorted",
  "group",
  "see",
  "expose"
]

let clause_words: List of Text be ["purpose", "tags", "see also", "deprecated"]

let symbols: List of Text be ["(", ")", "[", "]", "\{", "}", ",", ":", ".", "+", "-", "*", "/"]

let operator_symbols: List of Text be ["!", "&", "|", "%", "^", "~", "?", "@", "$", "`", "\\", "'"]

let operator_tail: List of Text be ["=", "<", ">", "!", "&", "|"]

let carriage_return_base64: Text be "DQ=="

let reserved_set: Set of Text be reserved_words.to_set()

let phrase_set: Set of Text be phrases.to_set()

let phrase_starter_set: Set of Text be phrase_starters.to_set()

let symbol_set: Set of Text be symbols.to_set()

let lower_letters: Text be "abcdefghijklmnopqrstuvwxyz"

let upper_letters: Text be "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

let digits: Text be "0123456789"

public function lex(source: Text) returns Lexed
  purpose: The tokens of a whole source text, ending with EndOfFile, and every problem met.

  let chars be source.characters()
  let limit be chars.length()
  let lexed be lex_range(chars: chars, start: 0, limit: limit)
  let eof be Token(kind: EndOfFile, text: "", span: Span(start: limit, stop: limit))
  return Lexed(tokens: lexed.tokens.append(eof), diagnostics: lexed.diagnostics)
end

function lex_range(chars: List of Text, start: Integer, limit: Integer) returns Lexed
  purpose: One loop over the characters: a blank skipped and a line break taken here, else a step.

  let mutable tokens: List of Token be []
  let mutable diagnostics: List of Diagnostic be []
  let mutable previous: maybe Token be nothing
  let mutable position be start
  repeat until position is at least limit
    let ch be chars.at(position) otherwise ""
    if ch is " " then
      change position to position + 1
    otherwise if ch is "\n" then
      let span be Span(start: position, stop: position + 1)
      let token be Token(kind: LineBreak, text: "\n", span: span)
      change tokens to tokens.append(token)
      change previous to token
      change position to position + 1
    otherwise
      let step be next_step(
        chars: chars,
        position: position,
        limit: limit,
        previous: previous,
        ch: ch
      )
      match step
        when Single(token: token) then
          change tokens to tokens.append(token)
          change previous to token
          change position to token.span.stop
        when Several(tokens: more, diagnostics: found, next: next) then
          change tokens to tokens.append_all(more)
          change diagnostics to diagnostics.append_all(found)
          change previous to last_of(tokens: more, fallback: previous)
          change position to next
      end
    end
  end
  return Lexed(tokens: tokens, diagnostics: diagnostics)
end

function last_of(tokens: List of Token, fallback: maybe Token) returns maybe Token
  purpose: The last of the tokens, or the fallback when there is none.

  match tokens.last()
    when some(token) then return token
    when nothing then return fallback
  end
end

function next_step(
  chars: List of Text,
  position: Integer,
  limit: Integer,
  previous: maybe Token,
  ch: Text
)
  returns Step
  purpose: The step at a character that is neither a blank nor a line break, the likeliest first.

  if lower_letters.contains(ch) then
    return lex_word(chars: chars, position: position, limit: limit, previous: previous)
  end
  if symbol_set.contains(ch) then
    return single(kind: Symbol(text: ch), chars: chars, start: position, stop: position + 1)
  end
  if ch is "\"" then
    return lex_text(chars: chars, position: position, limit: limit, previous: previous)
  end
  if upper_letters.contains(ch) then
    return lex_type_name(chars: chars, position: position, limit: limit)
  end
  if digits.contains(ch) then return lex_number(chars: chars, position: position, limit: limit) end
  if ch is "#" then return lex_comment(chars: chars, position: position, limit: limit) end
  return other_step(chars: chars, position: position, limit: limit, ch: ch)
end

function other_step(chars: List of Text, position: Integer, limit: Integer, ch: Text) returns Step
  purpose: A character no token starts with: other whitespace, another language's symbol.

  let span be Span(start: position, stop: position + 1)
  if ch is "\t" then
    let diagnostic be report.error(
      code: "tab",
      message: "tab character; Renyi indents with two spaces",
      span: span,
      fix: "replace the tab with spaces"
    )
    return Several(tokens: [], diagnostics: [diagnostic], next: position + 1)
  end
  if ch.to_bytes().to_base64() is carriage_return_base64 then
    let diagnostic be report.bare_error(
      code: "crlf",
      message: "carriage return; Renyi files use LF line endings",
      span: span
    )
    return Several(tokens: [], diagnostics: [diagnostic], next: position + 1)
  end
  if ch is "=" or ch is "<" or ch is ">" or ch is ";" or operator_symbols.contains(ch) then
    return symbol_error(chars: chars, position: position, limit: limit, ch: ch)
  end
  if ch is "_" then
    let stop be scan_word(chars: chars, start: position, limit: limit)
    let diagnostic be report.error(
      code: "identifier-shape",
      message: "a name cannot start with an underscore",
      span: Span(start: position, stop: stop),
      fix: "start the name with a lowercase letter"
    )
    return error_token(chars: chars, start: position, stop: stop, diagnostic: diagnostic)
  end
  let diagnostic be report.error(
    code: "unknown-character",
    message: "unexpected character `{ch}`",
    span: span,
    fix: "remove it, or put it inside a text literal"
  )
  return error_token(chars: chars, start: position, stop: position + 1, diagnostic: diagnostic)
end

function symbol_error(chars: List of Text, position: Integer, limit: Integer, ch: Text) returns Step
  purpose: A symbol of another language, with the following operator characters as one error token.

  let stop be scan_operator_tail(chars: chars, start: position + 1, limit: limit)
  let found be slice(chars: chars, start: position, stop: stop)
  let single_message be
    if ch is "<" or ch is ">" then "`<` and `>` are not Renyi" otherwise "`{ch}` is not Renyi" end
  let message be
    if found.length() is greater than 1 then "`{found}` is not Renyi" otherwise single_message end
  let span be Span(start: position, stop: stop)
  let diagnostic be report.error(
    code: symbol_code(ch),
    message: message,
    span: span,
    fix: symbol_fix(ch)
  )
  return error_token(chars: chars, start: position, stop: stop, diagnostic: diagnostic)
end

function symbol_code(ch: Text) returns Text
  if ch is "=" then return "equals-sign" end
  if ch is "<" or ch is ">" then return "angle-comparison" end
  if ch is ";" then return "semicolon" end
  return "symbolic-operator"
end

function symbol_fix(ch: Text) returns Text
  if ch is "=" then
    return "write `let name be value` to define, `change name to value` to change, `is` to compare"
  end
  if ch is "<" or ch is ">" then
    return "write `is less than`, `is at most`, `is greater than` or `is at least`"
  end
  if ch is ";" then return "one statement per line, no terminator" end
  return "use the English word for the operation (`and`, `or`, `not`, `remainder`, `power`)"
end

function error_token(chars: List of Text, start: Integer, stop: Integer, diagnostic: Diagnostic)
  returns Step
  purpose: An error token over the characters a diagnostic is about, as the Rust lexer pushes one.

  let token be Token(
    kind: ErrorToken,
    text: slice(chars: chars, start: start, stop: stop),
    span: Span(start: start, stop: stop)
  )
  return Several(tokens: [token], diagnostics: [diagnostic], next: stop)
end

function single(kind: TokenKind, chars: List of Text, start: Integer, stop: Integer) returns Step
  let token be Token(
    kind: kind,
    text: slice(chars: chars, start: start, stop: stop),
    span: Span(start: start, stop: stop)
  )
  return Single(token: token)
end

function flagged(step: Step, diagnostic: Diagnostic) returns Step
  purpose: A step with a diagnostic about the token it produced all the same.

  match step
    when Single(token: token) then
      return Several(tokens: [token], diagnostics: [diagnostic], next: token.span.stop)
    when Several(tokens: more, diagnostics: found, next: next) then
      return Several(tokens: more, diagnostics: found.append(diagnostic), next: next)
  end
end

function char_at(chars: List of Text, index: Integer) returns Text
  return chars.at(index) otherwise ""
end

function slice(chars: List of Text, start: Integer, stop: Integer) returns Text
  purpose: The characters from start to stop as one text; linear in their count (decision X2).

  return chars.slice(start: start, stop: stop).join("")
end

function is_lower(ch: Text) returns Boolean
  return ch is not "" and lower_letters.contains(ch)
end

function is_upper(ch: Text) returns Boolean
  return ch is not "" and upper_letters.contains(ch)
end

function is_digit(ch: Text) returns Boolean
  return ch is not "" and digits.contains(ch)
end

function scan_word(chars: List of Text, start: Integer, limit: Integer) returns Integer
  purpose: The end of the run of lowercase letters, digits and underscores from start.

  let mutable position be start
  let mutable scanning be position is less than limit
  repeat until not scanning
    let ch be chars.at(position) otherwise ""
    if lower_letters.contains(ch) or ch is "_" or digits.contains(ch) then
      change position to position + 1
      change scanning to position is less than limit
    otherwise
      change scanning to false
    end
  end
  return position
end

function scan_name_tail(chars: List of Text, start: Integer, limit: Integer) returns Integer
  purpose: The end of the run of letters of either case, digits or underscores from start.

  let mutable position be start
  let mutable scanning be position is less than limit
  repeat until not scanning
    let ch be chars.at(position) otherwise ""
    let letter be lower_letters.contains(ch) or upper_letters.contains(ch)
    if letter or ch is "_" or digits.contains(ch) then
      change position to position + 1
      change scanning to position is less than limit
    otherwise
      change scanning to false
    end
  end
  return position
end

function scan_alphanumeric(chars: List of Text, start: Integer, limit: Integer) returns Integer
  purpose: The end of the run of letters of either case and digits from start.

  let mutable position be start
  let mutable scanning be position is less than limit
  repeat until not scanning
    let ch be chars.at(position) otherwise ""
    if lower_letters.contains(ch) or upper_letters.contains(ch) or digits.contains(ch) then
      change position to position + 1
      change scanning to position is less than limit
    otherwise
      change scanning to false
    end
  end
  return position
end

function scan_digits(chars: List of Text, start: Integer, limit: Integer, underscores: Boolean)
  returns Integer
  purpose: The end of the run of digits from start, underscores among them when asked.

  let mutable position be start
  let mutable scanning be position is less than limit
  repeat until not scanning
    let ch be chars.at(position) otherwise ""
    if digits.contains(ch) or (underscores and ch is "_") then
      change position to position + 1
      change scanning to position is less than limit
    otherwise
      change scanning to false
    end
  end
  return position
end

function scan_spaces(chars: List of Text, start: Integer, limit: Integer) returns Integer
  purpose: The end of the run of blanks from start.

  let mutable position be start
  repeat until position is at least limit or (chars.at(position) otherwise "") is not " "
    change position to position + 1
  end
  return position
end

function scan_operator_tail(chars: List of Text, start: Integer, limit: Integer) returns Integer
  purpose: The end of the run of operator characters from start, for an error token.

  let mutable position be start
  repeat until position is at least limit
    or not operator_tail.contains(chars.at(position) otherwise "")
    change position to position + 1
  end
  return position
end

function line_end(chars: List of Text, position: Integer, limit: Integer) returns Integer
  let mutable stop be position
  repeat until stop is at least limit or (chars.at(stop) otherwise "") is "\n"
    change stop to stop + 1
  end
  return stop
end

function at_line_start(chars: List of Text, offset: Integer) returns Boolean
  let mutable index be offset
  repeat until index is 0 or (chars.at(index - 1) otherwise "") is not " "
    change index to index - 1
  end
  return index is 0 or (chars.at(index - 1) otherwise "") is "\n"
end

function previous_is_adjacent_dot(previous: maybe Token, start: Integer) returns Boolean
  match previous
    when nothing then return false
    when some(token) then
      if token.span.stop is not start then return false end
      match token.kind
        when Symbol(text: text) then return text is "."
        otherwise return false
      end
  end
end

public function pascal_case(text: Text) returns Text
  purpose: `user_record` as `UserRecord`: the spelling of a type name (decision C5), for a fix.

  let mutable out be ""
  for each part in text.split("_")
    if part is not "" then change out to "{out}{part.take(1).to_upper()}{part.drop(1)}" end
  end
  return out
end

public function snake_case(text: Text) returns Text
  purpose: `userName` as `user_name`, `HTTPClient` as `http_client` (decision C5), for a fix.

  let chars be text.characters()
  let mutable out be ""
  let mutable index be 0
  for each ch in chars
    if is_upper(ch) then
      let previous be char_at(chars: chars, index: index - 1)
      let following be char_at(chars: chars, index: index + 1)
      let after_lower be index is greater than 0 and (is_lower(previous) or is_digit(previous))
      let after_upper be index is greater than 0 and is_upper(previous)
      if (after_lower or (after_upper and is_lower(following))) and not out.ends_with("_") then
        change out to "{out}_"
      end
      change out to "{out}{ch.to_lower()}"
    otherwise
      change out to "{out}{ch}"
    end
    change index to index + 1
  end
  return out
end

function lex_comment(chars: List of Text, position: Integer, limit: Integer) returns Step
  let stop be line_end(chars: chars, position: position, limit: limit)
  return single(kind: CommentToken, chars: chars, start: position, stop: stop)
end

function lex_number(chars: List of Text, position: Integer, limit: Integer) returns Step
  let mutable stop be scan_digits(chars: chars, start: position, limit: limit, underscores: true)
  let mutable kind be IntegerToken
  if stop + 1 is less than limit
    and char_at(chars: chars, index: stop) is "."
    and is_digit(char_at(chars: chars, index: stop + 1)) then
    change stop to scan_digits(chars: chars, start: stop + 1, limit: limit, underscores: false)
    change kind to DecimalToken
  end
  let next_char be char_at(chars: chars, index: stop)
  let runs_on be is_lower(next_char) or is_upper(next_char) or next_char is "_"
  if stop is less than limit and runs_on then
    let bad_stop be scan_name_tail(chars: chars, start: stop, limit: limit)
    let diagnostic be report.error(
      code: "number-shape",
      message: "a number cannot run into letters",
      span: Span(start: position, stop: bad_stop),
      fix: "separate the number and the name with a space or an operator"
    )
    return error_token(chars: chars, start: position, stop: bad_stop, diagnostic: diagnostic)
  end
  let step be single(kind: kind, chars: chars, start: position, stop: stop)
  if char_at(chars: chars, index: stop - 1) is "_" then
    let diagnostic be report.bare_error(
      code: "number-shape",
      message: "a number cannot end with an underscore",
      span: Span(start: position, stop: stop)
    )
    return flagged(step: step, diagnostic: diagnostic)
  end
  return step
end

function lex_type_name(chars: List of Text, position: Integer, limit: Integer) returns Step
  let stop be scan_alphanumeric(chars: chars, start: position, limit: limit)
  if stop is less than limit and char_at(chars: chars, index: stop) is "_" then
    let full_stop be scan_name_tail(chars: chars, start: stop, limit: limit)
    let diagnostic be report.error(
      code: "type-name-shape",
      message: "type, ability and variant names are PascalCase without underscores",
      span: Span(start: position, stop: full_stop),
      fix: "remove the underscores and capitalize each word"
    )
    return error_token(chars: chars, start: position, stop: full_stop, diagnostic: diagnostic)
  end
  return single(kind: TypeIdentifier, chars: chars, start: position, stop: stop)
end

function lex_word(chars: List of Text, position: Integer, limit: Integer, previous: maybe Token)
  returns Step

  let stop be scan_word(chars: chars, start: position, limit: limit)
  let text be slice(chars: chars, start: position, stop: stop)
  if stop is less than limit and upper_letters.contains(chars.at(stop) otherwise "") then
    return camel_case_word(
      chars: chars,
      position: position,
      stop: stop,
      limit: limit,
      previous: previous
    )
  end
  let span be Span(start: position, stop: stop)
  if previous_is_adjacent_dot(previous: previous, start: position) then
    return Single(token: Token(kind: MemberName, text: text, span: span))
  end
  if reserved_set.contains(text) then
    return lex_reserved(chars: chars, position: position, stop: stop, limit: limit)
  end
  let step be Single(token: Token(kind: Identifier, text: text, span: span))
  if text.length() is 1 then
    let diagnostic be report.error(
      code: "single-letter-identifier",
      message: "single-letter name `{text}`",
      span: span,
      fix: "use a word that says what the value is"
    )
    return flagged(step: step, diagnostic: diagnostic)
  end
  if text.ends_with("_") or text.contains("__") then
    let diagnostic be report.error(
      code: "identifier-shape",
      message: "name `{text}` has a trailing or doubled underscore",
      span: span,
      fix: "separate words with single underscores"
    )
    return flagged(step: step, diagnostic: diagnostic)
  end
  return step
end

function camel_case_word(
  chars: List of Text,
  position: Integer,
  stop: Integer,
  limit: Integer,
  previous: maybe Token
)
  returns Step
  purpose: `userName`: one name in another language's casing (decision C5), kept as one token.

  let full_stop be scan_name_tail(chars: chars, start: stop, limit: limit)
  let full be slice(chars: chars, start: position, stop: full_stop)
  let kind be
    if previous_is_adjacent_dot(previous: previous, start: position) then MemberName
    otherwise Identifier
    end
  let diagnostic be report.error(
    code: "identifier-shape",
    message: "name `{full}` is not snake_case",
    span: Span(start: position, stop: full_stop),
    fix: "write `{snake_case(full)}`"
  )
  let step be single(kind: kind, chars: chars, start: position, stop: full_stop)
  return flagged(step: step, diagnostic: diagnostic)
end

function lex_reserved(chars: List of Text, position: Integer, stop: Integer, limit: Integer)
  returns Step

  let first_word be slice(chars: chars, start: position, stop: stop)
  let phrase be
    if phrase_starter_set.contains(first_word) then longest_phrase(
      chars: chars,
      first_word: first_word,
      stop: stop,
      limit: limit
    )
    otherwise Phrase(spelling: first_word, stop: stop)
    end
  let word be Token(
    kind: Word(spelling: phrase.spelling),
    text: slice(chars: chars, start: position, stop: phrase.stop),
    span: Span(start: position, stop: phrase.stop)
  )
  let colon be phrase.stop
  if clause_words.contains(phrase.spelling)
    and at_line_start(chars: chars, offset: position)
    and colon is less than limit
    and char_at(chars: chars, index: colon) is ":" then
    let colon_token be Token(
      kind: Symbol(text: ":"),
      text: ":",
      span: Span(start: colon, stop: colon + 1)
    )
    let text_start be scan_spaces(chars: chars, start: colon + 1, limit: limit)
    let text_stop be line_end(chars: chars, position: text_start, limit: limit)
    let clause be slice(chars: chars, start: text_start, stop: text_stop)
    let clause_token be Token(
      kind: ClauseToken(text: clause.trim_end()),
      text: clause,
      span: Span(start: text_start, stop: text_stop)
    )
    return Several(tokens: [word, colon_token, clause_token], diagnostics: [], next: text_stop)
  end
  return Single(token: word)
end

function longest_phrase(chars: List of Text, first_word: Text, stop: Integer, limit: Integer)
  returns Phrase

  let mutable spelling be first_word
  let mutable best be Phrase(spelling: first_word, stop: stop)
  let mutable position be stop
  let mutable attempts be 0
  repeat until attempts is 2
    change attempts to attempts + 1
    if position + 1 is less than limit
      and char_at(chars: chars, index: position) is " "
      and is_lower(char_at(chars: chars, index: position + 1)) then
      let word_stop be scan_word(chars: chars, start: position + 1, limit: limit)
      let word be slice(chars: chars, start: position + 1, stop: word_stop)
      change spelling to "{spelling} {word}"
      change position to word_stop
      if phrase_set.contains(spelling) then
        change best to Phrase(spelling: spelling, stop: word_stop)
      end
    otherwise
      change attempts to 2
    end
  end
  return best
end

function lex_text(chars: List of Text, position: Integer, limit: Integer, previous: maybe Token)
  returns Step

  if slice(chars: chars, start: position, stop: position + 3) is "\"\"\"" then
    return lex_block_text(chars: chars, position: position, limit: limit)
  end
  let raw_pending be
    match previous
      when some(token) then
        match token.kind
          when Word(spelling: spelling) then spelling is "raw"
          otherwise false
        end
      otherwise false
    end
  if raw_pending then return lex_raw_text(chars: chars, position: position, limit: limit) end
  return lex_simple_text(chars: chars, position: position, limit: limit)
end

function lex_raw_text(chars: List of Text, position: Integer, limit: Integer) returns Step
  let mutable stop be position + 1
  repeat until stop is at least limit
    or (chars.at(stop) otherwise "") is "\""
    or (chars.at(stop) otherwise "") is "\n"
    change stop to stop + 1
  end
  if stop is at least limit or char_at(chars: chars, index: stop) is not "\"" then
    let diagnostic be report.bare_error(
      code: "unterminated-text",
      message: "raw text without a closing quote",
      span: Span(start: position, stop: stop)
    )
    return error_token(chars: chars, start: position, stop: stop, diagnostic: diagnostic)
  end
  let content be slice(chars: chars, start: position + 1, stop: stop)
  return single(kind: RawToken(text: content), chars: chars, start: position, stop: stop + 1)
end

function simple_text_end(chars: List of Text, position: Integer, limit: Integer) returns Integer
  let mutable stop be position + 1
  let mutable done be false
  repeat until done or stop is at least limit
    let ch be chars.at(stop) otherwise ""
    if ch is "\"" or ch is "\n" then
      change done to true
    otherwise if ch is "\\" then
      change stop to stop + 2
    otherwise if ch is "\{" then
      change stop to hole_close(chars: chars, position: stop, limit: limit)
    otherwise
      change stop to stop + 1
    end
  end
  return stop
end

function hole_close(chars: List of Text, position: Integer, limit: Integer) returns Integer
  let stop be line_end(chars: chars, position: position, limit: limit)
  let mutable index be position
  repeat until index is at least stop or (chars.at(index) otherwise "") is "}"
    change index to index + 1
  end
  if index is at least stop then return position + 1 end
  return index + 1
end

function lex_simple_text(chars: List of Text, position: Integer, limit: Integer) returns Step
  let stop be simple_text_end(chars: chars, position: position, limit: limit)
  if stop is at least limit or char_at(chars: chars, index: stop) is not "\"" then
    let clamped be stop.at_most(limit)
    let diagnostic be report.error(
      code: "unterminated-text",
      message: "text without a closing quote on the same line",
      span: Span(start: position, stop: clamped),
      fix: "close the quote, or use `\"\"\"` for text that spans lines"
    )
    return error_token(chars: chars, start: position, stop: clamped, diagnostic: diagnostic)
  end
  let segment be scan_segment(chars: chars, start: position + 1, stop: stop, parts: [])
  let token be Token(
    kind: TextToken(parts: segment.parts, is_block: false),
    text: slice(chars: chars, start: position, stop: stop + 1),
    span: Span(start: position, stop: stop + 1)
  )
  if segment.diagnostics.is_empty() then return Single(token: token) end
  return Several(tokens: [token], diagnostics: segment.diagnostics, next: stop + 1)
end

function lex_block_text(chars: List of Text, position: Integer, limit: Integer) returns Step
  let after_quotes be position + 3
  let first_line_end be line_end(chars: chars, position: after_quotes, limit: limit)
  let mutable diagnostics: List of Diagnostic be []
  if slice(chars: chars, start: after_quotes, stop: first_line_end).trim() is not "" then
    let diagnostic be report.error(
      code: "block-text-start",
      message: "block text starts on the line after the opening quotes",
      span: Span(start: after_quotes, stop: first_line_end),
      fix: "move the text to the next line"
    )
    change diagnostics to [diagnostic]
  end
  let block be
    match block_lines(chars: chars, cursor: first_line_end, limit: limit)
      when some(found) then found
      when nothing then
        return unterminated_block(
          chars: chars,
          position: position,
          limit: limit,
          diagnostics: diagnostics
        )
    end
  let indent be common_indent(chars: chars, lines: block.lines)
  let mutable parts: List of Part be []
  let mutable index be 0
  for each line in block.lines
    if index is greater than 0 then change parts to push_text(parts: parts, text: "\n") end
    change index to index + 1
    let content_start be (line.start + indent).at_most(line.stop)
    let segment be scan_segment(chars: chars, start: content_start, stop: line.stop, parts: parts)
    change parts to segment.parts
    change diagnostics to diagnostics.append_all(segment.diagnostics)
  end
  let token be Token(
    kind: TextToken(parts: parts, is_block: true),
    text: slice(chars: chars, start: position, stop: block.closing.stop),
    span: Span(start: position, stop: block.closing.stop)
  )
  return Several(tokens: [token], diagnostics: diagnostics, next: block.closing.stop)
end

function unterminated_block(
  chars: List of Text,
  position: Integer,
  limit: Integer,
  diagnostics: List of Diagnostic
)
  returns Step
  purpose: Block text without closing quotes: one error token to the end of the file.

  let unterminated be report.bare_error(
    code: "unterminated-block-text",
    message: "block text without closing `\"\"\"` on its own line",
    span: Span(start: position, stop: limit)
  )
  let token be Token(
    kind: ErrorToken,
    text: slice(chars: chars, start: position, stop: limit),
    span: Span(start: position, stop: limit)
  )
  return Several(tokens: [token], diagnostics: diagnostics.append(unterminated), next: limit)
end

function block_lines(chars: List of Text, cursor: Integer, limit: Integer) returns maybe BlockLines
  purpose: The content lines up to the closing quotes on their own line; nothing without them.

  let mutable lines: List of Span be []
  let mutable position be cursor
  repeat until position is at least limit
    let line_start be position + 1
    let line_stop be line_end(chars: chars, position: line_start, limit: limit)
    let line be slice(chars: chars, start: line_start, stop: line_stop)
    if line.trim() is "\"\"\"" then
      let quote_start be line_start + (line.index_of("\"") otherwise 0)
      return BlockLines(lines: lines, closing: Span(start: quote_start, stop: quote_start + 3))
    end
    change lines to lines.append(Span(start: line_start, stop: line_stop))
    change position to line_stop
  end
  return nothing
end

function common_indent(chars: List of Text, lines: List of Span) returns Integer
  let mutable indent: maybe Integer be nothing
  for each line in lines
    where slice(chars: chars, start: line.start, stop: line.stop).trim() is not ""
    let content be scan_spaces(chars: chars, start: line.start, limit: line.stop)
    let spaces be content - line.start
    change indent to
      match indent
        when nothing then spaces
        when some(smallest) then smallest.at_most(spaces)
      end
  end
  return indent otherwise 0
end

function push_text(parts: List of Part, text: Text) returns List of Part
  match parts.last()
    when some(Characters(text: last)) then
      return parts.without_last().append(Characters(text: "{last}{text}"))
    otherwise return parts.append(Characters(text: text))
  end
end

function scan_segment(chars: List of Text, start: Integer, stop: Integer, parts: List of Part)
  returns Segment
  purpose: Escapes and `{holes}` within one line of text content, with the diagnostics met.

  let mutable out be parts
  let mutable diagnostics: List of Diagnostic be []
  let mutable buffer be ""
  let mutable position be start
  repeat until position is at least stop
    let ch be chars.at(position) otherwise ""
    if ch is "\\" then
      let piece be escape(chars: chars, position: position, stop: stop)
      change buffer to "{buffer}{piece.text}"
      change diagnostics to diagnostics.append_all(piece.diagnostics)
      change position to (position + 2).at_most(stop)
    otherwise if ch is "\{" then
      let hole_stop be hole_end(chars: chars, start: position + 1, stop: stop)
      if hole_stop is at least stop then
        let unterminated be report.error(
          code: "unterminated-hole",
          message: "`\{` without a closing `}` in text",
          span: Span(start: position, stop: stop),
          fix: "close the hole, or write `\\\{` for a literal brace"
        )
        change diagnostics to diagnostics.append(unterminated)
        change position to stop
      otherwise
        let hole be hole_part(chars: chars, position: position, hole_stop: hole_stop)
        if buffer is not "" then
          change out to push_text(parts: out, text: buffer)
          change buffer to ""
        end
        change out to out.append(hole.part)
        change diagnostics to diagnostics.append_all(hole.diagnostics)
        change position to hole_stop + 1
      end
    otherwise
      let run_stop be plain_run_end(chars: chars, start: position + 1, stop: stop)
      change buffer to "{buffer}{slice(chars: chars, start: position, stop: run_stop)}"
      change position to run_stop
    end
  end
  if buffer is not "" then change out to push_text(parts: out, text: buffer) end
  return Segment(parts: out, diagnostics: diagnostics)
end

function plain_run_end(chars: List of Text, start: Integer, stop: Integer) returns Integer
  purpose: The end of the run of characters from start that are neither an escape nor a hole.

  let mutable position be start
  let mutable scanning be position is less than stop
  repeat until not scanning
    let ch be chars.at(position) otherwise ""
    if ch is "\\" or ch is "\{" then
      change scanning to false
    otherwise
      change position to position + 1
      change scanning to position is less than stop
    end
  end
  return position
end

type Hole
  purpose: The part a hole became and the diagnostics about it, its own tokens' among them.
  has part: Part
  has diagnostics: List of Diagnostic
end

function hole_part(chars: List of Text, position: Integer, hole_stop: Integer) returns Hole
  purpose: The tokens of a hole; an empty hole or a text literal inside it is reported first.

  let hole_start be position + 1
  let hole be slice(chars: chars, start: hole_start, stop: hole_stop)
  let mutable diagnostics: List of Diagnostic be []
  if hole.trim() is "" then
    let empty be report.error(
      code: "empty-hole",
      message: "empty `\{}` in text",
      span: Span(start: position, stop: hole_stop + 1),
      fix: "put an expression in the hole, or write `\\\{}` for a literal brace"
    )
    change diagnostics to [empty]
  otherwise if hole.contains("\"") then
    let quoted be report.error(
      code: "text-in-hole",
      message: "a text literal inside a hole",
      span: Span(start: hole_start, stop: hole_stop),
      fix: "bind the text to a name first and use the name in the hole"
    )
    change diagnostics to [quoted]
  end
  let inner be lex_range(chars: chars, start: hole_start, limit: hole_stop)
  return Hole(
    part: HolePart(tokens: inner.tokens),
    diagnostics: diagnostics.append_all(inner.diagnostics)
  )
end

function hole_end(chars: List of Text, start: Integer, stop: Integer) returns Integer
  let mutable index be start
  repeat until index is at least stop or (chars.at(index) otherwise "") is "}"
    change index to index + 1
  end
  return index
end

type Escape
  purpose: What an escape sequence stands for, or nothing and a diagnostic for an unknown one.
  has text: Text
  has diagnostics: List of Diagnostic
end

function escape(chars: List of Text, position: Integer, stop: Integer) returns Escape
  purpose: What an escape stands for; the character after the backslash may lie past the segment.

  let code be char_at(chars: chars, index: position + 1)
  if code is "n" then return Escape(text: "\n", diagnostics: []) end
  if code is "t" then return Escape(text: "\t", diagnostics: []) end
  if code is "\"" then return Escape(text: "\"", diagnostics: []) end
  if code is "\\" then return Escape(text: "\\", diagnostics: []) end
  if code is "\{" then return Escape(text: "\{", diagnostics: []) end
  let bad_stop be (position + 2).at_most(stop)
  let shown be slice(chars: chars, start: position, stop: bad_stop)
  let diagnostic be report.error(
    code: "unknown-escape",
    message: "unknown escape `{shown}`",
    span: Span(start: position, stop: bad_stop),
    fix: "the escapes are \\n \\t \\\" \\\\ and \\\{"
  )
  return Escape(text: "", diagnostics: [diagnostic])
end
