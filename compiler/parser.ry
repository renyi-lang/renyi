module parser
  purpose: Tokens to the syntax tree, rule for rule as the Rust parser, with its diagnostics.

import words
import ast exposing Span,
  Name,
  TypeName,
  Module,
  Comment,
  Import,
  Item,
  Docs,
  Example,
  ExampleOutcome,
  Function,
  Param,
  Capability,
  Budget,
  Sink,
  ForAny,
  Constraint,
  Type,
  TypeDefinition,
  TypeKind,
  Field,
  Variant,
  Derive,
  Ability,
  Implementation,
  Constant,
  Test,
  Block,
  Statement,
  Branch,
  Arm,
  SortOrder,
  Pattern,
  FieldPattern,
  Expr,
  TextPiece,
  MapEntry,
  Arg,
  BinaryOp,
  Outcome,
  ExprBranch,
  ExprArm,
  QuerySource,
  QueryTerminal
import lexer exposing Token, TokenKind, Part, Lexed
import report exposing Diagnostic

public type ParsedModule
  purpose: The tree of a text, partial after an error, and its diagnostics in the Rust order.
  has tree: Module
  has diagnostics: List of Diagnostic
end

type Cursor
  purpose: The looked-at token and its index, the open brackets, the mode, the diagnostics so far.
  has tokens: List of Token
  has position: Integer
  has look: Integer
  has token: Token
  has nesting: Integer
  has declarations: Boolean
  has diagnostics: List of Diagnostic
  has chars: List of Text
end

type Halt
  purpose: A construct that could not be parsed: the cursor where it stopped, its diagnostics in it.
  has cursor: Cursor
end

type Peek
  purpose: A token and the cursor after looking at it or past it.
  has token: Token
  has cursor: Cursor
end

type Eaten
  purpose: Whether an optional token was there, and the cursor after it.
  has found: Boolean
  has cursor: Cursor
end

type Parsed of Node
  purpose: A parsed node and the cursor after it.
  has node: Node
  has cursor: Cursor
end

type Signature
  purpose: The clauses of a function head or a function type.
  has result: maybe Type
  has failures: List of Type
  has capabilities: List of Capability
  has type_params: maybe ForAny
  has cursor: Cursor
end

type CapabilityPath
  purpose: A capability path with its scope.
  has path: List of Name
  has scope: maybe Text
  has cursor: Cursor
end

type LoopSource
  purpose: The bindings and the source of a loop or a query.
  has bindings: List of Name
  has source: Expr
  has cursor: Cursor
end

type OptionalExpr
  purpose: An expression that may be absent, and the cursor after it.
  has value: maybe Expr
  has cursor: Cursor
end

type EmptyRule
  purpose: What a bracketed list that must not be empty says when it is.
  has what: Text
  has fix: Text
end

let continuation_words: List of Text be [
  "where",
  "sorted by",
  "group by",
  "collect",
  "sum",
  "count",
  "first",
  "any",
  "all",
  "returns",
  "or fails with",
  "needs",
  "for any",
  "with",
  "and",
  "or",
  "is",
  "fails"
]

let item_words: List of Text be ["public", "function", "type", "ability", "test", "let", "import"]

let budget_units: List of Text be ["second", "minute", "hour", "day", "run"]

public function parse(lexed: Lexed, chars: List of Text, declarations: Boolean) returns ParsedModule
  purpose: The module of a lexed text, comments set aside; the lexer's diagnostics come first.

  let mutable significant: List of Token be []
  let mutable comments: List of Comment be []
  for each token in lexed.tokens
    if token.kind is CommentToken then
      change comments to comments.append(Comment(text: token.text.trim_end(), span: token.span))
    otherwise
      change significant to significant.append(token)
    end
  end
  let final_token be significant.last() otherwise crash with "the token list is empty"
  let opened be Cursor(
    tokens: significant,
    position: 0,
    look: 0,
    token: final_token,
    nesting: 0,
    declarations: declarations,
    diagnostics: lexed.diagnostics,
    chars: chars
  )
  let parsed be parse_module(at_position(cursor: opened, position: 0))
  return ParsedModule(
    tree: (parsed.node with comments: comments),
    diagnostics: parsed.cursor.diagnostics
  )
end

function parse_hole(cursor: Cursor, tokens: List of Token) returns Parsed of Expr
  purpose: A run of tokens as one expression; what went wrong joins the outer cursor's diagnostics.

  let span be
    match tokens.first()
      when some(head) then join(left: head.span, right: hole_last_span(tokens))
      when nothing then Span(start: 0, stop: 0)
    end
  let eof be lexer.make_token(
    kind: EndOfFile,
    text: "",
    span: Span(start: span.stop, stop: span.stop)
  )
  let opened be Cursor(
    tokens: tokens.append(eof),
    position: 0,
    look: 0,
    token: eof,
    nesting: 1,
    declarations: false,
    diagnostics: [],
    chars: cursor.chars
  )
  let inner be at_position(cursor: opened, position: 0)
  let parsed be
    match expression(inner)
      when success(found) then found
      when failure(Halt(cursor: halted)) then
        Parsed(node: NothingLiteral(span: span), cursor: halted)
    end
  let look be peek(parsed.cursor)
  let look_token be look.token
  let mutable after be look.cursor
  if look_token.kind is not EndOfFile then
    let diagnostic be report.error(
      code: "hole-syntax",
      message: "a hole holds exactly one expression",
      span: look_token.span,
      fix: "bind the rest to a name first, and write `\{name}`"
    )
    change after to diagnose(cursor: after, diagnostic: diagnostic)
  end
  let diagnostics be cursor.diagnostics.append_all(after.diagnostics)
  return Parsed(node: parsed.node, cursor: cursor with diagnostics: diagnostics)
end

function hole_last_span(tokens: List of Token) returns Span
  match tokens.last()
    when some(last_token) then return last_token.span
    when nothing then return Span(start: 0, stop: 0)
  end
end

function join(left: Span, right: Span) returns Span
  return Span(start: left.start.at_most(right.start), stop: left.stop.at_least(right.stop))
end

function diagnose(cursor: Cursor, diagnostic: Diagnostic) returns Cursor
  purpose: The cursor with one more diagnostic.

  return cursor with diagnostics: cursor.diagnostics.append(diagnostic)
end

function halt(cursor: Cursor, diagnostic: Diagnostic) returns Halt
  purpose: A stop with its diagnostic recorded.

  return Halt(cursor: diagnose(cursor: cursor, diagnostic: diagnostic))
end

function text_of(cursor: Cursor, span: Span) returns Text
  purpose: The source text a span covers.

  return cursor.chars.slice_text(start: span.start, stop: span.stop)
end

function end_token(cursor: Cursor) returns Token
  purpose: The token past the end, which is the last one, EndOfFile.

  return cursor.tokens.last() otherwise crash with "the token list is empty"
end

function token_under(cursor: Cursor) returns Token
  return (cursor.tokens.at(cursor.position) otherwise end_token(cursor))
end

function previous(cursor: Cursor) returns Token
  return (cursor.tokens.at(cursor.position - 1) otherwise end_token(cursor))
end

function token_for(cursor: Cursor, span: Span) returns Token
  purpose: The token with this span near the cursor, else the one under the cursor.

  let low be (cursor.position - 2).at_least(0)
  let high be (cursor.position + 2).at_most(cursor.tokens.length())
  let mutable index be low
  repeat until index is at least high
    let candidate be (cursor.tokens.at(index) otherwise end_token(cursor))
    if candidate.span.start is span.start and candidate.span.stop is span.stop then
      return candidate
    end
    change index to index + 1
  end
  return (cursor.tokens.at(
    cursor.position.at_most(cursor.tokens.length() - 1)
  ) otherwise end_token(cursor))
end

function describe(cursor: Cursor, token: Token, span: Span) returns Text
  purpose: What was found, for a message: the end of the line or the file, or the text in backticks.

  match token.kind
    when LineBreak then return "the end of the line"
    when EndOfFile then return "the end of the file"
    otherwise return "`{text_of(cursor: cursor, span: span)}`"
  end
end

function expected(cursor: Cursor, what: Text, span: Span, fix: Text) returns Cursor
  purpose: `expected X, found Y` with its fix, or the Renyi spelling of a foreign token (C4).

  let token be token_for(cursor: cursor, span: span)
  if token.kind is ErrorToken then return cursor end
  let found be describe(cursor: cursor, token: token, span: span)
  let fix_text be foreign_spelling(token) otherwise fix
  let diagnostic be report.error(
    code: "expected",
    message: "expected {what}, found {found}",
    span: span,
    fix: fix_text
  )
  return diagnose(cursor: cursor, diagnostic: diagnostic)
end

function foreign_spelling(token: Token) returns maybe Text
  purpose: The Renyi spelling of a keyword or symbol of another language (decision C4), for a fix.

  match token.kind
    when Identifier then return foreign_identifier(token.text)
    when TypeIdentifier then return foreign_type_name(token.text)
    when Word(spelling: "than") then
      return "the comparisons are `is greater than`, `is less than`, `is at least` and `is at most`"
    when Word(spelling: "for") then return "write `for each item in items`"
    when Symbol(text: "\{") then return "a block is `then ... end`, without braces"
    when Symbol(text: "}") then return "write `end`"
    otherwise return nothing
  end
end

function foreign_identifier(text: Text) returns maybe Text
  if text is "while" then return "write `repeat until` with the opposite condition" end
  if text is "loop" or text is "do" then return "write `repeat until condition`" end
  if text is "else" or text is "elif" or text is "elsif" or text is "elseif" then
    return "write `otherwise`, or `otherwise if condition then`"
  end
  if text is "def" or text is "fn" or text is "func" or text is "fun" or text is "lambda" then
    return "write `function`"
  end
  if text is "var" or text is "const" or text is "val" then
    return "write `let`, or `let mutable` for a value that changes"
  end
  if text is "switch" then return "write `match`" end
  if text is "case" then return "write `when pattern then`" end
  if text is "foreach" then return "write `for each`" end
  if text is "throw" or text is "raise" then return "write `fail with`" end
  if text is "null" or text is "nil" or text is "undefined" then return "write `nothing`" end
  if text is "this" then return "write `self`" end
  if is_foreign_type_word(text) then
    return "write `type Name`, or `ability Name` for a set of methods"
  end
  return nothing
end

function is_foreign_type_word(text: Text) returns Boolean
  return text is "class"
    or text is "struct"
    or text is "record"
    or text is "enum"
    or text is "interface"
    or text is "trait"
end

function foreign_type_name(text: Text) returns maybe Text
  if text is "True" or text is "False" then return "write `true` or `false`" end
  if text is "None" or text is "Null" or text is "Nil" then return "write `nothing`" end
  return nothing
end

function span_from(start: Integer, cursor: Cursor) returns Span
  return Span(start: start, stop: previous(cursor).span.stop)
end

function is_plain_word(token: Token) returns Boolean
  match token.kind
    when Word(spelling) then return not spelling.contains(" ")
    otherwise return false
  end
end

function continues(token: Token) returns Boolean
  match token.kind
    when Word(spelling) then return continuation_words.contains(spelling)
    otherwise return false
  end
end

function after_breaks(cursor: Cursor, index: Integer) returns Integer
  let mutable next be index
  repeat until (cursor.tokens.at(next) otherwise end_token(cursor)).kind is not LineBreak
    change next to next + 1
  end
  return next
end

function at_position(cursor: Cursor, position: Integer) returns Cursor
  purpose: The cursor at a position, with its look and the looked-at token computed once there.

  let token be cursor.tokens.at(position) otherwise end_token(cursor)
  if token.kind is not LineBreak then
    return cursor with position: position, look: position, token: token
  end
  let next be after_breaks(cursor: cursor, index: position)
  let candidate be (cursor.tokens.at(next) otherwise end_token(cursor))
  let after_comma be position is greater than 0
    and (cursor.tokens.at(position - 1) otherwise end_token(cursor)).code is words.symbol_comma
  if cursor.nesting is greater than 0 or after_comma or continues(candidate) then
    return cursor with position: position, look: next, token: candidate
  end
  return cursor with position: position, look: position, token: token
end

function with_nesting(cursor: Cursor, nesting: Integer) returns Cursor
  purpose: The cursor with its open brackets changed and its look computed again for that.

  let position be cursor.position
  let mutable changed be cursor
  change changed to changed with nesting: nesting
  return at_position(cursor: changed, position: position)
end

function moved(cursor: Cursor, look: Integer) returns Cursor
  purpose: The cursor at its looked-at token, the look and the token kept; itself when they agree.

  if look is cursor.position then return cursor end
  return cursor with position: look
end

function peek(cursor: Cursor) returns Peek
  purpose: The next significant token and the cursor at it, for a caller that keeps both.

  let look be cursor.look
  let token be cursor.token
  let mutable at_look be cursor
  if look is not at_look.position then change at_look to at_look with position: look end
  return Peek(token: token, cursor: at_look)
end

function second_token(cursor: Cursor, look: Integer) returns Token
  purpose: The token after the one at `look`, past the line breaks a bracket or a comma skips.

  let mutable index be look + 1
  let after_comma be cursor.token.code is words.symbol_comma
  if cursor.nesting is greater than 0 or after_comma then
    change index to after_breaks(cursor: cursor, index: index)
  end
  return (cursor.tokens.at(index) otherwise end_token(cursor))
end

function advance(cursor: Cursor) returns Peek
  purpose: The next significant token, consumed, and the cursor after it; the end of the file stays.

  let look be cursor.look
  let token be cursor.token
  if token.kind is EndOfFile then
    let mutable at_look be cursor
    if look is not at_look.position then change at_look to at_look with position: look end
    return Peek(token: token, cursor: at_look)
  end
  return Peek(token: token, cursor: at_position(cursor: cursor, position: look + 1))
end

function bump(cursor: Cursor) returns Cursor
  purpose: `advance` for a caller that drops the token.

  let look be cursor.look
  if cursor.token.kind is EndOfFile then
    if look is not cursor.position then return cursor with position: look end
    return cursor
  end
  return at_position(cursor: cursor, position: look + 1)
end

function eat_word(cursor: Cursor, code: Integer) returns Eaten
  let look be cursor.look
  if cursor.token.code is code then
    return Eaten(found: true, cursor: at_position(cursor: cursor, position: look + 1))
  end
  let mutable at_look be cursor
  if look is not at_look.position then change at_look to at_look with position: look end
  return Eaten(found: false, cursor: at_look)
end

function eat_symbol(cursor: Cursor, code: Integer) returns Eaten
  let look be cursor.look
  if cursor.token.code is code then
    return Eaten(found: true, cursor: at_position(cursor: cursor, position: look + 1))
  end
  let mutable at_look be cursor
  if look is not at_look.position then change at_look to at_look with position: look end
  return Eaten(found: false, cursor: at_look)
end

function past_word(cursor: Cursor, code: Integer) returns Cursor or fails with Halt
  purpose: The cursor past a reserved word that must be there.

  let look be cursor.look
  let token be cursor.token
  if token.code is code then return at_position(cursor: cursor, position: look + 1) end
  let what be "`{words.spelling_of(code)}`"
  let flagged be expected(
    cursor: moved(cursor: cursor, look: look),
    what: what,
    span: token.span,
    fix: "write {what}"
  )
  fail with Halt(cursor: flagged)
end

function expect_word(cursor: Cursor, code: Integer) returns Peek or fails with Halt
  purpose: `past_word` with the word's token, for a caller that keeps its span.

  let after be past_word(cursor: cursor, code: code) otherwise fail
  return Peek(token: previous(after), cursor: after)
end

function past_symbol(cursor: Cursor, code: Integer, what: Text) returns Cursor or fails with Halt
  purpose: The cursor past a symbol that must be there, described by `what` in the message.

  let look be cursor.look
  let token be cursor.token
  if token.code is code then return at_position(cursor: cursor, position: look + 1) end
  let flagged be expected(
    cursor: moved(cursor: cursor, look: look),
    what: what,
    span: token.span,
    fix: "write {what}"
  )
  fail with Halt(cursor: flagged)
end

function expect_symbol(cursor: Cursor, code: Integer, what: Text) returns Peek or fails with Halt
  purpose: `past_symbol` with the symbol's token, for a caller that keeps its span.

  let after be past_symbol(cursor: cursor, code: code, what: what) otherwise fail
  return Peek(token: previous(after), cursor: after)
end

function skip_newlines(cursor: Cursor) returns Cursor
  let next be after_breaks(cursor: cursor, index: cursor.position)
  return at_position(cursor: cursor, position: next)
end

function recover(cursor: Cursor) returns Cursor
  purpose: Skip to the start of the next line after an error; the brackets are closed.

  let mutable position be cursor.position
  repeat until (cursor.tokens.at(position) otherwise end_token(cursor)).kind is LineBreak
    or (cursor.tokens.at(position) otherwise end_token(cursor)).kind is EndOfFile
    change position to position + 1
  end
  return at_position(cursor: with_nesting(cursor: cursor, nesting: 0), position: position)
end

function recovered(halted: Halt) returns Cursor
  purpose: The cursor of a stop, past the end of its line.

  match halted
    when Halt(cursor) then return recover(cursor)
  end
end

function column(cursor: Cursor, offset: Integer) returns Integer
  purpose: The column of an offset, counted in characters from the line start.

  let mutable index be offset
  repeat until index is 0 or (cursor.chars.at(index - 1) otherwise "") is "\n"
    change index to index - 1
  end
  return offset - index
end

function skip_to_next_item(cursor: Cursor) returns Cursor
  purpose: After a failed item, skip lines until one starts a new top-level item at the margin.

  let mutable current be cursor
  let mutable done be false
  repeat until done
    let token be token_under(current)
    if token.kind is EndOfFile then
      change done to true
    otherwise if starts_item(token) and column(cursor: current, offset: token.span.start) is 0 then
      change done to true
    otherwise
      change current to skip_newlines(recover(current))
    end
  end
  return current
end

function starts_item(token: Token) returns Boolean
  match token.kind
    when Word(spelling) then return item_words.contains(spelling)
    otherwise return false
  end
end

function closes_statement(token: Token) returns Boolean
  return token.code is words.word_end
    or token.code is words.word_otherwise
    or token.code is words.word_when
end

function line_end(cursor: Cursor, delimiter_ends_it: Boolean) returns Cursor or fails with Halt
  let token be token_under(cursor)
  if token.kind is LineBreak then return skip_newlines(cursor) end
  if token.kind is EndOfFile then return cursor end
  if delimiter_ends_it and closes_statement(token) then return cursor end
  let after_end be cursor.position is greater than 0 and previous(cursor).code is words.word_end
  let fix be
    if after_end then "`end` closes a block by itself; drop the word after it"
    otherwise if closes_statement(token) then "write `{token.text}` on its own line"
    otherwise "one statement per line; a long line breaks inside parentheses"
    end
  let flagged be expected(cursor: cursor, what: "the end of the line", span: token.span, fix: fix)
  fail with Halt(cursor: flagged)
end

function end_of_line(cursor: Cursor) returns Cursor or fails with Halt
  return line_end(cursor: cursor, delimiter_ends_it: false) otherwise fail
end

function end_of_statement(cursor: Cursor) returns Cursor or fails with Halt
  return line_end(cursor: cursor, delimiter_ends_it: true) otherwise fail
end

function lenient_end_of_line(cursor: Cursor) returns Cursor
  purpose: The end of the line, the diagnostic kept and the cursor left where it is otherwise.

  match end_of_line(cursor)
    when success(after) then return after
    when failure(Halt(cursor: halted)) then return halted
  end
end

function statement_ends_here(cursor: Cursor) returns Boolean
  let token be token_under(cursor)
  return token.kind is LineBreak or token.kind is EndOfFile or closes_statement(token)
end

function element_after_comma(cursor: Cursor, comma: Span, close_code: Integer, what: Text)
  returns Cursor
  or fails with Halt
  purpose: After a comma the next element follows; a comma before the closing bracket is an error.

  let look be cursor.look
  let token be cursor.token
  if token.code is close_code then
    let found be describe(cursor: moved(cursor: cursor, look: look), token: token, span: token.span)
    let diagnostic be report.error(
      code: "expected",
      message: "expected {what} after the comma, found {found}",
      span: comma,
      fix: "drop the comma"
    )
    fail with halt(cursor: moved(cursor: cursor, look: look), diagnostic: diagnostic)
  end
  return moved(cursor: cursor, look: look)
end

function bracketed(
  cursor: Cursor,
  element: function(Cursor) returns Parsed of Item or fails with Halt,
  open: Text,
  close: Text,
  what: Text,
  empty: maybe EmptyRule
)
  returns Parsed of List of Item
  or fails with Halt
  for any Item

  let opened be past_symbol(
    cursor: cursor,
    code: words.symbol_code(open),
    what: "`{open}`"
  ) otherwise fail
  let close_code be words.symbol_code(close)
  let opened_nesting be opened.nesting + 1
  let mutable current be with_nesting(cursor: opened, nesting: opened_nesting)
  let mutable items: List of Item be []
  let mutable done be false
  repeat until done
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is close_code then
      change current to refuse_empty(
        cursor: current,
        token: token,
        items: items,
        empty: empty
      ) otherwise fail
      change done to true
    otherwise
      let item be element(current) otherwise fail
      change items to items.append(item.node)
      change current to item.cursor
      let comma_look be current.look
      let comma be (current.tokens.at(comma_look) otherwise end_token(current))
      if comma.code is words.symbol_comma then
        change current to at_position(cursor: current, position: comma_look + 1)
        change current to element_after_comma(
          cursor: current,
          comma: comma.span,
          close_code: close_code,
          what: what
        ) otherwise fail
      otherwise
        if comma_look is not current.position then
          change current to current with position: comma_look
        end
        change done to true
      end
    end
  end
  let closed_nesting be current.nesting - 1
  change current to with_nesting(cursor: current, nesting: closed_nesting)
  let closed be past_symbol(cursor: current, code: close_code, what: "`{close}`") otherwise fail
  return Parsed(node: items, cursor: closed)
end

function refuse_empty(cursor: Cursor, token: Token, items: List of Item, empty: maybe EmptyRule)
  returns Cursor
  or fails with Halt
  for any Item
  purpose: A closing bracket right after the opening one, in a list that must not be empty.

  let rule be empty otherwise return cursor
  if not items.is_empty() then return cursor end
  let flagged be expected(cursor: cursor, what: rule.what, span: token.span, fix: rule.fix)
  fail with Halt(cursor: flagged)
end

function plain_text(cursor: Cursor, parts: List of Part, span: Span, what: Text)
  returns Text
  or fails with Halt
  purpose: The characters of a text literal without holes: a test name, a scope, a path, a name.

  let mutable text be ""
  for each part in parts
    match part
      when Characters(text: piece) then change text to "{text}{piece}"
      when HolePart then
        let diagnostic be report.error(
          code: "expected",
          message: "expected {what} as plain text, found a text with a hole",
          span: span,
          fix: "write the text without a hole"
        )
        fail with halt(cursor: cursor, diagnostic: diagnostic)
    end
  end
  return text
end

function split_list(text: Text) returns List of Text
  return for each piece in text.split(",") where piece.trim() is not "" collect piece.trim()
end

type Header
  purpose: `module name` and its clauses, or what stood in their place, and the cursor after them.
  has name: List of Name
  has docs: Docs
  has cursor: Cursor
end

function module_header(cursor: Cursor) returns Header
  purpose: `module name` and its clauses; a bad name or a missing header is reported and skipped.

  let look be peek(skip_newlines(cursor))
  let look_token be look.token
  let mutable current be look.cursor
  if look_token.code is not words.word_module then
    let diagnostic be report.error(
      code: "module-header",
      message: "a file starts with `module name`",
      span: look_token.span,
      fix: "write `module name` on the first line, named after the file"
    )
    change current to diagnose(cursor: current, diagnostic: diagnostic)
    return Header(name: [], docs: empty_docs(), cursor: current)
  end
  change current to at_position(cursor: current, position: current.position + 1)
  let mutable name: List of Name be []
  match dotted_name(current)
    when success(path) then
      change name to path.node
      change current to path.cursor
    when failure(Halt(cursor: halted)) then change current to halted
  end
  let clauses be doc_clauses(lenient_end_of_line(current))
  return Header(name: name, docs: clauses.node, cursor: clauses.cursor)
end

function parse_module(cursor: Cursor) returns Parsed of Module
  purpose: `module name`, its clauses, the imports and the items; a bad import or item skips lines.

  let first_look be peek(cursor)
  let start be first_look.token.span.start
  let header be module_header(first_look.cursor)
  let header_name be header.name
  let header_docs be header.docs
  let mutable current be header.cursor
  let mutable imports: List of Import be []
  let mutable items: List of Item be []
  let mutable done be false
  repeat until done
    change current to skip_newlines(current)
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.kind is EndOfFile then
      change done to true
    otherwise if token.code is words.word_import then
      match parse_import(current)
        when success(import_node) then
          change imports to imports.append(import_node.node)
          change current to import_node.cursor
        when failure(Halt(cursor: halted)) then change current to recover(halted)
      end
    otherwise
      match parse_item(current)
        when success(item) then
          change items to items.append(item.node)
          change current to item.cursor
        when failure(Halt(cursor: halted)) then
          change current to skip_to_next_item(skip_newlines(recover(halted)))
      end
    end
  end
  let tree be Module(
    name: header_name,
    docs: header_docs,
    imports: imports,
    items: items,
    comments: [],
    span: Span(start: start, stop: current.chars.length())
  )
  return Parsed(node: tree, cursor: current)
end

function empty_docs() returns Docs
  return Docs(
    summary: nothing,
    labels: [],
    see_also: [],
    deprecation: nothing,
    expose_as_tool: false,
    examples: []
  )
end

function dotted_name(cursor: Cursor) returns Parsed of List of Name or fails with Halt
  let head be identifier(cursor: cursor, what: "a module name") otherwise fail
  let mutable path be [head.node]
  let mutable current be head.cursor
  let mutable done be false
  repeat until done
    let dot be eat_symbol(cursor: current, code: words.symbol_dot)
    let dot_found be dot.found
    change current to dot.cursor
    if dot_found then
      let part be advance(current)
      let part_token be part.token
      change current to part.cursor
      match part_token.kind
        when MemberName then
          change path to path.append(Name(text: part_token.text, span: part_token.span))
        when Identifier then
          let flagged be expected(
            cursor: current,
            what: "a name directly after the dot",
            span: part_token.span,
            fix: "write the next part of the name directly after the dot: `std.console`"
          )
          fail with Halt(cursor: flagged)
        otherwise
          let flagged be expected(
            cursor: current,
            what: "a name after the dot",
            span: part_token.span,
            fix: "write the next part of the name: `std.console`"
          )
          fail with Halt(cursor: flagged)
      end
    otherwise
      change done to true
    end
  end
  return Parsed(node: path, cursor: current)
end

function parse_import(cursor: Cursor) returns Parsed of Import or fails with Halt
  let keyword be advance(cursor)
  let keyword_token be keyword.token
  let path be dotted_name(keyword.cursor) otherwise fail
  let path_node be path.node
  let mutable current be path.cursor
  let mutable alias: maybe Name be nothing
  let as_word be eat_word(cursor: current, code: words.word_as)
  let as_word_found be as_word.found
  change current to as_word.cursor
  if as_word_found then
    let name be identifier(cursor: current, what: "an alias") otherwise fail
    change alias to name.node
    change current to name.cursor
  end
  let mutable exposed: List of TypeName be []
  let exposing_word be eat_word(cursor: current, code: words.word_exposing)
  let exposing_word_found be exposing_word.found
  change current to exposing_word.cursor
  if exposing_word_found then
    let names be type_name_list(cursor: current, what: "a type or ability name") otherwise fail
    change exposed to names.node
    change current to names.cursor
  end
  let stop be previous(current).span
  change current to end_of_line(current) otherwise fail
  let node be Import(
    path: path_node,
    alias: alias,
    exposed: exposed,
    span: join(left: keyword_token.span, right: stop)
  )
  return Parsed(node: node, cursor: current)
end

type Clause
  purpose: A clause's text, absent when its line was malformed, and the cursor after the line.
  has text: maybe Text
  has cursor: Cursor
end

function is_clause_word(spelling: Text) returns Boolean
  return spelling is "purpose"
    or spelling is "tags"
    or spelling is "see also"
    or spelling is "deprecated"
end

function doc_clauses(cursor: Cursor) returns Parsed of Docs
  purpose: Documentation clauses after a head, each known by its clause word; a bad one is skipped.

  let mutable current be cursor
  let mutable docs be empty_docs()
  let mutable done be false
  repeat until done
    change current to skip_newlines(current)
    let token be token_under(current)
    match token.kind
      when Word(spelling) where is_clause_word(spelling) then
        let clause be clause_text(cursor: current, word: spelling)
        change docs to with_clause(docs: docs, word: spelling, text: clause.text)
        change current to clause.cursor
      when Word(spelling: "expose as tool") then
        let after be at_position(cursor: current, position: current.position + 1)
        change docs to docs with expose_as_tool: true
        change current to lenient_end_of_line(after)
      when Word(spelling: "example") then
        let after be at_position(cursor: current, position: current.position + 1)
        let colon be lenient_symbol(cursor: after, text: ":")
        match parse_example(cursor: colon, start: token.span.start)
          when success(sample) then
            change docs to docs with examples: docs.examples.append(sample.node)
            change current to lenient_end_of_line(sample.cursor)
          when failure(Halt(cursor: halted)) then
            change current to lenient_end_of_line(recover(halted))
        end
      otherwise change done to true
    end
  end
  return Parsed(node: docs, cursor: current)
end

function lenient_symbol(cursor: Cursor, text: Text) returns Cursor
  purpose: The symbol if it is there; its absence is recorded and the cursor stays where it is.

  match expect_symbol(cursor: cursor, code: words.symbol_code(text), what: "`{text}`")
    when success(found) then return found.cursor
    when failure(Halt(cursor: halted)) then return halted
  end
end

function clause_text(cursor: Cursor, word: Text) returns Clause
  purpose: The clause word, the colon and the text; a missing piece is reported, the line skipped.

  let next be cursor.position + 1
  let after_word be at_position(cursor: cursor, position: next)
  let colon be
    match expect_symbol(cursor: after_word, code: words.symbol_colon, what: "`:`")
      when success(found) then found.cursor
      when failure(Halt(cursor: halted)) then return Clause(text: nothing, cursor: recover(halted))
    end
  let token be token_under(colon)
  match token.kind
    when ClauseToken(text) then
      let past_text be colon.position + 1
      let consumed be at_position(cursor: colon, position: past_text)
      return Clause(text: text, cursor: lenient_end_of_line(consumed))
    otherwise
      let flagged be expected(
        cursor: colon,
        what: "the text of the clause",
        span: token.span,
        fix: "write the colon directly after the word: `{word}: ...`"
      )
      return Clause(text: nothing, cursor: recover(flagged))
  end
end

function with_clause(docs: Docs, word: Text, text: maybe Text) returns Docs
  let found be text otherwise return docs
  if word is "purpose" then return docs with summary: found end
  if word is "tags" then return docs with labels: split_list(found) end
  if word is "see also" then return docs with see_also: split_list(found) end
  return docs with deprecation: found
end

function parse_example(cursor: Cursor, start: Integer) returns Parsed of Example or fails with Halt
  let expr be expression(cursor) otherwise fail
  let expr_node be expr.node
  let fails_word be eat_word(cursor: expr.cursor, code: words.word_fails)
  if fails_word.found then
    let with_word be past_word(cursor: fails_word.cursor, code: words.word_with) otherwise fail
    let shape be parse_pattern(with_word) otherwise fail
    let sample be Example(
      expression: expr_node,
      outcome: FailsWith(pattern: shape.node),
      span: span_from(start: start, cursor: shape.cursor)
    )
    return Parsed(node: sample, cursor: shape.cursor)
  end
  match expr_node
    when Binary(operator: Is, left, right) then
      let sample be Example(
        expression: left,
        outcome: IsValue(value: right),
        span: span_from(start: start, cursor: fails_word.cursor)
      )
      return Parsed(node: sample, cursor: fails_word.cursor)
    otherwise
      let diagnostic be report.error(
        code: "example-shape",
        message: "an example is `expression is value` or `expression fails with Pattern`",
        span: expr_span(expr_node),
        fix: "write `go(1) is 2`, or `go(0) fails with Oops`"
      )
      fail with halt(cursor: fails_word.cursor, diagnostic: diagnostic)
  end
end

function parse_item(cursor: Cursor) returns Parsed of Item or fails with Halt
  let first_look be peek(cursor)
  let start be first_look.token.span.start
  let public_word be eat_word(cursor: first_look.cursor, code: words.word_public)
  let is_public be public_word.found
  let look be peek(public_word.cursor)
  let look_token be look.token
  let current be look.cursor
  match look_token.kind
    when Word(spelling: "function") then
      let node be parse_function(
        cursor: current,
        is_public: is_public,
        start: start,
        with_body: not current.declarations
      ) otherwise fail
      return Parsed(node: FunctionItem(value: node.node), cursor: node.cursor)
    when Word(spelling: "type") then
      let node be type_definition(
        cursor: current,
        is_public: is_public,
        start: start
      ) otherwise fail
      return Parsed(node: TypeItem(value: node.node), cursor: node.cursor)
    when Word(spelling: "ability") then
      return parse_ability(cursor: current, is_public: is_public, start: start) otherwise fail
    when Word(spelling: "let") then
      let node be parse_constant(cursor: current, is_public: is_public, start: start) otherwise fail
      return Parsed(node: ConstantItem(value: node.node), cursor: node.cursor)
    when Word(spelling: "test") where not is_public then
      let node be test_item(cursor: current, start: start) otherwise fail
      return Parsed(node: TestItem(value: node.node), cursor: node.cursor)
    otherwise fail with Halt(cursor: item_error(cursor: current, token: look_token))
  end
end

function item_error(cursor: Cursor, token: Token) returns Cursor
  purpose: What stands where an item should: a keyword of another language, or anything else.

  match foreign_spelling(token)
    when some(fix) then
      let word be describe(cursor: cursor, token: token, span: token.span)
      let diagnostic be report.error(
        code: "foreign-keyword",
        message: "{word} is not Renyi",
        span: token.span,
        fix: fix
      )
      return diagnose(cursor: cursor, diagnostic: diagnostic)
    when nothing then
      return expected(
        cursor: cursor,
        what: "`function`, `type`, `ability`, `let` or `test` at the top level",
        span: token.span,
        fix: top_level_fix()
      )
  end
end

function top_level_fix() returns Text
  let head be "write `function name(...)`, `type Name`, `ability Name`, "
  return "{head}`let name be value` or `test \"name\"`"
end

function parse_function(cursor: Cursor, is_public: Boolean, start: Integer, with_body: Boolean)
  returns Parsed of Function
  or fails with Halt

  let keyword be past_word(cursor: cursor, code: words.word_function) otherwise fail
  let name be method_or_function_name(keyword) otherwise fail
  let name_node be name.node
  let params be parameters(name.cursor) otherwise fail
  let params_node be params.node
  let signature be signature_clauses(params.cursor) otherwise fail
  let signature_result be signature.result
  let signature_failures be signature.failures
  let signature_capabilities be signature.capabilities
  let signature_type_params be signature.type_params
  let after_head be end_of_line(signature.cursor) otherwise fail
  let docs be doc_clauses(after_head)
  let docs_node be docs.node
  let mutable current be docs.cursor
  let mutable body: maybe Block be nothing
  if with_body then
    let block_node be parse_block(cursor: current, terminators: ["end"]) otherwise fail
    let block_node_node be block_node.node
    let end_word be past_word(cursor: block_node.cursor, code: words.word_end) otherwise fail
    change body to block_node_node
    change current to end_word
  end
  let stop be previous(current).span.stop
  if with_body then change current to end_of_line(current) otherwise fail end
  let node be Function(
    is_public: is_public,
    name: name_node,
    params: params_node,
    result: signature_result,
    failures: signature_failures,
    capabilities: signature_capabilities,
    type_params: signature_type_params,
    docs: docs_node,
    body: body,
    span: Span(start: start, stop: stop)
  )
  return Parsed(node: node, cursor: current)
end

function method_or_function_name(cursor: Cursor) returns Parsed of Name or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let after_name be (cursor.tokens.at(look + 1) otherwise end_token(cursor))
  let after_paren be (cursor.tokens.at(look + 2) otherwise end_token(cursor))
  let is_method be is_plain_word(token)
    and after_name.code is words.symbol_open_paren
    and after_paren.code is words.word_self
  if is_method then
    let name be Name(text: token.text, span: token.span)
    return Parsed(node: name, cursor: at_position(cursor: cursor, position: look + 1))
  end
  return identifier(
    cursor: moved(cursor: cursor, look: look),
    what: "a function name"
  ) otherwise fail
end

function parameters(cursor: Cursor) returns Parsed of List of Param or fails with Halt
  return bracketed(
    cursor: cursor,
    element: parameter,
    open: "(",
    close: ")",
    what: "a parameter",
    empty: nothing
  ) otherwise fail
end

function parameter(cursor: Cursor) returns Parsed of Param or fails with Halt
  let look be cursor.look
  let token be cursor.token
  if token.code is words.word_self then
    let mutable current be at_position(cursor: cursor, position: look + 1)
    let mutable annotation: maybe Type be nothing
    let colon be eat_symbol(cursor: current, code: words.symbol_colon)
    change current to colon.cursor
    if colon.found then
      let parsed be parse_type(current) otherwise fail
      change annotation to parsed.node
      change current to parsed.cursor
    end
    let name be Name(text: "self", span: token.span)
    let span be join(left: token.span, right: previous(current).span)
    return Parsed(node: Param(name: name, annotation: annotation, span: span), cursor: current)
  end
  let name be identifier(
    cursor: moved(cursor: cursor, look: look),
    what: "a parameter name"
  ) otherwise fail
  let colon be past_symbol(
    cursor: name.cursor,
    code: words.symbol_colon,
    what: "`:` and the parameter type"
  ) otherwise fail
  let annotation be parse_type(colon) otherwise fail
  let span be join(left: name.node.span, right: type_span(annotation.node))
  let node be Param(name: name.node, annotation: annotation.node, span: span)
  return Parsed(node: node, cursor: annotation.cursor)
end

function result_clauses(cursor: Cursor) returns Signature or fails with Halt
  let mutable current be cursor
  let mutable result: maybe Type be nothing
  let returns_word be eat_word(cursor: current, code: words.word_returns)
  let returns_word_found be returns_word.found
  change current to returns_word.cursor
  if returns_word_found then
    let parsed be parse_type(current) otherwise fail
    change result to parsed.node
    change current to parsed.cursor
  end
  let failures be failure_types(current) otherwise fail
  let failures_node be failures.node
  change current to failures.cursor
  let mutable capabilities: List of Capability be []
  let needs_word be eat_word(cursor: current, code: words.word_needs)
  let needs_word_found be needs_word.found
  change current to needs_word.cursor
  if needs_word_found then
    let parsed be parse_capabilities(current) otherwise fail
    change capabilities to parsed.node
    change current to parsed.cursor
  end
  return Signature(
    result: result,
    failures: failures_node,
    capabilities: capabilities,
    type_params: nothing,
    cursor: current
  )
end

function signature_clauses(cursor: Cursor) returns Signature or fails with Halt
  let clauses be result_clauses(cursor) otherwise fail
  let look be clauses.cursor.look
  let token be (clauses.cursor.tokens.at(look) otherwise end_token(clauses.cursor))
  if token.code is not words.word_for_any then
    return clauses with cursor: moved(cursor: clauses.cursor, look: look)
  end
  let parsed be parse_for_any(moved(cursor: clauses.cursor, look: look)) otherwise fail
  return clauses with type_params: parsed.node, cursor: parsed.cursor
end

function failure_types(cursor: Cursor) returns Parsed of List of Type or fails with Halt
  let mutable failures: List of Type be []
  let fails_word be eat_word(cursor: cursor, code: words.word_or_fails_with)
  let fails_word_found be fails_word.found
  let mutable current be fails_word.cursor
  if fails_word_found then
    let first_type be parse_type(current) otherwise fail
    change failures to [first_type.node]
    change current to first_type.cursor
    let mutable more be eat_word(cursor: current, code: words.word_or)
    change current to more.cursor
    repeat until not more.found
      let next be parse_type(current) otherwise fail
      change failures to failures.append(next.node)
      change more to eat_word(cursor: next.cursor, code: words.word_or)
      change current to more.cursor
    end
  end
  return Parsed(node: failures, cursor: current)
end

function parse_capabilities(cursor: Cursor) returns Parsed of List of Capability or fails with Halt
  let mutable capabilities: List of Capability be []
  let mutable current be cursor
  let mutable done be false
  repeat until done
    let capability be parse_capability(current) otherwise fail
    change capabilities to capabilities.append(capability.node)
    let look be capability.cursor.look
    let token be (capability.cursor.tokens.at(look) otherwise end_token(capability.cursor))
    change current to moved(cursor: capability.cursor, look: look)
    let comma be token.code is words.symbol_comma
    if not comma or parameter_follows_comma(current) then
      change done to true
    otherwise
      change current to at_position(cursor: current, position: current.position + 1)
    end
  end
  return Parsed(node: capabilities, cursor: current)
end

function parse_capability(cursor: Cursor) returns Parsed of Capability or fails with Halt
  let start be peek(cursor).token.span
  let path be capability_path(cursor) otherwise fail
  let path_path be path.path
  let path_scope be path.scope
  let mutable current be path.cursor
  let mutable budget: maybe Budget be nothing
  let look be current.look
  let token be current.token
  if look is not current.position then change current to current with position: look end
  if token.code is words.word_at_most then
    let parsed be parse_budget(current) otherwise fail
    change budget to parsed.node
    change current to parsed.cursor
  end
  let mutable only_to: List of Sink be []
  let only_word be eat_word(cursor: current, code: words.word_only_to)
  let only_word_found be only_word.found
  change current to only_word.cursor
  if only_word_found then
    let sinks be parse_sinks(current) otherwise fail
    change only_to to sinks.node
    change current to sinks.cursor
  end
  let node be Capability(
    path: path_path,
    scope: path_scope,
    budget: budget,
    only_to: only_to,
    span: join(left: start, right: previous(current).span)
  )
  return Parsed(node: node, cursor: current)
end

function parse_sinks(cursor: Cursor) returns Parsed of List of Sink or fails with Halt
  let mutable sinks: List of Sink be []
  let mutable current be cursor
  let mutable done be false
  repeat until done
    let start be peek(current).token.span
    let path be capability_path(current) otherwise fail
    let path_path be path.path
    let path_scope be path.scope
    let span be join(left: start, right: previous(path.cursor).span)
    change sinks to sinks.append(Sink(path: path_path, scope: path_scope, span: span))
    let or_word be eat_word(cursor: path.cursor, code: words.word_or)
    let or_word_found be or_word.found
    change current to or_word.cursor
    if not or_word_found then change done to true end
  end
  return Parsed(node: sinks, cursor: current)
end

function parameter_follows_comma(cursor: Cursor) returns Boolean
  let mutable index be after_breaks(cursor: cursor, index: cursor.position + 1)
  if (cursor.tokens.at(index) otherwise end_token(cursor)).kind is not Identifier then
    return false
  end
  change index to index + 1
  if cursor.nesting is greater than 0 then
    change index to after_breaks(cursor: cursor, index: index)
  end
  return (cursor.tokens.at(index) otherwise end_token(cursor)).code is words.symbol_colon
end

function capability_path(cursor: Cursor) returns CapabilityPath or fails with Halt
  let path be dotted_name(cursor) otherwise fail
  let path_node be path.node
  let open be eat_symbol(cursor: path.cursor, code: words.symbol_open_paren)
  if not open.found then
    return CapabilityPath(path: path_node, scope: nothing, cursor: open.cursor)
  end
  let inner_nesting be open.cursor.nesting + 1
  let inside be with_nesting(cursor: open.cursor, nesting: inner_nesting)
  let token be advance(inside)
  let token_token be token.token
  match token_token.kind
    when TextToken(parts) then
      let scope be plain_text(
        cursor: token.cursor,
        parts: parts,
        span: token_token.span,
        what: "a capability scope"
      ) otherwise fail
      let outer_nesting be token.cursor.nesting - 1
      let outside be with_nesting(cursor: token.cursor, nesting: outer_nesting)
      let close be past_symbol(
        cursor: outside,
        code: words.symbol_close_paren,
        what: "`)`"
      ) otherwise fail
      return CapabilityPath(path: path_node, scope: scope, cursor: close)
    otherwise
      let diagnostic be report.error(
        code: "capability-scope",
        message: "a capability scope is a text literal",
        span: token_token.span,
        fix: "write the scope in quotes: `filesystem.read(\"data/\")`"
      )
      fail with halt(cursor: token.cursor, diagnostic: diagnostic)
  end
end

function parse_budget(cursor: Cursor) returns Parsed of Budget or fails with Halt
  let start be expect_word(cursor: cursor, code: words.word_at_most) otherwise fail
  let start_token be start.token
  let limit be advance(start.cursor)
  let limit_token be limit.token
  if limit_token.kind is not IntegerToken then
    let flagged be expected(
      cursor: limit.cursor,
      what: "a whole number after `at most`",
      span: limit_token.span,
      fix: "write `at most 10 per minute`"
    )
    fail with Halt(cursor: flagged)
  end
  let per_word be past_word(cursor: limit.cursor, code: words.word_per) otherwise fail
  let unit be advance(per_word)
  let unit_token be unit.token
  let unit_text be text_of(cursor: unit.cursor, span: unit_token.span)
  if not budget_units.contains(unit_text) then
    let diagnostic be report.error(
      code: "expected",
      message: "a budget is per `second`, `minute`, `hour`, `day` or `run`, found `{unit_text}`",
      span: unit_token.span,
      fix: "write `per second`, `per minute`, `per hour`, `per day` or `per run`"
    )
    fail with halt(cursor: unit.cursor, diagnostic: diagnostic)
  end
  let node be Budget(
    limit: text_of(cursor: limit.cursor, span: limit_token.span),
    unit: Name(text: unit_text, span: unit_token.span),
    span: join(left: start_token.span, right: unit_token.span)
  )
  return Parsed(node: node, cursor: unit.cursor)
end

function parse_for_any(cursor: Cursor) returns Parsed of ForAny or fails with Halt
  let start be expect_word(cursor: cursor, code: words.word_for_any) otherwise fail
  let start_token be start.token
  let params be type_name_list(cursor: start.cursor, what: "a type parameter") otherwise fail
  let params_node be params.node
  let mutable current be params.cursor
  let mutable constraints: List of Constraint be []
  let where_word be eat_word(cursor: current, code: words.word_where)
  let where_word_found be where_word.found
  change current to where_word.cursor
  if where_word_found then
    let parsed be parse_constraints(current) otherwise fail
    change constraints to parsed.node
    change current to parsed.cursor
  end
  let node be ForAny(
    params: params_node,
    constraints: constraints,
    span: join(left: start_token.span, right: previous(current).span)
  )
  return Parsed(node: node, cursor: current)
end

function parse_constraints(cursor: Cursor) returns Parsed of List of Constraint or fails with Halt
  let mutable constraints: List of Constraint be []
  let mutable current be cursor
  let mutable done be false
  repeat until done
    let param be type_name(cursor: current, what: "a type parameter") otherwise fail
    let param_node be param.node
    let can_word be past_word(cursor: param.cursor, code: words.word_can) otherwise fail
    let requirement be parse_type(can_word) otherwise fail
    change constraints to constraints.append(
      Constraint(param: param_node, requirement: requirement.node)
    )
    let and_word be eat_word(cursor: requirement.cursor, code: words.word_and)
    let and_word_found be and_word.found
    change current to and_word.cursor
    if not and_word_found then change done to true end
  end
  return Parsed(node: constraints, cursor: current)
end

function type_name_list(cursor: Cursor, what: Text)
  returns Parsed of List of TypeName
  or fails with Halt

  let head be type_name(cursor: cursor, what: what) otherwise fail
  let mutable names be [head.node]
  let mutable current be head.cursor
  let mutable comma be eat_symbol(cursor: current, code: words.symbol_comma)
  change current to comma.cursor
  repeat until not comma.found
    let next be type_name(cursor: current, what: what) otherwise fail
    change names to names.append(next.node)
    change comma to eat_symbol(cursor: next.cursor, code: words.symbol_comma)
    change current to comma.cursor
  end
  return Parsed(node: names, cursor: current)
end

function identifier_list(cursor: Cursor, what: Text)
  returns Parsed of List of Name
  or fails with Halt

  let head be identifier(cursor: cursor, what: what) otherwise fail
  let mutable names be [head.node]
  let mutable current be head.cursor
  let mutable comma be eat_symbol(cursor: current, code: words.symbol_comma)
  change current to comma.cursor
  repeat until not comma.found
    let next be identifier(cursor: current, what: what) otherwise fail
    change names to names.append(next.node)
    change comma to eat_symbol(cursor: next.cursor, code: words.symbol_comma)
    change current to comma.cursor
  end
  return Parsed(node: names, cursor: current)
end

type TypeHead
  purpose: What every shape of a type definition shares: its visibility, name, parameters and start.
  has is_public: Boolean
  has name: TypeName
  has type_params: List of TypeName
  has start: Integer
end

type OptionalOrder
  purpose: A `sorted by` clause that may be absent, and the cursor after it.
  has value: maybe SortOrder
  has cursor: Cursor
end

function type_definition(cursor: Cursor, is_public: Boolean, start: Integer)
  returns Parsed of TypeDefinition
  or fails with Halt

  let keyword be past_word(cursor: cursor, code: words.word_type) otherwise fail
  let name be type_name(cursor: keyword, what: "a type name") otherwise fail
  let name_node be name.node
  let mutable current be name.cursor
  let mutable type_params: List of TypeName be []
  let of_word be eat_word(cursor: current, code: words.word_of)
  let of_word_found be of_word.found
  change current to of_word.cursor
  if of_word_found then
    let params be type_name_list(cursor: current, what: "a type parameter") otherwise fail
    change type_params to params.node
    change current to params.cursor
  end
  let head be TypeHead(
    is_public: is_public,
    name: name_node,
    type_params: type_params,
    start: start
  )
  let sum_word be eat_word(cursor: current, code: words.word_is_one_of)
  if sum_word.found then
    return sum_definition(cursor: sum_word.cursor, head: head) otherwise fail
  end
  let subtype_word be eat_word(cursor: sum_word.cursor, code: words.word_is)
  if subtype_word.found then
    return subtype_definition(cursor: subtype_word.cursor, head: head) otherwise fail
  end
  return record_definition(cursor: subtype_word.cursor, head: head) otherwise fail
end

function definition_of(head: TypeHead, definition: TypeKind, docs: Docs, stop: Integer)
  returns TypeDefinition

  return TypeDefinition(
    is_public: head.is_public,
    name: head.name,
    type_params: head.type_params,
    definition: definition,
    docs: docs,
    span: Span(start: head.start, stop: stop)
  )
end

function sum_definition(cursor: Cursor, head: TypeHead)
  returns Parsed of TypeDefinition
  or fails with Halt

  let after_head be end_of_line(cursor) otherwise fail
  let docs be doc_clauses(after_head)
  let docs_node be docs.node
  let mutable current be docs.cursor
  let mutable variants: List of Variant be []
  let mutable derives: List of Derive be []
  let mutable done be false
  repeat until done
    change current to skip_newlines(current)
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is words.word_end then
      change done to true
    otherwise if token.code is words.word_can then
      let derived be parse_derive(current) otherwise fail
      change derives to derives.append(derived.node)
      change current to derived.cursor
    otherwise
      let variant be parse_variant(current) otherwise fail
      change variants to variants.append(variant.node)
      change current to variant.cursor
    end
  end
  let end_word be expect_word(cursor: current, code: words.word_end) otherwise fail
  let end_word_token be end_word.token
  change current to end_of_line(end_word.cursor) otherwise fail
  let definition be SumDefinition(variants: variants, derives: derives)
  let node be definition_of(
    head: head,
    definition: definition,
    docs: docs_node,
    stop: end_word_token.span.stop
  )
  return Parsed(node: node, cursor: current)
end

function parse_variant(cursor: Cursor) returns Parsed of Variant or fails with Halt
  let name be type_name(cursor: cursor, what: "a variant name") otherwise fail
  let name_node be name.node
  let mutable current be name.cursor
  let mutable fields: List of Field be []
  let look be current.look
  let token be current.token
  if look is not current.position then change current to current with position: look end
  if token.code is words.symbol_open_paren then
    let parsed be bracketed(
      cursor: current,
      element: variant_field,
      open: "(",
      close: ")",
      what: "a field",
      empty: EmptyRule(
        what: "a field inside the parentheses",
        fix: "write `{name_node.text}` without parentheses"
      )
    ) otherwise fail
    change fields to parsed.node
    change current to parsed.cursor
  end
  let span be join(left: name_node.span, right: previous(current).span)
  change current to end_of_line(current) otherwise fail
  return Parsed(node: Variant(name: name_node, fields: fields, span: span), cursor: current)
end

function variant_field(cursor: Cursor) returns Parsed of Field or fails with Halt
  return parse_field(cursor: cursor, allow_external_name: false) otherwise fail
end

function record_field(cursor: Cursor) returns Parsed of Field or fails with Halt
  return parse_field(cursor: cursor, allow_external_name: true) otherwise fail
end

function parse_field(cursor: Cursor, allow_external_name: Boolean)
  returns Parsed of Field
  or fails with Halt

  let name be identifier(cursor: cursor, what: "a field name") otherwise fail
  let name_node be name.node
  let colon be past_symbol(
    cursor: name.cursor,
    code: words.symbol_colon,
    what: "`:` and the field type"
  ) otherwise fail
  let annotation be parse_type(colon) otherwise fail
  let annotation_node be annotation.node
  let refinement be expression_after(cursor: annotation.cursor, spelling: "where") otherwise fail
  let refinement_value be refinement.value
  let mutable current be refinement.cursor
  let mutable external_name: maybe Text be nothing
  if allow_external_name then
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is words.word_as then
      let parsed be external_name_text(
        at_position(cursor: current, position: look + 1)
      ) otherwise fail
      change external_name to parsed.node
      change current to parsed.cursor
    end
  end
  let node be Field(
    name: name_node,
    annotation: annotation_node,
    refinement: refinement_value,
    external_name: external_name,
    span: join(left: name_node.span, right: previous(current).span)
  )
  return Parsed(node: node, cursor: current)
end

function external_name_text(cursor: Cursor) returns Parsed of Text or fails with Halt
  purpose: The text literal after `as` in a field: its external name.

  let token be advance(cursor)
  let token_token be token.token
  match token_token.kind
    when TextToken(parts) then
      let text be plain_text(
        cursor: token.cursor,
        parts: parts,
        span: token_token.span,
        what: "an external name"
      ) otherwise fail
      return Parsed(node: text, cursor: token.cursor)
    otherwise
      let diagnostic be report.error(
        code: "external-name",
        message: "the external name after `as` is a text literal",
        span: token_token.span,
        fix: "write it in quotes: `as \"userName\"`"
      )
      fail with halt(cursor: token.cursor, diagnostic: diagnostic)
  end
end

function text_literal(cursor: Cursor, what: Text, missing: Text, fix: Text)
  returns Parsed of Text
  or fails with Halt
  purpose: A text literal without holes where one is required: a test name, a recording's path.

  let token be advance(cursor)
  let token_token be token.token
  match token_token.kind
    when TextToken(parts) then
      let text be plain_text(
        cursor: token.cursor,
        parts: parts,
        span: token_token.span,
        what: what
      ) otherwise fail
      return Parsed(node: text, cursor: token.cursor)
    otherwise
      let flagged be expected(cursor: token.cursor, what: missing, span: token_token.span, fix: fix)
      fail with Halt(cursor: flagged)
  end
end

function parse_derive(cursor: Cursor) returns Parsed of Derive or fails with Halt
  let start be expect_word(cursor: cursor, code: words.word_can) otherwise fail
  let start_token be start.token
  let ability_name be type_name(cursor: start.cursor, what: "an ability name") otherwise fail
  let ability_name_node be ability_name.node
  let mutable current be ability_name.cursor
  let mutable fields: List of Name be []
  let by_word be eat_word(cursor: current, code: words.word_by)
  let by_word_found be by_word.found
  change current to by_word.cursor
  if by_word_found then
    let names be identifier_list(cursor: current, what: "a field name") otherwise fail
    change fields to names.node
    change current to names.cursor
  end
  let span be join(left: start_token.span, right: previous(current).span)
  change current to end_of_line(current) otherwise fail
  let node be Derive(ability_name: ability_name_node, fields: fields, span: span)
  return Parsed(node: node, cursor: current)
end

function subtype_definition(cursor: Cursor, head: TypeHead)
  returns Parsed of TypeDefinition
  or fails with Halt

  let base be parse_type(cursor) otherwise fail
  let base_node be base.node
  let refinement be expression_after(cursor: base.cursor, spelling: "where") otherwise fail
  let refinement_value be refinement.value
  let stop be previous(refinement.cursor).span.stop
  let after be end_of_line(refinement.cursor) otherwise fail
  let docs be doc_clauses(after)
  let definition be SubtypeDefinition(base: base_node, refinement: refinement_value)
  let node be definition_of(head: head, definition: definition, docs: docs.node, stop: stop)
  return Parsed(node: node, cursor: docs.cursor)
end

function record_definition(cursor: Cursor, head: TypeHead)
  returns Parsed of TypeDefinition
  or fails with Halt

  let after_head be end_of_line(cursor) otherwise fail
  let docs be doc_clauses(after_head)
  let docs_node be docs.node
  let mutable current be docs.cursor
  let mutable fields: List of Field be []
  let mutable derives: List of Derive be []
  let mutable done be false
  repeat until done
    change current to skip_newlines(current)
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is words.word_end then
      change done to true
    otherwise if token.code is words.word_can then
      let derived be parse_derive(current) otherwise fail
      change derives to derives.append(derived.node)
      change current to derived.cursor
    otherwise if token.code is words.word_has then
      let field be record_field(at_position(cursor: current, position: look + 1)) otherwise fail
      change fields to fields.append(field.node)
      change current to end_of_line(field.cursor) otherwise fail
    otherwise
      let flagged be expected(
        cursor: current,
        what: "`has`, `can` or `end` in a type",
        span: token.span,
        fix: "write `has name: Type`, `can Ability`, or `end`"
      )
      fail with Halt(cursor: flagged)
    end
  end
  let end_word be expect_word(cursor: current, code: words.word_end) otherwise fail
  let end_word_token be end_word.token
  change current to end_of_line(end_word.cursor) otherwise fail
  let definition be RecordDefinition(fields: fields, derives: derives)
  let node be definition_of(
    head: head,
    definition: definition,
    docs: docs_node,
    stop: end_word_token.span.stop
  )
  return Parsed(node: node, cursor: current)
end

function parse_ability(cursor: Cursor, is_public: Boolean, start: Integer)
  returns Parsed of Item
  or fails with Halt

  let keyword be past_word(cursor: cursor, code: words.word_ability) otherwise fail
  let name be type_name(cursor: keyword, what: "an ability name") otherwise fail
  let name_node be name.node
  let mutable current be name.cursor
  # after `of`: the parameters of a declaration, which are names, or the
  # arguments of an implementation, which are types (decision AB1)
  let mutable ability_args: List of Type be []
  let of_word be eat_word(cursor: current, code: words.word_of)
  let of_word_found be of_word.found
  change current to of_word.cursor
  if of_word_found then
    let parsed be type_list(current) otherwise fail
    change ability_args to parsed.node
    change current to parsed.cursor
  end
  let for_word be eat_word(cursor: current, code: words.word_for)
  if for_word.found then
    return implementation(
      cursor: for_word.cursor,
      is_public: is_public,
      start: start,
      name: name_node,
      ability_args: ability_args
    ) otherwise fail
  end
  let type_params be parameter_names(
    cursor: for_word.cursor,
    ability_args: ability_args
  ) otherwise fail
  return ability_declaration(
    cursor: for_word.cursor,
    is_public: is_public,
    start: start,
    name: name_node,
    type_params: type_params
  ) otherwise fail
end

function type_list(cursor: Cursor) returns Parsed of List of Type or fails with Halt
  purpose: Types separated by commas, after `of` in an ability's head.

  let head be parse_type(cursor) otherwise fail
  let mutable tys be [head.node]
  let mutable current be head.cursor
  let mutable comma be eat_symbol(cursor: current, code: words.symbol_comma)
  change current to comma.cursor
  repeat until not comma.found
    let next be parse_type(current) otherwise fail
    change tys to tys.append(next.node)
    change comma to eat_symbol(cursor: next.cursor, code: words.symbol_comma)
    change current to comma.cursor
  end
  return Parsed(node: tys, cursor: current)
end

function parameter_names(cursor: Cursor, ability_args: List of Type)
  returns List of TypeName
  or fails with Halt
  purpose: The parameters of an ability declaration are names: `ability Iterable of Item`.

  let mutable names: List of TypeName be []
  for each written in ability_args
    match written
      when NamedType(name, args) where args.is_empty() then change names to names.append(name)
      otherwise
        let flagged be expected(
          cursor: cursor,
          what: "a type parameter",
          span: type_span(written),
          fix: "write a name: `ability Iterable of Item`"
        )
        fail with Halt(cursor: flagged)
    end
  end
  return names
end

function implementation(
  cursor: Cursor,
  is_public: Boolean,
  start: Integer,
  name: TypeName,
  ability_args: List of Type
)
  returns Parsed of Item
  or fails with Halt

  let target be parse_type(cursor) otherwise fail
  let target_node be target.node
  let ability_type be NamedType(name: name, args: ability_args, span: name.span)
  let end_of_head be previous(target.cursor).span
  let mutable current be target.cursor
  let mutable for_any: maybe ForAny be nothing
  let look be current.look
  let token be current.token
  if look is not current.position then change current to current with position: look end
  if token.code is words.word_for_any then
    let parsed be parse_for_any(current) otherwise fail
    change for_any to parsed.node
    change current to parsed.cursor
  end
  change current to end_of_line(current) otherwise fail
  # a declaration file gives the methods' heads alone
  let with_bodies be not cursor.declarations
  let functions be ability_functions(cursor: current, with_bodies: with_bodies) otherwise fail
  let functions_node be functions.node
  let end_word be expect_word(cursor: functions.cursor, code: words.word_end) otherwise fail
  let end_word_token be end_word.token
  change current to end_of_line(end_word.cursor) otherwise fail
  if is_public then
    let diagnostic be report.error(
      code: "public-implementation",
      message: "an implementation is never `public`; the ability and the type are",
      span: Span(start: start, stop: end_of_head.stop),
      fix: "drop `public`"
    )
    change current to diagnose(cursor: current, diagnostic: diagnostic)
  end
  let node be Implementation(
    ability_type: ability_type,
    target: target_node,
    type_params: for_any,
    functions: functions_node,
    span: Span(start: start, stop: end_word_token.span.stop)
  )
  return Parsed(node: ImplementationItem(value: node), cursor: current)
end

function ability_declaration(
  cursor: Cursor,
  is_public: Boolean,
  start: Integer,
  name: TypeName,
  type_params: List of TypeName
)
  returns Parsed of Item
  or fails with Halt

  let mutable current be cursor
  let mutable requirements: List of Type be []
  let where_word be eat_word(cursor: current, code: words.word_where)
  let where_word_found be where_word.found
  change current to where_word.cursor
  if where_word_found then
    let parsed be parse_requirements(current) otherwise fail
    change requirements to parsed.node
    change current to parsed.cursor
  end
  change current to end_of_line(current) otherwise fail
  let docs be doc_clauses(current)
  let docs_node be docs.node
  let functions be ability_functions(cursor: docs.cursor, with_bodies: false) otherwise fail
  let functions_node be functions.node
  let end_word be expect_word(cursor: functions.cursor, code: words.word_end) otherwise fail
  let end_word_token be end_word.token
  change current to end_of_line(end_word.cursor) otherwise fail
  let node be Ability(
    is_public: is_public,
    name: name,
    type_params: type_params,
    requirements: requirements,
    docs: docs_node,
    functions: functions_node,
    span: Span(start: start, stop: end_word_token.span.stop)
  )
  return Parsed(node: AbilityItem(value: node), cursor: current)
end

function parse_requirements(cursor: Cursor) returns Parsed of List of Type or fails with Halt
  let mutable requirements: List of Type be []
  let mutable current be cursor
  let mutable done be false
  repeat until done
    let self_word be past_word(cursor: current, code: words.word_self) otherwise fail
    let can_word be past_word(cursor: self_word, code: words.word_can) otherwise fail
    let requirement be parse_type(can_word) otherwise fail
    change requirements to requirements.append(requirement.node)
    let and_word be eat_word(cursor: requirement.cursor, code: words.word_and)
    let and_word_found be and_word.found
    change current to and_word.cursor
    if not and_word_found then change done to true end
  end
  return Parsed(node: requirements, cursor: current)
end

function ability_functions(cursor: Cursor, with_bodies: Boolean)
  returns Parsed of List of Function
  or fails with Halt

  let mutable functions: List of Function be []
  let mutable current be cursor
  let mutable done be false
  repeat until done
    change current to skip_newlines(current)
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is words.word_end or token.kind is EndOfFile then
      change done to true
    otherwise if token.code is words.word_public then
      fail with public_method_halt(cursor: current, span: token.span)
    otherwise if token.code is not words.word_function then
      let flagged be expected(
        cursor: current,
        what: "`function` or `end` in an ability",
        span: token.span,
        fix: "write `function name(self, ...) returns Type`, or `end`"
      )
      fail with Halt(cursor: flagged)
    otherwise
      let node be parse_function(
        cursor: current,
        is_public: false,
        start: token.span.start,
        with_body: with_bodies
      ) otherwise fail
      change functions to functions.append(node.node)
      change current to node.cursor
    end
  end
  return Parsed(node: functions, cursor: current)
end

function public_method_halt(cursor: Cursor, span: Span) returns Halt
  let diagnostic be report.error(
    code: "public-method",
    message: "a method is not `public` by itself; the ability's visibility covers its methods",
    span: span,
    fix: "drop `public`"
  )
  return halt(cursor: cursor, diagnostic: diagnostic)
end

function parse_constant(cursor: Cursor, is_public: Boolean, start: Integer)
  returns Parsed of Constant
  or fails with Halt

  let keyword be past_word(cursor: cursor, code: words.word_let) otherwise fail
  let name be identifier(cursor: keyword, what: "a constant name") otherwise fail
  let name_node be name.node
  let colon be past_symbol(
    cursor: name.cursor,
    code: words.symbol_colon,
    what: "`:` and the type of the constant"
  ) otherwise fail
  let annotation be parse_type(colon) otherwise fail
  let annotation_node be annotation.node
  let be_word be past_word(cursor: annotation.cursor, code: words.word_be) otherwise fail
  let value be expression(skip_newlines(be_word)) otherwise fail
  let value_node be value.node
  let stop be previous(value.cursor).span.stop
  let after be end_of_line(value.cursor) otherwise fail
  let docs be doc_clauses(after)
  let node be Constant(
    is_public: is_public,
    name: name_node,
    annotation: annotation_node,
    value: value_node,
    docs: docs.node,
    span: Span(start: start, stop: stop)
  )
  return Parsed(node: node, cursor: docs.cursor)
end

function test_item(cursor: Cursor, start: Integer) returns Parsed of Test or fails with Halt
  let keyword be past_word(cursor: cursor, code: words.word_test) otherwise fail
  let name be text_literal(
    cursor: keyword,
    what: "a test name",
    missing: "the test name as a text literal",
    fix: "write `test \"what it checks\"`"
  ) otherwise fail
  let name_node be name.node
  let mutable current be name.cursor
  let mutable capabilities: List of Capability be []
  let needs_word be eat_word(cursor: current, code: words.word_needs)
  let needs_word_found be needs_word.found
  change current to needs_word.cursor
  if needs_word_found then
    let parsed be parse_capabilities(current) otherwise fail
    change capabilities to parsed.node
    change current to parsed.cursor
  end
  let mutable recording: maybe Text be nothing
  let replays_word be eat_word(cursor: current, code: words.word_replays)
  let replays_word_found be replays_word.found
  change current to replays_word.cursor
  if replays_word_found then
    let parsed be text_literal(
      cursor: current,
      what: "a recording's path",
      missing: "the recording's path as a text literal after `replays`",
      fix: "write `replays \"recordings/name.json\"`"
    ) otherwise fail
    change recording to parsed.node
    change current to parsed.cursor
  end
  change current to end_of_line(current) otherwise fail
  let body be parse_block(cursor: current, terminators: ["end"]) otherwise fail
  let body_node be body.node
  let end_word be expect_word(cursor: body.cursor, code: words.word_end) otherwise fail
  let end_word_token be end_word.token
  change current to end_of_line(end_word.cursor) otherwise fail
  let node be Test(
    name: name_node,
    capabilities: capabilities,
    recording: recording,
    body: body_node,
    span: Span(start: start, stop: end_word_token.span.stop)
  )
  return Parsed(node: node, cursor: current)
end

function parse_type(cursor: Cursor) returns Parsed of Type or fails with Halt
  let look be cursor.look
  let token be cursor.token
  match token.kind
    when Word(spelling: "maybe") then
      let inner be parse_type(at_position(cursor: cursor, position: look + 1)) otherwise fail
      let span be join(left: token.span, right: type_span(inner.node))
      return Parsed(node: MaybeType(inner: inner.node, span: span), cursor: inner.cursor)
    when Word(spelling: "function") then
      return function_type(moved(cursor: cursor, look: look)) otherwise fail
    when Symbol(text: "(") then
      return parenthesised_type(moved(cursor: cursor, look: look)) otherwise fail
    when TypeIdentifier then return named_type(moved(cursor: cursor, look: look)) otherwise fail
    when Identifier then
      let text be token.text
      let diagnostic be report.error(
        code: "type-name-shape",
        message: "`{text}` is snake_case, but a type is PascalCase",
        span: token.span,
        fix: "write `{lexer.pascal_case(text)}`"
      )
      fail with halt(cursor: moved(cursor: cursor, look: look), diagnostic: diagnostic)
    otherwise
      let flagged be expected(
        cursor: moved(cursor: cursor, look: look),
        what: "a type",
        span: token.span,
        fix: "write a type name: `Integer`, `Text`, `List of Text` or `maybe Integer`"
      )
      fail with Halt(cursor: flagged)
  end
end

function function_type(cursor: Cursor) returns Parsed of Type or fails with Halt
  let keyword be advance(cursor)
  let keyword_token be keyword.token
  let params be bracketed(
    cursor: keyword.cursor,
    element: parse_type,
    open: "(",
    close: ")",
    what: "a type",
    empty: nothing
  ) otherwise fail
  let params_node be params.node
  let clauses be result_clauses(params.cursor) otherwise fail
  let node be FunctionType(
    params: params_node,
    result: clauses.result,
    failures: clauses.failures,
    capabilities: clauses.capabilities,
    span: join(left: keyword_token.span, right: previous(clauses.cursor).span)
  )
  return Parsed(node: node, cursor: clauses.cursor)
end

function parenthesised_type(cursor: Cursor) returns Parsed of Type or fails with Halt
  purpose: A type in parentheses: grouping only, the type itself the node (decision AW62).

  let opened be past_symbol(
    cursor: cursor,
    code: words.symbol_code("("),
    what: "`(`"
  ) otherwise fail
  let inner be parse_type(with_nesting(cursor: opened, nesting: opened.nesting + 1)) otherwise fail
  let inner_cursor be inner.cursor
  let back be with_nesting(cursor: inner_cursor, nesting: inner_cursor.nesting - 1)
  let closed be past_symbol(cursor: back, code: words.symbol_code(")"), what: "`)`") otherwise fail
  return Parsed(node: inner.node, cursor: closed)
end

function named_type(cursor: Cursor) returns Parsed of Type or fails with Halt
  let name be type_name(cursor: cursor, what: "a type") otherwise fail
  let name_node be name.node
  let mutable current be name.cursor
  let mutable args: List of Type be []
  let of_word be eat_word(cursor: current, code: words.word_of)
  let of_word_found be of_word.found
  change current to of_word.cursor
  if of_word_found then
    let parsed be type_arguments(current) otherwise fail
    change args to parsed.node
    change current to parsed.cursor
  end
  let span be join(left: name_node.span, right: previous(current).span)
  return Parsed(node: NamedType(name: name_node, args: args, span: span), cursor: current)
end

function type_arguments(cursor: Cursor) returns Parsed of List of Type or fails with Halt
  let first_type be parse_type(cursor) otherwise fail
  let mutable args be [first_type.node]
  let mutable current be first_type.cursor
  let to_word be eat_word(cursor: current, code: words.word_to)
  let to_word_found be to_word.found
  change current to to_word.cursor
  if to_word_found then
    let value_type be parse_type(current) otherwise fail
    return Parsed(node: args.append(value_type.node), cursor: value_type.cursor)
  end
  let mutable done be false
  repeat until done
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is words.symbol_comma and type_follows_comma(current) then
      let next be parse_type(at_position(cursor: current, position: look + 1)) otherwise fail
      change args to args.append(next.node)
      change current to next.cursor
    otherwise
      change done to true
    end
  end
  return Parsed(node: args, cursor: current)
end

function starts_type(token: Token) returns Boolean
  return token.kind is TypeIdentifier
    or token.code is words.word_maybe
    or token.code is words.word_function
end

function type_follows_comma(cursor: Cursor) returns Boolean
  return starts_type(second_token(cursor: cursor, look: cursor.look))
end

function identifier(cursor: Cursor, what: Text) returns Parsed of Name or fails with Halt
  purpose: A snake_case name; a reserved word is taken, with an error, so that parsing goes on.

  let look be cursor.look
  let token be cursor.token
  match token.kind
    when Identifier then
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: Name(text: token.text, span: token.span), cursor: after)
    when Word(spelling) where not spelling.contains(" ") then
      let diagnostic be report.error(
        code: "reserved-word",
        message: "`{spelling}` is a reserved word and cannot name {what}",
        span: token.span,
        fix: "rename it, for example to `{spelling}_value`"
      )
      let name be Name(text: spelling, span: token.span)
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: name, cursor: diagnose(cursor: after, diagnostic: diagnostic))
    when TypeIdentifier then
      let text be token.text
      let diagnostic be report.error(
        code: "identifier-shape",
        message: "`{text}` is PascalCase, but {what} is snake_case",
        span: token.span,
        fix: "write `{lexer.snake_case(text)}`"
      )
      fail with halt(cursor: moved(cursor: cursor, look: look), diagnostic: diagnostic)
    otherwise
      let flagged be expected(
        cursor: moved(cursor: cursor, look: look),
        what: what,
        span: token.span,
        fix: "write {what}: `total_count`"
      )
      fail with Halt(cursor: flagged)
  end
end

function type_name(cursor: Cursor, what: Text) returns Parsed of TypeName or fails with Halt
  let look be cursor.look
  let token be cursor.token
  match token.kind
    when TypeIdentifier then
      let name be TypeName(text: token.text, span: token.span)
      return Parsed(node: name, cursor: at_position(cursor: cursor, position: look + 1))
    when Identifier then
      let text be token.text
      let diagnostic be report.error(
        code: "type-name-shape",
        message: "`{text}` is snake_case, but {what} is PascalCase",
        span: token.span,
        fix: "write `{lexer.pascal_case(text)}`"
      )
      fail with halt(cursor: moved(cursor: cursor, look: look), diagnostic: diagnostic)
    otherwise
      let flagged be expected(
        cursor: moved(cursor: cursor, look: look),
        what: what,
        span: token.span,
        fix: "write {what}: `OrderLine`"
      )
      fail with Halt(cursor: flagged)
  end
end

function type_span(annotation: Type) returns Span
  match annotation
    when NamedType(span) then return span
    when MaybeType(span) then return span
    when FunctionType(span) then return span
  end
end

function terminates(token: Token, terminators: List of Text) returns Boolean
  match token.kind
    when Word(spelling) then return terminators.contains(spelling)
    otherwise return false
  end
end

function parse_block(cursor: Cursor, terminators: List of Text)
  returns Parsed of Block
  or fails with Halt
  purpose: Statements up to a terminator word; a bad statement is reported and its line skipped.

  let look be cursor.look
  let start be cursor.token.span.start
  let mutable current be cursor
  if look is not current.position then change current to current with position: look end
  let mutable statements: List of Statement be []
  let mutable done be false
  repeat until done
    change current to skip_newlines(current)
    let token be token_under(current)
    if token.kind is EndOfFile then
      let diagnostic be report.error(
        code: "missing-end",
        message: "the file ended inside a block; `end` is missing",
        span: token.span,
        fix: "write `end`"
      )
      fail with halt(cursor: current, diagnostic: diagnostic)
    end
    if terminates(token: token, terminators: terminators) then
      change done to true
    otherwise
      match parse_statement(current)
        when success(statement) then
          change statements to statements.append(statement.node)
          change current to statement.cursor
        when failure(Halt(cursor: halted)) then change current to recover(halted)
      end
    end
  end
  let stop be previous(current).span.stop.at_least(start)
  return Parsed(
    node: Block(statements: statements, span: Span(start: start, stop: stop)),
    cursor: current
  )
end

function parse_statement(cursor: Cursor) returns Parsed of Statement or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let parsed be statement_kind(
    cursor: moved(cursor: cursor, look: look),
    token: token,
    start: token.span.start
  ) otherwise fail
  let parsed_node be parsed.node
  let after be end_of_statement(parsed.cursor) otherwise fail
  return Parsed(node: parsed_node, cursor: after)
end

function statement_kind(cursor: Cursor, token: Token, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  match token.kind
    when Word(spelling: "let") then
      return let_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "change") then
      return change_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "if") then return if_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "match") then
      return match_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "for each") then
      return for_each_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "repeat until") then
      return repeat_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "run concurrently") then
      return concurrent_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "return") then
      return return_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "fail") then
      return fail_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "crash") then
      return crash_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "break") then
      let after be bump(cursor)
      return Parsed(node: Break(span: span_from(start: start, cursor: after)), cursor: after)
    when Word(spelling: "continue") then
      let after be bump(cursor)
      return Parsed(node: Continue(span: span_from(start: start, cursor: after)), cursor: after)
    when Word(spelling: "ignore") then
      return ignore_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "check") then
      return check_statement(cursor: cursor, start: start) otherwise fail
    when Word(spelling: "until") then fail with loop_phrase_halt(cursor: cursor, token: token)
    when Word(spelling: "repeat") then fail with loop_phrase_halt(cursor: cursor, token: token)
    when Word(spelling: "otherwise") then
      fail with otherwise_line_halt(cursor: cursor, token: token)
    when Identifier then
      match foreign_statement_fix(cursor: cursor, token: token)
        when some(fix) then fail with foreign_statement_halt(cursor: cursor, token: token, fix: fix)
        otherwise return expression_statement(cursor: cursor, start: start) otherwise fail
      end
    otherwise return expression_statement(cursor: cursor, start: start) otherwise fail
  end
end

function loop_phrase_halt(cursor: Cursor, token: Token) returns Halt
  purpose: `until` or `repeat` alone: the loop's phrase is `repeat until`.

  let diagnostic be report.error(
    code: "expected",
    message: "a loop starts with the phrase `repeat until`, then its condition",
    span: token.span,
    fix: "write `repeat until condition` on one line"
  )
  return halt(cursor: cursor, diagnostic: diagnostic)
end

function otherwise_line_halt(cursor: Cursor, token: Token) returns Halt
  purpose: `otherwise` starting a line outside a branch: the guard of a value stays on its line.

  let head be "`otherwise` starts a line only as the branch of an `if` or `match`; "
  let tail be "the `otherwise` that guards a value stays on the line of the value"
  let diagnostic be report.error(
    code: "otherwise-line",
    message: "{head}{tail}",
    span: token.span,
    fix: "join this line to the one before it; a long line breaks inside parentheses"
  )
  return halt(cursor: cursor, diagnostic: diagnostic)
end

function foreign_statement_fix(cursor: Cursor, token: Token) returns maybe Text
  purpose: The Renyi form of another language's keyword at the start of a statement (decision C4).

  let next be (cursor.tokens.at(cursor.position + 1) otherwise end_token(cursor))
  if next.code is words.symbol_open_paren or next.code is words.symbol_dot then return nothing end
  return foreign_spelling(token)
end

function foreign_statement_halt(cursor: Cursor, token: Token, fix: Text) returns Halt
  let diagnostic be report.error(
    code: "foreign-keyword",
    message: "`{token.text}` is not Renyi",
    span: token.span,
    fix: fix
  )
  return halt(cursor: cursor, diagnostic: diagnostic)
end

function let_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  let mutable_word be eat_word(cursor: keyword, code: words.word_mutable)
  let mutable_word_found be mutable_word.found
  let name be identifier(cursor: mutable_word.cursor, what: "a name to bind") otherwise fail
  let name_node be name.node
  let mutable current be name.cursor
  let mutable annotation: maybe Type be nothing
  let colon be eat_symbol(cursor: current, code: words.symbol_colon)
  let colon_found be colon.found
  change current to colon.cursor
  if colon_found then
    let parsed be parse_type(current) otherwise fail
    change annotation to parsed.node
    change current to parsed.cursor
  end
  let be_word be past_word(cursor: current, code: words.word_be) otherwise fail
  let value be expression(skip_newlines(be_word)) otherwise fail
  let node be Let(
    is_mutable: mutable_word_found,
    name: name_node,
    annotation: annotation,
    value: value.node,
    span: span_from(start: start, cursor: value.cursor)
  )
  return Parsed(node: node, cursor: value.cursor)
end

function change_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  let name be identifier(cursor: keyword, what: "the name of a mutable binding") otherwise fail
  let name_node be name.node
  let to_word be past_word(cursor: name.cursor, code: words.word_to) otherwise fail
  let value be expression(skip_newlines(to_word)) otherwise fail
  let node be Change(
    name: name_node,
    value: value.node,
    span: span_from(start: start, cursor: value.cursor)
  )
  return Parsed(node: node, cursor: value.cursor)
end

function if_statement(cursor: Cursor, start: Integer) returns Parsed of Statement or fails with Halt
  let keyword be past_word(cursor: cursor, code: words.word_if) otherwise fail
  let mutable current be keyword
  let mutable branches: List of Branch be []
  let mutable fallback: maybe Block be nothing
  let mutable done be false
  repeat until done
    let branch be if_branch(current) otherwise fail
    change branches to branches.append(branch.node)
    let otherwise_word be eat_word(cursor: branch.cursor, code: words.word_otherwise)
    let otherwise_word_found be otherwise_word.found
    change current to otherwise_word.cursor
    let if_word be eat_word(cursor: current, code: words.word_if)
    if otherwise_word_found and if_word.found then
      change current to if_word.cursor
    otherwise if otherwise_word_found then
      let rest be parse_block(cursor: current, terminators: ["end"]) otherwise fail
      change fallback to rest.node
      change current to rest.cursor
      change done to true
    otherwise
      change done to true
    end
  end
  let end_word be past_word(cursor: current, code: words.word_end) otherwise fail
  let node be If(
    branches: branches,
    fallback: fallback,
    span: span_from(start: start, cursor: end_word)
  )
  return Parsed(node: node, cursor: end_word)
end

function if_branch(cursor: Cursor) returns Parsed of Branch or fails with Halt
  let condition be expression(cursor) otherwise fail
  let condition_node be condition.node
  let then_word be past_word(cursor: condition.cursor, code: words.word_then) otherwise fail
  let body be parse_block(cursor: then_word, terminators: ["otherwise", "end"]) otherwise fail
  return Parsed(node: Branch(condition: condition_node, body: body.node), cursor: body.cursor)
end

function match_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be past_word(cursor: cursor, code: words.word_match) otherwise fail
  let subject be expression(keyword) otherwise fail
  let subject_node be subject.node
  let mutable current be end_of_line(subject.cursor) otherwise fail
  let mutable arms: List of Arm be []
  let mutable fallback: maybe Block be nothing
  let mutable done be false
  repeat until done
    change current to skip_newlines(current)
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is words.word_end then
      change done to true
    otherwise if token.code is words.word_otherwise then
      let after_word be at_position(cursor: current, position: look + 1)
      let rest be parse_block(cursor: after_word, terminators: ["end"]) otherwise fail
      change fallback to rest.node
      change current to rest.cursor
      change done to true
    otherwise
      let arm be match_arm(current) otherwise fail
      change arms to arms.append(arm.node)
      change current to arm.cursor
    end
  end
  let end_word be past_word(cursor: current, code: words.word_end) otherwise fail
  let node be Match(
    subject: subject_node,
    arms: arms,
    fallback: fallback,
    span: span_from(start: start, cursor: end_word)
  )
  return Parsed(node: node, cursor: end_word)
end

function match_arm(cursor: Cursor) returns Parsed of Arm or fails with Halt
  let when_word be expect_word(cursor: cursor, code: words.word_when) otherwise fail
  let when_word_token be when_word.token
  let shape be parse_pattern(when_word.cursor) otherwise fail
  let shape_node be shape.node
  let guard be expression_after(cursor: shape.cursor, spelling: "where") otherwise fail
  let guard_value be guard.value
  let then_word be past_word(cursor: guard.cursor, code: words.word_then) otherwise fail
  let body be parse_block(
    cursor: then_word,
    terminators: ["when", "otherwise", "end"]
  ) otherwise fail
  let node be Arm(
    pattern: shape_node,
    guard: guard_value,
    body: body.node,
    span: Span(start: when_word_token.span.start, stop: body.node.span.stop)
  )
  return Parsed(node: node, cursor: body.cursor)
end

function for_each_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be past_word(cursor: cursor, code: words.word_for_each) otherwise fail
  let source be loop_source(keyword) otherwise fail
  let source_bindings be source.bindings
  let source_source be source.source
  let filter be expression_after(cursor: source.cursor, spelling: "where") otherwise fail
  let filter_value be filter.value
  let order be ordering(filter.cursor) otherwise fail
  let order_value be order.value
  let after be end_of_line(order.cursor) otherwise fail
  let body be parse_block(cursor: after, terminators: ["end"]) otherwise fail
  let body_node be body.node
  let end_word be past_word(cursor: body.cursor, code: words.word_end) otherwise fail
  let node be ForEach(
    bindings: source_bindings,
    source: source_source,
    filter: filter_value,
    order: order_value,
    body: body_node,
    span: span_from(start: start, cursor: end_word)
  )
  return Parsed(node: node, cursor: end_word)
end

function loop_source(cursor: Cursor) returns LoopSource or fails with Halt
  purpose: `x in xs`, `key, value in map` or `i from 1 to 10 by 2`; a range after `in` is an error.

  let bindings be identifier_list(cursor: cursor, what: "a loop variable") otherwise fail
  let bindings_node be bindings.node
  let look be peek(bindings.cursor)
  if look.token.code is words.word_from then
    let bounds be range_literal(look.cursor) otherwise fail
    return LoopSource(bindings: bindings_node, source: bounds.node, cursor: bounds.cursor)
  end
  let in_word be expect_word(cursor: look.cursor, code: words.word_in) otherwise fail
  let in_word_token be in_word.token
  let from_look be peek(in_word.cursor)
  let from_look_token be from_look.token
  let source be or_expression(from_look.cursor) otherwise fail
  let source_node be source.node
  match source_node
    when RangeLiteral then
      let diagnostic be report.error(
        code: "range-loop",
        message: "a range loop is written `for each x from 1 to 9`, without `in`",
        span: join(left: in_word_token.span, right: from_look_token.span),
        fix: "drop `in`"
      )
      let flagged be diagnose(cursor: source.cursor, diagnostic: diagnostic)
      return LoopSource(bindings: bindings_node, source: source_node, cursor: flagged)
    otherwise return LoopSource(bindings: bindings_node, source: source_node, cursor: source.cursor)
  end
end

function ordering(cursor: Cursor) returns OptionalOrder or fails with Halt
  let sorted_word be eat_word(cursor: cursor, code: words.word_sorted_by)
  if not sorted_word.found then return OptionalOrder(value: nothing, cursor: sorted_word.cursor) end
  let key be or_expression(sorted_word.cursor) otherwise fail
  let key_node be key.node
  let descending_word be eat_word(cursor: key.cursor, code: words.word_descending)
  let order be SortOrder(key: key_node, is_descending: descending_word.found)
  return OptionalOrder(value: order, cursor: descending_word.cursor)
end

function repeat_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  let condition be expression(keyword) otherwise fail
  let condition_node be condition.node
  let after be end_of_line(condition.cursor) otherwise fail
  let body be parse_block(cursor: after, terminators: ["end"]) otherwise fail
  let body_node be body.node
  let end_word be past_word(cursor: body.cursor, code: words.word_end) otherwise fail
  let node be RepeatUntil(
    condition: condition_node,
    body: body_node,
    span: span_from(start: start, cursor: end_word)
  )
  return Parsed(node: node, cursor: end_word)
end

function concurrent_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  let deadline be expression_after(cursor: keyword, spelling: "within") otherwise fail
  let deadline_value be deadline.value
  let after be end_of_line(deadline.cursor) otherwise fail
  let body be parse_block(cursor: after, terminators: ["end"]) otherwise fail
  let body_node be body.node
  let end_word be past_word(cursor: body.cursor, code: words.word_end) otherwise fail
  let node be RunConcurrently(
    deadline: deadline_value,
    body: body_node,
    span: span_from(start: start, cursor: end_word)
  )
  return Parsed(node: node, cursor: end_word)
end

function return_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  if statement_ends_here(keyword) then
    let bare be Return(value: nothing, span: span_from(start: start, cursor: keyword))
    return Parsed(node: bare, cursor: keyword)
  end
  let value be expression(keyword) otherwise fail
  let node be Return(value: value.node, span: span_from(start: start, cursor: value.cursor))
  return Parsed(node: node, cursor: value.cursor)
end

function fail_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  let with_word be eat_word(cursor: keyword, code: words.word_with)
  if not with_word.found then
    let bare be Fail(value: nothing, span: span_from(start: start, cursor: with_word.cursor))
    return Parsed(node: bare, cursor: with_word.cursor)
  end
  let value be expression(with_word.cursor) otherwise fail
  let node be Fail(value: value.node, span: span_from(start: start, cursor: value.cursor))
  return Parsed(node: node, cursor: value.cursor)
end

function crash_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  let with_word be past_word(cursor: keyword, code: words.word_with) otherwise fail
  let message be expression(with_word) otherwise fail
  let node be Crash(message: message.node, span: span_from(start: start, cursor: message.cursor))
  return Parsed(node: node, cursor: message.cursor)
end

function ignore_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  let value be expression(keyword) otherwise fail
  let node be Ignore(value: value.node, span: span_from(start: start, cursor: value.cursor))
  return Parsed(node: node, cursor: value.cursor)
end

function check_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let keyword be bump(cursor)
  let value be expression(keyword) otherwise fail
  let node be Check(value: value.node, span: span_from(start: start, cursor: value.cursor))
  return Parsed(node: node, cursor: value.cursor)
end

function expression_statement(cursor: Cursor, start: Integer)
  returns Parsed of Statement
  or fails with Halt

  let value be expression(cursor) otherwise fail
  let value_node be value.node
  if not is_call_or_otherwise(value_node) then
    let diagnostic be report.error(
      code: "statement-shape",
      message: statement_shape_message(),
      span: expr_span(value_node),
      fix: "bind the value with `let name be ...`, or pass it to a function"
    )
    fail with halt(cursor: value.cursor, diagnostic: diagnostic)
  end
  let node be Expression(value: value_node, span: span_from(start: start, cursor: value.cursor))
  return Parsed(node: node, cursor: value.cursor)
end

function statement_shape_message() returns Text
  let head be "a statement is a call, or starts with `let`, `change`, `if`, `match`, `for each`, "
  return "{head}`repeat until`, `return`, `fail`, `crash`, `ignore` or `check`"
end

function is_call_or_otherwise(expr: Expr) returns Boolean
  match expr
    when Call then return true
    when Otherwise then return true
    otherwise return false
  end
end

function parse_pattern(cursor: Cursor) returns Parsed of Pattern or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let after be at_position(cursor: cursor, position: look + 1)
  match token.kind
    when TypeIdentifier then
      return variant_pattern(moved(cursor: cursor, look: look)) otherwise fail
    when Word(spelling: "nothing") then
      return Parsed(node: NothingPattern(span: token.span), cursor: after)
    when Word(spelling: "some") then
      return wrapped_pattern(
        cursor: moved(cursor: cursor, look: look),
        wrapper: "some"
      ) otherwise fail
    when Word(spelling: "success") then
      return wrapped_pattern(
        cursor: moved(cursor: cursor, look: look),
        wrapper: "success"
      ) otherwise fail
    when Word(spelling: "failure") then
      return wrapped_pattern(
        cursor: moved(cursor: cursor, look: look),
        wrapper: "failure"
      ) otherwise fail
    when Identifier then return binding_pattern(moved(cursor: cursor, look: look)) otherwise fail
    otherwise
      if starts_literal(token) then
        let literal be primary(moved(cursor: cursor, look: look)) otherwise fail
        let node be LiteralPattern(value: literal.node, span: expr_span(literal.node))
        return Parsed(node: node, cursor: literal.cursor)
      end
      let flagged be expected(
        cursor: moved(cursor: cursor, look: look),
        what: "a pattern",
        span: token.span,
        fix: pattern_fix()
      )
      fail with Halt(cursor: flagged)
  end
end

function pattern_fix() returns Text
  let head be "write a name, a literal, `nothing`, `some(x)`, `success(x)`, "
  return "{head}`failure(error)` or `Variant(...)`"
end

function starts_literal(token: Token) returns Boolean
  match token.kind
    when IntegerToken then return true
    when DecimalToken then return true
    when TextToken then return true
    when RawToken then return true
    when Symbol(text) then return text is "-" or text is "[" or text is "\{"
    when Word(spelling) then return spelling is "raw" or spelling is "true" or spelling is "false"
    otherwise return false
  end
end

function variant_pattern(cursor: Cursor) returns Parsed of Pattern or fails with Halt
  let name be type_name(cursor: cursor, what: "a variant") otherwise fail
  let name_node be name.node
  let open be eat_symbol(cursor: name.cursor, code: words.symbol_open_paren)
  if not open.found then
    let bare be VariantPattern(name: name_node, fields: [], span: name_node.span)
    return Parsed(node: bare, cursor: open.cursor)
  end
  let fields be bracketed(
    cursor: name.cursor,
    element: field_pattern,
    open: "(",
    close: ")",
    what: "a field",
    empty: EmptyRule(
      what: "a field name inside the parentheses",
      fix: "match the bare name: `when {name_node.text} then`"
    )
  ) otherwise fail
  let fields_node be fields.node
  let span be join(left: name_node.span, right: previous(fields.cursor).span)
  let node be VariantPattern(name: name_node, fields: fields_node, span: span)
  return Parsed(node: node, cursor: fields.cursor)
end

function field_pattern(cursor: Cursor) returns Parsed of FieldPattern or fails with Halt
  let field be identifier(cursor: cursor, what: "a field name") otherwise fail
  let field_node be field.node
  let colon be eat_symbol(cursor: field.cursor, code: words.symbol_colon)
  if not colon.found then
    return Parsed(node: FieldPattern(field: field_node, pattern: nothing), cursor: colon.cursor)
  end
  let inner be parse_pattern(colon.cursor) otherwise fail
  return Parsed(node: FieldPattern(field: field_node, pattern: inner.node), cursor: inner.cursor)
end

function wrapped_pattern(cursor: Cursor, wrapper: Text) returns Parsed of Pattern or fails with Halt
  let keyword be advance(cursor)
  let keyword_token be keyword.token
  let open be past_symbol(
    cursor: keyword.cursor,
    code: words.symbol_open_paren,
    what: "`(`"
  ) otherwise fail
  let inner_nesting be open.nesting + 1
  let inside be with_nesting(cursor: open, nesting: inner_nesting)
  let inner be parse_pattern(inside) otherwise fail
  let outer_nesting be inner.cursor.nesting - 1
  let outside be with_nesting(cursor: inner.cursor, nesting: outer_nesting)
  let close be expect_symbol(
    cursor: outside,
    code: words.symbol_close_paren,
    what: "`)`"
  ) otherwise fail
  let span be join(left: keyword_token.span, right: close.token.span)
  let node be
    if wrapper is "some" then SomePattern(inner: inner.node, span: span)
    otherwise if wrapper is "success" then SuccessPattern(inner: inner.node, span: span)
    otherwise FailurePattern(inner: inner.node, span: span)
    end
  return Parsed(node: node, cursor: close.cursor)
end

function binding_pattern(cursor: Cursor) returns Parsed of Pattern or fails with Halt
  let name be identifier(cursor: cursor, what: "a name") otherwise fail
  let name_node be name.node
  let look be name.cursor.look
  let token be (name.cursor.tokens.at(look) otherwise end_token(name.cursor))
  let following be second_token(cursor: name.cursor, look: look)
  let typed be token.code is words.symbol_colon and starts_type(following)
  if not typed then
    let bare be BindingPattern(name: name_node, span: name_node.span)
    return Parsed(node: bare, cursor: moved(cursor: name.cursor, look: look))
  end
  let annotation be parse_type(at_position(cursor: name.cursor, position: look + 1)) otherwise fail
  let span be join(left: name_node.span, right: type_span(annotation.node))
  let node be TypedPattern(name: name_node, annotation: annotation.node, span: span)
  return Parsed(node: node, cursor: annotation.cursor)
end

function expression_after(cursor: Cursor, spelling: Text) returns OptionalExpr or fails with Halt
  let word be eat_word(cursor: cursor, code: words.word_code(spelling))
  if not word.found then return OptionalExpr(value: nothing, cursor: word.cursor) end
  let parsed be expression(word.cursor) otherwise fail
  return OptionalExpr(value: parsed.node, cursor: parsed.cursor)
end

function or_expression_after(cursor: Cursor, spelling: Text) returns OptionalExpr or fails with Halt
  let word be eat_word(cursor: cursor, code: words.word_code(spelling))
  if not word.found then return OptionalExpr(value: nothing, cursor: word.cursor) end
  let parsed be or_expression(word.cursor) otherwise fail
  return OptionalExpr(value: parsed.node, cursor: parsed.cursor)
end

function is_present(value: maybe Expr) returns Boolean
  match value
    when nothing then return false
    otherwise return true
  end
end

function expression(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let first_value be or_expression(cursor) otherwise fail
  let mutable value be first_value.node
  let mutable current be first_value.cursor
  let mutable done be false
  repeat until done
    let look be current.look
    if current.token.code is words.word_otherwise then
      change current to at_position(cursor: current, position: look + 1)
      let fallback be parse_outcome(current) otherwise fail
      let span be join(left: expr_span(value), right: outcome_span(fallback.node))
      change value to Otherwise(value: value, fallback: fallback.node, span: span)
      change current to fallback.cursor
    otherwise
      if look is not current.position then change current to current with position: look end
      change done to true
    end
  end
  return Parsed(node: value, cursor: current)
end

function parse_outcome(cursor: Cursor) returns Parsed of Outcome or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let after be at_position(cursor: cursor, position: look + 1)
  match token.kind
    when Word(spelling: "fail") then
      return fail_outcome(cursor: after, start: token.span) otherwise fail
    when Word(spelling: "return") then
      return return_outcome(cursor: after, start: token.span) otherwise fail
    when Word(spelling: "crash") then
      let with_word be past_word(cursor: after, code: words.word_with) otherwise fail
      let value be or_expression(with_word) otherwise fail
      let span be join(left: token.span, right: expr_span(value.node))
      return Parsed(node: CrashOutcome(message: value.node, span: span), cursor: value.cursor)
    when Word(spelling: "break") then
      return Parsed(node: BreakOutcome(span: token.span), cursor: after)
    when Word(spelling: "continue") then
      return Parsed(node: ContinueOutcome(span: token.span), cursor: after)
    otherwise
      let value be or_expression(moved(cursor: cursor, look: look)) otherwise fail
      let node be ValueOutcome(value: value.node, span: expr_span(value.node))
      return Parsed(node: node, cursor: value.cursor)
  end
end

function fail_outcome(cursor: Cursor, start: Span) returns Parsed of Outcome or fails with Halt
  let with_word be eat_word(cursor: cursor, code: words.word_with)
  if not with_word.found then
    return Parsed(node: FailOutcome(value: nothing, span: start), cursor: with_word.cursor)
  end
  let value be or_expression(with_word.cursor) otherwise fail
  let span be join(left: start, right: expr_span(value.node))
  return Parsed(node: FailOutcome(value: value.node, span: span), cursor: value.cursor)
end

function return_outcome(cursor: Cursor, start: Span) returns Parsed of Outcome or fails with Halt
  if statement_ends_here(cursor) then
    return Parsed(node: ReturnOutcome(value: nothing, span: start), cursor: cursor)
  end
  let look be cursor.look
  let token be cursor.token
  if token.code is words.word_end then
    return Parsed(
      node: ReturnOutcome(value: nothing, span: start),
      cursor: moved(cursor: cursor, look: look)
    )
  end
  let value be or_expression(moved(cursor: cursor, look: look)) otherwise fail
  let span be join(left: start, right: expr_span(value.node))
  return Parsed(node: ReturnOutcome(value: value.node, span: span), cursor: value.cursor)
end

let or_level: Integer be 1

let and_level: Integer be 2

let not_level: Integer be 3

let comparison_level: Integer be 4

let with_level: Integer be 5

let additive_level: Integer be 6

let multiplicative_level: Integer be 7

let power_level: Integer be 8

function binary_operator(token: Token) returns maybe BinaryOp
  purpose: The operator a token spells, by its code: an Integer compared in place.

  let code be token.code
  if code is 0 then return nothing end
  if code is words.symbol_plus then return Add end
  if code is words.symbol_minus then return Subtract end
  if code is words.symbol_star then return Multiply end
  if code is words.symbol_slash then return Divide end
  if code is words.word_and then return And end
  if code is words.word_or then return Or end
  if code is words.word_is then return Is end
  if code is words.word_is_not then return IsNot end
  if code is words.word_is_less_than then return IsLessThan end
  if code is words.word_is_at_most then return IsAtMost end
  if code is words.word_is_greater_than then return IsGreaterThan end
  if code is words.word_is_at_least then return IsAtLeast end
  if code is words.word_remainder then return Remainder end
  if code is words.word_power then return Power end
  return nothing
end

function level_of(operator: BinaryOp) returns Integer
  purpose: How tightly a binary operator binds: `or` the loosest, `power` the tightest.

  match operator
    when Or then return or_level
    when And then return and_level
    when Add then return additive_level
    when Subtract then return additive_level
    when Multiply then return multiplicative_level
    when Divide then return multiplicative_level
    when Remainder then return multiplicative_level
    when Power then return power_level
    otherwise return comparison_level
  end
end

function binary(cursor: Cursor, lowest: Integer) returns Parsed of Expr or fails with Halt
  purpose: An expression of the operators from the level `lowest` up, in one loop over the levels.

  let mutable value: Expr be NothingLiteral(span: Span(start: 0, stop: 0))
  let mutable current be cursor
  # a comparison and `with` take one operand each, `not` a `not` or a comparison: the
  # ceiling closes the levels an operator leaves
  let mutable ceiling be power_level
  let head_look be current.look
  let head_token be (current.tokens.at(head_look) otherwise end_token(current))
  if lowest is at most not_level and head_token.code is words.word_not then
    change current to at_position(cursor: current, position: head_look + 1)
    let inner be binary(cursor: current, lowest: not_level) otherwise fail
    let not_span be join(left: head_token.span, right: expr_span(inner.node))
    change value to Not(value: inner.node, span: not_span)
    change current to inner.cursor
    change ceiling to and_level
  otherwise
    let head be postfix(moved(cursor: current, look: head_look)) otherwise fail
    change value to head.node
    change current to head.cursor
  end
  let mutable done be false
  repeat until done
    let look be current.look
    let token be current.token
    match binary_operator(token)
      when some(operator) then
        let level be level_of(operator)
        if level is less than lowest or level is greater than ceiling then
          if look is not current.position then change current to current with position: look end
          change done to true
        otherwise
          let right_lowest be if level is power_level then level otherwise level + 1 end
          change current to at_position(cursor: current, position: look + 1)
          let right be binary(cursor: current, lowest: right_lowest) otherwise fail
          change value to binary_expression(operator: operator, left: value, right: right.node)
          change current to right.cursor
          if level is comparison_level then change ceiling to not_level end
        end
      otherwise
        let with_fits be with_level is at least lowest and with_level is at most ceiling
        if with_fits and token.code is words.word_with then
          let updates be update_list(
            at_position(cursor: current, position: look + 1)
          ) otherwise fail
          let last_update be updates.node.last() otherwise crash with "an update list is not empty"
          let with_span be join(left: expr_span(value), right: last_update.span)
          change value to With(base: value, updates: updates.node, span: with_span)
          change current to updates.cursor
          change ceiling to comparison_level
        otherwise
          if look is not current.position then change current to current with position: look end
          change done to true
        end
    end
  end
  return Parsed(node: value, cursor: current)
end

function or_expression(cursor: Cursor) returns Parsed of Expr or fails with Halt
  return binary(cursor: cursor, lowest: or_level) otherwise fail
end

function additive(cursor: Cursor) returns Parsed of Expr or fails with Halt
  purpose: The values of an update list and the bounds of a range: no comparison, no `with`.

  return binary(cursor: cursor, lowest: additive_level) otherwise fail
end

function update_list(cursor: Cursor) returns Parsed of List of Arg or fails with Halt
  let mutable updates: List of Arg be []
  let mutable current be cursor
  let mutable done be false
  repeat until done
    let name be identifier(cursor: current, what: "a field name") otherwise fail
    let name_node be name.node
    let colon be past_symbol(
      cursor: name.cursor,
      code: words.symbol_colon,
      what: "`:`"
    ) otherwise fail
    let value be additive(colon) otherwise fail
    let span be join(left: name_node.span, right: expr_span(value.node))
    change updates to updates.append(Arg(name: name_node, value: value.node, span: span))
    let comma be eat_symbol(cursor: value.cursor, code: words.symbol_comma)
    let comma_found be comma.found
    change current to comma.cursor
    if not comma_found then change done to true end
  end
  return Parsed(node: updates, cursor: current)
end

function postfix(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let head be primary(cursor) otherwise fail
  let mutable value be head.node
  let mutable current be head.cursor
  let mutable done be false
  repeat until done
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is words.symbol_dot then
      let after_dot be at_position(cursor: current, position: look + 1)
      let member be member_access(cursor: after_dot, base: value) otherwise fail
      change value to member.node
      change current to member.cursor
    otherwise if token.code is words.symbol_open_paren and is_callable(value) then
      let args be arguments(current) otherwise fail
      let args_node be args.node
      let span be join(left: expr_span(value), right: previous(args.cursor).span)
      change value to Call(callee: value, args: args_node, span: span)
      change current to args.cursor
    otherwise
      change done to true
    end
  end
  return Parsed(node: value, cursor: current)
end

function member_access(cursor: Cursor, base: Expr) returns Parsed of Expr or fails with Halt
  let token be advance(cursor)
  let token_token be token.token
  match token_token.kind
    when MemberName then
      let name be Name(text: token_token.text, span: token_token.span)
      let span be join(left: expr_span(base), right: name.span)
      return Parsed(node: Member(base: base, name: name, span: span), cursor: token.cursor)
    when Identifier then
      let flagged be expected(
        cursor: token.cursor,
        what: "a member name directly after the dot",
        span: token_token.span,
        fix: "write the name directly after the dot: `value.length()`"
      )
      fail with Halt(cursor: flagged)
    otherwise
      let flagged be expected(
        cursor: token.cursor,
        what: "a member name after the dot",
        span: token_token.span,
        fix: "write the field or method name: `value.length()`"
      )
      fail with Halt(cursor: flagged)
  end
end

function is_callable(expr: Expr) returns Boolean
  match expr
    when Member then return true
    when NameExpr then return true
    otherwise return false
  end
end

function arguments(cursor: Cursor) returns Parsed of List of Arg or fails with Halt
  return bracketed(
    cursor: cursor,
    element: argument,
    open: "(",
    close: ")",
    what: "an argument",
    empty: nothing
  ) otherwise fail
end

function argument(cursor: Cursor) returns Parsed of Arg or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let following be second_token(cursor: cursor, look: look)
  let named be token.kind is Identifier and following.code is words.symbol_colon
  if not named then
    let value be expression(moved(cursor: cursor, look: look)) otherwise fail
    let bare be Arg(name: nothing, value: value.node, span: expr_span(value.node))
    return Parsed(node: bare, cursor: value.cursor)
  end
  let name be identifier(
    cursor: moved(cursor: cursor, look: look),
    what: "an argument name"
  ) otherwise fail
  let name_node be name.node
  let colon be bump(name.cursor)
  let value be expression(colon) otherwise fail
  let span be join(left: name_node.span, right: expr_span(value.node))
  return Parsed(node: Arg(name: name_node, value: value.node, span: span), cursor: value.cursor)
end

function primary(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let span be token.span
  match token.kind
    when IntegerToken then
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: IntegerLiteral(text: token.text, span: span), cursor: after)
    when DecimalToken then
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: DecimalLiteral(text: token.text, span: span), cursor: after)
    when TextToken(parts, is_block) then
      let after be at_position(cursor: cursor, position: look + 1)
      let pieces be text_pieces(cursor: after, parts: parts)
      let node be TextLiteral(pieces: pieces.node, block: is_block, span: span)
      return Parsed(node: node, cursor: pieces.cursor)
    when RawToken(text) then
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: RawTextLiteral(text: text, span: span), cursor: after)
    when Identifier then
      let name be identifier(
        cursor: moved(cursor: cursor, look: look),
        what: "a name"
      ) otherwise fail
      return Parsed(node: NameExpr(name: name.node, span: span), cursor: name.cursor)
    when TypeIdentifier then return type_primary(moved(cursor: cursor, look: look)) otherwise fail
    when Symbol(text: "-") then
      let after be at_position(cursor: cursor, position: look + 1)
      return negative_number(cursor: after, start: span) otherwise fail
    when Symbol(text: "(") then
      return paren_primary(moved(cursor: cursor, look: look)) otherwise fail
    when Symbol(text: "[") then
      return list_literal(moved(cursor: cursor, look: look)) otherwise fail
    when Symbol(text: "\{") then
      return map_literal(moved(cursor: cursor, look: look)) otherwise fail
    when Word then return word_primary(moved(cursor: cursor, look: look)) otherwise fail
    otherwise
      fail with Halt(
        cursor: expression_expected(cursor: moved(cursor: cursor, look: look), token: token)
      )
  end
end

function expression_expected(cursor: Cursor, token: Token) returns Cursor
  return expected(
    cursor: cursor,
    what: "an expression",
    span: token.span,
    fix: "write a value: a literal, a name, a call or `(...)`"
  )
end

function word_primary(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let span be token.span
  match token.kind
    when Word(spelling: "raw") then
      let after be at_position(cursor: cursor, position: look + 1)
      return raw_text(cursor: after, start: span) otherwise fail
    when Word(spelling: "true") then
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: BooleanLiteral(value: true, span: span), cursor: after)
    when Word(spelling: "false") then
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: BooleanLiteral(value: false, span: span), cursor: after)
    when Word(spelling: "nothing") then
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: NothingLiteral(span: span), cursor: after)
    when Word(spelling: "self") then
      let after be at_position(cursor: cursor, position: look + 1)
      return Parsed(node: SelfValue(span: span), cursor: after)
    when Word(spelling: "from") then
      return range_literal(moved(cursor: cursor, look: look)) otherwise fail
    when Word(spelling: "if") then
      return if_expression(moved(cursor: cursor, look: look)) otherwise fail
    when Word(spelling: "match") then
      return match_expression(moved(cursor: cursor, look: look)) otherwise fail
    when Word(spelling: "for each") then
      return query_expression(moved(cursor: cursor, look: look)) otherwise fail
    otherwise
      fail with Halt(
        cursor: expression_expected(cursor: moved(cursor: cursor, look: look), token: token)
      )
  end
end

function text_pieces(cursor: Cursor, parts: List of Part) returns Parsed of List of TextPiece
  purpose: The pieces of a text literal; each hole is parsed on its own, its problems recorded.

  let mutable pieces: List of TextPiece be []
  let mutable current be cursor
  for each part in parts
    match part
      when Characters(text) then change pieces to pieces.append(Literal(text: text))
      when HolePart(tokens) then
        let hole be parse_hole(cursor: current, tokens: tokens)
        change pieces to pieces.append(Hole(expression: hole.node))
        change current to hole.cursor
    end
  end
  return Parsed(node: pieces, cursor: current)
end

function raw_text(cursor: Cursor, start: Span) returns Parsed of Expr or fails with Halt
  let token be advance(cursor)
  let token_token be token.token
  match token_token.kind
    when RawToken(text) then
      let span be join(left: start, right: token_token.span)
      return Parsed(node: RawTextLiteral(text: text, span: span), cursor: token.cursor)
    otherwise
      let flagged be expected(
        cursor: token.cursor,
        what: "a text literal after `raw`",
        span: token_token.span,
        fix: "write `raw \"...\"`"
      )
      fail with Halt(cursor: flagged)
  end
end

function negative_number(cursor: Cursor, start: Span) returns Parsed of Expr or fails with Halt
  let number be advance(cursor)
  let text be "-{number.token.text}"
  let span be join(left: start, right: number.token.span)
  match number.token.kind
    when IntegerToken then
      return Parsed(node: IntegerLiteral(text: text, span: span), cursor: number.cursor)
    when DecimalToken then
      return Parsed(node: DecimalLiteral(text: text, span: span), cursor: number.cursor)
    otherwise
      let diagnostic be report.error(
        code: "unary-minus",
        message: "`-` negates only a number literal",
        span: span,
        fix: "write `0 - value` for a computed value"
      )
      fail with halt(cursor: number.cursor, diagnostic: diagnostic)
  end
end

function type_primary(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let name be type_name(cursor: cursor, what: "a type") otherwise fail
  let name_node be name.node
  let look be name.cursor.look
  let token be (name.cursor.tokens.at(look) otherwise end_token(name.cursor))
  if token.code is not words.symbol_open_paren then
    let bare be TypeNameExpr(name: name_node, span: name_node.span)
    return Parsed(node: bare, cursor: moved(cursor: name.cursor, look: look))
  end
  let args be arguments(moved(cursor: name.cursor, look: look)) otherwise fail
  let args_node be args.node
  let span be join(left: name_node.span, right: previous(args.cursor).span)
  return Parsed(node: Construct(name: name_node, args: args_node, span: span), cursor: args.cursor)
end

function paren_primary(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let open be advance(cursor)
  let inner_nesting be open.cursor.nesting + 1
  let inside be with_nesting(cursor: open.cursor, nesting: inner_nesting)
  let inner be expression(inside) otherwise fail
  let outer_nesting be inner.cursor.nesting - 1
  let outside be with_nesting(cursor: inner.cursor, nesting: outer_nesting)
  let close be expect_symbol(
    cursor: outside,
    code: words.symbol_close_paren,
    what: "`)`"
  ) otherwise fail
  let span be join(left: open.token.span, right: close.token.span)
  return Parsed(node: Paren(value: inner.node, span: span), cursor: close.cursor)
end

function list_literal(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let items be bracketed(
    cursor: moved(cursor: cursor, look: look),
    element: expression,
    open: "[",
    close: "]",
    what: "an item",
    empty: nothing
  ) otherwise fail
  let items_node be items.node
  let span be join(left: token.span, right: previous(items.cursor).span)
  return Parsed(node: ListLiteral(items: items_node, span: span), cursor: items.cursor)
end

function map_literal(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let look be cursor.look
  let token be cursor.token
  let entries be bracketed(
    cursor: moved(cursor: cursor, look: look),
    element: map_entry,
    open: "\{",
    close: "}",
    what: "an entry",
    empty: nothing
  ) otherwise fail
  let entries_node be entries.node
  let span be join(left: token.span, right: previous(entries.cursor).span)
  return Parsed(node: MapLiteral(entries: entries_node, span: span), cursor: entries.cursor)
end

function map_entry(cursor: Cursor) returns Parsed of MapEntry or fails with Halt
  let key be or_expression(cursor) otherwise fail
  let key_node be key.node
  let colon be past_symbol(
    cursor: key.cursor,
    code: words.symbol_colon,
    what: "`:` between a map key and its value"
  ) otherwise fail
  let value be expression(colon) otherwise fail
  return Parsed(node: MapEntry(key: key_node, value: value.node), cursor: value.cursor)
end

function range_literal(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let start be expect_word(cursor: cursor, code: words.word_from) otherwise fail
  let start_token be start.token
  let lower be additive(start.cursor) otherwise fail
  let lower_node be lower.node
  let to_word be past_word(cursor: lower.cursor, code: words.word_to) otherwise fail
  let upper be additive(to_word) otherwise fail
  let upper_node be upper.node
  let mutable current be upper.cursor
  let mutable step: maybe Expr be nothing
  let by_word be eat_word(cursor: current, code: words.word_by)
  let by_word_found be by_word.found
  change current to by_word.cursor
  if by_word_found then
    let parsed be additive(current) otherwise fail
    change step to parsed.node
    change current to parsed.cursor
  end
  let span be join(left: start_token.span, right: previous(current).span)
  let node be RangeLiteral(lower: lower_node, upper: upper_node, step: step, span: span)
  return Parsed(node: node, cursor: current)
end

function if_expression(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let start be expect_word(cursor: cursor, code: words.word_if) otherwise fail
  let start_token be start.token
  let mutable current be start.cursor
  let mutable branches: List of ExprBranch be []
  let mutable done be false
  repeat until done
    let branch be expression_branch(current) otherwise fail
    change branches to branches.append(branch.node)
    let if_word be eat_word(cursor: branch.cursor, code: words.word_if)
    let if_word_found be if_word.found
    change current to if_word.cursor
    if not if_word_found then change done to true end
  end
  let fallback be parse_outcome(skip_newlines(current)) otherwise fail
  let fallback_node be fallback.node
  let end_word be expect_word(
    cursor: skip_newlines(fallback.cursor),
    code: words.word_end
  ) otherwise fail
  let node be IfExpr(
    branches: branches,
    fallback: fallback_node,
    span: join(left: start_token.span, right: end_word.token.span)
  )
  return Parsed(node: node, cursor: end_word.cursor)
end

function expression_branch(cursor: Cursor) returns Parsed of ExprBranch or fails with Halt
  let condition be expression(cursor) otherwise fail
  let condition_node be condition.node
  let then_word be past_word(cursor: condition.cursor, code: words.word_then) otherwise fail
  let outcome be parse_outcome(skip_newlines(then_word)) otherwise fail
  let outcome_node be outcome.node
  let otherwise_word be past_word(
    cursor: skip_newlines(outcome.cursor),
    code: words.word_otherwise
  ) otherwise fail
  let node be ExprBranch(condition: condition_node, outcome: outcome_node)
  return Parsed(node: node, cursor: otherwise_word)
end

function match_expression(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let start be expect_word(cursor: cursor, code: words.word_match) otherwise fail
  let start_token be start.token
  let subject be expression(start.cursor) otherwise fail
  let subject_node be subject.node
  let mutable current be subject.cursor
  let mutable arms: List of ExprArm be []
  let mutable fallback: maybe Outcome be nothing
  let mutable done be false
  repeat until done
    change current to skip_newlines(current)
    let look be current.look
    let token be current.token
    if look is not current.position then change current to current with position: look end
    if token.code is words.word_end then
      change done to true
    otherwise if token.code is words.word_otherwise then
      let rest be match_fallback(at_position(cursor: current, position: look + 1)) otherwise fail
      change fallback to rest.node
      change current to rest.cursor
      change done to true
    otherwise
      let arm be expression_arm(current) otherwise fail
      change arms to arms.append(arm.node)
      change current to arm.cursor
    end
  end
  let end_word be expect_word(cursor: current, code: words.word_end) otherwise fail
  let node be MatchExpr(
    subject: subject_node,
    arms: arms,
    fallback: fallback,
    span: join(left: start_token.span, right: end_word.token.span)
  )
  return Parsed(node: node, cursor: end_word.cursor)
end

function match_fallback(cursor: Cursor) returns Parsed of Outcome or fails with Halt
  let outcome be parse_outcome(skip_newlines(cursor)) otherwise fail
  let outcome_node be outcome.node
  let after be peek(skip_newlines(outcome.cursor))
  let after_token be after.token
  if after_token.code is not words.word_end then
    let flagged be expected(
      cursor: after.cursor,
      what: "`end` after the `otherwise` arm",
      span: after_token.span,
      fix: "write the `otherwise` arm last"
    )
    fail with Halt(cursor: flagged)
  end
  return Parsed(node: outcome_node, cursor: after.cursor)
end

function expression_arm(cursor: Cursor) returns Parsed of ExprArm or fails with Halt
  let when_word be expect_word(cursor: cursor, code: words.word_when) otherwise fail
  let when_word_token be when_word.token
  let shape be parse_pattern(when_word.cursor) otherwise fail
  let shape_node be shape.node
  let guard be expression_after(cursor: shape.cursor, spelling: "where") otherwise fail
  let guard_value be guard.value
  let then_word be past_word(cursor: guard.cursor, code: words.word_then) otherwise fail
  let body be parse_outcome(skip_newlines(then_word)) otherwise fail
  let node be ExprArm(
    pattern: shape_node,
    guard: guard_value,
    body: body.node,
    span: Span(start: when_word_token.span.start, stop: outcome_span(body.node).stop)
  )
  return Parsed(node: node, cursor: body.cursor)
end

function query_expression(cursor: Cursor) returns Parsed of Expr or fails with Halt
  let start be expect_word(cursor: cursor, code: words.word_for_each) otherwise fail
  let start_token be start.token
  let sources be query_sources(start.cursor) otherwise fail
  let sources_node be sources.node
  let concurrently_word be eat_word(cursor: sources.cursor, code: words.word_concurrently)
  let concurrently_word_found be concurrently_word.found
  let mutable current be concurrently_word.cursor
  let mutable deadline: maybe Expr be nothing
  if concurrently_word_found then
    let deadline_clause be or_expression_after(cursor: current, spelling: "within") otherwise fail
    change deadline to deadline_clause.value
    change current to deadline_clause.cursor
  end
  let filter be or_expression_after(cursor: current, spelling: "where") otherwise fail
  let filter_value be filter.value
  let order be ordering(filter.cursor) otherwise fail
  let order_value be order.value
  let group_by be or_expression_after(cursor: order.cursor, spelling: "group by") otherwise fail
  let group_by_value be group_by.value
  let terminal be query_terminal(
    cursor: group_by.cursor,
    grouped: is_present(group_by_value)
  ) otherwise fail
  let node be QueryExpr(
    sources: sources_node,
    is_concurrent: concurrently_word_found,
    deadline: deadline,
    filter: filter_value,
    order: order_value,
    group_by: group_by_value,
    terminal: terminal.node,
    span: join(left: start_token.span, right: previous(terminal.cursor).span)
  )
  return Parsed(node: node, cursor: terminal.cursor)
end

function query_sources(cursor: Cursor) returns Parsed of List of QuerySource or fails with Halt
  let mutable sources: List of QuerySource be []
  let mutable current be cursor
  let mutable done be false
  repeat until done
    let source be loop_source(current) otherwise fail
    change sources to sources.append(QuerySource(bindings: source.bindings, source: source.source))
    let comma be eat_symbol(cursor: source.cursor, code: words.symbol_comma)
    let comma_found be comma.found
    change current to comma.cursor
    if not comma_found then change done to true end
  end
  return Parsed(node: sources, cursor: current)
end

function query_terminal(cursor: Cursor, grouped: Boolean)
  returns Parsed of QueryTerminal
  or fails with Halt

  let look be cursor.look
  let token be cursor.token
  let after be at_position(cursor: cursor, position: look + 1)
  match token.kind
    when Word(spelling: "collect") then
      let value be expression(after) otherwise fail
      return Parsed(node: Collect(value: value.node), cursor: value.cursor)
    when Word(spelling: "sum") then
      let value be expression(after) otherwise fail
      return Parsed(node: Sum(value: value.node), cursor: value.cursor)
    when Word(spelling: "count") then return Parsed(node: Count, cursor: after)
    when Word(spelling: "first") then return Parsed(node: First, cursor: after)
    when Word(spelling: "any") then
      let condition be expression(after) otherwise fail
      return Parsed(node: Any(condition: condition.node), cursor: condition.cursor)
    when Word(spelling: "all") then
      let condition be expression(after) otherwise fail
      return Parsed(node: All(condition: condition.node), cursor: condition.cursor)
    otherwise
      if grouped then return Parsed(node: GroupOnly, cursor: moved(cursor: cursor, look: look)) end
      let found be describe(
        cursor: moved(cursor: cursor, look: look),
        token: token,
        span: token.span
      )
      let diagnostic be report.error(
        code: "query-shape",
        message: query_shape_message(found),
        span: token.span,
        fix: "end the query with one of them"
      )
      fail with halt(cursor: moved(cursor: cursor, look: look), diagnostic: diagnostic)
  end
end

function query_shape_message(found: Text) returns Text
  let head be "a query ends with `collect`, `sum`, `count`, `first`, `any`, `all` or `group by`"
  return "{head}, found {found}"
end

function binary_expression(operator: BinaryOp, left: Expr, right: Expr) returns Expr
  let span be join(left: expr_span(left), right: expr_span(right))
  return Binary(operator: operator, left: left, right: right, span: span)
end

function expr_span(expr: Expr) returns Span
  match expr
    when IntegerLiteral(span) then return span
    when DecimalLiteral(span) then return span
    when TextLiteral(span) then return span
    when RawTextLiteral(span) then return span
    when BooleanLiteral(span) then return span
    when NothingLiteral(span) then return span
    when SelfValue(span) then return span
    when NameExpr(span) then return span
    when TypeNameExpr(span) then return span
    when Member(span) then return span
    when Call(span) then return span
    when Construct(span) then return span
    when ListLiteral(span) then return span
    when MapLiteral(span) then return span
    when RangeLiteral(span) then return span
    when Not(span) then return span
    when Binary(span) then return span
    when With(span) then return span
    when Otherwise(span) then return span
    when IfExpr(span) then return span
    when MatchExpr(span) then return span
    when QueryExpr(span) then return span
    when Paren(span) then return span
  end
end

function outcome_span(outcome: Outcome) returns Span
  match outcome
    when ValueOutcome(span) then return span
    when FailOutcome(span) then return span
    when ReturnOutcome(span) then return span
    when CrashOutcome(span) then return span
    when BreakOutcome(span) then return span
    when ContinueOutcome(span) then return span
  end
end
