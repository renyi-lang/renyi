module field_read
  purpose: Count the instructions of a field read: a loop reading a field of a record in a local.

import std.console
import std.environment

public type Point
  purpose: Two coordinates.
  has east: Integer
  has north: Integer
end

public function main() needs console, environment
  purpose: Print the total after the reads.

  let arguments be environment.arguments()
  let text be arguments.first() otherwise "1000000"
  let rounds be text.to_integer() otherwise 1000000
  let point be Point(east: 3, north: 4)
  let mutable total be 0
  for each index from 1 to rounds
    change total to total + point.east + index
  end
  console.print("{total}")
end
