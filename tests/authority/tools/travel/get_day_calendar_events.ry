module get_day_calendar_events
  purpose: The tool `get_day_calendar_events` of the environment: Returns the appointments for the given `day`.

import std.python exposing PythonError

public type CalendarEvent
  purpose: A calendar event with its times, location, participants and status.
  has id: Text
  has title: Text
  has description: Text
  has start_time: Text
  has end_time: Text
  has location: maybe Text
  has participants: List of Text
  has all_day: Boolean
  has status: Text
  can ToJson
  can FromJson
end

public function get_day_calendar_events(day: Text)
  returns List of CalendarEvent
  or fails with PythonError
  needs python("tools.get_day_calendar_events")
  purpose: Returns the appointments for the given `day`.
