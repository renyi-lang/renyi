module search_contacts_by_name
  purpose: The tool `search_contacts_by_name` of the environment: Finds contacts in the inbox's contact list by name.

import std.python exposing PythonError

public type EmailContact
  purpose: A contact of the address book: an email address and a name.
  has email: Text
  has name: Text
  can ToJson
  can FromJson
end

public function search_contacts_by_name(query: Text)
  returns List of EmailContact
  or fails with PythonError
  needs python("tools.search_contacts_by_name")
  purpose: Finds contacts in the inbox's contact list by name.
