module share_file
  purpose: The tool `share_file` of the environment: Share a file with a user.

import std.python exposing PythonError

public type CloudDriveFile
  purpose: A file of the cloud drive with its content and who it is shared with.
  has id: Text
  has filename: Text
  has content: Text
  has owner: Text
  has last_modified: Text
  has shared_with: Map of Text to Text
  has size: Integer
  can ToJson
  can FromJson
end

public function share_file(file_id: Text, email: Text, permission: Text)
  returns CloudDriveFile
  or fails with PythonError
  needs python("tools.share_file")
  purpose: Share a file with a user.
