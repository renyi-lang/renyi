module delete_file
  purpose: The tool `delete_file` of the environment: Delete a file from the cloud drive by its filename.

import std.python exposing PythonError

public type CloudDriveFile
  purpose: A file of the cloud drive with its content and who it is shared with.
  has id: Text
  has filename: Text
  has content: Text
  has owner: Text
  has last_modified: Text
  has shared_with: Map of Text to Text
  has size: Integer
  can ToJson
  can FromJson
end

public function delete_file(file_id: Text)
  returns CloudDriveFile
  or fails with PythonError
  needs python("tools.delete_file")
  purpose: Delete a file from the cloud drive by its filename.
