module append_to_file
  purpose: The tool `append_to_file` of the environment: Append content to a file in the cloud drive.

import std.python exposing PythonError

public type CloudDriveFile
  purpose: A file of the cloud drive with its content and who it is shared with.
  has id: Text
  has filename: Text
  has content: Text
  has owner: Text
  has last_modified: Text
  has shared_with: Map of Text to Text
  has size: Integer
  can ToJson
  can FromJson
end

public function append_to_file(file_id: Text, content: Text)
  returns CloudDriveFile
  or fails with PythonError
  needs python("tools.append_to_file")
  purpose: Append content to a file in the cloud drive.
