{
  "name": "renyi",
  "displayName": "Renyi",
  "description": "Renyi, the scripting language of AI agents: syntax highlighting and the language server (diagnostics, hover, go to definition, the outline). The agent writes it, you review it at a glance, and the program can only do what it declares.",
  "version": "0.1.0",
  "publisher": "renyi-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/renyi-lang/renyi",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/renyi-lang/renyi",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "renyi",
    "agents",
    "capabilities",
    "effects"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:renyi"
  ],
  "contributes": {
    "languages": [
      {
        "id": "renyi",
        "aliases": [
          "Renyi",
          "renyi"
        ],
        "extensions": [
          ".ry",
          ".renyi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "renyi",
        "scopeName": "source.renyi",
        "path": "./syntaxes/renyi.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Renyi",
      "properties": {
        "renyi.path": {
          "type": "string",
          "default": "renyi",
          "description": "The renyi binary that serves the language (`renyi lsp`): a name on the PATH or a full path. Takes effect when the window is reloaded."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --external:vscode --outfile=out/extension.js",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
